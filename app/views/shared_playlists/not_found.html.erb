<% content_for :title, "Playlist Not Found — hackr.tv" %>

<%= render layout: "shared/default_chrome" do %>
  <div class="playlists-wrap playlists-wrap--narrow">
    <div class="tui-window">
      <fieldset class="tui-fieldset">
        <legend>ERROR</legend>
        <div class="playlists-empty__body">
          <p class="playlist-error">This shared playlist doesn't exist or is no longer public.</p>
          <%= tui_button "Go to hackr.fm", "/fm/radio", class: "playlists-create-btn" %>
        </div>
      </fieldset>
    </div>
  </div>
<% end %>
