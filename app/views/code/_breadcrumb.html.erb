<%# CodeBreadcrumb.tsx port. Locals: repo_slug, path (may be nil), is_blob. %>
<% segments = path.to_s.split("/").reject(&:blank?) %>
<div class="code-breadcrumb">
  <%= link_to "code", code_path %>
  <span class="code-crumb-sep">/</span>
  <% if segments.empty? && !is_blob %>
    <span class="code-crumb-current"><%= repo_slug %></span>
  <% else %>
    <%= link_to repo_slug, code_repo_path(repo_slug) %>
  <% end %>
  <% segments.each_with_index do |segment, i| %>
    <span class="code-crumb-sep">/</span>
    <% if i == segments.length - 1 %>
      <span class="code-crumb-current"><%= segment %></span>
    <% else %>
      <%= link_to segment, code_tree_path(repo_slug, segments[0..i].join("/")) %>
    <% end %>
  <% end %>
</div>
