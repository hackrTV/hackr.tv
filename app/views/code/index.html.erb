<% content_for :title, "Code — hackr.tv" %>
<% numbers = @repos.each_index.map { |i| format("%02d", i + 1) } %>
<% languages = @repos.filter_map(&:language).uniq.sort %>

<%= render layout: "shared/default_chrome", locals: {ascii: false} do %>
  <div class="console console--code" data-controller="terminal ledger-filter" data-boot="done">
    <div class="console-bar">
      <h1 class="console-bar-title">CODE</h1>
      <span class="console-bar-sub">OPEN SOURCE FROM HACKRTV</span>
      <span class="console-bar-right">
        <%= link_to "[<] HOME", "/", class: "console-bar-link" %>
      </span>
    </div>

    <div class="console-status">
      <div class="console-status-row">
        <span class="console-key">REPOS</span>
        <span class="console-val"><% if @repos.any? %><%= pluralize(@repos.size, "repository") %><% if languages.any? %> <span class="console-dim">· <%= languages.join(" · ") %></span><% end %><% else %><span class="console-dim">NONE ON RECORD</span><% end %></span>
      </div>
      <div class="console-status-row">
        <span class="console-key">SYNC</span>
        <span class="console-val"><% if @last_sync %><%= future_stamp(@last_sync) %> <span class="console-dim">· daily from github.com/hackrTV</span><% else %><span class="console-dim">NEVER</span><% end %></span>
      </div>
      <div class="console-status-row cb-filter">
        <label class="console-key" for="ledger-filter">FILTER</label>
        <span class="console-val">
          <input type="search" id="ledger-filter" class="cb-input" placeholder="name · description · language" autocomplete="off" spellcheck="false"
            data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
          <span class="cb-count" data-ledger-filter-target="count"><%= @repos.size %> / <%= @repos.size %></span>
          <button type="button" class="cb-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
        </span>
      </div>
    </div>

    <section class="console-section" aria-label="Repositories">
      <div class="console-rule"><span>// REPOSITORIES //</span></div>
      <% if @repos.empty? %>
        <p class="cc-empty">NO REPOSITORIES ON RECORD <span class="console-dim">· the sync has not run</span></p>
      <% end %>
      <% @repos.each_with_index do |repo, i| %>
        <div class="cb-row cb-row--repo" data-ledger-filter-target="row"
          data-search="<%= [repo.name, repo.description, repo.language].compact.join(" ").downcase %>">
          <span class="console-tag">[<%= numbers[i] %>]</span>
          <div class="cc-text">
            <%= link_to repo.name, code_repo_path(repo.slug), class: "console-link cc-name", data: {command: numbers[i]} %>
            <div class="cc-meta"><%= [repo.language&.upcase, (repo.stargazers_count.to_i.positive? ? "★ #{repo.stargazers_count}" : nil), (repo.github_pushed_at ? "pushed #{future_stamp(repo.github_pushed_at)}" : nil), code_format_size(repo.size_kb.to_i * 1024)].compact.join(" · ") %></div>
          </div>
          <span class="console-desc"><%= repo.description %></span>
        </div>
      <% end %>
    </section>

    <%= render "destinations", except: "CODE", numbers: numbers %>
  </div>
<% end %>
