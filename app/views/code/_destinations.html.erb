<%# The /code screens' tail: destinations, closing rule, prompt. Locals: except (tag to omit),
    numbers (ledger row numbers), up (true when a [^] UP link answers ".."). %>
<% numbers = local_assigns.fetch(:numbers, []) %>
<% rows = [
  ["CODE", code_path, "Code", "Open source from hackrTV"],
  ["HOME", "/", "hackr.tv", "The broadcast console"]
].reject { |tag_name, *| tag_name == local_assigns[:except] } %>
<% tags = rows.map { |tag_name, *| tag_name.downcase } %>
<% hint = [] %>
<% if numbers.any? %>
  <% hint << safe_join(["type a number ", tag.span("(#{(numbers.size > 8) ? "#{numbers.first}–#{numbers.last}" : numbers.join(" ")})", class: "console-dim"), " or "]) %>
<% end %>
<% hint << safe_join(["type a tag ", tag.span("(#{(local_assigns[:up] ? [".."] + tags : tags).join(" ")})", class: "console-dim"), " · enter · ? help"]) %>

<section class="console-section" aria-label="Destinations">
  <div class="console-rule"><span>// DESTINATIONS //</span></div>
  <% rows.each do |tag_name, href, name, desc| %>
    <div class="console-row">
      <span class="console-tag">[<%= tag_name %>]</span>
      <%= link_to name, href, class: "console-link", data: {command: tag_name.downcase} %>
      <span class="console-desc"><%= desc %></span>
    </div>
  <% end %>
</section>

<div class="console-rule"><span>// EVERY LINE COMMITTED TO RECORD //</span></div>
<%= render "shared/console_prompt", hint: safe_join(hint) %>
