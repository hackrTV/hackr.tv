<%# The XERAEN console's destination rows (landing + bio): one aligned
    line per link, the [TAG] doubling as the prompt command (the
    terminal controller reads a[data-command]). Locals: except — the
    page's own tag, left out. %>
<% except = local_assigns[:except] %>
<% destinations = [
  ["XERAEN", "/xeraen", "XERAEN", "The operative record"],
  ["BIO", "/xeraen/bio", "Bio", "The story behind the broadcasts. How a systems architect broke time open and what he lost doing it."],
  ["RELEASES", "/xeraen/releases", "Releases", "Every transmission committed to record. Hardcore fury to OMNIWAVE and everything between."],
  ["VAULT", "/vault?filter=xeraen", "Pulse Vault", "Listen — every XERAEN track in the vault"],
  ["TCP", "/thecyberpulse", "The.CyberPul.se", "Flagship Standard Bearers of the Hackrs of CyberSpace"],
  ["FNET", "/f/net", "Fracture Network", "Back to the network"]
] %>
<section class="console-section" aria-label="Destinations">
  <div class="console-rule console-line" data-terminal-target="line"><span>// DESTINATIONS //</span></div>
  <% destinations.each do |tag, href, name, desc| %>
    <% next if tag == except %>
    <div class="console-row console-line" data-terminal-target="line">
      <span class="console-tag">[<%= tag %>]</span>
      <%= link_to name, href, class: "console-link", data: {command: tag.downcase} %>
      <span class="console-desc"><%= desc %></span>
    </div>
  <% end %>
</section>
