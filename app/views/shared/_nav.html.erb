        <%= nav_link_to "/grid", css_class: "mobile-menu-item#{" active" if nav_active?("/grid")}" do %><span class="purple-168-text">/</span>grid<% end %>
        <% if logged_in? %>
          <%= nav_link_to "/grid/identity", css_class: "mobile-menu-item#{" active" if nav_active?("/grid")}" do %><span class="purple-168-text">/</span>identity<% end %>
          <% if current_hackr.has_feature?("tactical_grid") %>
