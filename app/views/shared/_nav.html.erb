        <%= nav_link_to "/timeline", css_class: "mobile-menu-item#{" active" if nav_active?("/timeline")}" do %><span class="purple-168-text"><%= timeline_n %></span> Timeline<% end %>
        <%= nav_link_to "/codex", css_class: "mobile-menu-item#{" active" if nav_active?("/codex")}" do %><span class="purple-168-text"><%= codex_n %></span> Codex<% end %>
        <% if logged_in? %>
          <%= nav_link_to "/handbook", css_class: "mobile-menu-item#{" active" if nav_active?("/handbook")}" do %><span class="purple-168-text">9</span> Handbook<% end %>
        <% end %>
        <%= nav_link_to "/logs", css_class: "mobile-menu-item#{" active" if nav_active?("/logs")}" do %><span class="purple-168-text"><%= logs_n %></span> Logs<% end %>
