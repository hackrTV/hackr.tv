    <button class="mobile-menu-toggle" data-action="click->mobile-menu#open">[≡] MENU</button>
  </div>

  <div class="mobile-menu-overlay" data-mobile-menu-target="overlay" data-action="click->mobile-menu#backdropClose">
    <div class="mobile-menu-container" data-action="click->mobile-menu#maybeClose">
      <div class="mobile-menu-header">
        <div class="mobile-menu-title">[ NAVIGATION ]</div>
        <button class="mobile-menu-close" data-action="click->mobile-menu#close">[X]</button>
      </div>

      <div class="mobile-menu-section">
        <div class="mobile-menu-section-title">MAIN</div>
        <%= nav_link_to "/", css_class: "mobile-menu-item#{" active" if nav_active?("/")}" do %><span class="purple-168-text">0</span> / hackr.tv<% end %>
        <%= nav_link_to "/schedule", css_class: "mobile-menu-item#{" active" if nav_active?("/schedule")}" do %><span class="purple-168-text">/</span> schedule<% end %>
        <% if world_feed_visible? %>
          <%= nav_link_to "/feed", css_class: "mobile-menu-item#{" active" if nav_active?("/feed")}" do %><span class="purple-168-text">/</span> feed<% end %>
        <% end %>
      </div>

      <div class="mobile-menu-section">
        <div class="mobile-menu-section-title">1. THE.CYBERPUL.SE</div>
        <%= nav_link_to "/thecyberpulse", css_class: "mobile-menu-item#{" active" if nav_active?("/thecyberpulse")}" do %><span class="purple-168-text">/</span>root<% end %>
        <%= nav_link_to "/thecyberpulse/bio", css_class: "mobile-menu-item#{" active" if nav_active?("/thecyberpulse/bio")}" do %><span class="purple-168-text">/</span>bio<% end %>
        <%= nav_link_to "/thecyberpulse/releases", css_class: "mobile-menu-item#{" active" if nav_active?("/thecyberpulse/releases")}" do %><span class="purple-168-text">/</span>releases<% end %>
        <%= nav_link_to "/thecyberpulse/vidz", css_class: "mobile-menu-item#{" active" if nav_active?("/thecyberpulse/vidz")}" do %><span class="purple-168-text">/</span>vidz<% end %>
      </div>

      <div class="mobile-menu-section">
        <div class="mobile-menu-section-title">2. XERAEN.NET</div>
        <%= nav_link_to "/xeraen", css_class: "mobile-menu-item#{" active" if nav_active?("/xeraen")}" do %><span class="purple-168-text">/</span>root<% end %>
        <%= nav_link_to "/xeraen/bio", css_class: "mobile-menu-item#{" active" if nav_active?("/xeraen/bio")}" do %><span class="purple-168-text">/</span>bio<% end %>
        <%= nav_link_to "/xeraen/releases", css_class: "mobile-menu-item#{" active" if nav_active?("/xeraen/releases")}" do %><span class="purple-168-text">/</span>releases<% end %>
      </div>

      <div class="mobile-menu-section">
        <div class="mobile-menu-section-title">3. HACKR.FM</div>
        <%= nav_link_to "/fm", css_class: "mobile-menu-item#{" active" if nav_active?("/fm")}" do %><span class="purple-168-text">/</span>root<% end %>
        <%= nav_link_to "/fm/radio", css_class: "mobile-menu-item#{" active" if nav_active?("/fm/radio")}" do %><span class="purple-168-text">/</span>radio<% end %>
        <%= nav_link_to "/fm/releases", css_class: "mobile-menu-item#{" active" if nav_active?("/fm/releases")}" do %><span class="purple-168-text">/</span>releases<% end %>
        <%= nav_link_to "/vault", css_class: "mobile-menu-item#{" active" if nav_active?("/vault")}" do %><span class="purple-168-text">/</span>vault<% end %>
