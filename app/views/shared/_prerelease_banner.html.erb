<%# PrereleaseBanner.tsx port. The login page renders it into the layout's
    .top-notices header slot (below the nav, in normal flow — no fixed
    offset or spacer). Renders only when prerelease_mode is set
    ("alpha" / "prerelease" / nil, see config/initializers/app_settings.rb). %>
<% if prerelease_mode.present? %>
  <div class="prerelease-banner">
    <span class="prerelease-banner-mode">[<%= prerelease_mode.to_s.upcase %>]</span>
    <span class="prerelease-banner-text"><%= prerelease_banner_text.presence || "This application is in #{prerelease_mode} mode." %></span>
  </div>
<% end %>
