<%# @mention toast (Uplink Phase 2 item 1). ChatMessage#notify_mentions
    appends it to each mentioned hackr's #toast-region over their own
    [hackr, :toasts] stream, so it is viewer-neutral by construction. The
    whole toast is a link to the channel; data-channel lets the /uplink
    shell badge that sidebar row, or drop the toast when the viewer is
    already in the channel (the packet is in their log, highlighted).
    Locals: packet. %>
<%
  channel = packet.chat_channel
  sender = uplink_packet_sender(packet)
  excerpt = uplink_packet_excerpt(packet)
%>
<%= link_to uplink_path(channel: channel.slug), class: "toast toast--mention",
  data: {controller: "toast", action: "click->toast#dismiss", channel: channel.slug, packet_id: packet.id} do %>
  <div class="toast-kicker toast-kicker--mention">@MENTION <span class="toast-channel"><%= channel.name %></span></div>
  <div class="toast-title"><span class="toast-sender"><%= sender %></span></div>
  <div class="toast-description"><%= excerpt %></div>
<% end %>
