<%# Packet.tsx port. Locals:
      packet — required
      viewer — GridHackr or nil. Broadcast renders pass nil
               (viewer-neutral); the drop/restore controls render hidden
               and the packet Stimulus controller reveals them from the
               layout's current-hackr metas. It also fixes broadcast-form
               CSRF tokens, localizes the timestamp, and highlights the
               viewer's own @mentions.
    data-author-key / data-at feed the packet-log controller's
    client-side consecutive-author grouping (the /uplink shell).
    Replies: data-reply-to + a quote line "[>] sender excerpt" above the
    content, viewer-neutral (a dropped parent reads [PACKET DROPPED] —
    the model re-broadcasts reply rows when their parent drops/restores);
    clicking the quote jumps to the parent when it is in the log. The
    hover reply control dispatches packet:reply for the shell composer;
    CSS hides it on the dock/popout, whose composer has no reply bar.
    The author link opens the shell's operative record popover
    (popover#open, url in the action param); the dock/popout have no
    popover controller, so the action is inert and the link visits the
    WIRE profile as before. The hover [...] (native packets only) opens the
    operator menu the same way, into the shell's uplink-modmenu frame:
    rendered hidden, revealed by the packet controller for operators who
    outrank the author (data-packet-author-role-value), CSS-hidden off
    the shell. Pins: .packet--pinned + a PIN badge on a pinned active
    packet (the marker), and the hover ◆ pin/unpin form (operator+,
    revealed by the packet controller, CSS-hidden off the shell) — the
    pin endpoints and the model both replace the whole row, so the
    marker and the control flip together. %>
<%
  viewer = local_assigns.fetch(:viewer, nil)
  bot = packet.source == "SYNTHIA"
  bridged = packet.source.present? && !bot
  parsed = bridged ? parse_bridged_packet(packet.content) : nil
  own = viewer && viewer.id == packet.grid_hackr_id
  can_moderate = viewer&.at_least_operator?
  platform = uplink_platform_class(packet.source)
  role_badge = uplink_role_badge(packet.grid_hackr&.role)
  parent = packet.reply_to
  parent_class = parent && uplink_packet_sender_class(parent)
  pinned = packet.pinned? && !packet.dropped?
%>
<div id="<%= dom_id(packet) %>"
  class="packet<%= " packet--dropped" if packet.dropped? %><%= " packet--bridged" if bridged %><%= " packet--reply" if parent %><%= " packet--pinned" if pinned %>"
  data-controller="packet" data-packet-owner-id-value="<%= packet.grid_hackr_id %>"
  data-packet-author-role-value="<%= uplink_role_class(packet.grid_hackr.role) %>"
  data-author-key="<%= uplink_author_key(packet, parsed) %>" data-at="<%= (packet.created_at.to_f * 1000).to_i %>"<% if parent %>
  data-reply-to="<%= parent.id %>"<% end %>>
  <div class="packet-meta">
    <time class="packet-time" datetime="<%= packet.created_at.iso8601 %>"
      data-packet-target="time"><%= packet.created_at.strftime("%H:%M") %></time>
    <% if (bridged || bot) && platform %>
      <span class="packet-badge packet-badge--<%= platform %>"><%= packet.source %></span>
    <% elsif role_badge %>
      <span class="packet-badge packet-badge--<%= uplink_role_class(packet.grid_hackr.role) %>"><%= role_badge %></span>
    <% end %>
    <% if pinned %>
      <span class="packet-badge packet-badge--pinned" title="Pinned">PIN</span>
    <% end %>
  </div>

  <div class="packet-body">
    <% if parent %>
      <button type="button" class="packet-reply-quote" title="Jump to the original packet"
        data-action="click->packet#jumpToParent">
        <span class="packet-reply-mark">[&gt;]</span>
        <span class="packet-reply-author packet-reply-author--<%= parent_class %>"><%= uplink_packet_sender(parent) %></span>
        <span class="packet-reply-excerpt"><%= uplink_packet_excerpt(parent) %></span>
      </button>
    <% end %>
    <% if parsed %>
      <span class="packet-bridged-user<%= " packet-bridged-user--#{platform}" if platform %>"><%= parsed[1] %>:</span>
      <span class="packet-content"><% if packet.dropped? %>[PACKET DROPPED]<% else %><%= uplink_packet_text(packet, parsed[2]) %><% end %></span>
    <% else %>
      <% unless bot || bridged %>
        <a class="packet-author packet-author--<%= uplink_role_class(packet.grid_hackr.role) %>"
          href="/wire/<%= packet.grid_hackr.hackr_alias %>" data-action="click->popover#open"
          data-popover-url-param="<%= uplink_profile_path(packet.grid_hackr.hackr_alias.downcase) %>">@<%= packet.grid_hackr.hackr_alias %></a>
      <% end %>
      <span class="packet-content<%= " packet-content--synthia" if bot %>"><% if packet.dropped? %>[PACKET DROPPED]<% else %><%= uplink_packet_text(packet) %><% end %></span>
    <% end %>
  </div>

  <div class="packet-actions">
    <% if packet.dropped? %>
      <%= button_to "↺", uplink_packet_restore_path(packet), method: :post,
        class: "packet-action-button", title: "Restore packet", form_class: "uplink-inline-form",
        form: {hidden: !can_moderate, data: {packet_target: "restoreControl"}} %>
    <% else %>
      <button type="button" class="packet-action-button packet-reply-button" title="Reply to packet"
        data-action="click->packet#reply" data-reply-sender="<%= uplink_packet_sender(packet, parsed) %>">↩</button>
      <%= button_to "◆", packet.pinned? ? uplink_packet_unpin_path(packet) : uplink_packet_pin_path(packet), method: :post,
        class: class_names("packet-action-button packet-pin-button", "packet-pin-button--on": packet.pinned?),
        title: packet.pinned? ? "Unpin packet" : "Pin packet", form_class: "uplink-inline-form uplink-pin-form",
        form: {hidden: !can_moderate, data: {packet_target: "pinControl"}} %>
      <%= button_to "×", uplink_packet_drop_path(packet), method: :post,
        class: "packet-action-button", title: "Drop packet", form_class: "uplink-inline-form",
        form: {hidden: !(own || can_moderate), data: {packet_target: "dropControl"}} %>
    <% end %>
    <% unless bot || bridged %>
      <button type="button" class="packet-action-button packet-mod-button" title="Moderate" hidden
        data-packet-target="modControl" data-action="click->popover#open"
        data-popover-url-param="<%= uplink_packet_menu_path(packet) %>" data-popover-frame-param="uplink-modmenu"
        data-popover-align-param="end">...</button>
    <% end %>
  </div>
</div>
