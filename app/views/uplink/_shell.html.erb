<%# The /uplink page: a Discord-shaped NODE shell with the hackr.tv TUI
    laid over it — rail / channel sidebar / channel pane / operatives
    pane. Only /uplink renders this; the home dock and popout keep
    uplink/_panel, and all three share uplink/_body (log + composer +
    notices) and the packet/form partials, so the broadcast contracts
    (#uplink-log, #uplink-form-error, #chat_message_N) are identical.
    The uplink Stimulus controller sits on the root (ancestor of the
    banner, presence and logFrame targets, exactly as on .uplink-panel);
    uplink-shell owns the chrome: drawers under 768px, the members
    toggle, the stage collapse, the jump pill (which reads JUMP TO
    PRESENT on a located log), the / hotkey, the sidebar's unread badges
    (bump stream + read acks) and their mention recolor from toasts, and
    the operatives pane's search face (data-pane="search": the form
    whose GET lands in the uplink-search frame — Uplink::SearchController
    — and the hits' links, resolved in place when the log has the
    packet); uplink also relays the composer's typing
    events (packet-form:typing / stop-typing, bubbled from _packet_form)
    to its LiveChatChannel subscription, and the typing line above the
    composer listens on the ["uplink_typing", slug] stream; popover owns the operative
    record card (a turbo-frame in the channel pane that packet author
    links load — see uplink/profiles/show), the operator menu (a
    second frame, a grid child, that the [...] on packets and roster rows
    loads — see uplink/punishments/menu), the pinned packets panel (a
    third frame in the channel pane that the header's [◆] loads — see
    uplink/pins/show) and the reaction picker (a fourth, in the channel
    pane, that a packet's :) loads — see uplink/reactions/menu); one of
    the four is open at a time.
    Locals: channel, channels, packets, viewer, live_stream, roster,
    more (older packets exist — seeds the scrollback sentinel), unread
    (Uplink::Unread.sync result for the sidebar), unseen_from (the viewer's
    read mark before this visit, nil on first sight) + unseen_divider (this
    page holds the NEW PACKETS boundary — UplinkController), more_after +
    focus (a located log: /uplink?around=), search_query (?q= — the pane
    opens on its search face with these results). %>
<%
  viewable = channel.present? && channel.viewable_by?(viewer)
  live = live_stream.present?
  staged = live && channel&.requires_livestream? && live_stream.live_url.present?
  search_query = local_assigns.fetch(:search_query, "").to_s
  searching = viewable && search_query.present?
%>
<div class="uplink-shell" data-controller="uplink uplink-shell popover" data-members="open" data-drawer="" data-pane="<%= searching ? "search" : "members" %>"
  data-uplink-channel-value="<%= channel&.slug %>"
  data-uplink-log-src-value="<%= viewable ? uplink_log_path(channel: channel.slug, shell: 1) : "" %>"
  data-uplink-shell-channel-value="<%= channel&.slug %>"
  data-uplink-shell-ack-url-value="<%= viewable ? uplink_reads_path : "" %>"
  data-uplink-shell-present-url-value="<%= uplink_path(channel: channel&.slug, q: search_query.presence) %>"
  data-action="packet-log:state->uplink-shell#logState turbo:submit-end->uplink-shell#sent keydown@document->uplink-shell#hotkey toast:connected@document->uplink-shell#toast turbo:frame-load->popover#loaded mousedown@document->popover#outside keydown@document->popover#keydown turbo:submit-end->popover#submitted packet-form:typing->uplink#typing packet-form:stop-typing->uplink#stopTyping">
  <nav class="uplink-rail" aria-label="Nodes">
    <%= link_to "h.tv", uplink_path, class: "uplink-rail-node uplink-rail-node--active", title: "hackr.tv NODE", aria: {current: "page"} %>
  </nav>

  <aside class="uplink-sidebar" data-uplink-shell-target="sidebar" aria-label="Channels">
    <header class="uplink-sidebar-header">
      <span class="uplink-sidebar-kicker">UPLINK</span>
      <span class="uplink-sidebar-node">hackr.tv NODE</span>
    </header>
    <%= render "uplink/channel_list", channels: channels, active: channel&.slug, live: live,
      unread: local_assigns.fetch(:unread, {}) %>
    <footer class="uplink-userpanel">
      <span class="uplink-userpanel-alias uplink-userpanel-alias--<%= uplink_role_class(viewer.role) %>">@<%= viewer.hackr_alias %></span>
      <span class="uplink-userpanel-role"><%= viewer.role.upcase %></span>
      <%= link_to "WIRE", wire_user_path(viewer.hackr_alias), class: "uplink-userpanel-link", title: "Your WIRE profile" %>
    </footer>
  </aside>

  <div class="uplink-main" data-uplink-shell-target="main">
    <%# Stream sources live inside the pane, never as direct children of
        the grid root: an empty element is still a grid item and would
        take a cell. %>
    <% if viewable %>
      <%= turbo_stream_from "uplink_html", channel.slug %>
      <%= turbo_stream_from Uplink::MembersBroadcaster::STREAM, channel.slug %>
      <%= turbo_stream_from Uplink::Typing::STREAM, channel.slug %>
    <% end %>
    <div class="uplink-banner" data-uplink-target="banner">Establishing uplink...</div>

    <header class="uplink-chanhead">
      <button type="button" class="uplink-chanhead-button uplink-chanhead-menu" title="Channels"
        aria-label="Open channel list" data-action="click->uplink-shell#toggleSidebar">[#]</button>
      <h2 class="uplink-chanhead-name"><%= channel&.name || "UPLINK" %></h2>
      <%= uplink_live_dot(live) if channel&.requires_livestream? %>
      <% if channel&.description.present? %>
        <span class="uplink-chanhead-topic" title="<%= channel.description %>"><%= channel.description %></span>
      <% end %>
      <% if channel&.slow_mode? %>
        <span class="uplink-chanhead-chip" title="Slow mode: <%= channel.slow_mode_seconds %>s between packets">SLOW <%= channel.slow_mode_seconds %>s</span>
      <% end %>
      <span class="uplink-chanhead-presence">
        <span class="presence-dot" data-uplink-target="presenceDot"></span>
        <span class="presence-text" data-uplink-target="presenceText">Connecting...</span>
      </span>
      <% if viewable %>
        <button type="button" class="uplink-chanhead-button uplink-chanhead-pins" title="Pinned packets"
          data-action="click->popover#open" data-popover-url-param="<%= uplink_pins_path(channel: channel.slug) %>"
          data-popover-frame-param="uplink-pins" data-popover-align-param="end">[◆]<span class="uplink-chanhead-label"> PINNED</span> <%= render "uplink/pins_count", channel: channel %></button>
        <button type="button" class="uplink-chanhead-button uplink-chanhead-search" title="Search packets"
          aria-controls="uplink-members-pane" aria-pressed="<%= searching %>"
          data-uplink-shell-target="searchToggle" data-action="click->uplink-shell#toggleSearch">[/]<span class="uplink-chanhead-label"> SEARCH</span></button>
      <% end %>
      <button type="button" class="uplink-chanhead-button uplink-popout-button" title="Pop out Uplink"
        data-action="click->uplink#popout">[^]</button>
      <button type="button" class="uplink-chanhead-button uplink-chanhead-members" title="Operatives"
        aria-controls="uplink-members-pane" aria-pressed="true"
        data-uplink-shell-target="membersToggle" data-action="click->uplink-shell#toggleMembers">[o]<span class="uplink-chanhead-label"> OPERATIVES</span></button>
    </header>

    <% if staged %>
      <%= render "uplink/stage", stream: live_stream %>
    <% end %>

    <%= render "uplink/body", channel: channel, viewer: viewer, packets: packets, shell: true,
      more: local_assigns.fetch(:more, false), unseen_from: local_assigns.fetch(:unseen_from, nil),
      unseen_divider: local_assigns.fetch(:unseen_divider, false),
      more_after: local_assigns.fetch(:more_after, false), focus: local_assigns.fetch(:focus, nil) %>

    <%# Operative record popover: empty + hidden until a packet author is
        clicked; absolute inside .uplink-main (the popover controller
        clamps it to this pane). target=_top: links in the card navigate
        the page. %>
    <%= turbo_frame_tag "uplink-popover", target: "_top", hidden: true, class: "uplink-popover-frame", data: {popover_target: "frame"} %>
    <%# Pinned packets panel: the popover controller's third frame, parked
        under the header's [◆] (align end) over the log top. %>
    <%= turbo_frame_tag "uplink-pins", target: "_top", hidden: true, class: "uplink-pins-frame", data: {popover_target: "frame"} %>
    <%# Reaction picker: the fourth frame, parked under the packet's :). %>
    <%= turbo_frame_tag "uplink-reactmenu", target: "_top", hidden: true, class: "uplink-reactmenu-frame", data: {popover_target: "frame"} %>
  </div>

  <aside class="uplink-members-pane" id="uplink-members-pane" data-uplink-shell-target="members" aria-label="Operatives">
    <header class="uplink-members-title uplink-members-title--roster">OPERATIVES</header>
    <%= render "uplink/members", roster: roster %>
    <% if viewable %>
      <%# Search (Phase 2 item 9): the pane's other face. data-pane="search"
          on the shell root (uplink-shell#toggleSearch, or ?q= on load)
          shows this instead of the roster, wider, even with the roster
          preference closed. The form's GET lands in the uplink-search
          frame (Uplink::SearchController); the frame starts with the hint,
          or with the ?q= results (src, fetched on connect). %>
      <section class="uplink-search" aria-label="Search packets" data-uplink-shell-target="search">
        <header class="uplink-members-title uplink-search-title">SEARCH
          <button type="button" class="uplink-search-close" aria-label="Close search" data-action="click->uplink-shell#closeSearch">[x]</button>
        </header>
        <form class="uplink-search-form" role="search" action="<%= uplink_search_path %>" method="get" data-turbo-frame="uplink-search">
          <input type="hidden" name="channel" value="<%= channel.slug %>">
          <input type="text" name="q" value="<%= search_query %>" class="uplink-search-field" placeholder="Scan <%= channel.name %>..." autocomplete="off" maxlength="<%= Uplink::SearchController::QUERY_MAX %>" aria-label="Search <%= channel.name %>"
            data-uplink-shell-target="searchField" data-action="keydown->uplink-shell#searchKey">
          <button type="submit" class="uplink-search-go" title="Search" aria-label="Search">[&gt;]</button>
        </form>
        <%= turbo_frame_tag "uplink-search", target: "_top", class: "uplink-search-frame",
          src: (uplink_search_path(channel: channel.slug, q: search_query) if searching) do %>
          <%= render "uplink/search/results", channel: channel, query: "", results: [], capped: false, error: nil %>
        <% end %>
      </section>
    <% end %>
  </aside>

  <div class="uplink-backdrop" data-action="click->uplink-shell#closeDrawers"></div>

  <%# Operator menu (operator+): the popover controller's second frame,
      loaded from a packet's or roster row's [...] (GET …/menu). A grid
      child, not a pane child: under 768px the roster is a drawer over an
      inert channel pane, and the menu must stack above both (the grid
      guard in uplink.css lets this one through). %>
  <%= turbo_frame_tag "uplink-modmenu", target: "_top", hidden: true, class: "uplink-modmenu-frame", data: {popover_target: "frame"} %>
</div>
