<%# UplinkPanel.tsx port. Locals:
      channel  — active ChatChannel (nil when none configured)
      channels — tab row (empty array hides it: home dock pins one channel)
      packets  — chronological initial log (the SPA's initial_packets)
      viewer   — GridHackr or nil
      tab_path — proc slug→path for tab links (default /uplink?channel=)
      popout_button — render the [^] opener
    The turbo_stream_from subscription delivers packet HTML; the uplink
    Stimulus controller separately subscribes LiveChatChannel for presence
    counts + connection state (its packet JSON is ignored). The body
    below the header (log + composer / notices) is uplink/_body, shared
    with the /uplink shell. %>
<%
  channels = local_assigns.fetch(:channels, [])
  viewer = local_assigns.fetch(:viewer, nil)
  tab_path = local_assigns.fetch(:tab_path, ->(slug) { uplink_path(channel: slug) })
  popout_button = local_assigns.fetch(:popout_button, false)
  live = HackrStream.current_live.present?
  viewable = channel.present? && channel.viewable_by?(viewer)
%>
<div class="uplink-panel" data-controller="uplink"
  data-uplink-channel-value="<%= channel&.slug %>"
  data-uplink-log-src-value="<%= viewable ? uplink_log_path(channel: channel.slug) : "" %>">
  <% if viewable %>
    <%= turbo_stream_from "uplink_html", channel.slug %>
  <% end %>

  <div class="uplink-banner" data-uplink-target="banner">Establishing uplink...</div>

  <div class="uplink-header">
    <h2 class="uplink-title">UPLINK</h2>
    <div class="uplink-header-right">
      <% if viewer %><span class="uplink-header-alias">@<%= viewer.hackr_alias %></span><% end %>
      <% if popout_button %>
        <button type="button" class="uplink-popout-button" title="Pop out Uplink"
          data-action="click->uplink#popout">[^]</button>
      <% end %>
    </div>
  </div>

  <% if channels.any? %>
    <%= render "uplink/channel_tabs", channels: channels, active: channel&.slug, live: live, tab_path: tab_path %>
  <% end %>

  <div class="presence-indicator">
    <span class="presence-dot" data-uplink-target="presenceDot"></span>
    <span class="presence-text" data-uplink-target="presenceText">Connecting...</span>
  </div>

  <%= render "uplink/body", channel: channel, viewer: viewer, packets: packets %>
</div>
