<% content_for :title, "Uplink — hackr.tv" %>
<% content_for :head do %>
  <%# Never restore a stale log / roster / open drawer from a snapshot. %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<%# stream-status refreshes the page when live state flips, so the
    sidebar's live dot, the live channel's availability and the stage
    re-render server-side (the SPA's useStreamStatus isLive equivalent). %>
<div data-controller="stream-status" data-stream-status-live-value="<%= @live_stream.present? %>">
  <%= render "uplink/shell", channel: @channel, channels: @channels, packets: @packets, more: @more_packets,
    viewer: current_hackr, live_stream: @live_stream, roster: @roster, unread: @unread,
    unseen_from: @unseen_from, unseen_divider: @unseen_divider %>
</div>
