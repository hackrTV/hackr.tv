<% content_for :title, "Thread — The WIRE — hackr.tv" %>

<%# Deep-link page for a thread: the root's entry with its thread frame
    already filled (the same fragment a feed row loads on ↩). %>
<%= render layout: "shared/default_chrome", locals: {ascii: false} do %>
  <div class="wire-page" data-controller="wire-keys" data-action="keydown@document->wire-keys#key">
    <%= turbo_stream_from "wire_html" %>

    <div class="wire-bar">
      <%= link_to "< WIRE", wire_path, class: "wire-back" %>
      <h1 class="wire-bar-title">Thread</h1>
      <span class="wire-bar-sub"><%= @thread.length %> <%= (@thread.length == 1) ? "pulse" : "pulses" %></span>
    </div>

    <% thread_html = capture do %>
      <%= render "wire/thread", root: @root, nodes: @nodes, reply_counts: @reply_counts, echoed_ids: @echoed_ids %>
    <% end %>
    <%= render "wire/pulse_entry", pulse: @root, viewer: current_hackr, echoed: @echoed_ids.include?(@root.id),
      thread_content: thread_html %>
    <%= render "wire/keys_legend" %>
  </div>
<% end %>
