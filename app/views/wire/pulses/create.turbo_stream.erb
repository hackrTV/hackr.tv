<%# The author's own contextual entry (the global broadcast copy is
    viewer-neutral and replaces/gets replaced by id — either order lands
    correctly because wire-row re-reveals on connect). %>
<%= turbo_stream.remove "wire-empty" %>
<%= turbo_stream.prepend "wire-feed", partial: "wire/pulse_entry",
  locals: {pulse: @pulse, viewer: current_hackr, echoed: false} %>
<%= turbo_stream.replace "composer-error", partial: "wire/composer_error", locals: {error: nil} %>
