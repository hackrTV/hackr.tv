<%# Profile status line + bio + stat strip (ledger redesign, 2026-10;
    ProfileHeader.tsx lineage). Locals: hackr, stats, is_self. %>
<% role = uplink_role_class(hackr.role) %>
<div class="wire-profile">
  <div class="wire-bar">
    <%= link_to "< WIRE", wire_path, class: "wire-back" %>
    <h1 class="wire-handle wire-author--<%= role %>">@<%= hackr.hackr_alias %></h1>
    <span class="wire-badge wire-badge--outline wire-badge--<%= role %>"><%= hackr.role.upcase %></span>
    <span class="wire-cl">CL<%= hackr.stat("clearance").to_i %></span>
    <span class="wire-bar-meta">MEMBER SINCE <%= hackr.created_at.strftime("%Y-%m-%d") %></span>
    <% if hackr.last_activity_at %>
      <span class="wire-bar-meta<%= " wire-online" if (Time.current - hackr.last_activity_at) < 5.minutes %>">● <%= last_active_label(hackr.last_activity_at).upcase %></span>
    <% end %>
    <button type="button" class="wire-share"
      data-controller="clipboard"
      data-clipboard-text-value="<%= "#{request.base_url}/@#{hackr.hackr_alias}" %>"
      data-clipboard-target="button"
      data-action="click->clipboard#copy">⧉ SHARE</button>
  </div>

  <div class="wire-bio">
    <%= turbo_frame_tag "profile-bio" do %>
      <%= render "wire/bio_display", hackr: hackr, is_self: is_self %>
    <% end %>
  </div>

  <div class="wire-stats">
    <% [["WIRE PULSES", stats[:pulses]],
        ["ECHOES", stats[:echoes_received]],
        ["PACKETS", stats[:packets]],
        ["ACHIEVEMENTS", stats[:achievements]],
        ["BREACHES", stats[:breaches_completed]],
        ["WATCH TIME", watch_time_label(stats[:watch_seconds])]].each do |label, value| %>
      <div class="wire-stat"><b class="wire-stat-value"><%= value %></b><span class="wire-stat-label"><%= label %></span></div>
    <% end %>
  </div>
</div>
