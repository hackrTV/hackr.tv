<%# Static key legend toggled by wire-keys (? / the [?] KEYS button). %>
<div class="wire-legend" role="dialog" aria-label="Keyboard shortcuts" hidden data-wire-keys-target="legend">
  <div class="wire-legend-head">
    <span class="wire-legend-title">// KEYS //</span>
    <button type="button" class="wire-legend-close" aria-label="Close" data-action="click->wire-keys#closeLegend">[x]</button>
  </div>
  <dl class="wire-legend-rows">
    <dt>j / k</dt><dd>next / previous pulse</dd>
    <dt>g / G</dt><dd>first / last pulse</dd>
    <dt>e</dt><dd>echo</dd>
    <dt>r</dt><dd>reply</dd>
    <dt>o</dt><dd>open / close thread</dd>
    <dt>a</dt><dd>author's record (pane) / profile</dd>
    <dt>c</dt><dd>context pane on / off</dd>
    <dt>v</dt><dd>MUTT mode on / off</dd>
    <dt>x x</dt><dd>delete own pulse (press twice)</dd>
    <dt>/</dt><dd>compose</dd>
    <dt>enter</dt><dd>send (shift+enter: newline); MUTT index: open</dd>
    <dt>?</dt><dd>this legend</dd>
    <dt>esc</dt><dd>close / clear</dd>
  </dl>
</div>
