<% content_for :title, "The WIRE — hackr.tv" %>

<% if @page > 1 %>
  <%# Lazy-frame pagination response: Turbo extracts just this frame. %>
  <%= render "wire/feed_page" %>
<% else %>
  <%= render layout: "shared/default_chrome", locals: {ascii: false} do %>
    <div class="wire-page" data-controller="wire-keys wire-feed" data-action="keydown@document->wire-keys#key">
      <%= turbo_stream_from "wire_html" %>

      <div class="wire-bar" data-controller="wire-status">
        <h1 class="wire-bar-title" title="Wideband Information Relay Emitter">The WIRE</h1>
        <span class="wire-bar-sub">WIDEBAND INFORMATION RELAY EMITTER</span>
        <span class="status-disconnected" data-wire-status-target="badge">◌ CONNECTING</span>
        <button type="button" class="wire-bar-keys" title="Keyboard shortcuts" data-action="click->wire-keys#toggleLegend">[?] KEYS</button>
      </div>

      <% if logged_in? %>
        <%= render "wire/composer" %>
      <% else %>
        <div class="wire-login-prompt">
          <p class="wire-login-prompt-lede">
            <a href="/grid/login">Log in</a> to broadcast on the WIRE
          </p>
          <p class="wire-login-prompt-sub">Wideband Information Relay Emitter</p>
        </div>
      <% end %>

      <div id="wire-feed" class="wire-feed">
        <% if @pulses.any? %>
          <% @pulses.each do |pulse| %>
            <%= render "wire/pulse_entry", pulse: pulse, viewer: current_hackr, echoed: @echoed_ids.include?(pulse.id) %>
          <% end %>
        <% else %>
          <div class="empty-state" id="wire-empty">
            <p>The WIRE is silent. Broadcast the first pulse.</p>
            <p class="wire-empty-sub">Wideband Information Relay Emitter</p>
          </div>
        <% end %>
      </div>

      <%= render "wire/feed_pager" %>
      <%= render "wire/keys_legend" %>
    </div>
  <% end %>
<% end %>
