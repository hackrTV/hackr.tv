<% content_for :title, "The WIRE — hackr.tv" %>

<% if @page > 1 %>
  <%# Lazy-frame pagination response: Turbo extracts just this frame. %>
  <%= render "wire/feed_page" %>
<% elsif @view == "mutt" %>
  <%# MUTT mode (cookie wire_view=mutt): the index/pager shell, no page chrome. %>
  <%= render "wire/mutt" %>
<% else %>
  <%= render layout: "shared/default_chrome", locals: {ascii: false} do %>
    <%# wire-pane: the context pane beside the ledger (wide viewports) —
        rows offer their thread/author loads through wire-row:pane, the
        cursor is followed through wire:cursor, c toggles via
        wire-keys:pane. Open → data-pane="open" switches the page to the
        two-column grid (pulse_wire.css); the wire_pane cookie renders it
        open from the first paint. wire-view: v / [≡] MUTT writes the
        wire_view cookie and revisits. %>
    <div class="wire-page" data-view="ledger" data-controller="wire-keys wire-feed wire-pane wire-view"<%= raw(' data-pane="open"') if @pane_open %>
      data-action="keydown@document->wire-keys#key click->wire-keys#click wire:cursor->wire-pane#follow wire-row:pane->wire-pane#claim wire-keys:pane->wire-pane#toggle wire-keys:view->wire-view#toggle">
      <div class="wire-bar" data-controller="wire-status">
        <h1 class="wire-bar-title" title="Wideband Information Relay Emitter">The WIRE</h1>
        <span class="wire-bar-sub">WIDEBAND INFORMATION RELAY EMITTER</span>
        <span class="status-disconnected" data-wire-status-target="badge">◌ CONNECTING</span>
        <button type="button" class="wire-bar-view" title="MUTT mode (v)" aria-pressed="false" data-action="click->wire-view#toggle">[≡] MUTT</button>
        <button type="button" class="wire-bar-pane" title="Context pane (c)" aria-pressed="false"
          data-wire-pane-target="toggle" data-action="click->wire-pane#toggle">[&gt;] CONTEXT</button>
        <button type="button" class="wire-bar-keys" title="Keyboard shortcuts" data-action="click->wire-keys#toggleLegend">[?] KEYS</button>
      </div>

      <div class="wire-main">
        <%= turbo_stream_from "wire_html" %>

        <%= render(logged_in? ? "wire/composer" : "wire/login_prompt") %>

        <%= render "wire/feed_entries" %>
        <%= render "wire/feed_pager" %>
      </div>

      <aside class="wire-pane" aria-label="Context pane">
        <%= turbo_frame_tag "wire-pane", target: "_top", data: {wire_pane_target: "frame"} %>
        <div class="wire-pane-empty">
          <span>// SELECT A PULSE //</span>
          <span class="wire-pane-empty-sub">j / k walk the ledger · ↩ opens a thread · @alias opens a record</span>
        </div>
      </aside>
      <%= render "wire/keys_legend" %>
    </div>
  <% end %>
<% end %>
