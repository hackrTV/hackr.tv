<!DOCTYPE html>
<html lang="en-US">
  <head>
    <title><%= content_for(:title) || "/root :: Admin" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# tokens first: the console family (console.css) and the /root music
        screens (root_console.css) read the semantic palette; the TuiCss
        base + default.css admin rules follow as before. No Turbo here —
        the admin is plain full-page navigation; admin.ts is Stimulus
        alone (terminal / peek / ledger-filter / file-pick / autogrow /
        confirm-slug) and the terminal controller's prompt falls back to a
        full load when Turbo is absent (utils/visit.ts). %>
    <%= stylesheet_link_tag "tokens", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tuicss", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "default", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "console", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "root_console", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "admin_chrome", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "tuicss", "data-turbo-track": "reload", type: "module" %>
    <%= vite_client_tag %>
    <%= vite_typescript_tag "admin.ts" %>
    <%= yield :head %>
    <script nonce="<%= content_security_policy_nonce %>">
      // Rails UJS confirmation handler
      document.addEventListener('DOMContentLoaded', function() {
        document.addEventListener('submit', function(event) {
          const form = event.target;
          const confirmMessage = form.querySelector('[data-confirm]')?.getAttribute('data-confirm') ||
                                 form.getAttribute('data-confirm');

          if (confirmMessage && !confirm(confirmMessage)) {
            event.preventDefault();
            event.stopPropagation();
            return false;
          }
        }, true);
      });
    </script>
  </head>

  <body class="black-168" style="background: #0a0a0a;">
    <%# One 22px row each (admin_chrome.css): the nav, then any banner
        strips flush under it. Sticky on desktop; the site-header
        controller publishes the rendered height as --site-header-h. %>
    <header class="admin-chrome" data-controller="site-header">
      <%= render "admin/shared/nav" %>
      <%= render "admin/shared/data_audit_banner" %>
    </header>
    <%= yield %>
    <%= render "admin/shared/sortable_tables" %>
  </body>
</html>
