<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "hackr.tv" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Viewer identity for Stimulus (broadcast-rendered pulse cards are
        viewer-neutral; pulse-card reveals owner controls from this). %>
    <% if logged_in? %>
      <meta name="current-hackr-id" content="<%= current_hackr.id %>">
    <% end %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
    <link rel="manifest" href="/manifest.json">

    <%# Same stylesheet set as the SPA layout so ported pages keep their look, plus hotwire.css for the ERB nav/flash/toasts %>
    <%= stylesheet_link_tag "tuicss", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "default", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "audio_player", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pulse_wire", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "hotwire", "data-turbo-track": "reload" %>
    <%# Phase 4 artist cluster. ALL cluster CSS loads here, never per-page:
        data-turbo-track=reload means Turbo hard-reloads when two pages'
        tracked-asset sets differ, which kills the permanent player — every
        Hotwire page must ship the identical tracked set. %>
    <%= stylesheet_link_tag "band_profiles", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "artist_pages", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "artist_catalog", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "tuicss", "data-turbo-track": "reload", type: "module" %>
    <%= vite_client_tag %>
    <%= vite_typescript_tag "hotwire.ts" %>
  </head>

  <body class="black-168">
    <%= render "shared/nav" %>
    <%= render "shared/flash" %>

    <div id="main-content">
      <%= yield %>
    </div>

    <%# Achievement/mission toasts (Phase 3): user-scoped stream, toasts
        append here from AchievementAwarder / MissionRewardGranter. %>
    <%= turbo_stream_from current_hackr, :toasts if logged_in? %>
    <div id="toast-region" aria-live="polite"></div>

    <%# Persistent audio player (Phase 4) — survives Turbo visits. %>
    <div id="player-bar" data-turbo-permanent data-controller="player">
      <%= render "shared/player_bar" %>
    </div>
  </body>
</html>
