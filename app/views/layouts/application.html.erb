<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "hackr.tv" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Viewer identity for Stimulus (broadcast-rendered pulse cards and
        uplink packets are viewer-neutral; pulse-card/packet reveal
        owner/moderator controls and self-mentions from these). %>
    <% if logged_in? %>
      <meta name="current-hackr-id" content="<%= current_hackr.id %>">
      <meta name="current-hackr-alias" content="<%= current_hackr.hackr_alias %>">
      <meta name="current-hackr-role" content="<%= current_hackr.role %>">
      <%# The viewer's anonymized Uplink callsign token (Uplink::Callsign):
          the members controller reveals "you" in the roster and the
          reactions controller marks the viewer's own chips — on every
          surface the packets render (shell, dock, popout). %>
      <meta name="uplink-callsign" content="<%= Uplink::Callsign.token(current_hackr.id) %>">
    <% end %>

    <%= yield :head %>

    <%# Icons + the full tracked asset set — shared with the popout layout
        so both carry the identical turbo-track signature. %>
    <%= render "layouts/hotwire_assets" %>
  </head>

  <body class="black-168">
    <%# Site header: the nav plus every top-of-page notice, in normal
        flow. The nav used to be position:fixed with no reserved height
        and wraps to a variable number of rows with login state and
        viewport width, so anything at the top of flow (scheduled banner,
        live banner, flashes) rendered underneath it and no fixed offset
        was safe. Everything in .top-notices now lands directly below the
        nav whatever its height; the header is sticky on desktop so nav +
        notices stay pinned (hotwire.css "Site header"). Pages add banners
        with content_for :top_notices. The site-header controller publishes
        the rendered height as --site-header-h on <html> for viewport-fixed
        surfaces (.tactical-root) to start below it. %>
    <header class="site-header" data-controller="site-header">
      <%= render "shared/nav" %>
      <div class="top-notices">
        <%= yield :top_notices %>
        <%= render "shared/flash" %>
        <%= render "shared/admin_preview_banner" %>
      </div>
    </header>

    <main id="main-content">
      <%= yield %>
    </main>

    <%# Achievement/mission toasts (Phase 3): user-scoped stream, toasts
        append here from AchievementAwarder / MissionRewardGranter. %>
    <%= turbo_stream_from current_hackr, :toasts if logged_in? %>
    <div id="toast-region" aria-live="polite"></div>

    <%# Persistent audio player (Phase 4) — survives Turbo visits. %>
    <div id="player-bar" data-turbo-permanent data-controller="player">
      <%= render "shared/player_bar" %>
    </div>

    <%# Terminal easter egg (Phase 6e): Konami / Ctrl+` / typed
        "/terminal" / window.hackr.terminal() / [data-terminal-open]
        buttons. Iframe onto the Hotwire /terminal page — exactly what
        the SPA's TerminalModal wrapped. %>
    <div data-controller="terminal-egg">
      <div class="terminal-egg-backdrop" hidden data-terminal-egg-target="backdrop" data-action="click->terminal-egg#close"></div>
      <div class="terminal-egg" hidden data-terminal-egg-target="panel">
        <div class="terminal-egg-header">
          <span class="terminal-egg-title">TERMINAL ACCESS</span>
          <span class="terminal-egg-hints"><span><kbd>ESC</kbd> close</span><span><kbd>Ctrl+`</kbd> toggle</span></span>
          <button type="button" class="terminal-egg-close" data-action="click->terminal-egg#close">[X] CLOSE</button>
        </div>
        <iframe class="terminal-egg-frame" title="Terminal" data-terminal-egg-target="frame"></iframe>
        <div class="terminal-egg-handle" data-action="click->terminal-egg#close"></div>
      </div>
    </div>
  </body>
</html>
