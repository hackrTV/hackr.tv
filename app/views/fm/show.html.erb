<% content_for :title, "hackr.fm — hackr.tv" %>
<% current_year = Date.current.year %>
<% future_year = current_year + 100 %>
<% latest_rows = @latest_releases.each_with_index.map { |release, i| [release, format("%02d", i + 1)] } %>
<% incoming_rows = @coming_soon.each_with_index.map { |release, i| [release, format("%02d", latest_rows.size + i + 1), i >= 4] } %>
<% destinations = [
  ["RADIO", "/fm/radio", "Radio", "Live stations broadcasting around the clock — raw frequencies, unfiltered", "radio"],
  ["RELEASES", "/fm/releases", "Releases", "Every release on the label, newest first", nil],
  ["VAULT", "/vault", "Pulse Vault", "The complete archive — every track ever released on hackr.fm, ready to play", "vault"],
  ["FNET", "/f/net", "Fracture Network", "The roster — the artists who carry the signal through sound", "fnet"],
  (["PLAYLISTS", "/fm/playlists", "Playlists", "Your saved queues", nil] if logged_in?),
  ["HOME", "/", "hackr.tv", "Back to the broadcast system", nil]
].compact %>
<% numbers = latest_rows.map(&:last) + incoming_rows.reject(&:last).map { |(_, num, _)| num } %>

<%= render layout: "shared/default_chrome", locals: {ascii: false} do %>
  <div class="console console--fm" data-controller="terminal" data-boot="pending"
    data-action="keydown@document->terminal#skip click->terminal#skip">
    <div class="console-bar console-line" data-terminal-target="line">
      <h1 class="console-bar-title">HACKR.FM</h1>
      <span class="console-bar-sub">MUSIC LABEL &amp; BROADCAST NETWORK</span>
      <span class="console-bar-right">
        <span class="console-bar-badge">● ON AIR</span>
        <%= link_to "[>] RADIO", "/fm/radio", class: "console-bar-link" %>
        <%= link_to "[>] VAULT", "/vault", class: "console-bar-link" %>
      </span>
    </div>

    <div class="console-status">
      <div class="console-status-row console-line" data-terminal-target="line">
        <span class="console-key">LABEL</span>
        <span class="console-val">hackr.fm <span class="console-dim">· the Fracture Network's broadcast infrastructure</span></span>
      </div>
      <div class="console-status-row console-line" data-terminal-target="line">
        <span class="console-key">SIGNAL</span>
        <span class="console-val"><%= current_year %> → <%= future_year %></span>
      </div>
      <div class="console-status-row console-line" data-terminal-target="line">
        <span class="console-key">CATALOG</span>
        <span class="console-val">
          <% if @catalog.any? %>
            <%= link_to pluralize(@catalog.size, "release"), "/fm/releases", class: "console-link" %> <span class="console-dim">· <%= pluralize(@catalog.sum { |r| r.tracks.size }, "track") %></span>
          <% else %>
            <span class="console-dim">NONE CATALOGED</span>
          <% end %>
        </span>
      </div>
      <div class="console-status-row console-line" data-terminal-target="line">
        <span class="console-key">INCOMING</span>
        <span class="console-val">
          <% if @coming_soon.any? %>
            <span class="xt-brand"><%= @coming_soon.size %> pending transmission</span>
          <% else %>
            <span class="console-dim">NONE SCHEDULED</span>
          <% end %>
        </span>
      </div>
      <div class="console-status-row console-line" data-terminal-target="line">
        <span class="console-key">ARTISTS</span>
        <span class="console-val"><%= link_to "#{@artist_count} on the network", "/f/net", class: "console-link" %></span>
      </div>
      <div class="console-status-row console-line" data-terminal-target="line">
        <span class="console-key">STATUS</span>
        <span class="console-val"><span class="console-hot">● ON AIR</span> <span class="console-dim">· the signal is always on</span></span>
      </div>
    </div>

    <div class="console-rule console-line" data-terminal-target="line"><span>// THE FREQUENCY //</span></div>
    <div class="xt-prose">
      <p class="console-line" data-terminal-target="line">
        In <%= current_year %>, hackr.fm opened as a frequency — a channel tuned to something that was already
        there, carrying music that refused to be owned, cataloged, or silenced. By <%= future_year %>, it will
        become the backbone of the Fracture Network's broadcast infrastructure: a decentralized label
        transmitting from nodes scattered across the grid.
      </p>
      <p class="console-line" data-terminal-target="line">
        Every artist on hackr.fm operates under one principle: <span class="xt-brand">the music carries the signal, not the system's approval</span>.
        No RIDE-approved playlists. No managed reality. No substitute for the real thing. Just
        uncompromising sound moving directly from creator to listener — because what it carries
        is something GovCorp has never been able to counterfeit.
      </p>
      <p class="xt-dim console-line" data-terminal-target="line">
        This is the home frequency. From here, you can tune into live broadcasts, explore the vault
        of everything we've ever released, or connect with the artists who make up
        the Fracture Network. The signal is always on. You just have to listen.
      </p>
    </div>

    <% if latest_rows.any? %>
      <section class="console-section" aria-label="Latest releases">
        <div class="console-rule console-line" data-terminal-target="line"><span>// LATEST RELEASES //</span></div>
        <% latest_rows.each do |(release, num)| %>
          <%= render "fm/tile", release: release, num: num %>
        <% end %>
        <div class="console-row console-line" data-terminal-target="line">
          <span class="console-tag">[>]</span>
          <%= link_to "All releases", "/fm/releases", class: "console-link" %>
          <span class="console-desc"><%= pluralize(@catalog.size, "release") %> on the label</span>
        </div>
      </section>
    <% end %>

    <% if incoming_rows.any? %>
      <section class="console-section" aria-label="Incoming releases" data-controller="signal-code">
        <div class="console-rule console-line" data-terminal-target="line">
          <span class="fm-signal" data-action="click->signal-code#signalClicked">// TRANSMISSION INCOMING //</span>
        </div>
        <% incoming_rows.each do |(release, num, locked)| %>
          <%= render "fm/tile", release: release, num: num, incoming: true, locked: locked %>
        <% end %>

        <div class="fm-code-overlay" hidden
             data-signal-code-target="modal"
             data-action="click->signal-code#backdropClicked">
          <div class="fm-code-box">
            <div class="fm-code-scanlines"></div>
            <div class="fm-code-title">TRANSMISSION INTERCEPT DETECTED</div>
            <div class="fm-code-sub">
              FREQUENCY LOCK REQUIRES AUTHORIZATION<br>
              ENTER TRANSMISSION CODE TO PROCEED
            </div>
            <div class="fm-code-row">
              <input type="text" class="fm-code-input" placeholder="_ _ _ _"
                     data-signal-code-target="input"
                     data-action="keydown.enter->signal-code#submit">
              <button class="fm-code-submit" data-action="click->signal-code#submit">TRANSMIT</button>
            </div>
            <div class="fm-code-error" hidden data-signal-code-target="error">AUTHORIZATION DENIED — INVALID FREQUENCY</div>
            <div class="fm-code-abort" data-action="click->signal-code#close">[ABORT INTERCEPT]</div>
          </div>
        </div>
      </section>
    <% end %>

    <section class="console-section" aria-label="Destinations">
      <div class="console-rule console-line" data-terminal-target="line"><span>// DESTINATIONS //</span></div>
      <% destinations.each do |tag_name, href, name, desc, tone| %>
        <div class="console-row console-line" data-terminal-target="line">
          <span class="<%= class_names("console-tag", "fm-tag--#{tone}" => tone) %>">[<%= tag_name %>]</span>
          <%= link_to name, href, class: "console-link", data: {command: tag_name.downcase} %>
          <span class="console-desc"><%= desc %></span>
        </div>
      <% end %>
    </section>

    <div class="console-rule console-line" data-terminal-target="line"><span>// THE SIGNAL IS ALWAYS ON //</span></div>
    <%= render "shared/console_prompt", hint: safe_join([
      *(numbers.any? ? ["type a release number ", tag.span("(#{numbers.join(" ")})", class: "console-dim"), " or "] : []),
      "type a tag ", tag.span("(#{destinations.map { |tag_name, *| tag_name.downcase }.join(" ")})", class: "console-dim"), " · enter · ? help"
    ]) %>
  </div>
<% end %>
