<%# /root/grid_missions — the missions ledger as a console screen
    (2026-11-01; root_console.css): bar ([+] NEW MISSION, [>] WIZARD),
    ON RECORD row, the FILTER row (ledger-filter: name / slug / arc /
    giver / prereq), // MISSIONS // rows ([NN] · name over slug ·
    prereq · ARC · GIVER · CL · OBJ · RWD · ACTIVE · DONE · LIVE / DRAFT
    + REPEAT · [HISTORY]), destinations, the > prompt (NN opens the
    record screen; deletes live there). Assigns: @missions,
    @active_counts, @completed_counts. %>
<% content_for :title, "/root/grid_missions :: MISSIONS" %>
<% missions = @missions %>
<% numbers = missions.each_index.map { |i| root_num(i, total: missions.size) } %>
<div class="console console--root" data-controller="terminal ledger-filter" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "MISSIONS", sub: "ROOT · SYSTEMS · /root/grid_missions"} do %>
    <%= link_to "[+] NEW MISSION", new_admin_grid_mission_path, class: "console-bar-link", data: {command: "new"} %>
    <%= link_to "[>] WIZARD", new_admin_grid_mission_wizard_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(missions.size, "mission") %> <span class="console-dim">· <%= missions.count(&:published?) %> live · <%= missions.count(&:repeatable?) %> repeatable · <%= @active_counts.values.sum %> active</span></span>
    </div>
    <div class="console-status-row rc-field rc-filter">
      <label class="console-key" for="ledger-filter">FILTER</label>
      <span class="console-val">
        <input type="search" id="ledger-filter" class="rc-input" placeholder="name · slug · arc · giver · prereq" autocomplete="off" spellcheck="false"
          data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
        <span class="rc-count" data-ledger-filter-target="count"><%= missions.size %> / <%= missions.size %></span>
        <button type="button" class="rc-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--missions" aria-label="Missions">
    <div class="console-rule"><span>// MISSIONS //</span></div>
    <% if missions.empty? %>
      <%= render "admin/console/empty", text: "NO MISSIONS ON RECORD", hint: "[>] WIZARD builds one in seven steps" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span></span><span>MISSION</span><span>ARC</span><span>GIVER</span><span class="rc-cell--r">CL</span><span class="rc-cell--r">OBJ</span><span class="rc-cell--r">RWD</span><span class="rc-cell--r">ACTIVE</span><span class="rc-cell--r">DONE</span><span>STATE</span><span></span>
      </div>
    <% end %>
    <% missions.each_with_index do |mission, i| %>
      <% num = numbers[i] %>
      <div class="rc-row" data-ledger-filter-target="row" data-search="<%= [mission.name, mission.slug, mission.grid_mission_arc&.name, mission.giver_mob&.name, mission.prereq_mission&.slug].compact.join(" ").downcase %>">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to mission.name, edit_admin_grid_mission_path(mission), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= mission.slug %><% if mission.prereq_mission %> · after <%= mission.prereq_mission.slug %><% end %></div>
        </div>
        <span class="rc-cell rc-hot"><%= mission.grid_mission_arc&.name || "—" %></span>
        <span class="rc-cell"><%= mission.giver_mob&.name || "—" %></span>
        <span class="rc-cell rc-cell--r rc-star"><%= mission.min_clearance %></span>
        <span class="rc-cell rc-cell--r"><%= mission.grid_mission_objectives.size %></span>
        <span class="rc-cell rc-cell--r"><%= mission.grid_mission_rewards.size %></span>
        <span class="rc-cell rc-cell--r rc-hot"><%= @active_counts[mission.id] || 0 %></span>
        <span class="rc-cell rc-cell--r rc-on"><%= @completed_counts[mission.id] || 0 %></span>
        <span class="rc-cell <%= mission.published? ? "rc-on" : "rc-off" %>"><%= mission.published? ? "LIVE" : "DRAFT" %><% if mission.repeatable? %> <span class="rc-hot">REP</span><% end %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[HISTORY]", history_admin_grid_mission_path(mission), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :systems, except: "MISSIONS" %>

  <div class="console-rule"><span>// EVERY MISSION ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems, except: "MISSIONS", numbers: numbers, noun: "a mission number", extra: ["new"]) %>
</div>
