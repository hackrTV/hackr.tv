<%= render TuiWindowComponent.new(title: "/root/grid/missions/#{@mission.slug} :: EDIT MISSION", variant: :admin, width: 1200) do %>
    <div style="padding: 20px;">
      <%= form_with model: @mission, url: admin_grid_mission_path(@mission), local: true do |f| %>
        <%= render "form", f: f %>
      <% end %>

      <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #333; display: flex; justify-content: space-between; align-items: center;">
        <%= tui_button "← Back to Missions", admin_grid_missions_path, color: :green, style: "padding: 6px 14px;" %>
        <%= tui_button_to "Delete Mission", admin_grid_mission_path(@mission), method: :delete, color: :red, style: "padding: 6px 14px;", data: { confirm: "Delete mission '#{@mission.name}'? This will also delete all objectives, rewards, and player progress." } %>
      </div>
    </div>
<% end %>
