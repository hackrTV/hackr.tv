<%# The mission's fields on the console: status rows (ConsoleFormBuilder
    rc_* rows; GIVER / ARC / PREREQ are typed pickers —
    admin/console/_picker, initialized by _script after the screen),
    // DESCRIPTION //, // DIALOGUE PATH // (a JSON array the controller
    parses; a rejected save shows it as typed), then // OBJECTIVES //
    and // REWARDS // as rows of inputs (nested attributes; the
    controller adds one blank row to each on edit and on a rejected
    save — an objective whose TYPE and LABEL stay blank, or a reward
    whose TYPE does, is dropped). [x] marks a saved row _destroy and hides
    it, or drops an unsaved one (_script); a row already marked comes
    back hidden on a rejected save. The commit row belongs to the
    caller. Locals: f, mission; @mobs, @arcs, @missions_for_prereq,
    @factions. %>
<% giver = mission.giver_mob %>
<% objective_targets = [
     ["visit_room", "room slug"],
     ["talk_npc", "mob name (AXIOM) · any case"],
     ["collect_item buy_item use_item salvage_item fabricate_item equip_item place_fixture", "item name · any case"],
     ["deliver_item", "item name · the giver receives it"],
     ["salvage_yield_received", "yield item name"],
     ["reach_rep", "faction slug"],
     ["reach_clearance spend_cred", "not used · leave blank"],
     ["complete_breach", "breach template slug"],
     ["dismantle_protocols", "protocol type (trace)"],
     ["extract_data", "fragment item slug"]
   ] %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, required: true, autocomplete: "off", hint: "unique · the record's address" %>
  <%= render "admin/console/picker", label: "GIVER", key: "giver-cb", name: "grid_mission[giver_mob_id]", value: mission.giver_mob_id,
    text: giver && "#{giver.name} @ #{giver.grid_room&.name || "—"}", placeholder: "type an NPC or room", status: "quest givers and vendors · required to publish",
    errors: f.rc_errors(:giver_mob_id) %>
  <%= render "admin/console/picker", label: "ARC", key: "arc-cb", name: "grid_mission[grid_mission_arc_id]", value: mission.grid_mission_arc_id,
    text: mission.grid_mission_arc&.name, placeholder: "type an arc (optional)", status: "optional" %>
  <%= render "admin/console/picker", label: "PREREQ", key: "prereq-cb", name: "grid_mission[prereq_mission_id]", value: mission.prereq_mission_id,
    text: mission.prereq_mission&.name, placeholder: "type a mission (optional)", status: "finished first · optional" %>
  <%= f.rc_number_field :min_clearance, label: "CLEARANCE", width: :short, min: 0, hint: "minimum to be offered" %>
  <%= f.rc_collection_select :min_rep_faction_id, @factions, :id, :display_name, {include_blank: "(none)"}, label: "REP FACTION" %>
  <%= f.rc_number_field :min_rep_value, label: "REP VALUE", width: :short, hint: "minimum standing with that faction" %>
  <%= f.rc_number_field :position, label: "POS", width: :short, min: 0 %>
  <%= f.rc_flags("FLAGS") { f.rc_check_box(:repeatable, label: "REPEATABLE") + " ".html_safe + f.rc_check_box(:published, label: "PUBLISHED") } %>
</div>

<%= f.rc_text_area :description, rows: 3, spellcheck: true %>
<%= f.rc_text_area :dialogue_path_json, label: "DIALOGUE PATH", rows: 1, spellcheck: false, class: "rc-textarea--code",
  value: params.dig(:grid_mission, :dialogue_path_json) || (mission.dialogue_path.present? ? JSON.generate(mission.dialogue_path) : ""),
  placeholder: %(["topic", "subtopic"]),
  hint: "a JSON array of topic keys · blank = no gate · offered only once the hackr has walked the giver's dialogue that deep" %>

<section class="console-section rc-ledger rc-ledger--mission-objectives" aria-label="Objectives">
  <div class="console-rule"><span>// OBJECTIVES //</span></div>
  <p class="rc-sub">TARGET SLUG by TYPE (blank = any) · COUNT = how many finish it (1 for an event)</p>
  <div class="rc-ledger--legend">
    <% objective_targets.each do |types, target| %>
      <div class="rc-row"><span class="rc-cell rc-hot"><%= types %></span><span class="rc-cell"><%= target %></span></div>
    <% end %>
  </div>
  <div class="rc-row rc-row--head" aria-hidden="true">
    <span>POS</span><span>TYPE</span><span>LABEL · PLAYER-VISIBLE</span><span>TARGET SLUG</span><span>COUNT</span><span></span>
  </div>
  <div id="objectives-rows" class="rc-edit-rows">
    <%= f.fields_for :grid_mission_objectives do |ff| %>
      <%= tag.div class: "rc-row", hidden: ff.object.marked_for_destruction? do %>
        <%= ff.number_field :position, class: "rc-input", aria: {label: "Objective position"} %>
        <%= ff.select :objective_type, GridMission::OBJECTIVE_TYPES, {include_blank: "—"}, class: "rc-select", aria: {label: "Objective type"} %>
        <%= ff.text_field :label, class: "rc-input", aria: {label: "Objective label"} %>
        <%= ff.text_field :target_slug, class: "rc-input", aria: {label: "Objective target slug"} %>
        <%= ff.number_field :target_count, class: "rc-input", min: 1, aria: {label: "Objective count"} %>
        <span class="rc-links">
          <% if ff.object.persisted? %><%= ff.hidden_field :_destroy %><% end %>
          <button type="button" class="rc-btn rc-btn--danger" data-row-remove aria-label="Remove objective">[x]</button>
        </span>
      <% end %>
    <% end %>
  </div>
  <p class="rc-sub">each save leaves one blank row · fill it to add an objective, leave its TYPE and LABEL blank to skip it</p>
</section>

<section class="console-section rc-ledger rc-ledger--mission-rewards" aria-label="Rewards">
  <div class="console-rule"><span>// REWARDS //</span></div>
  <p class="rc-sub"><%= GridMission::REWARD_TYPES.join(" · ") %> · xp / cred use AMOUNT · TARGET SLUG names the faction / item / mission / achievement · item grants use QTY</p>
  <div class="rc-row rc-row--head" aria-hidden="true">
    <span>POS</span><span>TYPE</span><span>AMOUNT</span><span>TARGET SLUG</span><span>QTY</span><span></span>
  </div>
  <div id="rewards-rows" class="rc-edit-rows">
    <%= f.fields_for :grid_mission_rewards do |ff| %>
      <%= tag.div class: "rc-row", hidden: ff.object.marked_for_destruction? do %>
        <%= ff.number_field :position, class: "rc-input", aria: {label: "Reward position"} %>
        <%= ff.select :reward_type, GridMission::REWARD_TYPES, {include_blank: "—"}, class: "rc-select", aria: {label: "Reward type"} %>
        <%= ff.number_field :amount, class: "rc-input rc-input--r", aria: {label: "Reward amount"} %>
        <%= ff.text_field :target_slug, class: "rc-input", aria: {label: "Reward target slug"} %>
        <%= ff.number_field :quantity, class: "rc-input", min: 1, aria: {label: "Reward quantity"} %>
        <span class="rc-links">
          <% if ff.object.persisted? %><%= ff.hidden_field :_destroy %><% end %>
          <button type="button" class="rc-btn rc-btn--danger" data-row-remove aria-label="Remove reward">[x]</button>
        </span>
      <% end %>
    <% end %>
  </div>
  <p class="rc-sub">each save leaves one blank row · fill it to add a reward, leave its TYPE blank to skip it · or seed via data/world/missions.yml</p>
</section>
