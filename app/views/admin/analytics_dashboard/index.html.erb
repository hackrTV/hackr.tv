<%# /root/analytics — the analytics as a console readout
    (2026-11-04; root_console.css): bar ([>] ERRORS), the // RANGE //
    links (7D / 30D / 90D / ALL), // USERS // tiles, // REGISTRATIONS //
    and // DAILY ACTIVE // day charts (one <progress> column a day — the
    value and max carry the numbers, the title the date; no inline
    widths), // TOP ROOMS // and // TOP TRACKS // (rank · name · count),
    // FEATURES // tiles, // TUTORIAL FUNNEL // (tiles + a step chart,
    the biggest drop-off lit red), // SESSIONS // tiles, // TELEMETRY //
    rows, destinations, the > prompt. Assigns: @range_days,
    @user_metrics, @feature_usage, @tutorial_funnel, @session_metrics,
    @registrations_by_day, @activity_by_day, @analytics_event_count,
    @perf_summary. %>
<% content_for :title, "/root/analytics :: ANALYTICS" %>
<% max_reg = @registrations_by_day.map { |b| b[:count] }.max.to_i %>
<% max_act = @activity_by_day.map { |b| b[:count] }.max.to_i %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "ANALYTICS", sub: "ROOT · META · /root/analytics"} do %>
    <%= link_to "[>] ERRORS", admin_error_groups_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row rc-field">
      <span class="console-key">RANGE</span>
      <span class="console-val">
        <% {"7" => "7D", "30" => "30D", "90" => "90D", "0" => "ALL"}.each do |value, word| %>
          <%= link_to word, admin_analytics_dashboard_path(range: value), class: class_names("rc-btn", "rc-btn--on": @range_days.to_s == value), aria: {current: @range_days.to_s == value && "page"} %>
        <% end %>
        <span class="rc-hint">feature usage and sessions read the range · the user tiles read the last 1 / 7 / 30 days · the tutorial funnel is all-time</span>
      </span>
    </div>
  </div>

  <div class="console-rule"><span>// USERS //</span></div>
  <div class="rc-stats">
    <div class="rc-stat"><span class="rc-stat-key">DAU</span><span class="rc-stat-val rc-on"><%= @user_metrics[:dau] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">WAU</span><span class="rc-stat-val rc-hot"><%= @user_metrics[:wau] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">MAU</span><span class="rc-stat-val rc-violet"><%= @user_metrics[:mau] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">TOTAL</span><span class="rc-stat-val"><%= @user_metrics[:total] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">NEW 30D</span><span class="rc-stat-val rc-star"><%= @user_metrics[:new_30d] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">RETURNING 30D</span><span class="rc-stat-val"><%= @user_metrics[:returning_30d] %></span></div>
  </div>

  <% {"REGISTRATIONS" => [@registrations_by_day, max_reg, nil], "DAILY ACTIVE" => [@activity_by_day, max_act, "rc-chart--hot"]}.each do |word, (buckets, max, tone)| %>
    <section class="console-section" aria-label="<%= word.titleize %> by day">
      <div class="console-rule"><span>// <%= word %> · <%= buckets.size %> DAYS · PEAK <%= max %> //</span></div>
      <div class="rc-chart <%= tone %>">
        <% buckets.each do |bucket| %>
          <progress value="<%= bucket[:count] %>" max="<%= [max, 1].max %>" title="<%= bucket[:date] %>: <%= bucket[:count] %>"><%= bucket[:count] %></progress>
        <% end %>
      </div>
      <p class="rc-sub"><%= buckets.first&.dig(:date) %> to <%= buckets.last&.dig(:date) %> · a day a column, hover for its count</p>
    </section>
  <% end %>

  <% {"TOP ROOMS" => [@feature_usage[:top_rooms], "rc-on"], "TOP TRACKS" => [@feature_usage[:top_tracks], "rc-star"]}.each do |word, (rows, tone)| %>
    <section class="console-section rc-ledger rc-ledger--top" aria-label="<%= word.titleize %>">
      <div class="console-rule"><span>// <%= word %> //</span></div>
      <% if rows.empty? %>
        <%= render "admin/console/empty", text: "NO DATA IN RANGE" %>
      <% end %>
      <% rows.each_with_index do |row, i| %>
        <div class="rc-row">
          <span class="console-tag">[<%= root_num(i) %>]</span>
          <span class="cc-name"><%= row[:name] %></span>
          <span class="rc-cell rc-cell--r <%= tone %>"><%= row[:count] %></span>
        </div>
      <% end %>
    </section>
  <% end %>

  <div class="console-rule"><span>// FEATURES //</span></div>
  <div class="rc-stats">
    <div class="rc-stat"><span class="rc-stat-key">BREACH ATTEMPTS</span><span class="rc-stat-val rc-bad"><%= @feature_usage[:breach_attempts] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">BREACH SUCCESS</span><span class="rc-stat-val rc-on"><%= @feature_usage[:breach_success_rate] %>%</span></div>
    <div class="rc-stat"><span class="rc-stat-key">SHOP BUYS</span><span class="rc-stat-val rc-star"><%= @feature_usage[:shop_buys] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">SHOP SELLS</span><span class="rc-stat-val"><%= @feature_usage[:shop_sells] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">MISSIONS ACCEPTED</span><span class="rc-stat-val rc-hot"><%= @feature_usage[:mission_accepted] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">MISSIONS COMPLETE</span><span class="rc-stat-val rc-violet"><%= @feature_usage[:mission_completion_rate] %>%</span></div>
  </div>

  <section class="console-section" aria-label="Tutorial funnel">
    <div class="console-rule"><span>// TUTORIAL FUNNEL //</span></div>
    <div class="rc-stats">
      <div class="rc-stat"><span class="rc-stat-key">STARTED</span><span class="rc-stat-val"><%= @tutorial_funnel[:total_started] %></span></div>
      <div class="rc-stat"><span class="rc-stat-key">COMPLETED</span><span class="rc-stat-val rc-on"><%= @tutorial_funnel[:completed] || 0 %></span></div>
      <div class="rc-stat"><span class="rc-stat-key">BIGGEST DROP-OFF</span><span class="rc-stat-val <%= @tutorial_funnel[:drop_off_step] ? "rc-bad" : "rc-off" %>"><%= @tutorial_funnel[:drop_off_step] ? "STEP #{@tutorial_funnel[:drop_off_step]}" : "—" %></span></div>
    </div>
    <% steps = @tutorial_funnel[:step_counts] %>
    <% if steps.any? %>
      <% max_step = steps.map(&:last).max.to_i %>
      <div class="rc-chart rc-chart--violet">
        <% steps.each do |step, count| %>
          <progress value="<%= count %>" max="<%= [max_step, 1].max %>" title="step <%= step %>: <%= pluralize(count, "hackr") %>" class="<%= "rc-chart-drop" if step == @tutorial_funnel[:drop_off_step] %>"><%= count %></progress>
        <% end %>
      </div>
    <% else %>
      <%= render "admin/console/empty", text: "NO TUTORIAL STEPS ON RECORD" %>
    <% end %>
  </section>

  <div class="console-rule"><span>// SESSIONS //</span></div>
  <div class="rc-stats">
    <div class="rc-stat"><span class="rc-stat-key">AVG SESSION</span><span class="rc-stat-val"><%= @session_metrics[:avg_duration_seconds].to_i / 60 %>m</span></div>
    <div class="rc-stat"><span class="rc-stat-key">SESSIONS</span><span class="rc-stat-val"><%= @session_metrics[:total_sessions] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">UNIQUE USERS</span><span class="rc-stat-val"><%= @session_metrics[:unique_users] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">SESSIONS / USER</span><span class="rc-stat-val"><%= @session_metrics[:avg_sessions_per_user] %></span></div>
  </div>

  <div class="console-rule"><span>// TELEMETRY //</span></div>
  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">PERF METRICS</span>
      <span class="console-val"><span class="rc-hot"><%= @perf_summary[:total_metrics] %></span> <span class="console-dim">· on record</span></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">WEB VITALS</span>
      <span class="console-val"><span class="rc-hot"><%= @perf_summary[:web_vitals_24h] %></span> <span class="console-dim">· last 24h</span></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">SLOW RENDERS</span>
      <span class="console-val"><span class="<%= (@perf_summary[:slow_zone_renders_7d] > 0) ? "rc-bad" : "rc-on" %>"><%= @perf_summary[:slow_zone_renders_7d] %></span> <span class="console-dim">· zone map, last 7d</span></span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">EVENTS</span>
      <span class="console-val"><span class="rc-star"><%= @analytics_event_count %></span> <span class="console-dim">· frontend events collected, no report yet</span>
        <span class="rc-hint">page_view feature_click button_click panel_open panel_close command_entered session_start session_end</span></span>
    </div>
  </div>

  <%= render "admin/console/destinations", section: :meta, except: "ANALYTICS" %>

  <div class="console-rule"><span>// END OF READOUT //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:meta, except: "ANALYTICS") %>
</div>
