<%# The handbook article's fields as console status rows
    (ConsoleFormBuilder rc_* rows), then // SUMMARY // // BODY // //
    METADATA // as growing textareas (metadata is a JSON object the
    controller parses; a rejected save shows the JSON as typed, not the
    stored value). The commit row belongs to the caller. Locals: f,
    article; @sections for the select. %>
<div class="console-status">
  <%= f.rc_select :handbook_section_id, @sections.map { |s| [s.name, s.id] }, {}, label: "SECTION" %>
  <%= f.rc_text_field :title, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, autocomplete: "off", pattern: "[a-z0-9\\-]+", title: "lowercase letters, digits, hyphens",
    hint: "/handbook/#{article.slug_in_database.presence || "slug"} · blank = from the title · unique across the handbook" %>
  <%= f.rc_select :kind, HandbookArticle::KINDS.map { |k| [k.upcase, k] }, {} %>
  <%= f.rc_select :difficulty, HandbookArticle::DIFFICULTIES.map { |d| [d.upcase, d] }, {include_blank: "—"}, hint: "optional · for tutorials" %>
  <%= f.rc_number_field :position, width: :short, min: 0, step: 1, hint: "order within the section" %>
  <%= f.rc_flags("FLAGS", hint: "an article shows on /handbook only while its section is published too") do %>
    <%= f.rc_check_box :published, label: "PUBLISHED" %>
  <% end %>
</div>

<%= f.rc_text_area :summary, rows: 2, spellcheck: true, hint: "the one-sentence hook in the sidebar and on the landing" %>
<%= f.rc_text_area :body, label: "BODY (MARKDOWN)", rows: 20, spellcheck: true, class: "rc-textarea--body",
  hint: "GFM markdown · raw HTML is sanitized on render · [[Codex Entry]] links the codex · [text](/handbook/other-slug) links an article" %>
<%= f.rc_text_area :metadata_json, label: "METADATA (JSON)", rows: 4, spellcheck: false, class: "rc-textarea--code",
  value: params.dig(:handbook_article, :metadata_json) || (article.metadata.present? ? JSON.pretty_generate(article.metadata) : "{}"),
  hint: %(a JSON object · search_tags is searched client-side and never shown · {"search_tags": ["cred", "mining", "rigs"]}) %>
