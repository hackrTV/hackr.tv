<%# /root/handbook_articles — the Hackr Handbook's articles ledger as a
    console screen (2026-10-31; root_console.css): bar, ON RECORD row, the
    SECTION row (server-side ?section_id=), the FILTER row (ledger-filter:
    title / slug / section / kind; a section group hides when none of its
    rows match), one // <SECTION> // rule per section with its articles
    numbered through ([NN] · title over slug · KIND · LIVE / DRAFT ·
    [EDIT] [HISTORY]), destinations, the > prompt (NN opens the record
    screen; deletes live there). Assigns: @articles, @sections. %>
<% content_for :title, "/root/handbook_articles :: ARTICLES" %>
<% articles = @articles.to_a %>
<% groups = articles.group_by(&:handbook_section) %>
<% numbers = articles.each_index.map { |i| root_num(i, total: articles.size) } %>
<% counter = 0 %>
<% current = params[:section_id].to_s %>
<div class="console console--root" data-controller="terminal ledger-filter" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "ARTICLES", sub: "ROOT · HANDBOOK · /root/handbook_articles"} do %>
    <%= link_to "[+] NEW ARTICLE", new_admin_handbook_article_path(section_id: params[:section_id]), class: "console-bar-link", data: {command: "new"} %>
    <%= link_to "[>] PUBLIC", handbook_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(articles.size, "article") %> <span class="console-dim">· <%= articles.count { |a| a.kind == "tutorial" } %> tutorial · <%= articles.count(&:published?) %> live · <%= pluralize(groups.size, "section") %></span></span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">SECTION</span>
      <span class="console-val">
        <%= link_to "ALL", admin_handbook_articles_path, class: class_names("rc-btn", "rc-btn--on": current.blank?), aria: {current: current.blank? && "page"} %>
        <% @sections.each do |section| %>
          <% on = current == section.id.to_s %>
          <%= link_to section.name.upcase, admin_handbook_articles_path(section_id: section.id), class: class_names("rc-btn", "rc-btn--on": on), aria: {current: on && "page"} %>
        <% end %>
      </span>
    </div>
    <div class="console-status-row rc-field rc-filter">
      <label class="console-key" for="ledger-filter">FILTER</label>
      <span class="console-val">
        <input type="search" id="ledger-filter" class="rc-input" placeholder="title · slug · section · kind" autocomplete="off" spellcheck="false"
          data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
        <span class="rc-count" data-ledger-filter-target="count"><%= articles.size %> / <%= articles.size %></span>
        <button type="button" class="rc-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
      </span>
    </div>
  </div>

  <% if articles.empty? %>
    <div class="console-rule"><span>// ARTICLES //</span></div>
    <%= render "admin/console/empty", text: "NO ARTICLES ON RECORD", hint: "[+] NEW ARTICLE writes the first one" %>
  <% end %>
  <% groups.each do |section, rows| %>
    <section class="console-section rc-ledger" aria-label="<%= section.name %>" data-ledger-filter-target="group">
      <div class="console-rule"><span>// <%= section.name.upcase %><% unless section.published? %> · DRAFT<% end %> //</span></div>
      <% rows.each do |article| %>
        <% num = numbers[counter] %>
        <% counter += 1 %>
        <div class="rc-row" data-ledger-filter-target="row" data-search="<%= [article.title, article.slug, section.name, article.kind].join(" ").downcase %>">
          <span class="console-tag">[<%= num %>]</span>
          <div class="cc-text">
            <%= link_to article.title, edit_admin_handbook_article_path(article), class: "console-link cc-name", data: {command: num} %>
            <div class="cc-meta"><%= article.slug %> · POS <%= article.position %><% if article.difficulty.present? %> · <%= article.difficulty.upcase %><% end %></div>
          </div>
          <span class="rc-cell <%= (article.kind == "tutorial") ? "rc-star" : "rc-off" %>"><%= article.kind.upcase %></span>
          <span class="rc-cell <%= article.published? ? "rc-on" : "rc-off" %>"><%= article.published? ? "LIVE" : "DRAFT" %></span>
          <span class="rc-cell rc-links">
            <%= link_to "[EDIT]", edit_admin_handbook_article_path(article), class: "console-link" %>
            <%= link_to "[HISTORY]", history_admin_handbook_article_path(article), class: "console-link" %>
          </span>
        </div>
      <% end %>
    </section>
  <% end %>

  <%= render "admin/console/destinations", section: :content, except: "ARTICLES" %>

  <div class="console-rule"><span>// THE HACKR HANDBOOK //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:content, except: "ARTICLES", numbers: numbers, noun: "an article number", extra: ["new"]) %>
</div>
