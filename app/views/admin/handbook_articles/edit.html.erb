<%= render TuiWindowComponent.new(title: %(/root/handbook/articles :: EDIT "#{@article.title}"), variant: :admin) do %>

    <div style="padding: 20px;">
      <% if flash[:error] %>
        <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin-bottom: 20px;">
          <p class="red-255-text"><%= flash[:error] %></p>
        </div>
      <% end %>

      <%= render "form", article: @article %>
    </div>
<% end %>
