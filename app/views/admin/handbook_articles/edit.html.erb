<%# /root/handbook_articles/:slug/edit — the handbook article as a
    console screen (2026-10-31; show redirects here). Bar (title · ROOT ·
    ARTICLE · path; [<] ARTICLES (its section), [>] PUBLIC while
    published, [HISTORY]), the fields, the prose rules, // COMMIT //
    ([SAVE] [CANCEL] · [DELETE]), destinations, the > prompt. The delete
    form is hidden at the end. URLs use slug_in_database. Assigns:
    @article, @sections. %>
<% slug = @article.slug_in_database %>
<% back = admin_handbook_articles_path(section_id: @article.handbook_section_id_in_database) %>
<% content_for :title, "/root/handbook_articles/#{slug} :: #{@article.title_in_database}" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: @article.title_in_database, sub: "ROOT · ARTICLE · /root/handbook_articles/#{slug}"} do %>
    <%= link_to "[<] ARTICLES", back, class: "console-bar-link" %>
    <% if @article.published_in_database %><%= link_to "[>] PUBLIC", handbook_article_path(slug), class: "console-bar-link" %><% end %>
    <%= link_to "[HISTORY]", history_admin_handbook_article_path(slug), class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @article, url: admin_handbook_article_path(slug), method: :patch, local: true do |f| %>
    <%= render "form", f: f, article: @article %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[SAVE ARTICLE]</button>
      <%= link_to "[CANCEL]", back, class: "rc-btn" %>
      <span class="rc-actions--end">
        <button type="submit" form="delete-article" class="rc-btn rc-btn--danger">[DELETE ARTICLE]</button>
      </span>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :content %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:content) %>

  <div class="rc-hidden-forms">
    <%= root_delete_form("delete-article", admin_handbook_article_path(slug), confirm: "Delete article '#{@article.title_in_database}'?") %>
  </div>
</div>
