<div class="tui-window white-text" style="display: block; background: #0a0a0a; padding: 20px;">
  <% if @lower_third.errors.any? %>
    <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin-bottom: 20px;">
      <p class="red-255-text"><%= @lower_third.errors.full_messages.join(", ") %></p>
    </div>
  <% end %>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_text_field :name %>
    </div>
    <div style="flex: 1;">
      <%= f.tui_text_field :slug, hint: "Leave blank to auto-generate from name" %>
    </div>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.tui_text_field :primary_text %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.tui_text_field :secondary_text %>
  </div>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_text_field :logo_url %>
    </div>
    <div style="flex: 1;">
      <%= f.tui_check_box :active %>
    </div>
  </div>

  <div style="margin-top: 20px;">
    <%= tui_submit @lower_third.new_record? ? "Create Lower Third" : "Update Lower Third", form: f, color: :green, style: "padding: 10px 20px; font-weight: bold;" %>
    <%= tui_button "Cancel", admin_overlay_lower_thirds_path, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% if @lower_third.persisted? %>
      <%= tui_button "History", history_admin_overlay_lower_third_path(@lower_third), color: :purple, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% end %>
  </div>
</div>
