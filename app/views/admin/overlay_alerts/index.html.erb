<%# /root/overlays/alerts — the HUD's alert queue as a console ledger
    (2026-10-31; root_console.css): bar ([+] SEND ALERT), ON RECORD + the
    TYPE row (server-side ?alert_type=), // ALERTS // rows newest first,
    the last 100 ([NN] · title over type / message · PENDING / DISPLAYED
    / EXPIRED · created · [DEL]), destinations, the > prompt (NN opens
    the alert). Assigns: @alerts. %>
<% content_for :title, "/root/overlays/alerts :: ALERTS" %>
<% alerts = @alerts.to_a %>
<% numbers = alerts.each_index.map { |i| root_num(i, total: alerts.size) } %>
<% current = params[:alert_type].to_s %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "ALERTS", sub: "ROOT · OVERLAYS · /root/overlays/alerts"} do %>
    <%= link_to "[+] SEND ALERT", new_admin_overlay_alert_path, class: "console-bar-link", data: {command: "new"} %>
    <%= link_to "[<] OVERLAYS", admin_overlays_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(alerts.size, "alert") %><% if current.present? %> · <%= current.upcase %><% end %> <span class="console-dim">· the newest 100 · <%= alerts.count { |a| !a.displayed? && !a.expired? } %> pending</span></span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">TYPE</span>
      <span class="console-val">
        <%= link_to "ALL", admin_overlay_alerts_path, class: class_names("rc-btn", "rc-btn--on": current.blank?), aria: {current: current.blank? && "page"} %>
        <% OverlayAlert::ALERT_TYPES.each do |type| %>
          <%= link_to type.upcase, admin_overlay_alerts_path(alert_type: type), class: class_names("rc-btn", "rc-btn--on": current == type), aria: {current: current == type && "page"} %>
        <% end %>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--alerts" aria-label="Alerts">
    <div class="console-rule"><span>// ALERTS //</span></div>
    <% if alerts.empty? %>
      <%= render "admin/console/empty", text: "NO ALERTS ON RECORD", hint: "[+] SEND ALERT queues one for the HUD" %>
    <% end %>
    <% alerts.each_with_index do |alert, i| %>
      <% num = numbers[i] %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to alert.title.presence || alert.alert_type.upcase, admin_overlay_alert_path(alert), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= alert.alert_type.upcase %><% if alert.message.present? %> · <%= truncate(alert.message, length: 60) %><% end %></div>
        </div>
        <%= render "admin/overlay_alerts/status", alert: alert, cell: true %>
        <span class="rc-cell"><%= alert.created_at.strftime("%Y-%m-%d %H:%M") %></span>
        <span class="rc-cell rc-links">
          <%= button_to "[DEL]", admin_overlay_alert_path(alert), method: :delete, class: "rc-btn rc-btn--danger", form: {data: {confirm: "Delete this alert?"}} %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :streams, except: "ALERTS" %>

  <div class="console-rule"><span>// END OF QUEUE //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:streams, except: "ALERTS", numbers: numbers, noun: "an alert number", extra: ["new"]) %>
</div>
