<%# /root/overlays/alerts/:id — one alert as a read-only console readout
    (2026-10-31; root_console.css): bar ([<] ALERTS), the alert's facts
    as status rows, // MESSAGE // and // DATA // (the JSON payload),
    // COMMIT // ([DELETE ALERT] — the hidden form at the end),
    destinations, the > prompt. Assigns: @alert. %>
<% alert = @alert %>
<% content_for :title, "/root/overlays/alerts/#{alert.id} :: ALERT" %>
<% stamp = "%Y-%m-%d %H:%M:%S" %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: alert.title.presence || alert.alert_type.upcase, sub: "ROOT · ALERT · /root/overlays/alerts/#{alert.id}"} do %>
    <%= link_to "[<] ALERTS", admin_overlay_alerts_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row"><span class="console-key">TYPE</span><span class="console-val rc-hot"><%= alert.alert_type.upcase %></span></div>
    <div class="console-status-row"><span class="console-key">TITLE</span><span class="console-val"><%= alert.title.presence || "—" %></span></div>
    <div class="console-status-row">
      <span class="console-key">STATUS</span>
      <span class="console-val"><%= render "admin/overlay_alerts/status", alert: alert %><% if alert.displayed? && alert.displayed_at %> <span class="console-dim">· at <%= alert.displayed_at.strftime(stamp) %></span><% end %></span>
    </div>
    <div class="console-status-row"><span class="console-key">CREATED</span><span class="console-val"><%= alert.created_at.strftime(stamp) %></span></div>
    <div class="console-status-row"><span class="console-key">EXPIRES</span><span class="console-val"><%= alert.expires_at&.strftime(stamp) || "never" %></span></div>
  </div>

  <div class="console-rule"><span>// MESSAGE //</span></div>
  <p class="console-reply"><%= alert.message.presence || "—" %></p>
  <% if alert.data.present? %>
    <div class="console-rule"><span>// DATA //</span></div>
    <pre class="rc-pre"><%= JSON.pretty_generate(alert.data) %></pre>
  <% end %>

  <div class="console-rule"><span>// COMMIT //</span></div>
  <div class="rc-actions">
    <button type="submit" form="delete-alert" class="rc-btn rc-btn--danger">[DELETE ALERT]</button>
  </div>

  <%= render "admin/console/destinations", section: :streams %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:streams) %>

  <div class="rc-hidden-forms">
    <%= root_delete_form("delete-alert", admin_overlay_alert_path(alert), confirm: "Delete this alert?") %>
  </div>
</div>
