<% content_for(:title) { "/root/overlays/alerts/new :: Send Alert" } %>

<%= render TuiWindowComponent.new(title: "/root/overlays/alerts/new :: SEND ALERT", variant: :admin, width: 900) do %>
    <div style="padding: 20px;">
      <%= form_with model: @alert, url: admin_overlay_alerts_path, local: true do |f| %>
        <%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "padding: 20px;") do %>
          <div style="display: flex; gap: 20px; margin-bottom: 15px;">
            <div style="flex: 1;">
              <%= f.tui_select :alert_type, OverlayAlert::ALERT_TYPES.map { |t| [t.titleize, t] }, {} %>
            </div>
            <div style="flex: 1;">
              <%= f.tui_text_field :title %>
            </div>
          </div>

          <div style="margin-bottom: 15px;">
            <%= f.tui_text_area :message, style: "min-height: 80px;" %>
          </div>

          <div style="margin-bottom: 15px;">
            <label class="white-text" style="display: block; margin-bottom: 5px; font-weight: bold;">DATA (JSON)</label>
            <textarea name="overlay_alert[data_json]" class="tui-input" style="width: 100%; padding: 8px; font-family: monospace; min-height: 80px;">{}</textarea>
            <small style="color: #666;">Optional JSON data payload</small>
          </div>

          <div style="margin-top: 20px;">
            <%= tui_submit "Send Alert", form: f, color: :green, style: "padding: 10px 20px; font-weight: bold;" %>
            <%= tui_button "Cancel", admin_overlay_alerts_path, style: "padding: 10px 20px; margin-left: 10px;" %>
          </div>
        <% end %>
      <% end %>
    </div>
<% end %>
