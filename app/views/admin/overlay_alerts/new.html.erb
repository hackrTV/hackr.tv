<%# /root/overlays/alerts/new — send an alert to the HUD, as a console
    screen (2026-10-31; root_console.css): bar ([<] ALERTS), the fields
    (TYPE, TITLE, // MESSAGE //, // DATA // — an optional JSON object;
    invalid JSON is dropped with a [WARN]), // COMMIT // ([SEND ALERT]
    [CANCEL]), destinations, the > prompt. The alert expires 10 seconds
    after it is queued. Assigns: @alert. %>
<% content_for :title, "/root/overlays/alerts/new :: SEND ALERT" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "SEND ALERT", sub: "ROOT · OVERLAYS · /root/overlays/alerts/new"} do %>
    <%= link_to "[<] ALERTS", admin_overlay_alerts_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @alert, url: admin_overlay_alerts_path, local: true do |f| %>
    <div class="console-status">
      <%= f.rc_select :alert_type, OverlayAlert::ALERT_TYPES.map { |t| [t.upcase, t] }, {}, label: "TYPE" %>
      <%= f.rc_text_field :title, autocomplete: "off", width: :wide %>
    </div>
    <%= f.rc_text_area :message, rows: 3, spellcheck: true %>
    <%= f.rc_text_area :data_json, label: "DATA (JSON)", rows: 4, value: "{}", spellcheck: false, class: "rc-textarea--code",
      hint: "optional JSON payload for the HUD · invalid JSON is dropped" %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[SEND ALERT]</button>
      <%= link_to "[CANCEL]", admin_overlay_alerts_path, class: "rc-btn" %>
      <span class="rc-hint">broadcast on OverlayChannel · expires 10 seconds after it is queued</span>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :streams %>
  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:streams) %>
</div>
