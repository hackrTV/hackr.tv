<%# /root/radio_stations — the hackr.fm stations as a read-only console
    ledger (2026-10-31; root_console.css): bar, ON RECORD + SOURCE rows,
    // STATIONS // rows in dial order ([NN] · name over slug / genre ·
    HIDDEN · playlists · [OPEN]), destinations, the > prompt (NN opens
    the station). Stations are seeded from YAML and read-only here.
    Assigns: @radio_stations. %>
<% content_for :title, "/root/radio_stations :: RADIO" %>
<% stations = @radio_stations.to_a %>
<% numbers = stations.each_index.map { |i| root_num(i) } %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "RADIO", sub: "ROOT · STREAMS · /root/radio_stations"} do %>
    <%= link_to "[>] FM RADIO", fm_radio_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(stations.size, "station") %> <span class="console-dim">· <%= stations.count(&:hidden) %> hidden</span></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">SOURCE</span>
      <span class="console-val console-dim">seeded from data/system/radio_stations.yml · rails data:radio_stations adds new slugs, never overwrites · read-only here</span>
    </div>
  </div>

  <section class="console-section rc-ledger" aria-label="Stations">
    <div class="console-rule"><span>// STATIONS //</span></div>
    <% if stations.empty? %>
      <%= render "admin/console/empty", text: "NO STATIONS ON RECORD", hint: "seed data/system/radio_stations.yml with rails data:radio_stations" %>
    <% end %>
    <% stations.each_with_index do |station, i| %>
      <% num = numbers[i] %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to station.name, admin_radio_station_path(station), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= station.slug %> · POS <%= station.position %><% if station.genre.present? %> · <%= station.genre %><% end %></div>
        </div>
        <span class="rc-cell <%= station.hidden ? "rc-off" : "rc-on" %>"><%= station.hidden ? "HIDDEN" : "ON THE DIAL" %></span>
        <span class="rc-cell rc-cell--r"><%= pluralize(station.playlists.size, "playlist") %></span>
        <span class="rc-cell rc-links"><%= link_to "[OPEN]", admin_radio_station_path(station), class: "console-link" %></span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :streams, except: "RADIO" %>

  <div class="console-rule"><span>// END OF DIAL //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:streams, except: "RADIO", numbers: numbers, noun: "a station number") %>
</div>
