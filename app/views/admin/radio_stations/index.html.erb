<%= render TuiWindowComponent.new(title: "RADIO STATIONS", variant: :admin) do %>

    <div style="padding: 20px;">
      <div style="margin-bottom: 20px; display: flex; gap: 10px; align-items: center;">
        <%= tui_button "← Back to Dashboard", admin_root_path, color: :green, style: "padding: 10px 20px;" %>
        <span style="color: #666; margin-left: 15px; font-size: 0.9em;">
          Edit via: <code style="color: #888;">data/system/radio_stations.yml</code> → <code style="color: #888;">rails data:radio_stations</code>
        </span>
      </div>

      <% if @radio_stations.empty? %>
        <%= render TuiWindowComponent.new(title: "No Stations", variant: :plain, color: :yellow, legend_class: nil, style: "margin: 20px 0;") do %>
            <div style="padding: 20px; text-align: center;">
              No radio stations found. Add them to <code>data/system/radio_stations.yml</code> and run <code>rails data:radio_stations</code>.
            </div>
        <% end %>
      <% else %>
        <%= render TuiWindowComponent.new(variant: :panel, fieldset: false) do %>
          <table class="tui-table" style="width: 100%;">
            <thead>
              <tr style="border-bottom: 2px solid #00ffff;">
                <th style="padding: 10px; text-align: left;">Position</th>
                <th style="padding: 10px; text-align: left;">Name</th>
                <th style="padding: 10px; text-align: left;">Slug</th>
                <th style="padding: 10px; text-align: left;">Genre</th>
                <th style="padding: 10px; text-align: center;">Playlists</th>
              </tr>
            </thead>
            <tbody>
              <% @radio_stations.each do |station| %>
                <tr class="admin-table-row">
                  <td style="padding: 10px;"><%= station.position %></td>
                  <td style="padding: 10px;"><%= station.name %></td>
                  <td style="padding: 10px;"><code class="cyan-168-text"><%= station.slug %></code></td>
                  <td style="padding: 10px;"><%= station.genre %></td>
                  <td style="padding: 10px; text-align: center;">
                    <%= link_to station.playlists.count, admin_radio_station_path(station), class: "cyan-168-text" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      <% end %>
    </div>
<% end %>
