<%# /root/radio_stations/:id — a hackr.fm station as a read-only console
    readout (2026-10-31; root_console.css): bar ([<] RADIO), the
    station's facts as status rows, // PLAYLISTS // rows in rotation order
    ([NN] · name · tracks), destinations, the > prompt. Assigns:
    @radio_station. %>
<% station = @radio_station %>
<% rotation = station.radio_station_playlists.includes(:playlist).to_a %>
<% content_for :title, "/root/radio_stations/#{station.id} :: #{station.name}" %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: station.name, sub: "ROOT · RADIO · /root/radio_stations/#{station.id}"} do %>
    <% if station.hidden %><%= root_badge("HIDDEN", :warn) %><% end %>
    <%= link_to "[<] RADIO", admin_radio_stations_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row"><span class="console-key">SLUG</span><span class="console-val"><%= station.slug %></span></div>
    <div class="console-status-row"><span class="console-key">GENRE</span><span class="console-val"><%= station.genre.presence || "—" %></span></div>
    <div class="console-status-row"><span class="console-key">POSITION</span><span class="console-val"><%= station.position %></span></div>
    <div class="console-status-row"><span class="console-key">COLOR</span><span class="console-val"><%= station.color.presence || "—" %></span></div>
    <div class="console-status-row"><span class="console-key">STREAM URL</span><span class="console-val"><%= station.stream_url.presence || "none · plays its playlists" %></span></div>
    <div class="console-status-row"><span class="console-key">SOURCE</span><span class="console-val console-dim">data/system/radio_stations.yml · playlists from data/playlists/key_playlists.yml · read-only here</span></div>
  </div>
  <% if station.description.present? %>
    <div class="console-rule"><span>// DESCRIPTION //</span></div>
    <p class="console-reply"><%= station.description %></p>
  <% end %>

  <section class="console-section rc-ledger" aria-label="Playlists">
    <div class="console-rule"><span>// PLAYLISTS //</span></div>
    <% if rotation.empty? %>
      <%= render "admin/console/empty", text: "NO PLAYLISTS ON THIS STATION" %>
    <% end %>
    <% rotation.each_with_index do |rsp, i| %>
      <div class="rc-row">
        <span class="console-tag">[<%= root_num(i) %>]</span>
        <div class="cc-text"><span class="cc-name"><%= rsp.playlist.name %></span></div>
        <span class="rc-cell rc-cell--r"><%= pluralize(rsp.playlist.track_count, "track") %></span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :streams %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:streams) %>
</div>
