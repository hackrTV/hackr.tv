<%# /root/grid_achievements — the achievements ledger as a console screen
    (2026-11-01; root_console.css): bar, ON RECORD row, the CATEGORY row
    (server-side ?category=), the FILTER row (ledger-filter: name / slug
    / category / trigger), // ACHIEVEMENTS // rows ([NN] · name over
    badge · slug · CATEGORY · TRIGGER · XP · CRED · EARNED · HIDDEN ·
    [HISTORY]), // MANUAL AWARD // (one
    row per manual achievement: badge · name · hackr · [AWARD]), destinations, the > prompt (NN opens the record
    screen; deletes live there). Assigns: @achievements,
    @category_filter, @hackrs. %>
<% content_for :title, "/root/grid_achievements :: ACHIEVEMENTS" %>
<% achievements = @achievements.to_a %>
<% numbers = achievements.each_index.map { |i| root_num(i, total: achievements.size) } %>
<% manual = achievements.select { |a| a.trigger_type == "manual" } %>
<div class="console console--root" data-controller="terminal ledger-filter" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "ACHIEVEMENTS", sub: "ROOT · SYSTEMS · /root/grid_achievements"} do %>
    <%= link_to "[+] NEW ACHIEVEMENT", new_admin_grid_achievement_path, class: "console-bar-link", data: {command: "new"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(achievements.size, "achievement") %><% if @category_filter %> · <%= @category_filter.upcase %><% end %> <span class="console-dim">· <%= pluralize(achievements.sum { |a| a.grid_hackr_achievements.size }, "award") %> earned · <%= achievements.count(&:hidden?) %> hidden · <%= manual.size %> manual</span></span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">CATEGORY</span>
      <span class="console-val">
        <%= link_to "ALL", admin_grid_achievements_path, class: class_names("rc-btn", "rc-btn--on": @category_filter.nil?), aria: {current: @category_filter.nil? && "page"} %>
        <% GridAchievement::CATEGORIES.each do |category| %>
          <%= link_to category.upcase, admin_grid_achievements_path(category: category), class: class_names("rc-btn", "rc-btn--on": @category_filter == category), aria: {current: @category_filter == category && "page"} %>
        <% end %>
      </span>
    </div>
    <div class="console-status-row rc-field rc-filter">
      <label class="console-key" for="ledger-filter">FILTER</label>
      <span class="console-val">
        <input type="search" id="ledger-filter" class="rc-input" placeholder="name · slug · category · trigger" autocomplete="off" spellcheck="false"
          data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
        <span class="rc-count" data-ledger-filter-target="count"><%= achievements.size %> / <%= achievements.size %></span>
        <button type="button" class="rc-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--achievements" aria-label="Achievements">
    <div class="console-rule"><span>// ACHIEVEMENTS //</span></div>
    <% if achievements.empty? %>
      <%= render "admin/console/empty", text: "NO ACHIEVEMENTS ON RECORD", hint: "[+] NEW ACHIEVEMENT defines one" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span></span><span>ACHIEVEMENT</span><span>CATEGORY</span><span>TRIGGER</span><span class="rc-cell--r">XP</span><span class="rc-cell--r">CRED</span><span class="rc-cell--r">EARNED</span><span>HIDDEN</span><span></span>
      </div>
    <% end %>
    <% achievements.each_with_index do |achievement, i| %>
      <% num = numbers[i] %>
      <div class="rc-row" data-ledger-filter-target="row" data-search="<%= [achievement.name, achievement.slug, achievement.category, achievement.trigger_type].compact.join(" ").downcase %>">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to achievement.name, edit_admin_grid_achievement_path(achievement), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><% if achievement.badge_icon.present? %><span class="rc-star"><%= achievement.badge_icon %></span> · <% end %><%= achievement.slug %></div>
        </div>
        <span class="rc-cell rc-hot"><%= achievement.category.upcase %></span>
        <span class="rc-cell"><%= achievement.trigger_type %></span>
        <span class="rc-cell rc-cell--r rc-on"><%= achievement.xp_reward %></span>
        <span class="rc-cell rc-cell--r rc-star"><%= achievement.cred_reward %></span>
        <span class="rc-cell rc-cell--r"><%= achievement.grid_hackr_achievements.size %></span>
        <span class="rc-cell <%= achievement.hidden? ? "rc-star" : "rc-off" %>"><%= achievement.hidden? ? "HIDDEN" : "—" %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[HISTORY]", history_admin_grid_achievement_path(achievement), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--awards" aria-label="Manual award">
    <div class="console-rule"><span>// MANUAL AWARD //</span></div>
    <% if manual.empty? %>
      <%= render "admin/console/empty", text: "NO MANUAL ACHIEVEMENTS", hint: "a TRIGGER of manual makes one awardable here" %>
    <% end %>
    <% manual.each do |achievement| %>
      <%= form_with url: award_admin_grid_achievement_path(achievement), method: :post, local: true, class: "rc-row" do %>
        <span class="rc-star"><%= achievement.badge_icon %></span>
        <span class="cc-name"><%= achievement.name %></span>
        <%= select_tag :hackr_id, options_from_collection_for_select(@hackrs, :id, :hackr_alias), id: "award-#{achievement.id}-hackr", class: "rc-select", aria: {label: "Hackr to award #{achievement.name}"} %>
        <button type="submit" class="rc-btn rc-btn--hot">[AWARD]</button>
      <% end %>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :systems, except: "ACHIEVEMENTS" %>

  <div class="console-rule"><span>// EVERY ACHIEVEMENT ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems, except: "ACHIEVEMENTS", numbers: numbers, noun: "an achievement number", extra: ["new"]) %>
</div>
