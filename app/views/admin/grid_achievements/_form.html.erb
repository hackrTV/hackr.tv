<%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "padding: 20px;") do %>
  <% if @achievement.errors.any? %>
    <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin-bottom: 20px;">
      <p class="red-255-text"><%= @achievement.errors.full_messages.join(", ") %></p>
    </div>
  <% end %>

  <div style="margin-bottom: 15px;">
    <%= f.tui_text_field :slug %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.tui_text_field :name %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.tui_text_area :description, style: "min-height: 60px;" %>
  </div>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_text_field :badge_icon %>
      <small style="color: #666;">Short text icon (e.g. >>, %, *, F)</small>
    </div>

    <div style="flex: 1;">
      <%= f.tui_select :category, GridAchievement::CATEGORIES.map { |c| [c, c] }, {} %>
    </div>

    <div style="flex: 1;">
      <%= f.tui_select :trigger_type, GridAchievement::TRIGGER_TYPES.map { |t| [t, t] }, {} %>
    </div>
  </div>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_number_field :xp_reward, min: 0 %>
    </div>

    <div style="flex: 1;">
      <%= f.tui_number_field :cred_reward, min: 0 %>
    </div>

    <div style="flex: 1;">
      <%= f.tui_check_box :hidden %>
      <small style="color: #666;">Hidden achievements don't show in examine until earned</small>
    </div>
  </div>

  <div style="margin-bottom: 15px;">
    <%= label_tag :trigger_data_json, "TRIGGER DATA (JSON)", class: "white-text", style: "display: block; margin-bottom: 5px; font-weight: bold;" %>
    <%= text_area_tag "grid_achievement[trigger_data_json]", (@achievement.trigger_data || {}).to_json, class: "tui-input", style: "width: 100%; padding: 8px; min-height: 60px; font-family: monospace;" %>
    <small style="color: #666;">e.g. {"count": 10} or {"item_name": "data chip"} or {"room_slug": "govcorp-hub"}</small>
  </div>

  <div style="margin-top: 20px;">
    <%= tui_submit @achievement.new_record? ? "Create Achievement" : "Update Achievement", form: f, color: :green, style: "padding: 10px 20px; font-weight: bold;" %>
    <%= tui_button "Cancel", admin_grid_achievements_path, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% if @achievement.persisted? %>
      <%= tui_button "History", history_admin_grid_achievement_path(@achievement), color: :purple, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% end %>
  </div>
<% end %>
