<%# The achievement's fields as console status rows (ConsoleFormBuilder
    rc_* rows), then // DESCRIPTION // and // TRIGGER DATA // (a JSON
    object the controller parses; a rejected save shows the JSON as
    typed, not the stored value). The commit row belongs to the caller.
    Locals: f, achievement. %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, required: true, autocomplete: "off", hint: "unique" %>
  <%= f.rc_text_field :badge_icon, label: "BADGE", width: :short, autocomplete: "off", hint: "short text icon — >> · % · * · F" %>
  <%= f.rc_select :category, GridAchievement::CATEGORIES.map { |c| [c.upcase, c] } %>
  <%= f.rc_select :trigger_type, GridAchievement::TRIGGER_TYPES.map { |t| [t, t] }, label: "TRIGGER", hint: "manual = awarded by hand on the ledger" %>
  <%= f.rc_number_field :xp_reward, label: "XP", width: :short, min: 0 %>
  <%= f.rc_number_field :cred_reward, label: "CRED", width: :short, min: 0 %>
  <%= f.rc_flags("FLAGS", hint: "a hidden achievement stays out of examine until earned") { f.rc_check_box(:hidden, label: "HIDDEN") } %>
</div>

<%= f.rc_text_area :description, rows: 3, spellcheck: true %>
<%= f.rc_text_area :trigger_data_json, label: "TRIGGER DATA", rows: 3, spellcheck: false, class: "rc-textarea--code",
  value: params.dig(:grid_achievement, :trigger_data_json) || (achievement.trigger_data || {}).to_json,
  hint: %(a JSON object · blank = {} · e.g. {"count": 10} · {"item_name": "data chip"} · {"room_slug": "govcorp-hub"}) %>
