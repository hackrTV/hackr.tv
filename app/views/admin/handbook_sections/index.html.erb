<%# /root/handbook_sections — the Hackr Handbook's sections ledger as a
    console screen (2026-10-31; root_console.css): bar, ON RECORD row,
    // SECTIONS // rows in handbook order ([NN] · name over slug · icon ·
    position · summary · articles · LIVE / DRAFT · [ARTICLES] [EDIT]
    [HISTORY]), destinations, the > prompt (NN opens the record screen;
    deletes live there). Assigns: @sections. %>
<% content_for :title, "/root/handbook_sections :: SECTIONS" %>
<% sections = @sections.to_a %>
<% numbers = sections.each_index.map { |i| root_num(i) } %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "SECTIONS", sub: "ROOT · HANDBOOK · /root/handbook_sections"} do %>
    <%= link_to "[+] NEW SECTION", new_admin_handbook_section_path, class: "console-bar-link", data: {command: "new"} %>
    <%= link_to "[>] PUBLIC", handbook_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(sections.size, "section") %> <span class="console-dim">· <%= pluralize(sections.sum { |s| s.articles.size }, "article") %> · <%= sections.count(&:published?) %> live</span></span>
    </div>
  </div>

  <section class="console-section rc-ledger" aria-label="Sections">
    <div class="console-rule"><span>// SECTIONS //</span></div>
    <% if sections.empty? %>
      <%= render "admin/console/empty", text: "NO SECTIONS ON RECORD", hint: "[+] NEW SECTION opens the handbook" %>
    <% end %>
    <% sections.each_with_index do |section, i| %>
      <% num = numbers[i] %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to section.name, edit_admin_handbook_section_path(section), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= section.slug %><% if section.icon.present? %> · <%= section.icon %><% end %> · POS <%= section.position %><% if section.summary.present? %> · <%= truncate(section.summary, length: 80) %><% end %></div>
        </div>
        <span class="rc-cell rc-cell--r"><%= pluralize(section.articles.size, "article") %></span>
        <span class="rc-cell <%= section.published? ? "rc-on" : "rc-off" %>"><%= section.published? ? "LIVE" : "DRAFT" %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[ARTICLES]", admin_handbook_articles_path(section_id: section.id), class: "console-link" %>
          <%= link_to "[EDIT]", edit_admin_handbook_section_path(section), class: "console-link" %>
          <%= link_to "[HISTORY]", history_admin_handbook_section_path(section), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :content, except: "SECTIONS" %>

  <div class="console-rule"><span>// THE HACKR HANDBOOK //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:content, except: "SECTIONS", numbers: numbers, noun: "a section number", extra: ["new"]) %>
</div>
