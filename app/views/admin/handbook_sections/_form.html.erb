<%= form_with model: [:admin, section], local: true do |f| %>
  <div style="margin-bottom: 15px;">
    <%= f.tui_text_field :name %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.tui_text_field :slug, hint: "Auto-generated from name if left blank. Lowercase, hyphens only." %>
  </div>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_text_field :icon, hint: "Short text/emoji (e.g. &gt;&gt;, %%, F, ⚡)" %>
    </div>

    <div style="flex: 1;">
      <%= f.tui_number_field :position, min: 0 %>
    </div>

    <div style="flex: 1;">
      <%= f.tui_check_box :published %>
    </div>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.tui_text_area :summary, style: "min-height: 80px;", hint: "Short description for the section landing/header." %>
  </div>

  <div style="margin-top: 20px;">
    <%= tui_submit section.persisted? ? "Save Section" : "Create Section", form: f, color: :green, style: "padding: 10px 20px; font-weight: bold;" %>
    <%= tui_button "Cancel", admin_handbook_sections_path, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% if section.persisted? %>
      <%= tui_button "History", history_admin_handbook_section_path(section), color: :purple, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% end %>
  </div>
<% end %>
