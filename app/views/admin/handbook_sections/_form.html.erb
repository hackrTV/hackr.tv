<%# The handbook section's fields as console status rows
    (ConsoleFormBuilder rc_* rows) and // SUMMARY //. The commit row
    belongs to the caller. Locals: f, section. %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off" %>
  <%= f.rc_text_field :slug, autocomplete: "off", pattern: "[a-z0-9\\-]+", title: "lowercase letters, digits, hyphens",
    hint: "blank = from the name · lowercase, hyphens" %>
  <%= f.rc_text_field :icon, width: :short, autocomplete: "off", hint: "short text beside the name · >> %% F" %>
  <%= f.rc_number_field :position, width: :short, min: 0, step: 1, hint: "the handbook orders sections by this" %>
  <%= f.rc_flags("FLAGS", hint: "unchecked hides the section and every article in it from /handbook") do %>
    <%= f.rc_check_box :published, label: "PUBLISHED" %>
  <% end %>
</div>

<%= f.rc_text_area :summary, rows: 3, spellcheck: true, hint: "the section's landing / header line" %>
