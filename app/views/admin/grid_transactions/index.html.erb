<%# /root/grid_transactions — every CRED movement as a console ledger
    (2026-11-01; root_console.css): bar ([<] ECONOMY), ON RECORD, the
    // FILTER // rows (server-side: TYPE links, HACKR, FROM / TO dates,
    MEMO — [FILTER] / [x] CLEAR), // TRANSACTIONS // newest first, 100
    a page (time · hash · TYPE · from over its address · to · amount ·
    memo) with the pager, destinations, the > prompt. Assigns:
    @transactions, @total_count, @offset, @per_page, @hackr_not_found. %>
<% content_for :title, "/root/grid_transactions :: TRANSACTIONS" %>
<% transactions = @transactions.to_a %>
<% tx_type = params[:tx_type].to_s.presence_in(GridTransaction::TX_TYPES).to_s %>
<% keep = request.query_parameters.slice("hackr_alias", "date_from", "date_to", "memo") %>
<% filtered = tx_type.present? || keep.values.any?(&:present?) %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "TRANSACTIONS", sub: "ROOT · SYSTEMS · /root/grid_transactions"} do %>
    <%= link_to "[<] ECONOMY", admin_grid_economy_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(@total_count, "transaction") %><% if filtered %> <span class="console-dim">· filtered</span><% end %> <span class="console-dim">· newest first · <%= @per_page %> a page</span></span>
    </div>
  </div>

  <%= form_with url: admin_grid_transactions_path, method: :get, local: true do %>
    <div class="console-rule"><span>// FILTER //</span></div>
    <div class="console-status">
      <div class="console-status-row rc-field">
        <span class="console-key">TYPE</span>
        <span class="console-val">
          <% [["ALL", ""]].concat(GridTransaction::TX_TYPES.map { |t| [t.upcase, t] }).each do |word, value| %>
            <%= link_to word, admin_grid_transactions_path(keep.merge(tx_type: value.presence).compact), class: class_names("rc-btn", "rc-btn--on": tx_type == value), aria: {current: tx_type == value && "page"} %>
          <% end %>
        </span>
      </div>
      <%= root_field("HACKR", id: "hackr_alias") do %>
        <%= text_field_tag :hackr_alias, params[:hackr_alias], class: "rc-input", placeholder: "alias", autocomplete: "off", spellcheck: "false" %>
      <% end %>
      <%= root_field("FROM", id: "date_from") do %>
        <%= date_field_tag :date_from, params[:date_from], class: "rc-input rc-input--date" %>
        <%= label_tag :date_to, "TO", class: "rc-count" %>
        <%= date_field_tag :date_to, params[:date_to], class: "rc-input rc-input--date" %>
      <% end %>
      <%= root_field("MEMO", id: "memo") do %>
        <%= text_field_tag :memo, params[:memo], class: "rc-input rc-input--wide", placeholder: "words in the memo", autocomplete: "off" %>
      <% end %>
    </div>
    <% if tx_type.present? %><%= hidden_field_tag :tx_type, tx_type %><% end %>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[FILTER]</button>
      <%= link_to "[x] CLEAR", admin_grid_transactions_path, class: "rc-btn" %>
    </div>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--tx" aria-label="Transactions">
    <div class="console-rule"><span>// TRANSACTIONS //</span></div>
    <% if @hackr_not_found %>
      <%= render "admin/console/empty", text: "NO HACKR NAMED '#{params[:hackr_alias]}'", hint: "[x] CLEAR shows every transaction" %>
    <% elsif transactions.empty? %>
      <%= render "admin/console/empty", text: filtered ? "NO TRANSACTIONS MATCH" : "NO TRANSACTIONS YET", hint: (filtered ? "[x] CLEAR shows every transaction" : "rails data:economy seeds genesis") %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>TIME</span><span>HASH</span><span>TYPE</span><span>FROM</span><span>TO</span><span class="rc-cell--r">AMOUNT</span><span>MEMO</span>
      </div>
    <% end %>
    <% transactions.each do |tx| %>
      <div class="rc-row">
        <span class="console-tag"><%= tx.created_at.strftime("%Y-%m-%d %H:%M") %></span>
        <span class="rc-cell rc-off"><%= tx.short_hash %></span>
        <%= render "tx_type", tx: tx %>
        <% [tx.from_cache, tx.to_cache].each do |cache| %>
          <div class="cc-text">
            <span class="<%= cache.system? ? "rc-off" : "rc-hot" %>"><%= cache_display(cache) %></span>
            <% unless cache.system? %><div class="cc-meta"><%= cache.address %></div><% end %>
          </div>
        <% end %>
        <span class="rc-cell rc-cell--r rc-on"><%= format_cred(tx.amount) %></span>
        <span class="rc-cell rc-off" title="<%= tx.memo %>"><%= tx.memo || "—" %></span>
      </div>
    <% end %>
    <%= root_pager(@offset, @per_page, @total_count) %>
  </section>

  <%= render "admin/console/destinations", section: :systems, except: "TRANSACTIONS" %>

  <div class="console-rule"><span>// END OF TRANSACTIONS //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems, except: "TRANSACTIONS") %>
</div>
