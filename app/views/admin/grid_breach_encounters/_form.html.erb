<%# The encounter's placement as console status rows (ConsoleFormBuilder
    rc_* rows): template, room, state, seed. The commit row belongs to
    the caller. Locals: f; @templates, @rooms for the selects. %>
<div class="console-status">
  <%= f.rc_select :grid_breach_template_id, @templates.map { |t| ["#{t.name} (#{t.tier_label})", t.id] }, {include_blank: "(select a template)"}, label: "TEMPLATE", required: true, hint: "published templates" %>
  <%= f.rc_select :grid_room_id, @rooms.map { |r| ["#{r.grid_zone.name} :: #{r.name}", r.id] }, {include_blank: "(select a room)"}, label: "ROOM", required: true %>
  <%= f.rc_select :state, GridBreachEncounter::STATES.map { |s| [s.upcase, s] }, {} %>
  <%= f.rc_number_field :instance_seed, label: "SEED", width: :short, hint: "optional — procedural variation seed" %>
</div>
