<%# /root/grid_breach_encounters — the BREACH encounters ledger as a
    console screen (2026-11-01; root_console.css): bar, ON RECORD row,
    the FILTER row (ledger-filter: room / zone / template / tier / state
    — typing "cooldown" replaces the old cooldown-only toggle script),
    // ENCOUNTERS // rows ([NN] · room over zone · template over tier ·
    STATE · ACTIVE · COOLDOWN · [RESET] [HISTORY]), destinations, the
    > prompt (NN opens the record screen; deletes live there). [RESET]
    sets a non-available encounter back to available. Assigns:
    @encounters, @active_counts. %>
<% content_for :title, "/root/grid_breach_encounters :: BREACH ENCOUNTERS" %>
<% encounters = @encounters.to_a %>
<% numbers = encounters.each_index.map { |i| root_num(i, total: encounters.size) } %>
<% states = encounters.map(&:state).tally %>
<div class="console console--root" data-controller="terminal ledger-filter" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "BREACH ENCOUNTERS", sub: "ROOT · SYSTEMS · /root/grid_breach_encounters"} do %>
    <%= link_to "[+] NEW ENCOUNTER", new_admin_grid_breach_encounter_path, class: "console-bar-link", data: {command: "new"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(encounters.size, "encounter") %> <span class="console-dim">· <%= GridBreachEncounter::STATES.map { |s| "#{states.fetch(s, 0)} #{s}" }.join(" · ") %></span></span>
    </div>
    <div class="console-status-row rc-field rc-filter">
      <label class="console-key" for="ledger-filter">FILTER</label>
      <span class="console-val">
        <input type="search" id="ledger-filter" class="rc-input" placeholder="room · zone · template · tier · state" autocomplete="off" spellcheck="false"
          data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
        <span class="rc-count" data-ledger-filter-target="count"><%= encounters.size %> / <%= encounters.size %></span>
        <button type="button" class="rc-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--encounters" aria-label="Encounters">
    <div class="console-rule"><span>// ENCOUNTERS //</span></div>
    <% if encounters.empty? %>
      <%= render "admin/console/empty", text: "NO ENCOUNTERS PLACED", hint: "[+] NEW ENCOUNTER places a template in a room" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span></span><span>ROOM</span><span>TEMPLATE</span><span>STATE</span><span class="rc-cell--r">ACTIVE</span><span>COOLDOWN</span><span></span>
      </div>
    <% end %>
    <% encounters.each_with_index do |encounter, i| %>
      <% num = numbers[i] %>
      <% room = encounter.grid_room %>
      <% template = encounter.grid_breach_template %>
      <% active = @active_counts[encounter.id] || 0 %>
      <div class="rc-row" data-ledger-filter-target="row" data-search="<%= [room.name, room.grid_zone.name, template.name, template.tier_label, encounter.state].join(" ").downcase %>">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to room.name, edit_admin_grid_breach_encounter_path(encounter), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= room.grid_zone.name %></div>
        </div>
        <div class="cc-text">
          <span class="cc-name"><%= template.name %></span>
          <div class="cc-meta"><%= template.tier_label %></div>
        </div>
        <span class="rc-cell <%= {"available" => "rc-on", "active" => "rc-hot", "cooldown" => "rc-star"}.fetch(encounter.state, "rc-off") %>"><%= encounter.state.upcase %></span>
        <span class="rc-cell rc-cell--r <%= active.positive? ? "rc-hot" : "rc-off" %>"><%= active %></span>
        <span class="rc-cell <%= encounter.cooldown_until ? "rc-star" : "rc-off" %>"><%= encounter.cooldown_until&.strftime("%H:%M:%S") || "—" %></span>
        <span class="rc-cell rc-links">
          <% unless encounter.available? %>
            <%= button_to "[RESET]", make_available_admin_grid_breach_encounter_path(encounter), class: "rc-btn", form: {data: {confirm: "Reset this encounter to available?"}} %>
          <% end %>
          <%= link_to "[HISTORY]", history_admin_grid_breach_encounter_path(encounter), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :systems, except: "ENCOUNTERS" %>

  <div class="console-rule"><span>// EVERY ENCOUNTER ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems, except: "ENCOUNTERS", numbers: numbers, noun: "an encounter number", extra: ["new"]) %>
</div>
