<%# /root/grid_breach_encounters/new — a new encounter on the record
    screen's shell (?grid_breach_template_id= prefills the template — the
    template record's [+] NEW ENCOUNTER). %>
<% content_for :title, "/root/grid_breach_encounters/new :: NEW ENCOUNTER" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "NEW ENCOUNTER", sub: "ROOT · ENCOUNTER · /root/grid_breach_encounters/new"} do %>
    <%= link_to "[<] ENCOUNTERS", admin_grid_breach_encounters_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @encounter, url: admin_grid_breach_encounters_path, local: true do |f| %>
    <%= render "form", f: f %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[PLACE ENCOUNTER]</button>
      <%= link_to "[CANCEL]", admin_grid_breach_encounters_path, class: "rc-btn" %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :systems %>
  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems) %>
</div>
