<%# /root/grid_transit_journeys — the newest 100 transit journeys as a
    console screen (2026-10-31; root_console.css): bar, ON SCREEN row,
    the STATE and TYPE rows (server-side ?state= / ?journey_type=, each
    keeping the other), // JOURNEYS // rows ([NN] · hackr over #id ·
    TYPE · route · STATE · started · [ABANDON] while active and dev tools
    are on), destinations, the > prompt (NN opens the journey readout).
    Assigns: @journeys, @state, @journey_type. %>
<% content_for :title, "/root/grid_transit_journeys :: JOURNEYS" %>
<% journeys = @journeys.to_a %>
<% numbers = journeys.each_index.map { |i| root_num(i, total: journeys.size) } %>
<% state_tone = {"active" => "rc-on", "completed" => "rc-off", "abandoned" => "rc-star"} %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "JOURNEYS", sub: "ROOT · WORLD · /root/grid_transit_journeys"} do %>
    <% if dev_tools_enabled? %><%= root_badge("DEV TOOLS ON", :warn) %><% end %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON SCREEN</span>
      <span class="console-val"><%= pluralize(journeys.size, "journey") %><% if @state || @journey_type %> · <%= [@state, @journey_type].compact.join(" · ").upcase %><% end %> <span class="console-dim">· newest first · at most 100</span></span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">STATE</span>
      <span class="console-val">
        <%= link_to "ALL", admin_grid_transit_journeys_path(journey_type: @journey_type), class: class_names("rc-btn", "rc-btn--on": @state.nil?), aria: {current: @state.nil? && "page"} %>
        <% GridTransitJourney::STATES.each do |state| %>
          <%= link_to state.upcase, admin_grid_transit_journeys_path(state: state, journey_type: @journey_type), class: class_names("rc-btn", "rc-btn--on": @state == state), aria: {current: @state == state && "page"} %>
        <% end %>
      </span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">TYPE</span>
      <span class="console-val">
        <%= link_to "ALL", admin_grid_transit_journeys_path(state: @state), class: class_names("rc-btn", "rc-btn--on": @journey_type.nil?), aria: {current: @journey_type.nil? && "page"} %>
        <% GridTransitJourney::JOURNEY_TYPES.each do |type| %>
          <%= link_to type.upcase, admin_grid_transit_journeys_path(state: @state, journey_type: type), class: class_names("rc-btn", "rc-btn--on": @journey_type == type), aria: {current: @journey_type == type && "page"} %>
        <% end %>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--journeys" aria-label="Journeys">
    <div class="console-rule"><span>// JOURNEYS //</span></div>
    <% if journeys.empty? %>
      <%= render "admin/console/empty", text: "NO JOURNEYS ON RECORD", hint: ("clear a filter to see more" if @state || @journey_type) %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span></span><span>HACKR</span><span>TYPE</span><span>ROUTE</span><span>STATE</span><span>STARTED</span><span></span>
      </div>
    <% end %>
    <% journeys.each_with_index do |journey, i| %>
      <% num = numbers[i] %>
      <% route = journey.slipstream? ? journey.grid_slipstream_route : journey.grid_transit_route %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to journey.grid_hackr.hackr_alias, admin_grid_transit_journey_path(journey), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta">#<%= journey.id %></div>
        </div>
        <span class="rc-cell <%= journey.slipstream? ? "rc-star" : "rc-hot" %>"><%= journey.journey_type.upcase %></span>
        <span class="rc-cell"><%= route&.name || "—" %></span>
        <span class="rc-cell <%= state_tone.fetch(journey.state, "rc-bad") %>"><%= journey.state.upcase %></span>
        <span class="rc-cell"><%= journey.started_at&.strftime("%Y-%m-%d %H:%M") || "—" %></span>
        <span class="rc-cell rc-links">
          <% if journey.active? && dev_tools_enabled? %>
            <%= button_to "[ABANDON]", force_abandon_admin_grid_transit_journey_path(journey), method: :post, class: "rc-btn rc-btn--danger",
              form: {data: {confirm: "Force-abandon journey ##{journey.id}?"}} %>
          <% end %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :world, except: "JOURNEYS" %>

  <div class="console-rule"><span>// NEWEST JOURNEYS //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world, except: "JOURNEYS", numbers: numbers, noun: "a journey number") %>
</div>
