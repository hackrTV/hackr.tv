<%# /root/grid_transit_journeys/:id — one transit journey as a console
    readout (2026-10-31; read-only): bar (#id · ROOT · JOURNEY · path;
    [<] JOURNEYS, the DEV TOOLS badge), // JOURNEY // (hackr, type,
    state, times), // ROUTE // (the slipstream legs and heat, or the
    local stop and fare), // META // as JSON when present, // DEV TOOLS //
    [FORCE ABANDON] while active and dev tools are on, destinations, the
    > prompt. Assigns: @journey. %>
<% state_tone = {"active" => "rc-on", "completed" => "rc-off", "abandoned" => "rc-star"} %>
<% content_for :title, "/root/grid_transit_journeys/#{@journey.id} :: JOURNEY" %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "JOURNEY ##{@journey.id}", sub: "ROOT · JOURNEY · /root/grid_transit_journeys/#{@journey.id}"} do %>
    <%= link_to "[<] JOURNEYS", admin_grid_transit_journeys_path, class: "console-bar-link" %>
    <% if dev_tools_enabled? %><%= root_badge("DEV TOOLS ON", :warn) %><% end %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-rule"><span>// JOURNEY //</span></div>
  <div class="console-status">
    <div class="console-status-row"><span class="console-key">HACKR</span><span class="console-val rc-hot"><%= @journey.grid_hackr.hackr_alias %></span></div>
    <div class="console-status-row"><span class="console-key">TYPE</span><span class="console-val"><%= @journey.journey_type.upcase %></span></div>
    <div class="console-status-row"><span class="console-key">STATE</span><span class="console-val <%= state_tone.fetch(@journey.state, "rc-bad") %>"><%= @journey.state.upcase %></span></div>
    <div class="console-status-row"><span class="console-key">STARTED</span><span class="console-val"><%= @journey.started_at&.strftime("%Y-%m-%d %H:%M:%S") || "—" %></span></div>
    <div class="console-status-row"><span class="console-key">ENDED</span><span class="console-val"><%= @journey.ended_at&.strftime("%Y-%m-%d %H:%M:%S") || "—" %></span></div>
    <div class="console-status-row"><span class="console-key">FROM</span><span class="console-val"><%= @journey.origin_room&.name || "—" %></span></div>
    <div class="console-status-row"><span class="console-key">TO</span><span class="console-val"><%= @journey.destination_room&.name || "—" %></span></div>
  </div>

  <div class="console-rule"><span>// ROUTE //</span></div>
  <div class="console-status">
    <% if @journey.slipstream? %>
      <% route = @journey.grid_slipstream_route %>
      <div class="console-status-row"><span class="console-key">ROUTE</span><span class="console-val"><%= route ? link_to(route.name, edit_admin_grid_slipstream_route_path(route), class: "console-link") : "—" %></span></div>
      <div class="console-status-row"><span class="console-key">LEG</span><span class="console-val"><%= @journey.current_leg&.name || "—" %> <span class="console-dim">· <%= @journey.legs_completed %> / <%= @journey.total_legs %> done</span></span></div>
      <div class="console-status-row"><span class="console-key">HEAT</span><span class="console-val"><%= @journey.heat_accumulated %></span></div>
      <div class="console-status-row"><span class="console-key">FORK</span><span class="console-val"><%= @journey.pending_fork? ? "PENDING" : "—" %></span></div>
      <div class="console-status-row"><span class="console-key">BREACH</span><span class="console-val"><%= @journey.breach_mid_journey? ? "MID-JOURNEY" : "—" %></span></div>
    <% else %>
      <% route = @journey.grid_transit_route %>
      <div class="console-status-row"><span class="console-key">ROUTE</span><span class="console-val"><%= route ? link_to(route.name, edit_admin_grid_transit_route_path(route), class: "console-link") : "—" %></span></div>
      <div class="console-status-row"><span class="console-key">STOP</span><span class="console-val"><%= @journey.current_stop&.display_name || "—" %></span></div>
      <div class="console-status-row"><span class="console-key">FARE</span><span class="console-val"><%= @journey.fare_paid %> CRED</span></div>
    <% end %>
  </div>

  <% if @journey.meta.present? %>
    <div class="console-rule"><span>// META //</span></div>
    <pre class="rc-pre"><%= JSON.pretty_generate(@journey.meta) %></pre>
  <% end %>

  <% if @journey.active? && dev_tools_enabled? %>
    <div class="console-rule"><span>// DEV TOOLS //</span></div>
    <div class="rc-actions">
      <%= button_to "[FORCE ABANDON]", force_abandon_admin_grid_transit_journey_path(@journey), method: :post, class: "rc-btn rc-btn--danger",
        form: {data: {confirm: "Force-abandon journey ##{@journey.id}? The hackr goes back to the origin room."}} %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :world %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world) %>
</div>
