<%= render TuiWindowComponent.new(title: "/root :: ADMIN DASHBOARD", variant: :admin) do %>

    <div style="padding: 20px;">
      <!-- Quick Stats -->
      <h2 class="cyan-255-text" style="margin-bottom: 20px;">[:: SYSTEM STATS ::]</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 40px;">
        <%= render TuiWindowComponent.new(title: "Online Hackrs", variant: :plain, color: :green, legend_class: nil) do %>
            <div style="padding: 15px; text-align: center;">
              <p style="font-size: 2.5em; margin: 0;"><%= @stats[:online_hackrs_count] %></p>
            </div>
        <% end %>

        <%= render TuiWindowComponent.new(title: "Total Emails Sent", variant: :plain, color: :yellow, legend_class: nil) do %>
            <div style="padding: 15px; text-align: center;">
              <p style="font-size: 2.5em; margin: 0;"><%= @stats[:total_emails_sent] %></p>
            </div>
        <% end %>

        <%= render TuiWindowComponent.new(title: "Emails Sent (30d)", variant: :plain, color: :yellow, legend_class: nil) do %>
            <div style="padding: 15px; text-align: center;">
              <p style="font-size: 2.5em; margin: 0;"><%= @stats[:emails_sent_30d] %></p>
            </div>
        <% end %>

        <%= render TuiWindowComponent.new(title: "Emails Sent (24h)", variant: :plain, color: :yellow, legend_class: nil) do %>
            <div style="padding: 15px; text-align: center;">
              <p style="font-size: 2.5em; margin: 0;"><%= @stats[:emails_sent_24h] %></p>
            </div>
        <% end %>

        <%= render TuiWindowComponent.new(title: "Artists", variant: :plain, color: :purple, legend_class: nil) do %>
            <div style="padding: 15px; text-align: center;">
              <p style="font-size: 2.5em; margin: 0;"><%= @stats[:artists_count] %></p>
            </div>
        <% end %>

        <%= render TuiWindowComponent.new(title: "Tracks", variant: :plain, color: :purple, legend_class: nil) do %>
            <div style="padding: 15px; text-align: center;">
              <p style="font-size: 2.5em; margin: 0;"><%= @stats[:tracks_count] %></p>
            </div>
        <% end %>

        <%= render TuiWindowComponent.new(title: "Hackr Logs", variant: :plain, color: :purple, legend_class: nil) do %>
            <div style="padding: 15px; text-align: center;">
              <p style="font-size: 2.5em; margin: 0;"><%= @stats[:hackr_logs_count] %></p>
            </div>
        <% end %>

        <%= render TuiWindowComponent.new(title: "Codex Entries", variant: :plain, color: :purple, legend_class: nil) do %>
            <div style="padding: 15px; text-align: center;">
              <p style="font-size: 2.5em; margin: 0;"><%= @stats[:codex_entries_count] %></p>
            </div>
        <% end %>
      </div>

      <!-- Quick Actions -->
      <h2 class="cyan-255-text" style="margin-bottom: 20px;">[:: QUICK ACTIONS ::]</h2>
      <div style="display: flex; gap: 15px; margin-bottom: 40px; flex-wrap: wrap;">
        <%= tui_button "🎵 Artists", admin_artists_path, color: :purple, style: "padding: 10px 20px;" %>
        <%= tui_button "💿 Releases", admin_releases_path, color: :purple, style: "padding: 10px 20px;" %>
        <%= tui_button "🎶 Tracks", admin_tracks_path, color: :purple, style: "padding: 10px 20px;" %>
        <%= tui_button "📝 Logs", admin_hackr_logs_path, color: :purple, style: "padding: 10px 20px;" %>
        <%= tui_button "📖 Codex", admin_codex_entries_path, color: :purple, style: "padding: 10px 20px;" %>
        <%= tui_button "📻 Radio Stations", admin_radio_stations_path, color: :purple, style: "padding: 10px 20px;" %>
        <%= tui_button "🎶 Zone Playlists", admin_zone_playlists_path, color: :purple, style: "padding: 10px 20px;" %>
        <%= tui_button "🗺️ Grid Zones", admin_grid_zones_path, color: :yellow, style: "padding: 10px 20px;" %>
        <%= tui_button "🚪 Grid Rooms", admin_grid_rooms_path, color: :yellow, style: "padding: 10px 20px;" %>
        <%= tui_button "🎮 GRID Admin", admin_grid_path, color: :green, style: "padding: 10px 20px;" %>
        <%= tui_button "📦 World Export", admin_grid_world_export_path, color: :green, style: "padding: 10px 20px;" %>
      </div>

      <!-- Recent Activity -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 30px;">
        <!-- Recent Tracks -->
        <div>
          <h3 class="cyan-255-text" style="margin-bottom: 15px;">[:: RECENT TRACKS ::]</h3>
          <%= render TuiWindowComponent.new(variant: :panel, fieldset: false) do %>
            <% if @recent_tracks.any? %>
              <table class="tui-table" style="width: 100%;">
                <thead>
                  <tr>
                    <th style="text-align: left;">Track</th>
                    <th style="text-align: left;">Artist</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_tracks.each do |track| %>
                    <tr>
                      <td>
                        <span class="purple-168-text"><%= track.title %></span>
                        <%= "★" if track.featured %>
                      </td>
                      <td><%= track.artist.name %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% else %>
              <p style="padding: 20px; text-align: center; color: #666;">No tracks yet</p>
            <% end %>
          <% end %>
        </div>

        <!-- Recent Logs -->
        <div>
          <h3 class="cyan-255-text" style="margin-bottom: 15px;">[:: RECENT LOGS ::]</h3>
          <%= render TuiWindowComponent.new(variant: :panel, fieldset: false) do %>
            <% if @recent_logs.any? %>
              <table class="tui-table" style="width: 100%;">
                <thead>
                  <tr>
                    <th style="text-align: left;">Title</th>
                    <th style="text-align: center;">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_logs.each do |log| %>
                    <tr>
                      <td>
                        <span class="purple-168-text"><%= log.title %></span>
                      </td>
                      <td style="text-align: center;">
                        <% if log.published? %>
                          <span class="green-255-text">✓</span>
                        <% else %>
                          <span style="color: #666;">⊗</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% else %>
              <p style="padding: 20px; text-align: center; color: #666;">No logs yet</p>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- GRID Activity -->
      <div>
        <h3 class="cyan-255-text" style="margin-bottom: 15px;">[:: ONLINE HACKRS ::]</h3>
        <%= render TuiWindowComponent.new(variant: :panel, fieldset: false) do %>
          <% if @online_hackrs.any? %>
            <table class="tui-table" style="width: 100%;">
              <thead>
                <tr>
                  <th style="text-align: left;">Hackr</th>
                  <th style="text-align: left;">Room</th>
                </tr>
              </thead>
              <tbody>
                <% @online_hackrs.each do |hackr| %>
                  <tr>
                    <td>
                      <%= hackr.hackr_alias %>
                      <% if hackr.admin? %>
                        <span class="red-255-text">[ADMIN]</span>
                      <% end %>
                    </td>
                    <td><%= hackr.current_room&.name || "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p style="padding: 20px; text-align: center; color: #666;">No hackrs online</p>
          <% end %>
        <% end %>
      </div>

      <!-- Navigation Links -->
      <div style="margin-top: 40px; padding-top: 20px; border-top: 1px solid #333;">
        <%= tui_button "← Back to Site", root_path, color: :green %>
      </div>
    </div>
<% end %>
