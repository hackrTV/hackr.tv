<%# /root — the admin dashboard as a console screen (2026-10-30; the
    root of the /root console family — console.css + root_console.css).
    Bar (ROOT · ADMIN · /root · the alias; DEV TOOLS ON badge while the
    gate is on; [>] SITE), // SYSTEM // stat tiles, one // <SECTION> //
    rule of destination rows per Admin::ConsoleHelper::ROOT_SECTIONS
    section (every [TAG] is a prompt command; a tag two sections share —
    RADIO — keeps its first row), then // RECENT TRACKS // // RECENT
    LOGS // // ONLINE HACKRS // ledgers numbered through ([NN] opens the
    record / the inspector), the > prompt. Assigns: @stats,
    @recent_tracks, @recent_logs, @online_hackrs. %>
<% content_for :title, "/root :: ROOT" %>
<% seen = Set.new %>
<% counter = 0 %>
<% total = @recent_tracks.size + @recent_logs.size + @online_hackrs.size %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "ROOT", sub: "ADMIN · /root · @#{current_hackr.hackr_alias}"} do %>
    <% if dev_tools_enabled? %><%= root_badge("DEV TOOLS ON", :warn) %><% end %>
    <%= link_to "[>] SITE", root_path, class: "console-bar-link", data: {command: "site"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-rule"><span>// SYSTEM //</span></div>
  <div class="rc-stats">
    <div class="rc-stat"><span class="rc-stat-key">ONLINE</span><span class="rc-stat-val <%= (@stats[:online_hackrs_count] > 0) ? "rc-on" : "rc-off" %>"><%= @stats[:online_hackrs_count] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">ARTISTS</span><span class="rc-stat-val"><%= @stats[:artists_count] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">TRACKS</span><span class="rc-stat-val"><%= @stats[:tracks_count] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">LOGS</span><span class="rc-stat-val"><%= @stats[:hackr_logs_count] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">CODEX</span><span class="rc-stat-val"><%= @stats[:codex_entries_count] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">MAIL 24H</span><span class="rc-stat-val"><%= @stats[:emails_sent_24h] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">MAIL 30D</span><span class="rc-stat-val"><%= @stats[:emails_sent_30d] %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">MAIL TOTAL</span><span class="rc-stat-val"><%= @stats[:total_emails_sent] %></span></div>
  </div>

  <% Admin::ConsoleHelper::ROOT_SECTIONS.each_key do |section| %>
    <section class="console-section" aria-label="<%= section.to_s.titleize %>">
      <div class="console-rule"><span>// <%= section.to_s.upcase %> //</span></div>
      <% root_section_rows(section).each do |tag_name, href, name, desc| %>
        <% next unless seen.add?(tag_name) %>
        <div class="console-row">
          <span class="console-tag">[<%= tag_name %>]</span>
          <%= link_to name, href, class: "console-link", data: {command: tag_name.downcase} %>
          <span class="console-desc"><%= desc %></span>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--recent" aria-label="Recent tracks">
    <div class="console-rule"><span>// RECENT TRACKS //</span></div>
    <% if @recent_tracks.empty? %>
      <%= render "admin/console/empty", text: "NO TRACKS ON RECORD", hint: "[TRACKS] starts the archive" %>
    <% end %>
    <% @recent_tracks.each do |track| %>
      <% num = root_num(counter, total: total) %>
      <% counter += 1 %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to track.title, edit_admin_track_path(track), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= track.artist.name %> · <%= track.release.name %></div>
        </div>
        <span class="rc-cell <%= track.featured ? "rc-star" : "rc-off" %>"><%= track.featured ? "★ FEATURED" : "—" %></span>
        <span class="rc-cell rc-links"><%= link_to "[EDIT]", edit_admin_track_path(track), class: "console-link" %></span>
      </div>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--recent" aria-label="Recent logs">
    <div class="console-rule"><span>// RECENT LOGS //</span></div>
    <% if @recent_logs.empty? %>
      <%= render "admin/console/empty", text: "NO LOGS ON RECORD", hint: "[LOGS] starts the transmissions" %>
    <% end %>
    <% @recent_logs.each do |log| %>
      <% num = root_num(counter, total: total) %>
      <% counter += 1 %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to log.title, edit_admin_hackr_log_path(log), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= log.slug %> · <%= log.timeline %><% if log.published_at %> · <%= log.published_at.strftime("%Y-%m-%d") %><% end %></div>
        </div>
        <span class="rc-cell <%= log.published? ? "rc-on" : "rc-off" %>"><%= log.published? ? "PUBLISHED" : "DRAFT" %></span>
        <span class="rc-cell rc-links"><%= link_to "[EDIT]", edit_admin_hackr_log_path(log), class: "console-link" %></span>
      </div>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--recent" aria-label="Online hackrs">
    <div class="console-rule"><span>// ONLINE HACKRS //</span></div>
    <% if @online_hackrs.empty? %>
      <%= render "admin/console/empty", text: "NO HACKRS ON THE GRID", hint: "active in the last 15 minutes, in a room" %>
    <% end %>
    <% @online_hackrs.each do |hackr| %>
      <% num = root_num(counter, total: total) %>
      <% counter += 1 %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to hackr.hackr_alias, admin_grid_hackr_path(hackr), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= hackr.current_room&.name || "—" %></div>
        </div>
        <span class="rc-cell <%= hackr.admin? ? "rc-bad" : "rc-on" %>"><%= hackr.admin? ? "ADMIN" : "ONLINE" %></span>
        <span class="rc-cell rc-links"><%= link_to "[INSPECT]", admin_grid_hackr_path(hackr), class: "console-link" %></span>
      </div>
    <% end %>
  </section>

  <div class="console-rule"><span>// END OF LINE //</span></div>
  <%= render "shared/console_prompt", hint: safe_join([
    "type a tag ", tag.span("(any [TAG] on screen)", class: "console-dim"),
    (total > 0 ? safe_join([" or a number ", tag.span("(#{root_num(0, total: total)}–#{root_num(total - 1, total: total)})", class: "console-dim")]) : ""),
    " · enter · ? help"
  ]) %>
</div>
