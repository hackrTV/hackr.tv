<%# /root/zone_playlists — the grid's ambient playlists as a read-only
    console ledger (2026-10-31; root_console.css): bar, ON RECORD +
    SOURCE rows, // PLAYLISTS // rows ([NN] · name over slug /
    description · tracks · crossfade · volume), destinations, the >
    prompt (NN opens the playlist). Seeded from YAML, read-only here.
    Assigns: @zone_playlists. %>
<% content_for :title, "/root/zone_playlists :: PLAYLISTS" %>
<% playlists = @zone_playlists.to_a %>
<% numbers = playlists.each_index.map { |i| root_num(i) } %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "ZONE PLAYLISTS", sub: "ROOT · STREAMS · /root/zone_playlists"} do %><% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(playlists.size, "playlist") %> <span class="console-dim">· <%= pluralize(playlists.sum { |p| p.tracks.size }, "track") %> placed</span></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">SOURCE</span>
      <span class="console-val console-dim">seeded from data/system/zone_playlists.yml · rails data:zone_playlists adds new slugs, never overwrites · read-only here</span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--playlists" aria-label="Zone playlists">
    <div class="console-rule"><span>// PLAYLISTS //</span></div>
    <% if playlists.empty? %>
      <%= render "admin/console/empty", text: "NO ZONE PLAYLISTS ON RECORD", hint: "seed data/system/zone_playlists.yml with rails data:zone_playlists" %>
    <% end %>
    <% playlists.each_with_index do |playlist, i| %>
      <% num = numbers[i] %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to playlist.name, admin_zone_playlist_path(playlist), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= playlist.slug %><% if playlist.description.present? %> · <%= truncate(playlist.description, length: 80) %><% end %></div>
        </div>
        <span class="rc-cell rc-cell--r"><%= pluralize(playlist.tracks.size, "track") %></span>
        <span class="rc-cell rc-cell--r"><%= playlist.crossfade_duration_ms %> ms fade</span>
        <span class="rc-cell rc-cell--r"><%= (playlist.default_volume * 100).round %>% vol</span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :streams, except: "PLAYLISTS" %>

  <div class="console-rule"><span>// WHAT THE GRID PLAYS //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:streams, except: "PLAYLISTS", numbers: numbers, noun: "a playlist number") %>
</div>
