<%# /root/zone_playlists/:id — a grid ambient playlist as a read-only
    console readout (2026-10-31; root_console.css): bar ([<] PLAYLISTS),
    the playlist's facts as status rows, // TRACKS // rows in play order
    ([NN] position · title over artist · release), destinations, the >
    prompt. Assigns: @zone_playlist, @tracks. %>
<% playlist = @zone_playlist %>
<% tracks = @tracks.to_a %>
<% positions = playlist.zone_playlist_tracks.index_by(&:track_id) %>
<% content_for :title, "/root/zone_playlists/#{playlist.id} :: #{playlist.name}" %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: playlist.name, sub: "ROOT · ZONE PLAYLIST · /root/zone_playlists/#{playlist.id}"} do %>
    <%= link_to "[<] PLAYLISTS", admin_zone_playlists_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row"><span class="console-key">SLUG</span><span class="console-val"><%= playlist.slug %></span></div>
    <div class="console-status-row"><span class="console-key">DESCRIPTION</span><span class="console-val"><%= playlist.description.presence || "—" %></span></div>
    <div class="console-status-row"><span class="console-key">CROSSFADE</span><span class="console-val"><%= playlist.crossfade_duration_ms %> ms</span></div>
    <div class="console-status-row"><span class="console-key">VOLUME</span><span class="console-val"><%= (playlist.default_volume * 100).round %>%</span></div>
    <div class="console-status-row"><span class="console-key">SOURCE</span><span class="console-val console-dim">data/system/zone_playlists.yml · read-only here</span></div>
  </div>

  <section class="console-section rc-ledger" aria-label="Tracks">
    <div class="console-rule"><span>// TRACKS (<%= tracks.size %>) //</span></div>
    <% if tracks.empty? %>
      <%= render "admin/console/empty", text: "NO TRACKS IN THIS PLAYLIST" %>
    <% end %>
    <% tracks.each do |track| %>
      <div class="rc-row">
        <span class="console-tag">[<%= format("%02d", positions[track.id]&.position.to_i) %>]</span>
        <div class="cc-text">
          <%= link_to track.title, edit_admin_track_path(track), class: "console-link cc-name" %>
          <div class="cc-meta"><%= track.artist.name %><% if track.release %> · <%= track.release.name %><% end %></div>
        </div>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :streams %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:streams) %>
</div>
