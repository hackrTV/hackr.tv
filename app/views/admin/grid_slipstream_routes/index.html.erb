<%# /root/grid_slipstream_routes — the slipstream routes ledger as a
    console screen (2026-10-31; root_console.css): bar, ON RECORD row,
    // SLIPSTREAM // rows ([NN] · name over origin > destination · LEGS ·
    CL · HEAT · RISK · ACTIVE · [HISTORY]), destinations, the > prompt
    (NN opens the record screen, which holds the legs; deletes live
    there). Assigns: @routes. %>
<% content_for :title, "/root/grid_slipstream_routes :: SLIPSTREAM" %>
<% routes = @routes.to_a %>
<% numbers = routes.each_index.map { |i| root_num(i, total: routes.size) } %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "SLIPSTREAM", sub: "ROOT · WORLD · /root/grid_slipstream_routes"} do %>
    <%= link_to "[+] NEW ROUTE", new_admin_grid_slipstream_route_path, class: "console-bar-link", data: {command: "new"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(routes.size, "slipstream route") %> <span class="console-dim">· <%= routes.count(&:active?) %> active</span></span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--slipstream" aria-label="Slipstream routes">
    <div class="console-rule"><span>// SLIPSTREAM //</span></div>
    <% if routes.empty? %>
      <%= render "admin/console/empty", text: "NO SLIPSTREAM ROUTES ON RECORD", hint: "[+] NEW ROUTE links two regions" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span></span><span>ROUTE</span><span class="rc-cell--r">LEGS</span><span class="rc-cell--r">CL</span><span class="rc-cell--r">HEAT</span><span class="rc-cell--r">RISK</span><span></span><span></span>
      </div>
    <% end %>
    <% routes.each_with_index do |route, i| %>
      <% num = numbers[i] %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to route.name, edit_admin_grid_slipstream_route_path(route), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= route.origin_region.name %> &gt; <%= route.destination_region.name %></div>
        </div>
        <span class="rc-cell rc-cell--r"><%= route.grid_slipstream_legs.size %></span>
        <span class="rc-cell rc-cell--r"><%= route.min_clearance %></span>
        <span class="rc-cell rc-cell--r"><%= route.base_heat_cost %></span>
        <span class="rc-cell rc-cell--r"><%= route.detection_risk_base %>%</span>
        <span class="rc-cell <%= route.active? ? "rc-on" : "rc-off" %>"><%= route.active? ? "ACTIVE" : "OFF" %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[HISTORY]", history_admin_grid_slipstream_route_path(route), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :world, except: "SLIPSTREAM" %>

  <div class="console-rule"><span>// EVERY SLIPSTREAM ROUTE ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world, except: "SLIPSTREAM", numbers: numbers, noun: "a route number", extra: ["new"]) %>
</div>
