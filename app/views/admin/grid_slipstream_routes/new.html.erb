<%= render TuiWindowComponent.new(title: "/root/grid/slipstream_routes/new :: NEW SLIPSTREAM ROUTE", variant: :admin, width: 1200) do %>
    <div style="padding: 20px;">
      <% if flash[:error] %>
        <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin: 20px 0;">
          <p class="red-255-text"><%= flash[:error] %></p>
        </div>
      <% end %>
      <%= render "form", route: @route %>
    </div>
<% end %>
