<%= form_with model: [:admin, route], local: true do |f| %>
  <h3 class="cyan-255-text" style="margin: 20px 0 15px 0;">[:: ROUTE INFO ::]</h3>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
    <div>
      <%= f.tui_text_field :name %>
    </div>
    <div>
      <%= f.tui_text_field :slug, hint: "e.g. lakeshore-to-arch" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 15px;">
    <div>
      <%= f.tui_select :origin_region_id, @regions.map { |r| [r.name, r.id] }, { include_blank: "-- Select --" }, label: "ORIGIN REGION" %>
    </div>
    <div>
      <%= f.tui_select :destination_region_id, @regions.map { |r| [r.name, r.id] }, { include_blank: "-- Select --" }, label: "DESTINATION REGION" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 15px;">
    <div>
      <%= f.tui_select :origin_room_id, @rooms.map { |r| ["#{r.name} (#{r.grid_zone.name})", r.id] }, { include_blank: "-- Select --" }, label: "ORIGIN ROOM (boarding point)" %>
    </div>
    <div>
      <%= f.tui_select :destination_room_id, @rooms.map { |r| ["#{r.name} (#{r.grid_zone.name})", r.id] }, { include_blank: "-- Select --" }, label: "DESTINATION ROOM (arrival point)" %>
    </div>
  </div>

  <div style="margin-top: 15px;">
    <%= f.tui_text_area :description, style: "height: 80px;" %>
  </div>

  <h3 class="cyan-255-text" style="margin: 20px 0 15px 0;">[:: RISK CONFIG ::]</h3>

  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 20px;">
    <div>
      <%= f.tui_number_field :min_clearance, min: 0, max: 99 %>
    </div>
    <div>
      <%= f.tui_number_field :base_heat_cost, min: 0, max: 100 %>
    </div>
    <div>
      <%= f.tui_number_field :detection_risk_base, min: 0, max: 100, label: "DETECTION RISK %" %>
    </div>
    <div>
      <%= f.tui_number_field :position, min: 0 %>
    </div>
  </div>

  <div style="margin-top: 15px;">
    <%= f.tui_check_box :active %>
  </div>

  <div style="margin-top: 25px;">
    <%= tui_submit route.new_record? ? "Create Slipstream Route" : "Update Slipstream Route", form: f, color: :green, style: "padding: 8px 20px;" %>
    <%= tui_button "Cancel", admin_grid_slipstream_routes_path, style: "padding: 8px 20px; margin-left: 10px;" %>
  </div>
<% end %>
