<%# The slipstream route's fields as console status rows
    (ConsoleFormBuilder rc_* rows): the route, its two regions and
    boarding / arrival rooms, // DESCRIPTION //, then // RISK // —
    clearance, heat, detection, order, ACTIVE. The commit row belongs to
    the caller. Locals: f; @regions, @rooms. %>
<% region_choices = @regions.map { |r| [r.name, r.id] } %>
<% room_choices = @rooms.map { |r| ["#{r.name} (#{r.grid_zone.name})", r.id] } %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, required: true, autocomplete: "off", pattern: "[a-z0-9\\-]+", title: "lowercase letters, digits, hyphens", hint: "unique · e.g. lakeshore-to-arch" %>
  <%= f.rc_select :origin_region_id, region_choices, {include_blank: "-- Select --"}, label: "FROM REGION" %>
  <%= f.rc_select :origin_room_id, room_choices, {include_blank: "-- Select --"}, label: "BOARDING", hint: "the room a hackr boards from" %>
  <%= f.rc_select :destination_region_id, region_choices, {include_blank: "-- Select --"}, label: "TO REGION" %>
  <%= f.rc_select :destination_room_id, room_choices, {include_blank: "-- Select --"}, label: "ARRIVAL", hint: "the room a hackr arrives in" %>
</div>

<%= f.rc_text_area :description, rows: 3, spellcheck: true %>

<div class="console-rule"><span>// RISK //</span></div>
<div class="console-status">
  <%= f.rc_number_field :min_clearance, label: "CLEARANCE", width: :short, min: 0, max: 99 %>
  <%= f.rc_number_field :base_heat_cost, label: "HEAT", width: :short, min: 0, max: 100 %>
  <%= f.rc_number_field :detection_risk_base, label: "DETECTION", width: :short, min: 0, max: 100, hint: "% base risk" %>
  <%= f.rc_number_field :position, width: :short, min: 0 %>
  <%= f.rc_flags("FLAGS") do %>
    <%= f.rc_check_box :active, label: "ACTIVE" %>
  <% end %>
</div>
