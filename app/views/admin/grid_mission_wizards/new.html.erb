<%# /root/grid_mission_wizard/new — the mission wizard as a console screen
    (2026-11-01; root_console.css .rc-steps / .rc-step): bar, the
    [WARN] draft line (a localStorage draft — [RESTORE] [DISCARD]), the
    step row ([1] ARC … [7] REVIEW; a passed step reopens on click), one
    // STEP N/7 // section at a time (arc · giver · the giver's room,
    skipped unless the giver is new · mission · objectives · rewards ·
    review), the ghost nav ([<] BACK [CANCEL] [>] NEXT / [CREATE
    MISSION]), destinations, the > prompt. Every id and field name is
    the script's (_script, rendered after the screen); the steps toggle
    with `hidden`. A rejected create comes back here with 422 and
    data-rejected on the form (only the create's re-render is a POST)
    — the script restores the submitted state. Assigns: @arcs, @mobs, @rooms, @zones, @factions,
    @missions_for_prereq. %>
<% content_for :title, "/root/grid_mission_wizard/new :: MISSION WIZARD" %>
<% steps = %w[ARC GIVER ROOM MISSION OBJECTIVES REWARDS REVIEW] %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "MISSION WIZARD", sub: "ROOT · SYSTEMS · /root/grid_mission_wizard/new"} do %>
    <%= link_to "[<] MISSIONS", admin_grid_missions_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div id="draft-banner" class="rc-flash rc-flash--warn console-line" hidden>
    <span class="console-tag">[WARN]</span>
    <span>unsaved wizard progress found
      <button type="button" class="rc-btn rc-btn--hot" id="draft-restore">[RESTORE]</button>
      <button type="button" class="rc-btn rc-btn--danger" id="draft-discard">[DISCARD]</button>
    </span>
  </div>

  <nav id="step-indicator" class="rc-steps" aria-label="Wizard steps">
    <% steps.each.with_index(1) do |label, n| %>
      <button type="button" class="step-dot rc-btn rc-step" data-step="<%= n %>">[<%= n %>] <%= label %></button>
    <% end %>
  </nav>

  <%= form_with url: admin_grid_mission_wizard_path, method: :post, id: "wizard-form", local: true, data: {rejected: request.post?} do %>

    <section class="wizard-step" id="step-1">
      <div class="console-rule"><span>// STEP 1/7 · MISSION ARC //</span></div>
      <p class="rc-sub">group this mission under a storyline arc — optional, standalone missions work fine</p>
      <div class="console-status">
        <div class="console-status-row rc-field">
          <span class="console-key">ARC</span>
          <span class="console-val">
            <label class="rc-check"><input type="radio" name="arc_mode" value="none" checked> NO ARC</label>
            <label class="rc-check"><input type="radio" name="arc_mode" value="select"> EXISTING</label>
            <label class="rc-check"><input type="radio" name="arc_mode" value="create"> NEW ARC</label>
          </span>
        </div>
      </div>
      <div id="arc-select-section" class="console-status" hidden>
        <%= render "admin/console/picker", label: "PICK ARC", key: "arc-select", name: "arc_id", value: "", text: nil, placeholder: "type an arc", status: pluralize(@arcs.size, "arc") %>
      </div>
      <div id="arc-create-section" hidden>
        <div class="console-status">
          <div class="console-status-row rc-field">
            <label class="console-key" for="arc-name">NAME</label>
            <span class="console-val"><input type="text" name="new_arc[name]" id="arc-name" class="rc-input rc-input--wide" autocomplete="off"></span>
          </div>
          <div class="console-status-row rc-field">
            <label class="console-key" for="arc-slug">SLUG</label>
            <span class="console-val"><input type="text" name="new_arc[slug]" id="arc-slug" class="rc-input" autocomplete="off"><span class="rc-hint">follows the name until edited</span></span>
          </div>
          <div class="console-status-row rc-field">
            <label class="console-key" for="arc-position">POS</label>
            <span class="console-val"><input type="number" name="new_arc[position]" id="arc-position" class="rc-input rc-input--short" value="<%= (GridMissionArc.maximum(:position) || 0) + 1 %>" min="0"></span>
          </div>
          <div class="console-status-row rc-field">
            <span class="console-key">FLAGS</span>
            <span class="console-val">
              <input type="hidden" name="new_arc[published]" value="0">
              <label class="rc-check"><input type="checkbox" name="new_arc[published]" value="1" checked> PUBLISHED</label>
            </span>
          </div>
        </div>
        <div class="console-rule"><span>// ARC DESCRIPTION //</span></div>
        <textarea name="new_arc[description]" id="arc-description" class="rc-textarea" rows="3" data-controller="autogrow" data-action="input->autogrow#grow"></textarea>
      </div>
    </section>

    <section class="wizard-step" id="step-2" hidden>
      <div class="console-rule"><span>// STEP 2/7 · MISSION GIVER //</span></div>
      <p class="rc-sub">who hands out this mission — an existing NPC, or a new quest_giver mob</p>
      <div class="console-status">
        <div class="console-status-row rc-field">
          <span class="console-key">GIVER</span>
          <span class="console-val">
            <label class="rc-check"><input type="radio" name="mob_mode" value="select" checked> EXISTING</label>
            <label class="rc-check"><input type="radio" name="mob_mode" value="create"> NEW NPC</label>
          </span>
        </div>
      </div>
      <div id="mob-select-section" class="console-status">
        <%= render "admin/console/picker", label: "PICK NPC", key: "mob-select", name: "mob_id", value: "", text: nil, placeholder: "type an NPC or room", status: "quest givers and vendors" %>
      </div>
      <div id="mob-create-section" hidden>
        <div class="console-status">
          <div class="console-status-row rc-field">
            <label class="console-key" for="mob-name">NAME</label>
            <span class="console-val"><input type="text" name="new_mob[name]" id="mob-name" class="rc-input" autocomplete="off" placeholder="e.g. AXIOM"><span class="rc-hint">TYPE becomes quest_giver · step 3 places it</span></span>
          </div>
        </div>
        <div class="console-rule"><span>// NPC DESCRIPTION //</span></div>
        <textarea name="new_mob[description]" id="mob-description" class="rc-textarea" rows="3" data-controller="autogrow" data-action="input->autogrow#grow"></textarea>
      </div>
    </section>

    <section class="wizard-step" id="step-3" hidden>
      <div class="console-rule"><span>// STEP 3/7 · THE NPC'S ROOM //</span></div>
      <p class="rc-sub">where the new NPC lives — an existing room, or a new one</p>
      <div class="console-status">
        <div class="console-status-row rc-field">
          <span class="console-key">ROOM</span>
          <span class="console-val">
            <label class="rc-check"><input type="radio" name="room_mode" value="select" checked> EXISTING</label>
            <label class="rc-check"><input type="radio" name="room_mode" value="create"> NEW ROOM</label>
          </span>
        </div>
      </div>
      <div id="room-select-section" class="console-status">
        <%= render "admin/console/picker", label: "PICK ROOM", key: "room-select", name: "mob_room_id", value: "", text: nil, placeholder: "type a room, zone or region", status: pluralize(@rooms.size, "room") %>
      </div>
      <div id="room-create-section" class="console-status" hidden>
        <div class="console-status-row rc-field">
          <label class="console-key" for="room-name">NAME</label>
          <span class="console-val"><input type="text" name="new_room[name]" id="room-name" class="rc-input rc-input--wide" autocomplete="off"></span>
        </div>
        <div class="console-status-row rc-field">
          <label class="console-key" for="room-slug">SLUG</label>
          <span class="console-val"><input type="text" name="new_room[slug]" id="room-slug" class="rc-input" autocomplete="off"><span class="rc-hint">follows the name until edited</span></span>
        </div>
        <%= render "admin/console/picker", label: "ZONE", key: "zone-select", name: "new_room[grid_zone_id]", value: "", text: nil, placeholder: "type a zone or region", status: pluralize(@zones.size, "zone") %>
        <div class="console-status-row rc-field">
          <label class="console-key" for="room-type">TYPE</label>
          <span class="console-val">
            <select name="new_room[room_type]" id="room-type" class="rc-select">
              <option value="standard" selected>Standard</option>
              <option value="hub">Hub</option>
              <option value="faction_base">Faction Base</option>
              <option value="govcorp">GovCorp</option>
              <option value="special">Special</option>
              <option value="safe_zone">Safe Zone</option>
              <option value="transit">Transit</option>
              <option value="shop">Shop</option>
              <option value="danger_zone">Danger Zone</option>
            </select>
          </span>
        </div>
        <div class="console-status-row rc-field">
          <label class="console-key" for="room-min-cl">CLEARANCE</label>
          <span class="console-val"><input type="number" name="new_room[min_clearance]" id="room-min-cl" class="rc-input rc-input--short" value="0" min="0"></span>
        </div>
      </div>
    </section>

    <section class="wizard-step" id="step-4" hidden>
      <div class="console-rule"><span>// STEP 4/7 · MISSION //</span></div>
      <div class="console-status">
        <div class="console-status-row rc-field">
          <label class="console-key" for="mission-name">NAME</label>
          <span class="console-val"><input type="text" name="mission[name]" id="mission-name" class="rc-input rc-input--wide" autocomplete="off"></span>
        </div>
        <div class="console-status-row rc-field">
          <label class="console-key" for="mission-slug">SLUG</label>
          <span class="console-val"><input type="text" name="mission[slug]" id="mission-slug" class="rc-input" autocomplete="off"><span class="rc-hint">follows the name until edited · unique</span></span>
        </div>
        <div class="console-status-row rc-field">
          <label class="console-key" for="mission-min-cl">CLEARANCE</label>
          <span class="console-val"><input type="number" name="mission[min_clearance]" id="mission-min-cl" class="rc-input rc-input--short" value="0" min="0"></span>
        </div>
        <div class="console-status-row rc-field">
          <label class="console-key" for="mission-position">POS</label>
          <span class="console-val"><input type="number" name="mission[position]" id="mission-position" class="rc-input rc-input--short" value="<%= (GridMission.maximum(:position) || 0) + 1 %>" min="0"></span>
        </div>
        <div class="console-status-row rc-field">
          <span class="console-key">FLAGS</span>
          <span class="console-val">
            <input type="hidden" name="mission[repeatable]" value="0">
            <label class="rc-check"><input type="checkbox" name="mission[repeatable]" id="mission-repeatable" value="1"> REPEATABLE</label>
            <input type="hidden" name="mission[published]" value="0">
            <label class="rc-check"><input type="checkbox" name="mission[published]" id="mission-published" value="1" checked> PUBLISHED</label>
          </span>
        </div>
        <%= render "admin/console/picker", label: "PREREQ", key: "prereq-select", name: "mission[prereq_mission_id]", value: "", text: nil, placeholder: "type a mission (optional)", status: "finished first · optional" %>
        <div class="console-status-row rc-field">
          <label class="console-key" for="mission-rep-faction">REP FACTION</label>
          <span class="console-val">
            <select name="mission[min_rep_faction_id]" id="mission-rep-faction" class="rc-select">
              <option value="">(none)</option>
              <% @factions.each do |faction| %>
                <option value="<%= faction.id %>"><%= faction.name %></option>
              <% end %>
            </select>
          </span>
        </div>
        <div class="console-status-row rc-field">
          <label class="console-key" for="mission-rep-value">REP VALUE</label>
          <span class="console-val"><input type="number" name="mission[min_rep_value]" id="mission-rep-value" class="rc-input rc-input--short" value="0"></span>
        </div>
        <div class="console-status-row rc-field">
          <label class="console-key" for="mission-dialogue-path">DIALOGUE PATH</label>
          <span class="console-val"><input type="text" name="mission[dialogue_path_json]" id="mission-dialogue-path" class="rc-input rc-input--wide" autocomplete="off" spellcheck="false" placeholder='["topic", "subtopic"]'><span class="rc-hint">a JSON array of topic keys · blank = no gate</span></span>
        </div>
      </div>
      <div class="console-rule"><span>// DESCRIPTION //</span></div>
      <textarea name="mission[description]" id="mission-description" class="rc-textarea" rows="3" data-controller="autogrow" data-action="input->autogrow#grow"></textarea>
    </section>

    <section class="wizard-step" id="step-5" hidden>
      <div class="console-rule"><span>// STEP 5/7 · OBJECTIVES //</span></div>
      <p class="rc-sub"><%= GridMission::OBJECTIVE_TYPES.join(" · ") %></p>
      <div class="rc-ledger rc-ledger--mission-objectives">
        <div class="rc-ledger--legend">
          <div class="rc-row"><span class="rc-cell rc-hot">visit_room</span><span class="rc-cell">room slug</span></div>
          <div class="rc-row"><span class="rc-cell rc-hot">talk_npc</span><span class="rc-cell">mob name · any case</span></div>
          <div class="rc-row"><span class="rc-cell rc-hot">collect_item buy_item use_item salvage_item fabricate_item</span><span class="rc-cell">item name</span></div>
          <div class="rc-row"><span class="rc-cell rc-hot">deliver_item</span><span class="rc-cell">item name · the giver receives it</span></div>
          <div class="rc-row"><span class="rc-cell rc-hot">complete_breach</span><span class="rc-cell">breach template slug</span></div>
          <div class="rc-row"><span class="rc-cell rc-hot">reach_rep</span><span class="rc-cell">faction slug</span></div>
        </div>
        <div class="rc-row rc-row--head" aria-hidden="true">
          <span>POS</span><span>TYPE</span><span>LABEL · PLAYER-VISIBLE</span><span>TARGET SLUG</span><span>COUNT</span><span></span>
        </div>
        <div id="objectives-tbody" class="rc-edit-rows"></div>
      </div>
      <div class="rc-actions">
        <button type="button" class="rc-btn" id="add-objective-btn">[+] ADD OBJECTIVE</button>
      </div>
    </section>

    <section class="wizard-step" id="step-6" hidden>
      <div class="console-rule"><span>// STEP 6/7 · REWARDS //</span></div>
      <p class="rc-sub"><%= GridMission::REWARD_TYPES.join(" · ") %> · xp / cred use AMOUNT · item grants use TARGET SLUG (the item definition) + QTY</p>
      <div class="rc-ledger rc-ledger--mission-rewards">
        <div class="rc-row rc-row--head" aria-hidden="true">
          <span>POS</span><span>TYPE</span><span>AMOUNT</span><span>TARGET SLUG</span><span>QTY</span><span></span>
        </div>
        <div id="rewards-tbody" class="rc-edit-rows"></div>
      </div>
      <div class="rc-actions">
        <button type="button" class="rc-btn" id="add-reward-btn">[+] ADD REWARD</button>
      </div>
    </section>

    <section class="wizard-step" id="step-7" hidden>
      <div class="console-rule"><span>// STEP 7/7 · REVIEW AND CREATE //</span></div>
      <div id="review-content" class="console-status"></div>
    </section>

    <div class="console-rule"><span>// STEPS //</span></div>
    <div class="rc-actions">
      <button type="button" class="rc-btn" id="btn-back" hidden>[&lt;] BACK</button>
      <%= link_to "[CANCEL]", admin_grid_missions_path, class: "rc-btn" %>
      <span class="rc-actions--end">
        <button type="button" class="rc-btn rc-btn--hot" id="btn-next">[&gt;] NEXT</button>
        <button type="submit" class="rc-btn rc-btn--hot" id="btn-submit" hidden>[CREATE MISSION]</button>
      </span>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :systems, except: "WIZARD" %>
  <div class="console-rule"><span>// END OF WIZARD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems, except: "WIZARD") %>
</div>
<%= render "script" %>
