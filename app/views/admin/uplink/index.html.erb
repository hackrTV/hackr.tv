<%# /root/uplink — the Uplink's channels and the moderation at a glance as
    a console screen (2026-10-31; root_console.css): bar ([+] NEW
    CHANNEL, [>] UPLINK), ON RECORD, one // <CATEGORY> // rule per
    sidebar group in the order /uplink draws them (UplinkHelper#
    uplink_channel_groups over ChatChannel.ordered), channels numbered
    through ([NN] · name over slug · POS · ACTIVE / OFF · STREAM · SLOW ·
    ROLE · [UP] [DN] swap inside the group, disabled at its edges ·
    [ACTIVATE] / [DEACTIVATE] · [EDIT]), // IN FORCE // the active
    punishments, // RECENT PACKETS // the last 20, // RECENT ACTIVITY //
    the last 10 log entries, destinations, the > prompt (NN opens the
    channel). Assigns: @channels, @active_punishments, @recent_packets,
    @moderation_logs. %>
<% content_for :title, "/root/uplink :: UPLINK" %>
<% channels = @channels.to_a %>
<% groups = uplink_channel_groups(channels) %>
<% numbers = channels.each_index.map { |i| root_num(i, total: channels.size) } %>
<% counter = 0 %>
<% punishments = @active_punishments.to_a %>
<% packets = @recent_packets.to_a %>
<% logs = @moderation_logs.to_a %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "UPLINK", sub: "ROOT · MODERATION · /root/uplink"} do %>
    <%= link_to "[+] NEW CHANNEL", admin_new_uplink_channel_path, class: "console-bar-link", data: {command: "new"} %>
    <%= link_to "[>] UPLINK", uplink_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(channels.size, "channel") %> <span class="console-dim">· <%= channels.count(&:is_active) %> active · <%= pluralize(groups.size, "sidebar group") %> · <%= punishments.size %> in force</span></span>
    </div>
  </div>

  <% if channels.empty? %>
    <div class="console-rule"><span>// CHANNELS //</span></div>
    <%= render "admin/console/empty", text: "NO CHANNELS ON RECORD", hint: "[+] NEW CHANNEL opens the first one" %>
  <% end %>
  <% groups.each do |category, rows| %>
    <section class="console-section rc-ledger rc-ledger--channels" aria-label="<%= category %>">
      <div class="console-rule"><span>// <%= category %> · <%= pluralize(rows.size, "channel").upcase %> //</span></div>
      <% rows.each_with_index do |channel, index| %>
        <% num = numbers[counter] %>
        <% counter += 1 %>
        <div class="rc-row">
          <span class="console-tag">[<%= num %>]</span>
          <div class="cc-text">
            <%= link_to channel.name, admin_edit_uplink_channel_path(slug: channel.slug), class: "console-link cc-name", data: {command: num} %>
            <div class="cc-meta"><%= channel.slug %><% if channel.description.present? %> · <%= truncate(channel.description, length: 60) %><% end %></div>
          </div>
          <span class="rc-cell">#<%= channel.position %></span>
          <span class="rc-cell <%= channel.is_active ? "rc-on" : "rc-bad" %>"><%= channel.is_active ? "ACTIVE" : "OFF" %></span>
          <span class="rc-cell <%= channel.requires_livestream ? "rc-hot" : "rc-off" %>"><%= channel.requires_livestream ? "LIVE ONLY" : "ALWAYS" %></span>
          <span class="rc-cell"><%= (channel.slow_mode_seconds > 0) ? "SLOW #{channel.slow_mode_seconds}s" : "—" %></span>
          <span class="rc-cell"><%= channel.minimum_role.upcase %></span>
          <span class="rc-cell rc-links">
            <%= button_to "[UP]", admin_move_uplink_channel_path(slug: channel.slug, direction: "up"), class: "rc-btn", disabled: index.zero?, title: "Move up within #{category}" %>
            <%= button_to "[DN]", admin_move_uplink_channel_path(slug: channel.slug, direction: "down"), class: "rc-btn", disabled: index == rows.size - 1, title: "Move down within #{category}" %>
            <%= button_to channel.is_active ? "[DEACTIVATE]" : "[ACTIVATE]", admin_toggle_uplink_channel_path(slug: channel.slug), class: class_names("rc-btn", "rc-btn--danger": channel.is_active),
              title: channel.is_active ? "Hide the channel from everyone" : "Open the channel again" %>
            <%= link_to "[EDIT]", admin_edit_uplink_channel_path(slug: channel.slug), class: "console-link" %>
          </span>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--punishments" aria-label="Punishments in force">
    <div class="console-rule"><span>// IN FORCE · <%= pluralize(punishments.size, "punishment").upcase %> //</span></div>
    <% if punishments.empty? %>
      <%= render "admin/console/empty", text: "NO ACTIVE PUNISHMENTS", hint: "[PUNISH] issues a squelch or a blackout" %>
    <% end %>
    <% punishments.each do |punishment| %>
      <%= render "admin/uplink/punishment_row", punishment: punishment %>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--packets" aria-label="Recent packets">
    <div class="console-rule"><span>// RECENT PACKETS //</span></div>
    <% if packets.empty? %>
      <%= render "admin/console/empty", text: "NO PACKETS YET" %>
    <% end %>
    <% packets.each do |packet| %>
      <%= render "admin/uplink/packet_row", packet: packet, truncate: 100 %>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--modlog" aria-label="Recent moderation activity">
    <div class="console-rule"><span>// RECENT ACTIVITY //</span></div>
    <% if logs.empty? %>
      <%= render "admin/console/empty", text: "NO MODERATION ACTIVITY YET" %>
    <% end %>
    <% logs.each do |log| %>
      <%= render "admin/uplink/log_row", log: log %>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :moderation, except: "UPLINK" %>

  <div class="console-rule"><span>// END OF UPLINK //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:moderation, except: "UPLINK", numbers: numbers, noun: "a channel number", extra: ["new"]) %>
</div>
