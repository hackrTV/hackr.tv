<%# A channel's fields as console status rows (ConsoleFormBuilder rc_*
    rows) — new + edit (/root/uplink/channels). The slug is typed on
    create only (it keys /uplink?channel= and the live stream names) and
    shown fixed on edit; the category field offers every group in use
    (datalist). The commit row belongs to the caller. Locals: f, channel,
    categories. %>
<div class="console-rule"><span>// CHANNEL //</span></div>
<div class="console-status">
  <% if channel.new_record? %>
    <%= f.rc_text_field :slug, maxlength: 32, required: true, autocomplete: "off", spellcheck: "false", pattern: "[a-z0-9_\\-]+",
      hint: "lowercase letters, numbers, _ and - · keys /uplink?channel=slug and its live streams · fixed once created" %>
  <% else %>
    <div class="console-status-row">
      <span class="console-key">SLUG</span>
      <span class="console-val"><span class="rc-hot"><%= channel.slug_in_database %></span> <span class="console-dim">· fixed: keys /uplink?channel=<%= channel.slug_in_database %> and its live streams</span></span>
    </div>
  <% end %>
  <%= f.rc_text_field :name, required: true, autocomplete: "off", hint: "the sidebar and the channel header, e.g. #ops" %>
  <%= f.rc_flags("ACCESS", hint: "off hides the channel from everyone · live only opens it during broadcasts") do %>
    <%= f.rc_check_box :is_active, label: "ACTIVE" %>
    <%= f.rc_check_box :requires_livestream, label: "LIVE ONLY" %>
  <% end %>
  <%= f.rc_select :minimum_role, GridHackr::ROLE_LEVELS.keys.map { |role| [role.upcase, role] }, {}, label: "MIN ROLE", hint: "this role or higher can open the channel" %>
  <%= f.rc_number_field :slow_mode_seconds, label: "SLOW MODE", width: :short, min: 0, max: 300, hint: "seconds between a hackr's packets · 0 = off" %>
  <%= f.rc_text_field :category, list: "channel-categories", maxlength: 24, autocomplete: "off", spellcheck: "false",
    hint: "the sidebar heading · pick a group in use or type a new one (upcased) · groups order by their first channel" %>
  <%= f.rc_number_field :position, width: :short, min: 0, hint: "lower sorts first inside the group · [UP] / [DN] on the channel list swap neighbours" %>
</div>
<datalist id="channel-categories">
  <% categories.each do |category| %>
    <option value="<%= category %>"></option>
  <% end %>
</datalist>
<%= f.rc_text_area :description, rows: 3, hint: "the topic line under the channel name" %>
