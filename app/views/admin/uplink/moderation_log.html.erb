<%# /root/uplink/moderation_log — who did what to whom on the Uplink as a
    console ledger (2026-10-31; root_console.css): bar ([<] UPLINK), ON
    RECORD, the // FILTER // rows (server-side: ACTION, ACTOR, TARGET —
    [FILTER] / [x] CLEAR), // LOG // newest first (admin/uplink/_log_row:
    when · @actor · ACTION · @target · reason / packet · duration),
    destinations, the > prompt. Assigns: @logs. %>
<% content_for :title, "/root/uplink/moderation_log :: MODLOG" %>
<% logs = @logs.to_a %>
<% filtered = request.query_parameters.slice("action_type", "actor", "target").values.any?(&:present?) %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "MODERATION LOG", sub: "ROOT · MODERATION · /root/uplink/moderation_log"} do %>
    <%= link_to "[<] UPLINK", admin_uplink_index_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(logs.size, "entry") %><% if filtered %> <span class="console-dim">· filtered</span><% end %></span>
    </div>
  </div>

  <%= form_with url: moderation_log_admin_uplink_index_path, method: :get, local: true do %>
    <div class="console-rule"><span>// FILTER //</span></div>
    <div class="console-status">
      <%= root_field("ACTION", id: "action_type") do %>
        <%= select_tag :action_type, options_for_select(ModerationLog::ACTIONS.map { |a| [a.tr("_", " ").upcase, a] }, params[:action_type]), include_blank: "ALL ACTIONS", class: "rc-select" %>
      <% end %>
      <%= root_field("ACTOR", id: "actor") do %>
        <%= text_field_tag :actor, params[:actor], class: "rc-input", placeholder: "alias", autocomplete: "off", spellcheck: "false" %>
      <% end %>
      <%= root_field("TARGET", id: "target") do %>
        <%= text_field_tag :target, params[:target], class: "rc-input", placeholder: "alias", autocomplete: "off", spellcheck: "false" %>
      <% end %>
    </div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[FILTER]</button>
      <%= link_to "[x] CLEAR", moderation_log_admin_uplink_index_path, class: "rc-btn" %>
    </div>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--modlog" aria-label="Moderation log">
    <div class="console-rule"><span>// LOG //</span></div>
    <% if logs.empty? %>
      <%= render "admin/console/empty", text: filtered ? "NO ENTRIES MATCH" : "NO MODERATION ACTIVITY YET", hint: ("[x] CLEAR shows the whole log" if filtered) %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>WHEN</span><span>ACTOR</span><span>ACTION</span><span>TARGET</span><span>DETAILS</span><span>DURATION</span>
      </div>
    <% end %>
    <% logs.each do |log| %>
      <%= render "admin/uplink/log_row", log: log %>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :moderation, except: "MODLOG" %>

  <div class="console-rule"><span>// END OF LOG //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:moderation, except: "MODLOG") %>
</div>
