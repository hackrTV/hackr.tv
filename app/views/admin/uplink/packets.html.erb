<%# /root/uplink/packets — every packet on the Uplink as a console ledger
    (2026-10-31; root_console.css): bar ([<] UPLINK), ON RECORD, the
    // FILTER // rows (server-side: CHANNEL, STATUS links, HACKR, SEARCH
    — [FILTER] / [x] CLEAR), // PACKETS // newest first (when · #channel
    · content over @alias / DROPPED · [DROP] / [RESTORE] [DEL] —
    admin/uplink/_packet_row), destinations, the > prompt. Assigns:
    @packets. %>
<% content_for :title, "/root/uplink/packets :: PACKETS" %>
<% packets = @packets.to_a %>
<% status = params[:status].to_s.presence_in(%w[active dropped]).to_s %>
<% keep = request.query_parameters.slice("channel", "username", "search") %>
<% filtered = status.present? || keep.values.any?(&:present?) %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "PACKETS", sub: "ROOT · MODERATION · /root/uplink/packets"} do %>
    <%= link_to "[<] UPLINK", admin_uplink_index_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(packets.size, "packet") %><% if filtered %> <span class="console-dim">· filtered</span><% end %> <span class="console-dim">· <%= packets.count(&:dropped) %> dropped</span></span>
    </div>
  </div>

  <%= form_with url: packets_admin_uplink_index_path, method: :get, local: true do %>
    <div class="console-rule"><span>// FILTER //</span></div>
    <div class="console-status">
      <%= root_field("CHANNEL", id: "channel") do %>
        <%= select_tag :channel, options_for_select(ChatChannel.pluck(:name, :slug), params[:channel]), include_blank: "ALL CHANNELS", class: "rc-select" %>
      <% end %>
      <div class="console-status-row rc-field">
        <span class="console-key">STATUS</span>
        <span class="console-val">
          <% [["ALL", ""], ["ACTIVE", "active"], ["DROPPED", "dropped"]].each do |word, value| %>
            <%= link_to word, packets_admin_uplink_index_path(keep.merge(status: value.presence).compact), class: class_names("rc-btn", "rc-btn--on": status == value), aria: {current: status == value && "page"} %>
          <% end %>
        </span>
      </div>
      <%= root_field("HACKR", id: "username") do %>
        <%= text_field_tag :username, params[:username], class: "rc-input", placeholder: "alias", autocomplete: "off", spellcheck: "false" %>
      <% end %>
      <%= root_field("SEARCH", id: "search") do %>
        <%= text_field_tag :search, params[:search], class: "rc-input rc-input--wide", placeholder: "words in the packet", autocomplete: "off" %>
      <% end %>
    </div>
    <% if status.present? %><%= hidden_field_tag :status, status %><% end %>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[FILTER]</button>
      <%= link_to "[x] CLEAR", packets_admin_uplink_index_path, class: "rc-btn" %>
    </div>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--packets" aria-label="Packets">
    <div class="console-rule"><span>// PACKETS //</span></div>
    <% if packets.empty? %>
      <%= render "admin/console/empty", text: filtered ? "NO PACKETS MATCH" : "NO PACKETS YET", hint: ("[x] CLEAR shows every packet" if filtered) %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>SENT</span><span>CHANNEL</span><span>PACKET</span><span></span>
      </div>
    <% end %>
    <% packets.each do |packet| %>
      <%= render "admin/uplink/packet_row", packet: packet, actions: true %>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :moderation, except: "PACKETS" %>

  <div class="console-rule"><span>// END OF PACKETS //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:moderation, except: "PACKETS") %>
</div>
