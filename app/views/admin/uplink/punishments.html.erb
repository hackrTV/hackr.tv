<%# /root/uplink/punishments — squelches and blackouts as a console
    screen (2026-10-31; root_console.css): bar ([<] UPLINK), // ISSUE //
    (HACKR · MINUTES · REASON, then [SQUELCH] posts to the squelch route
    and [BLACKOUT] to the blackout one via formaction — the controller
    looks the hackr up by alias, the :id is a 0 placeholder; each button
    carries its own data-confirm, which the admin layout's handler reads
    from the submitter), ON RECORD +
    the STATUS / TYPE rows (server-side ?status= ?type=, each keeping
    the other), // PUNISHMENTS // newest first (admin/uplink/
    _punishment_row: issued · @alias over reason · TYPE · by · expires ·
    ACTIVE / EXPIRED · [LIFT]), destinations, the > prompt. Assigns:
    @punishments. %>
<% content_for :title, "/root/uplink/punishments :: PUNISH" %>
<% punishments = @punishments.to_a %>
<% status = params[:status].to_s.presence_in(%w[active expired]).to_s %>
<% type = params[:type].to_s.presence_in(UserPunishment::PUNISHMENT_TYPES).to_s %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "PUNISHMENTS", sub: "ROOT · MODERATION · /root/uplink/punishments"} do %>
    <%= link_to "[<] UPLINK", admin_uplink_index_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with url: admin_squelch_uplink_user_path(0), method: :post, local: true, id: "punishment-form" do %>
    <div class="console-rule"><span>// ISSUE //</span></div>
    <div class="console-status">
      <%= root_field("HACKR", id: "punishment-username") do %>
        <%= text_field_tag :username, nil, id: "punishment-username", class: "rc-input", placeholder: "alias", required: true, autocomplete: "off", spellcheck: "false" %>
      <% end %>
      <%= root_field("MINUTES", id: "punishment-duration") do %>
        <%= number_field_tag :duration_minutes, nil, id: "punishment-duration", class: "rc-input rc-input--short", min: 1 %>
        <span class="rc-hint">blank = permanent</span>
      <% end %>
      <%= root_field("REASON", id: "punishment-reason") do %>
        <%= text_field_tag :reason, nil, id: "punishment-reason", class: "rc-input rc-input--wide", placeholder: "optional", autocomplete: "off" %>
      <% end %>
    </div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--danger" data-confirm="Squelch this hackr? They keep reading the Uplink but cannot send.">[SQUELCH]</button>
      <button type="submit" class="rc-btn rc-btn--danger" formaction="<%= admin_blackout_uplink_user_path(0) %>" data-confirm="Black out this hackr? They lose the Uplink entirely.">[BLACKOUT]</button>
      <span class="rc-hint">squelch mutes · blackout bans from the Uplink</span>
    </div>
  <% end %>

  <div class="console-rule"><span>// ON RECORD //</span></div>
  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(punishments.size, "punishment") %> <span class="console-dim">· <%= punishments.count { |p| !p.expired? } %> in force</span></span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">STATUS</span>
      <span class="console-val">
        <% [["ALL", ""], ["ACTIVE", "active"], ["EXPIRED", "expired"]].each do |word, value| %>
          <%= link_to word, punishments_admin_uplink_index_path({status: value.presence, type: type.presence}.compact), class: class_names("rc-btn", "rc-btn--on": status == value), aria: {current: status == value && "page"} %>
        <% end %>
      </span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">TYPE</span>
      <span class="console-val">
        <% [["ALL", ""], ["SQUELCH", "squelch"], ["BLACKOUT", "blackout"]].each do |word, value| %>
          <%= link_to word, punishments_admin_uplink_index_path({status: status.presence, type: value.presence}.compact), class: class_names("rc-btn", "rc-btn--on": type == value), aria: {current: type == value && "page"} %>
        <% end %>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--punishments" aria-label="Punishments">
    <div class="console-rule"><span>// PUNISHMENTS //</span></div>
    <% if punishments.empty? %>
      <%= render "admin/console/empty", text: "NO PUNISHMENTS FOUND" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>ISSUED</span><span>HACKR · REASON</span><span>TYPE</span><span>BY</span><span>EXPIRES</span><span>STATUS</span><span></span>
      </div>
    <% end %>
    <% punishments.each do |punishment| %>
      <%= render "admin/uplink/punishment_row", punishment: punishment %>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :moderation, except: "PUNISH" %>

  <div class="console-rule"><span>// END OF PUNISHMENTS //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:moderation, except: "PUNISH") %>
</div>
