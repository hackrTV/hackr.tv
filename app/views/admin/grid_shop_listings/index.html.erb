<%# /root/grid_shop_listings — every vendor's listings as a console screen
    (2026-11-01; root_console.css): bar ([+] NEW LISTING — for the vendor
    shown, [>] SALES), ON RECORD, the VENDOR row (links, server-side:
    ?mob_id=), the FILTER row (ledger-filter: item / vendor / type /
    rarity), // LISTINGS // rows ([NN] · item over vendor · RARITY · BUY
    · SELL · STOCK · CL · ACTIVE / ROT · [RESTOCK] [HISTORY]),
    destinations, the > prompt (NN opens the record screen; deletes live
    there). Assigns: @listings, @vendors, @vendor. %>
<% content_for :title, "/root/grid_shop_listings :: SHOPS" %>
<% listings = @listings.to_a %>
<% numbers = listings.each_index.map { |i| root_num(i, total: listings.size) } %>
<div class="console console--root" data-controller="terminal ledger-filter" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "SHOPS", sub: "ROOT · SYSTEMS · /root/grid_shop_listings"} do %>
    <%= link_to "[+] NEW LISTING", new_admin_grid_shop_listing_path(grid_mob_id: @vendor&.id), class: "console-bar-link", data: {command: "new"} %>
    <% if @vendor %><%= link_to "[>] VENDOR", edit_admin_grid_mob_path(@vendor), class: "console-bar-link" %><% end %>
    <%= link_to "[>] SALES", admin_grid_shop_transactions_path(mob_id: @vendor&.id), class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(listings.size, "listing") %> <span class="console-dim">· <%= @vendor ? @vendor.name : pluralize(@vendors.size, "vendor") %> · <%= listings.count(&:active?) %> active · <%= listings.count(&:out_of_stock?) %> sold out</span></span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">VENDOR</span>
      <span class="console-val">
        <%= link_to "ALL", admin_grid_shop_listings_path, class: class_names("rc-btn", "rc-btn--on": @vendor.nil?), aria: {current: @vendor.nil? && "page"} %>
        <% @vendors.each do |vendor| %>
          <%= link_to vendor.name.upcase, admin_grid_shop_listings_path(mob_id: vendor.id), class: class_names("rc-btn", "rc-btn--on": @vendor == vendor), aria: {current: @vendor == vendor && "page"} %>
        <% end %>
      </span>
    </div>
    <div class="console-status-row rc-field rc-filter">
      <label class="console-key" for="ledger-filter">FILTER</label>
      <span class="console-val">
        <input type="search" id="ledger-filter" class="rc-input" placeholder="item · vendor · type · rarity" autocomplete="off" spellcheck="false"
          data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
        <span class="rc-count" data-ledger-filter-target="count"><%= listings.size %> / <%= listings.size %></span>
        <button type="button" class="rc-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--shops" aria-label="Shop listings">
    <div class="console-rule"><span>// LISTINGS //</span></div>
    <% if listings.empty? %>
      <%= render "admin/console/empty", text: @vendor ? "NOTHING FOR SALE AT #{@vendor.name.upcase}" : "NO SHOP LISTINGS ON RECORD", hint: "[+] NEW LISTING stocks a vendor" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span></span><span>ITEM</span><span>RARITY</span><span class="rc-cell--r">BUY</span><span class="rc-cell--r">SELL</span><span class="rc-cell--r">STOCK</span><span class="rc-cell--r">CL</span><span>STATE</span><span></span>
      </div>
    <% end %>
    <% listings.each_with_index do |listing, i| %>
      <% num = numbers[i] %>
      <div class="rc-row" data-ledger-filter-target="row" data-search="<%= [listing.name, listing.grid_mob.name, listing.item_type, listing.rarity_label].compact.join(" ").downcase %>">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to listing.name, edit_admin_grid_shop_listing_path(listing), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= listing.grid_mob.name %> · <%= listing.item_type %></div>
        </div>
        <span class="rc-cell"><%= listing.rarity_label || "—" %></span>
        <span class="rc-cell rc-cell--r rc-star"><%= number_with_delimiter(listing.base_price) %></span>
        <span class="rc-cell rc-cell--r"><%= number_with_delimiter(listing.sell_price) %></span>
        <% if listing.unlimited_stock? %>
          <span class="rc-cell rc-cell--r rc-on">INF</span>
        <% else %>
          <span class="rc-cell rc-cell--r <%= "rc-bad" if listing.out_of_stock? %>"><%= listing.stock || 0 %>/<%= listing.max_stock || "INF" %></span>
        <% end %>
        <span class="rc-cell rc-cell--r"><%= listing.min_clearance.positive? ? listing.min_clearance : "—" %></span>
        <span class="rc-cell"><span class="<%= listing.active? ? "rc-on" : "rc-off" %>"><%= listing.active? ? "ACTIVE" : "OFF" %></span><% if listing.rotation_pool? %> · <span class="rc-hot">ROT</span><% end %></span>
        <span class="rc-cell rc-links">
          <% if listing.max_stock.present? %>
            <%= button_to "[RESTOCK]", restock_admin_grid_shop_listing_path(listing), method: :post, class: "rc-btn" %>
          <% end %>
          <%= link_to "[HISTORY]", history_admin_grid_shop_listing_path(listing), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :systems, except: "SHOPS" %>

  <div class="console-rule"><span>// EVERY LISTING ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems, except: "SHOPS", numbers: numbers, noun: "a listing number", extra: ["new"]) %>
</div>
