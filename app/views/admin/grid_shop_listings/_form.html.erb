<%# Flash Messages %>
<% if flash[:error] %>
  <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin: 20px 0;">
    <p class="red-255-text"><%= flash[:error] %></p>
  </div>
<% end %>

<%= form_with model: [:admin, listing], local: true do |f| %>
  <h3 class="cyan-255-text" style="margin: 20px 0 15px 0;">[:: LISTING INFO ::]</h3>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
    <div>
      <%= f.tui_select :grid_mob_id,
          @vendors.map { |v| ["#{v.name} (#{v.grid_room.name})", v.id] },
          {}, label: "VENDOR" %>
    </div>

    <div>
      <%= f.tui_select :grid_item_definition_id,
          @definitions.map { |d| ["#{d.name} [#{d.item_type} / #{d.rarity_label}]", d.id] },
          { include_blank: "Select definition..." }, label: "ITEM DEFINITION" %>
      <% if listing.errors[:grid_item_definition].any? %>
        <br><small class="red-255-text"><%= listing.errors[:grid_item_definition].join(", ") %></small>
      <% end %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 15px;">
    <div>
      <%= f.tui_number_field :min_clearance, style: "width: 200px;", min: 0 %>
    </div>
  </div>

  <h3 class="cyan-255-text" style="margin: 30px 0 15px 0;">[:: PRICING ::]</h3>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
    <div>
      <%= f.tui_number_field :base_price, min: 1, label: "BUY PRICE (CRED)" %>
    </div>

    <div>
      <%= f.tui_number_field :sell_price, min: 0, label: "SELL PRICE (CRED)", hint: "Leave blank for auto (50% of buy price)" %>
    </div>
  </div>

  <h3 class="cyan-255-text" style="margin: 30px 0 15px 0;">[:: STOCK ::]</h3>

  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 20px;">
    <div>
      <%= f.tui_number_field :stock, min: 0, label: "CURRENT STOCK", hint: "Blank = unlimited" %>
    </div>

    <div>
      <%= f.tui_number_field :max_stock, min: 1, hint: "Blank = unlimited" %>
    </div>

    <div>
      <%= f.tui_number_field :restock_amount, min: 1, label: "RESTOCK AMT" %>
    </div>

    <div>
      <%= f.tui_number_field :restock_interval_hours, min: 1, label: "RESTOCK (hrs)" %>
    </div>
  </div>

  <h3 class="cyan-255-text" style="margin: 30px 0 15px 0;">[:: FLAGS ::]</h3>

  <div style="display: flex; gap: 30px;">
    <label class="white-text" style="display: flex; align-items: center; gap: 8px;">
      <%= f.check_box :active, style: "width: auto;" %> Active
    </label>
    <label class="white-text" style="display: flex; align-items: center; gap: 8px;">
      <%= f.check_box :rotation_pool, style: "width: auto;" %> Rotation Pool
    </label>
  </div>

  <div style="margin-top: 30px; display: flex; gap: 10px;">
    <%= tui_submit listing.persisted? ? "Save Listing" : "Create Listing", form: f,
        color: :purple,
        style: "padding: 10px 30px; font-size: 1.1em;" %>
    <%= tui_button "Cancel", admin_grid_shop_listings_path,
        color: :grey,
        style: "padding: 10px 30px; font-size: 1.1em;" %>
    <% if listing.persisted? %>
      <%= tui_button "History", history_admin_grid_shop_listing_path(listing),
          color: :purple,
          style: "padding: 10px 30px; font-size: 1.1em;" %>
    <% end %>
  </div>
<% end %>
