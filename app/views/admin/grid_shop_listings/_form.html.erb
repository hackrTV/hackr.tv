<%# The listing's fields as console status rows (ConsoleFormBuilder rc_*
    rows): the vendor and item, // PRICING //, // STOCK //, the FLAGS row.
    The commit row belongs to the caller. Locals: f; @vendors,
    @definitions for the selects. %>
<div class="console-status">
  <%= f.rc_select :grid_mob_id, @vendors.map { |v| ["#{v.name} (#{v.grid_room&.name || "no room"})", v.id] }, {}, label: "VENDOR" %>
  <%= f.rc_select :grid_item_definition_id, @definitions.map { |d| ["#{d.name} [#{d.item_type} / #{d.rarity_label}]", d.id] }, {include_blank: "Select definition..."}, label: "ITEM" %>
  <%= f.rc_number_field :min_clearance, label: "CLEARANCE", width: :short, min: 0 %>
</div>

<div class="console-rule"><span>// PRICING //</span></div>
<div class="console-status">
  <%= f.rc_number_field :base_price, label: "BUY PRICE", width: :short, min: 1, hint: "CRED" %>
  <%= f.rc_number_field :sell_price, label: "SELL PRICE", width: :short, min: 0, hint: "CRED · blank = auto (50% of buy price)" %>
</div>

<div class="console-rule"><span>// STOCK //</span></div>
<div class="console-status">
  <%= f.rc_number_field :stock, label: "STOCK", width: :short, min: 0, hint: "current · blank = unlimited" %>
  <%= f.rc_number_field :max_stock, label: "MAX STOCK", width: :short, min: 1, hint: "blank = unlimited" %>
  <%= f.rc_number_field :restock_amount, label: "RESTOCK AMT", width: :short, min: 1 %>
  <%= f.rc_number_field :restock_interval_hours, label: "RESTOCK HRS", width: :short, min: 1, hint: "hours between restocks" %>
  <%= f.rc_flags("FLAGS") do %>
    <%= f.rc_check_box :active %>
    <%= f.rc_check_box :rotation_pool, label: "ROTATION POOL" %>
  <% end %>
</div>
