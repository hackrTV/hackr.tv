<%# /root/grid_mission_arcs/new — a new arc on the record screen's shell. %>
<% content_for :title, "/root/grid_mission_arcs/new :: NEW ARC" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "NEW ARC", sub: "ROOT · ARC · /root/grid_mission_arcs/new"} do %>
    <%= link_to "[<] ARCS", admin_grid_mission_arcs_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @arc, url: admin_grid_mission_arcs_path, local: true do |f| %>
    <%= render "form", f: f %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[CREATE ARC]</button>
      <%= link_to "[CANCEL]", admin_grid_mission_arcs_path, class: "rc-btn" %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :systems %>
  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems) %>
</div>
