<%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "padding: 20px;") do %>
  <% if @arc.errors.any? %>
    <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin-bottom: 20px;">
      <p class="red-255-text"><%= @arc.errors.full_messages.join(", ") %></p>
    </div>
  <% end %>

  <div style="margin-bottom: 15px;">
    <%= f.tui_text_field :slug %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.tui_text_field :name %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.tui_text_area :description, style: "min-height: 60px;" %>
  </div>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_number_field :position, min: 0 %>
    </div>

    <div style="flex: 1;">
      <%= f.tui_check_box :published %>
    </div>
  </div>

  <div style="margin-top: 20px;">
    <%= tui_submit @arc.new_record? ? "Create Arc" : "Update Arc", form: f, color: :green, style: "padding: 10px 20px; font-weight: bold;" %>
    <%= tui_button "Cancel", admin_grid_mission_arcs_path, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% if @arc.persisted? %>
      <%= tui_button "History", history_admin_grid_mission_arc_path(@arc), color: :purple, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% end %>
  </div>
<% end %>
