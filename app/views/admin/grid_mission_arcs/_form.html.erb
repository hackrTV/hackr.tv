<%# The arc's fields as console status rows (ConsoleFormBuilder rc_*
    rows), then // DESCRIPTION //. The commit row belongs to the caller.
    Locals: f. %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, required: true, autocomplete: "off", hint: "unique · the record's address" %>
  <%= f.rc_number_field :position, label: "POS", width: :short, min: 0, hint: "the arcs' order" %>
  <%= f.rc_flags("FLAGS") { f.rc_check_box(:published, label: "PUBLISHED") } %>
</div>

<%= f.rc_text_area :description, rows: 3, spellcheck: true %>
