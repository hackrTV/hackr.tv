<%# /root/grid_mission_arcs — the mission arcs ledger as a console screen
    (2026-11-01; root_console.css): bar, ON RECORD row, // ARCS // rows
    ([NN] · name over slug · POS · MISSIONS · LIVE / DRAFT · [HISTORY]),
    destinations, the > prompt (NN opens the record screen; deletes live
    there). Assigns: @arcs. %>
<% content_for :title, "/root/grid_mission_arcs :: ARCS" %>
<% arcs = @arcs.to_a %>
<% numbers = arcs.each_index.map { |i| root_num(i, total: arcs.size) } %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "MISSION ARCS", sub: "ROOT · SYSTEMS · /root/grid_mission_arcs"} do %>
    <%= link_to "[+] NEW ARC", new_admin_grid_mission_arc_path, class: "console-bar-link", data: {command: "new"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(arcs.size, "arc") %> <span class="console-dim">· <%= pluralize(arcs.sum { |a| a.grid_missions.size }, "mission") %> in arcs · <%= arcs.count(&:published?) %> live</span></span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--arcs" aria-label="Mission arcs">
    <div class="console-rule"><span>// ARCS //</span></div>
    <% if arcs.empty? %>
      <%= render "admin/console/empty", text: "NO ARCS ON RECORD", hint: "[+] NEW ARC groups missions into a storyline" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span></span><span>ARC</span><span class="rc-cell--r">POS</span><span class="rc-cell--r">MISSIONS</span><span>STATE</span><span></span>
      </div>
    <% end %>
    <% arcs.each_with_index do |arc, i| %>
      <% num = numbers[i] %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to arc.name, edit_admin_grid_mission_arc_path(arc), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= arc.slug %></div>
        </div>
        <span class="rc-cell rc-cell--r"><%= arc.position %></span>
        <span class="rc-cell rc-cell--r"><%= arc.grid_missions.size %></span>
        <span class="rc-cell <%= arc.published? ? "rc-on" : "rc-off" %>"><%= arc.published? ? "LIVE" : "DRAFT" %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[HISTORY]", history_admin_grid_mission_arc_path(arc), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :systems, except: "ARCS" %>

  <div class="console-rule"><span>// EVERY ARC ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems, except: "ARCS", numbers: numbers, noun: "an arc number", extra: ["new"]) %>
</div>
