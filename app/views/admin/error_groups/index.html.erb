<%# /root/error_groups — the error tracker as a console ledger
    (2026-11-04; root_console.css): bar, ON RECORD, the // FILTER //
    rows (server-side: STATUS / COMPONENT / SEVERITY links keeping each
    other and the search, SEARCH — [FILTER] / [x] CLEAR), // ERROR
    GROUPS // newest seen first, 50 a page (NN opens the group · STATUS
    over "until …" · title · COMPONENT · COUNT · 24H · FIRST · LAST ·
    [RESOLVE] [IGNORE 24H] or [REOPEN]) with the pager, destinations,
    the > prompt. Assigns: @error_groups, @total_count, @offset,
    @per_page, @trends_24h, @status, @component, @severity. %>
<% content_for :title, "/root/error_groups :: ERRORS" %>
<% groups = @error_groups.to_a %>
<% keep = {"status" => @status, "component" => @component, "severity" => @severity, "search" => @search}.compact_blank %>
<% filtered = keep.any? %>
<% numbers = groups.each_index.map { |i| root_num(i) } %>
<% status_tone = {"open" => "rc-bad", "resolved" => "rc-on", "ignored" => "rc-off"} %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "ERRORS", sub: "ROOT · META · /root/error_groups"} do %>
    <%= link_to "[>] ANALYTICS", admin_analytics_dashboard_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(@total_count, "error group") %><% if filtered %> <span class="console-dim">· filtered</span><% end %> <span class="console-dim">· last seen first · <%= @per_page %> a page</span></span>
    </div>
  </div>

  <%= form_with url: admin_error_groups_path, method: :get, local: true do %>
    <div class="console-rule"><span>// FILTER //</span></div>
    <div class="console-status">
      <% {"STATUS" => [:status, @status, ErrorGroup::STATUSES], "COMPONENT" => [:component, @component, ErrorGroup::COMPONENTS], "SEVERITY" => [:severity, @severity, ErrorGroup::SEVERITIES]}.each do |label, (key, current, values)| %>
        <div class="console-status-row rc-field">
          <span class="console-key"><%= label %></span>
          <span class="console-val">
            <% [["ALL", ""]].concat(values.map { |v| [v.upcase, v] }).each do |word, value| %>
              <%= link_to word, admin_error_groups_path(keep.merge(key.to_s => value.presence).compact), class: class_names("rc-btn", "rc-btn--on": current == value), aria: {current: current == value && "page"} %>
            <% end %>
          </span>
        </div>
      <% end %>
      <%= root_field("SEARCH", id: "search") do %>
        <%= text_field_tag :search, @search, class: "rc-input rc-input--wide", placeholder: "words in the title", autocomplete: "off" %>
      <% end %>
    </div>
    <% keep.except("search").each do |key, value| %><%= hidden_field_tag key, value %><% end %>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[FILTER]</button>
      <%= link_to "[x] CLEAR", admin_error_groups_path, class: "rc-btn" %>
    </div>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--errors" aria-label="Error groups">
    <div class="console-rule"><span>// ERROR GROUPS //</span></div>
    <% if groups.empty? %>
      <%= render "admin/console/empty", text: filtered ? "NO ERROR GROUPS MATCH" : "NO ERRORS ON RECORD", hint: ("[x] CLEAR shows every group" if filtered) %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span></span><span>STATUS</span><span>TITLE</span><span>COMPONENT</span><span class="rc-cell--r">COUNT</span><span class="rc-cell--r">24H</span><span>FIRST SEEN</span><span>LAST SEEN</span><span></span>
      </div>
    <% end %>
    <% groups.each_with_index do |group, i| %>
      <% eff_status = group.effective_status %>
      <% trend = @trends_24h[group.id] || 0 %>
      <div class="rc-row">
        <span class="console-tag">[<%= numbers[i] %>]</span>
        <div class="cc-text">
          <span class="rc-cell <%= status_tone[eff_status] %>"><%= eff_status.upcase %></span>
          <% if group.status == "ignored" && group.ignore_until %><div class="cc-meta">until <%= group.ignore_until.strftime("%m-%d %H:%M") %></div><% end %>
        </div>
        <%= link_to group.title, admin_error_group_path(group), class: "console-link cc-name", title: group.title, data: {command: numbers[i]} %>
        <span class="rc-cell <%= (group.component == "backend") ? "rc-violet" : "rc-star" %>"><%= group.component.upcase %></span>
        <span class="rc-cell rc-cell--r"><%= group.occurrence_count %></span>
        <span class="rc-cell rc-cell--r <%= (trend > 0) ? "rc-bad" : "rc-off" %>"><%= trend %></span>
        <span class="rc-cell"><%= group.first_seen_at&.strftime("%Y-%m-%d %H:%M") || "—" %></span>
        <span class="rc-cell"><%= group.last_seen_at&.strftime("%Y-%m-%d %H:%M") || "—" %></span>
        <span class="rc-cell rc-links">
          <% if eff_status == "open" %>
            <%= button_to "[RESOLVE]", resolve_admin_error_group_path(group), method: :post, class: "rc-btn rc-btn--hot" %>
            <%= button_to "[IGNORE 24H]", ignore_admin_error_group_path(group, duration: "24h"), method: :post, class: "rc-btn" %>
          <% else %>
            <%= button_to "[REOPEN]", reopen_admin_error_group_path(group), method: :post, class: "rc-btn rc-btn--danger" %>
          <% end %>
        </span>
      </div>
    <% end %>
    <%= root_pager(@offset, @per_page, @total_count) %>
  </section>

  <%= render "admin/console/destinations", section: :meta, except: "ERRORS" %>

  <div class="console-rule"><span>// LAST SEEN FIRST //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:meta, except: "ERRORS", numbers: numbers, noun: "a group number") %>
</div>
