<%# /root/error_groups/:id — one error group as a console readout
    (2026-11-04; root_console.css): bar (the title · ERROR #id · [<]
    ERRORS), status rows (STATUS over "until …", COMPONENT, SEVERITY,
    OCCURRENCES, FIRST / LAST SEEN, FINGERPRINT, RESOLVED BY), //
    ACTIONS // ([RESOLVE] [IGNORE 1H / 24H / 7D / FOREVER] while open,
    [REOPEN] otherwise — each lands back here), // OCCURRENCES // newest
    first, 50 a page (time · @alias · ip · METHOD url over the exception
    and message, BACKTRACE / METADATA / PARAMS folded under details)
    with the pager, destinations, the > prompt. Assigns: @error_group,
    @occurrences, @total_occurrences, @offset, @per_page. %>
<% content_for :title, "/root/error_groups/#{@error_group.id} :: ERROR" %>
<% eff_status = @error_group.effective_status %>
<% status_tone = {"open" => "rc-bad", "resolved" => "rc-on", "ignored" => "rc-off"} %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: @error_group.title.truncate(72), sub: "ERROR ##{@error_group.id} · ROOT · META"} do %>
    <%= link_to "[<] ERRORS", admin_error_groups_path, class: "console-bar-link", data: {command: "back"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">STATUS</span>
      <span class="console-val"><span class="<%= status_tone[eff_status] %>"><%= eff_status.upcase %></span><% if @error_group.status == "ignored" && @error_group.ignore_until %> <span class="console-dim">· until <%= @error_group.ignore_until.strftime("%Y-%m-%d %H:%M") %></span><% end %></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">COMPONENT</span>
      <span class="console-val <%= (@error_group.component == "backend") ? "rc-violet" : "rc-star" %>"><%= @error_group.component.upcase %></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">SEVERITY</span>
      <span class="console-val"><%= @error_group.severity.upcase %></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">OCCURRENCES</span>
      <span class="console-val"><%= @error_group.occurrence_count %> <span class="console-dim">· lifetime</span></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">FIRST SEEN</span>
      <span class="console-val"><%= @error_group.first_seen_at&.strftime("%Y-%m-%d %H:%M:%S") || "—" %></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">LAST SEEN</span>
      <span class="console-val"><%= @error_group.last_seen_at&.strftime("%Y-%m-%d %H:%M:%S") || "—" %></span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">TITLE</span>
      <span class="console-val rc-cell--any"><%= @error_group.title %></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">FINGERPRINT</span>
      <span class="console-val console-dim"><%= @error_group.fingerprint %></span>
    </div>
    <% if @error_group.resolved_by_hackr %>
      <div class="console-status-row">
        <span class="console-key">RESOLVED BY</span>
        <span class="console-val"><span class="rc-on"><%= @error_group.resolved_by_hackr.hackr_alias %></span> <span class="console-dim">· <%= @error_group.resolved_at&.strftime("%Y-%m-%d %H:%M") %></span></span>
      </div>
    <% end %>
  </div>

  <div class="console-rule"><span>// ACTIONS //</span></div>
  <div class="rc-actions">
    <% if eff_status == "open" %>
      <%= button_to "[RESOLVE]", resolve_admin_error_group_path(@error_group), method: :post, class: "rc-btn rc-btn--hot" %>
      <% {"1h" => "1H", "24h" => "24H", "7d" => "7D", "forever" => "FOREVER"}.each do |duration, word| %>
        <%= button_to "[IGNORE #{word}]", ignore_admin_error_group_path(@error_group, duration: duration), method: :post, class: "rc-btn" %>
      <% end %>
    <% else %>
      <%= button_to "[REOPEN]", reopen_admin_error_group_path(@error_group), method: :post, class: "rc-btn rc-btn--danger" %>
    <% end %>
  </div>

  <section class="console-section" aria-label="Occurrences">
    <div class="console-rule"><span>// OCCURRENCES · <%= @total_occurrences %> //</span></div>
    <% if @occurrences.empty? %>
      <%= render "admin/console/empty", text: "NO OCCURRENCES ON RECORD", hint: "the retention purge keeps the count, not the rows" %>
    <% end %>
    <% @occurrences.each do |occ| %>
      <div class="rc-occ">
        <div class="rc-occ-head">
          <span class="console-tag"><%= occ.occurred_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
          <% if occ.hackr_alias.present? %><span class="rc-violet">@<%= occ.hackr_alias %></span><% end %>
          <span><%= occ.ip_address || "—" %></span>
          <span class="rc-cell--wrap"><%= occ.request_method %> <%= occ.request_url %></span>
        </div>
        <div class="rc-occ-line">
          <% if occ.exception_class.present? %><span class="rc-bad"><%= occ.exception_class %></span>: <% end %><%= occ.message %>
        </div>
        <% {"BACKTRACE" => occ.parsed_backtrace, "METADATA" => occ.parsed_metadata, "PARAMS" => occ.parsed_request_params}.each do |word, data| %>
          <% next if data.empty? %>
          <details class="rc-details">
            <summary><%= word %><% if data.is_a?(Array) %> <span class="console-dim">· <%= pluralize(data.size, "frame") %></span><% end %></summary>
            <pre class="rc-pre"><%= data.is_a?(Array) ? data.join("\n") : JSON.pretty_generate(data) %></pre>
          </details>
        <% end %>
      </div>
    <% end %>
    <%= root_pager(@offset, @per_page, @total_occurrences) %>
  </section>

  <%= render "admin/console/destinations", section: :meta, except: "ERRORS" %>

  <div class="console-rule"><span>// NEWEST FIRST //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:meta, except: "ERRORS", extra: ["back"]) %>
</div>
