<%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "padding: 20px;") do %>
  <% if @scene.errors.any? %>
    <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin-bottom: 20px;">
      <p class="red-255-text"><%= @scene.errors.full_messages.join(", ") %></p>
    </div>
  <% end %>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_text_field :name %>
    </div>
    <div style="flex: 1;">
      <%= f.tui_text_field :slug, hint: "Leave blank to auto-generate from name" %>
    </div>
  </div>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_select :scene_type, OverlayScene::SCENE_TYPES.map { |t| [t.titleize, t] }, {} %>
    </div>
    <div style="flex: 1;">
      <%= f.tui_number_field :position, label: "POSITION (sort order)" %>
    </div>
    <div style="flex: 1;">
      <%= f.tui_check_box :active %>
    </div>
  </div>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_number_field :width, min: 1, label: "WIDTH (px)" %>
    </div>
    <div style="flex: 1;">
      <%= f.tui_number_field :height, min: 1, label: "HEIGHT (px)" %>
    </div>
  </div>

  <div style="margin-bottom: 15px;">
    <label class="white-text" style="display: block; margin-bottom: 5px; font-weight: bold;">SETTINGS (JSON)</label>
    <% settings_json = @scene.settings.present? ? JSON.pretty_generate(@scene.settings) : "{}" %>
    <textarea name="overlay_scene[settings_json]" class="tui-input" style="width: 100%; padding: 8px; font-family: monospace; min-height: 120px;"><%= settings_json %></textarea>
  </div>

  <div style="margin-top: 20px;">
    <%= tui_submit @scene.new_record? ? "Create Scene" : "Update Scene", form: f, color: :green, style: "padding: 10px 20px; font-weight: bold;" %>
    <%= tui_button "Cancel", admin_overlay_scenes_path, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% if @scene.persisted? %>
      <%= tui_button "History", history_admin_overlay_scene_path(@scene), color: :purple, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% end %>
  </div>
<% end %>
