<%# The schematic's fields as console status rows (ConsoleFormBuilder rc_*
    rows), // DESCRIPTION //, // GATES // (optional mission / achievement
    slugs, resolved at runtime, and the room a fabrication needs) and
    // INGREDIENTS // — one row per ingredient (POS · INPUT · QTY · [x];
    a saved row's [x] sets its _destroy flag and hides it, a new row's
    removes it; a row already flagged comes back hidden on a rejected
    save) and [+] ADD INGREDIENT, both driven by
    grid_schematics/_script (the #ingredients-table /
    #add-ingredient-btn / #ingredient-row-template ids). The commit row
    belongs to the caller. Locals: f, schematic; @all_definitions,
    @sorted_ingredients (edit: the saved ingredients + one blank). %>
<% item_options = @all_definitions.map { |d| ["#{d.name} [#{d.rarity_label}]", d.id] } %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, required: true, autocomplete: "off", hint: "lowercase letters, numbers, hyphens only" %>
  <%= f.rc_select :output_definition_id, item_options, {include_blank: "Select..."}, label: "OUTPUT" %>
  <%= f.rc_number_field :output_quantity, label: "OUTPUT QTY", width: :short, min: 1 %>
  <%= f.rc_number_field :xp_reward, label: "XP", width: :short, min: 0 %>
  <%= f.rc_number_field :required_clearance, label: "CLEARANCE", width: :short, min: 0, max: 99 %>
  <%= f.rc_number_field :position, width: :short, min: 0 %>
  <%= f.rc_flags("FLAGS", hint: "drafts stay off the fabricator") { f.rc_check_box(:published) } %>
</div>

<%= f.rc_text_area :description, rows: 3, spellcheck: true %>

<div class="console-rule"><span>// GATES //</span></div>
<p class="rc-sub">Leave blank for no gate. Slugs are resolved at runtime.</p>
<div class="console-status">
  <%= f.rc_text_field :required_mission_slug, label: "MISSION", autocomplete: "off", placeholder: "e.g. signal-recovery" %>
  <%= f.rc_text_field :required_achievement_slug, label: "ACHIEVEMENT", autocomplete: "off", placeholder: "e.g. first-salvage" %>
  <%= f.rc_select :required_room_type, [["Den (own)", "den"]], {include_blank: "None (craft anywhere)"}, label: "ROOM TYPE", hint: "location required to fabricate" %>
</div>

<section id="ingredients-table" class="console-section rc-ledger rc-ledger--parts" aria-label="Ingredients">
  <div class="console-rule"><span>// INGREDIENTS //</span></div>
  <p class="rc-sub">Items consumed when this schematic is fabricated.</p>
  <div class="rc-row rc-row--head" aria-hidden="true">
    <span>POS</span><span>INPUT ITEM</span><span class="rc-cell--r">QTY</span><span></span>
  </div>
  <%= f.fields_for :ingredients, @sorted_ingredients || schematic.ingredients do |ff| %>
    <%= tag.div class: "rc-row", hidden: ff.object.marked_for_destruction? do %>
      <span><%= ff.number_field :position, class: "rc-input", min: 0, aria: {label: "Position"} %></span>
      <span><%= ff.select :input_definition_id, item_options, {include_blank: "— select input —"}, class: "rc-select", aria: {label: "Input item"} %></span>
      <span><%= ff.number_field :quantity, class: "rc-input rc-input--r", min: 1, aria: {label: "Quantity"} %></span>
      <span class="rc-links">
        <% if ff.object.persisted? %>
          <%= ff.hidden_field :id %>
          <%= ff.hidden_field :_destroy, value: ff.object.marked_for_destruction? ? "1" : "0", class: "destroy-flag" %>
          <button type="button" class="rc-btn rc-btn--danger ingredient-destroy-btn" data-persisted="true" aria-label="Remove ingredient">[x]</button>
        <% else %>
          <button type="button" class="rc-btn rc-btn--danger ingredient-destroy-btn" aria-label="Remove ingredient">[x]</button>
        <% end %>
      </span>
    <% end %>
  <% end %>
</section>
<div class="rc-actions">
  <button type="button" id="add-ingredient-btn" class="rc-btn">[+] ADD INGREDIENT</button>
  <%= f.rc_errors(:ingredients) %>
</div>
