<%# The mob record's fields on the console: the avatar column (art +
    [^] REPLACE / UPLOAD inside this form, [x] REMOVE pointing at the
    caller's hidden purge form — a button_to can't nest) beside the
    status rows (ConsoleFormBuilder rc_* rows; ROOM is a typed picker —
    admin/console/_picker), // DESCRIPTION //, then the two editors the
    script after the screen drives (_script): // DIALOGUE TREE //
    (greeting + nested topics, or the raw JSON) and // VENDOR CONFIG //
    (shop type, restock, rotation, or the raw JSON). Both serialize into
    the hidden *_json fields on submit; the ids are the script's. The
    commit row belongs to the caller. Locals: f, mob; @rooms, @factions. %>
<% avatar = mob.avatar.attached? && mob.avatar.blob.persisted? %>
<% room = mob.grid_room %>
<div class="cc-head">
  <div class="rc-art-stack">
    <div class="cc-art">
      <% if avatar %>
        <%= image_tag mob.avatar_panel, alt: mob.name_in_database.to_s, class: "cc-art-img" %>
      <% else %>
        <div class="cc-art-none rc-art-none--text">NO AVATAR</div>
      <% end %>
    </div>
    <span class="rc-pick" data-controller="file-pick">
      <%= f.file_field :avatar, accept: "image/jpeg,image/png,image/webp", class: "rc-pick-input",
        data: {file_pick_target: "input", action: "change->file-pick#changed"} %>
      <button type="button" class="rc-btn" data-action="file-pick#open">[^] <%= avatar ? "REPLACE" : "UPLOAD" %> AVATAR</button>
      <span class="rc-hint" data-file-pick-target="name">no file chosen</span>
    </span>
    <% if avatar && mob.persisted? %>
      <span><button type="submit" form="purge-avatar" class="rc-btn rc-btn--danger">[x] REMOVE AVATAR</button></span>
    <% end %>
    <span class="rc-hint">square · JPEG · PNG · WEBP</span>
  </div>

  <div class="console-status">
    <%= f.rc_text_field :name, required: true, autocomplete: "off" %>
    <%= f.rc_select :mob_type, [["Quest Giver", "quest_giver"], ["Vendor", "vendor"], ["Lore", "lore"], ["Special", "special"]],
      {include_blank: "(none)"}, label: "TYPE", hint: "VENDOR opens the shop listings" %>
    <%= render "admin/console/picker", label: "ROOM", key: "room-cb", name: "grid_mob[grid_room_id]", value: mob.grid_room_id,
      text: room && "#{room.grid_zone&.name} / #{room.name}", placeholder: "type a room or zone", status: pluralize(@rooms.length, "room"),
      errors: f.rc_errors(:grid_room_id) %>
    <%= f.rc_collection_select :grid_faction_id, @factions, :id, :name, {include_blank: "(none)"}, label: "FACTION" %>
  </div>
</div>

<%= f.rc_text_area :description, rows: 3, spellcheck: true %>

<div class="console-rule"><span>// DIALOGUE TREE //</span></div>
<input type="hidden" name="grid_mob[dialogue_tree_json]" id="dialogue-tree-hidden" value="<%= (mob.dialogue_tree || {}).to_json %>">
<div class="rc-actions">
  <button type="button" class="rc-btn rc-btn--on" id="dialogue-mode-structured">[STRUCTURED]</button>
  <button type="button" class="rc-btn" id="dialogue-mode-raw">[RAW JSON]</button>
</div>
<div id="dialogue-structured" class="rc-editor">
  <label class="rc-editor-key" for="dialogue-greeting">GREETING</label>
  <textarea id="dialogue-greeting" class="rc-textarea" rows="2"></textarea>
  <span class="rc-editor-key">TOPICS</span>
  <div id="dialogue-topics-root"></div>
  <div class="rc-actions">
    <button type="button" class="rc-btn" id="dialogue-add-root-topic">[+] ADD TOPIC</button>
  </div>
</div>
<div id="dialogue-raw" class="rc-editor" hidden>
  <textarea id="dialogue-raw-textarea" class="rc-textarea rc-textarea--code" rows="10" spellcheck="false" aria-label="Dialogue tree JSON"></textarea>
  <p id="dialogue-raw-error" class="rc-sub rc-bad" hidden></p>
</div>

<div class="console-rule"><span>// VENDOR CONFIG //</span></div>
<input type="hidden" name="grid_mob[vendor_config_json]" id="vendor-config-hidden" value="<%= (mob.vendor_config || {}).to_json %>">
<div class="rc-actions">
  <button type="button" class="rc-btn rc-btn--on" id="vendor-mode-structured">[STRUCTURED]</button>
  <button type="button" class="rc-btn" id="vendor-mode-raw">[RAW JSON]</button>
</div>
<div id="vendor-structured" class="console-status">
  <div class="console-status-row rc-field">
    <label class="console-key" for="vendor-shop-type">SHOP TYPE</label>
    <span class="console-val">
      <select id="vendor-shop-type" class="rc-select">
        <option value="standard">Standard</option>
        <option value="black_market">Black Market</option>
      </select>
    </span>
  </div>
  <div class="console-status-row rc-field">
    <label class="console-key" for="vendor-restock-hours">RESTOCK</label>
    <span class="console-val"><input type="number" id="vendor-restock-hours" class="rc-input rc-input--short" min="1" value="24"><span class="rc-hint">hours</span></span>
  </div>
  <div class="console-status-row rc-field" id="vendor-rotation-wrap" hidden>
    <label class="console-key" for="vendor-rotation-count">ROTATION</label>
    <span class="console-val"><input type="number" id="vendor-rotation-count" class="rc-input rc-input--short" min="1" value="3"><span class="rc-hint">active items per rotation cycle</span></span>
  </div>
</div>
<div id="vendor-raw" class="rc-editor" hidden>
  <textarea id="vendor-raw-textarea" class="rc-textarea rc-textarea--code" rows="6" spellcheck="false" aria-label="Vendor config JSON"></textarea>
  <p id="vendor-raw-error" class="rc-sub rc-bad" hidden></p>
</div>
