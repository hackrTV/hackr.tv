<%# /root/grid_mobs — the mobs ledger as a console screen (2026-10-31;
    root_console.css): bar, ON RECORD row, the FILTER row (ledger-filter:
    name / type / room / zone / faction — replaces the old filter
    script), // MOBS // rows ([NN] · name over room / zone · TYPE ·
    FACTION · [TEST] (dev tools) [HISTORY]), destinations, the > prompt
    (NN opens the record screen; deletes live there). Assigns: @mobs. %>
<% content_for :title, "/root/grid_mobs :: MOBS" %>
<% mobs = @mobs.to_a %>
<% numbers = mobs.each_index.map { |i| root_num(i, total: mobs.size) } %>
<div class="console console--root" data-controller="terminal ledger-filter" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "MOBS", sub: "ROOT · WORLD · /root/grid_mobs"} do %>
    <%= link_to "[+] NEW MOB", new_admin_grid_mob_path, class: "console-bar-link", data: {command: "new"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(mobs.size, "mob") %> <span class="console-dim">· <%= mobs.count(&:vendor?) %> vendors</span></span>
    </div>
    <div class="console-status-row rc-field rc-filter">
      <label class="console-key" for="ledger-filter">FILTER</label>
      <span class="console-val">
        <input type="search" id="ledger-filter" class="rc-input" placeholder="name · type · room · zone · faction" autocomplete="off" spellcheck="false"
          data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
        <span class="rc-count" data-ledger-filter-target="count"><%= mobs.size %> / <%= mobs.size %></span>
        <button type="button" class="rc-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--mobs" aria-label="Mobs">
    <div class="console-rule"><span>// MOBS //</span></div>
    <% if mobs.empty? %>
      <%= render "admin/console/empty", text: "NO MOBS ON RECORD", hint: "[+] NEW MOB puts one in a room" %>
    <% end %>
    <% mobs.each_with_index do |mob, i| %>
      <% num = numbers[i] %>
      <% room = mob.grid_room %>
      <div class="rc-row" data-ledger-filter-target="row" data-search="<%= [mob.name, mob.mob_type, room&.name, room&.grid_zone&.name, mob.grid_faction&.name].compact.join(" ").downcase %>">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to mob.name, edit_admin_grid_mob_path(mob), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= room ? "#{room.grid_zone&.name} / #{room.name}" : "—" %></div>
        </div>
        <span class="rc-cell <%= mob.vendor? ? "rc-star" : "rc-hot" %>"><%= mob.mob_type&.upcase || "—" %></span>
        <span class="rc-cell"><%= mob.grid_faction&.name || "—" %></span>
        <span class="rc-cell rc-links">
          <% if dev_tools_enabled? %>
            <%= link_to "[TEST]", new_admin_grid_npc_dialogue_tester_path(mob_id: mob.id), class: "console-link" %>
          <% end %>
          <%= link_to "[HISTORY]", history_admin_grid_mob_path(mob), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :world, except: "MOBS" %>

  <div class="console-rule"><span>// EVERY MOB ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world, except: "MOBS", numbers: numbers, noun: "a mob number", extra: ["new"]) %>
</div>
