<%= render TuiWindowComponent.new(title: "/root/tracks/new :: NEW TRACK", variant: :admin, width: 1200) do %>

    <div style="padding: 20px;">
      <div style="margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap;">
        <%= tui_button "← All Tracks", admin_tracks_path, color: :green, style: "padding: 8px 20px;" %>
      </div>

      <%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "padding: 20px;") do %>
        <% if @track.errors.any? %>
          <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin-bottom: 20px;">
            <p class="red-255-text"><%= @track.errors.full_messages.join(", ") %></p>
          </div>
        <% end %>

        <%= form_with model: [:admin, @track], local: true do |f| %>
          <div style="display: flex; gap: 20px; margin-bottom: 15px;">
            <div style="flex: 1;">
              <%= f.tui_text_field :title %>
            </div>
            <div style="flex: 1;">
              <%= f.tui_text_field :slug %>
            </div>
          </div>

          <div style="margin-bottom: 15px;">
            <%= f.tui_select :release_id, options_for_select(@releases.map { |r| ["#{r.artist.name} — #{r.name}", r.id] }, @track.release_id), {include_blank: "(select release)"}, label: "RELEASE", hint: "Artist is derived from the release." %>
          </div>

          <div style="display: flex; gap: 20px; margin-bottom: 15px;">
            <div style="flex: 1;">
              <%= f.tui_number_field :track_number, min: 1, label: "TRACK #" %>
            </div>
            <div style="flex: 1;">
              <%= f.tui_text_field :duration, placeholder: "3:45" %>
            </div>
          </div>

          <div style="display: flex; gap: 20px; margin-bottom: 15px;">
            <div style="flex: 1;">
              <%= f.tui_check_box :featured %>
            </div>
            <div style="flex: 1;">
              <%= f.tui_check_box :show_in_pulse_vault %>
            </div>
          </div>

          <div style="margin-top: 20px;">
            <%= tui_submit "Create Track", form: f, color: :green, style: "padding: 10px 20px; font-weight: bold;" %>
            <%= tui_button "Cancel", admin_tracks_path, style: "padding: 10px 20px; margin-left: 10px;" %>
          </div>
        <% end %>
      <% end %>
    </div>
<% end %>
