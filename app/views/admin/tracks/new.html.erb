<%# /root/tracks/new — a new track on the record screen's shell;
    ?release_id prefills the RELEASE select and the next track number
    (a release screen's [+] ADD TRACK). Assigns: @track, @releases. %>
<% content_for :title, "/root/tracks/new :: NEW TRACK" %>
<% release = @track.release %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "NEW TRACK", sub: [("#{release.artist.name} · #{release.name}" if release), "/root/tracks/new"].compact.join(" · ")} do %>
    <% if release&.persisted? %><%= link_to "[<] #{release.name.upcase}", edit_admin_release_path(release), class: "console-bar-link" %><% end %>
    <%= link_to "[<] TRACKS", admin_tracks_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @track, url: admin_tracks_path, local: true do |f| %>
    <%= render "form", f: f, track: @track %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[CREATE TRACK]</button>
      <%= link_to "[CANCEL]", (release&.persisted? ? edit_admin_release_path(release) : admin_tracks_path), class: "rc-btn" %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :music %>
  <div class="console-rule"><span>// END OF TRANSMISSION //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:music) %>
</div>
