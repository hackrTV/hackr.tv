<%# /root/tracks — the tracks ledger as a console screen (2026-10-30;
    console.css family + root_console.css): bar, ON RECORD row, the FILTER
    row (ledger-filter controller: title / slug / artist / release, a
    release group hides when none of its rows match), one
    // <ARTIST> · <RELEASE> (TYPE) // rule per release with its tracks as
    rows ([NN] · cover · title over slug · TRACK NN · date · AUDIO · ★ ·
    VAULT · time · [HISTORY]), destinations, the > prompt (NN opens the
    record screen). Assigns: @tracks, @groups, @with_audio, @in_vault,
    @featured. %>
<% content_for :title, "/root/tracks :: TRACKS" %>
<% numbers = @tracks.to_a.each_index.map { |i| root_num(i) } %>
<% counter = 0 %>
<div class="console console--root" data-controller="terminal ledger-filter" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "TRACKS", sub: "ROOT · MUSIC · /root/tracks"} do %>
    <%= link_to "[+] NEW TRACK", new_admin_track_path, class: "console-bar-link", data: {command: "new"} %>
    <%= link_to "[>] VAULT", "/vault", class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(@tracks.size, "track") %> <span class="console-dim">· <%= @with_audio %> with audio · <%= @in_vault %> in the vault · <%= @featured %> featured · <%= pluralize(@groups.size, "release") %></span></span>
    </div>
    <div class="console-status-row rc-field rc-filter">
      <label class="console-key" for="ledger-filter">FILTER</label>
      <span class="console-val">
        <input type="search" id="ledger-filter" class="rc-input" placeholder="title · slug · artist · release" autocomplete="off" spellcheck="false"
          data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
        <span class="rc-count" data-ledger-filter-target="count"><%= @tracks.size %> / <%= @tracks.size %></span>
        <button type="button" class="rc-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
      </span>
    </div>
  </div>

  <% if @tracks.empty? %>
    <div class="console-rule"><span>// TRACKS //</span></div>
    <p class="rc-empty">NO TRACKS ON RECORD <span class="console-dim">· [+] NEW TRACK starts the archive</span></p>
  <% end %>
  <% @groups.each do |release, tracks| %>
    <section class="console-section" aria-label="<%= release.artist.name %> · <%= release.name %>" data-ledger-filter-target="group">
      <div class="console-rule"><span>// <%= release.artist.name.upcase %> · <%= release.name.upcase %> (<%= release.release_type&.upcase || "RELEASE" %><% if release.coming_soon %> · INCOMING<% end %>) //</span></div>
      <% tracks.each do |track| %>
        <%= render "admin/music/track_row", track: track, num: root_num(counter), cover: true, search: root_track_search(track) %>
        <% counter += 1 %>
      <% end %>
    </section>
  <% end %>

  <%= render "admin/console/destinations", section: :music, except: "TRACKS" %>

  <div class="console-rule"><span>// EVERY TRANSMISSION COMMITTED TO RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:music, except: "TRACKS", numbers: numbers, noun: "a track number", extra: ["new"]) %>
</div>
