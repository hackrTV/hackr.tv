<%# The track record's fields on the console: the release's cover (context,
    hover peek) beside the status rows — TITLE, SLUG, RELEASE (grouped by
    artist; the artist follows it), TRACK #, LENGTH, RELEASED, FLAGS,
    AUDIO (the file on record with an inline preview, [^] REPLACE /
    UPLOAD inside this form, [x] REMOVE pointing at the hidden purge
    form) — then // DECODED LYRICS // as one growing textarea and
    // FREQUENCIES //. The commit row belongs to the caller. Locals: f,
    track; @releases for the select. %>
<% release = track.release %>
<% art = release && root_cover_ready?(release) %>
<% audio = root_audio_ready?(track) %>
<% grouped = @releases.group_by { |r| r.artist.name }.map { |artist_name, releases| [artist_name, releases.map { |r| ["#{r.name} · #{r.release_type&.upcase || "RELEASE"}", r.id] }] } %>
<div class="cc-head">
  <div class="rc-art-stack">
    <div class="cc-art" <%= tag.attributes(data: peek_attrs(url_for(release.cover_large))) if art %>>
      <% if art %>
        <%= image_tag url_for(release.cover_standard), alt: "#{release.name} cover", class: "cc-art-img" %>
      <% else %>
        <div class="cc-art-none" aria-hidden="true">&#9834;</div>
      <% end %>
    </div>
    <% if release&.persisted? %>
      <span class="rc-hint">the release's cover · <%= link_to "edit #{release.name}", edit_admin_release_path(release) %></span>
    <% else %>
      <span class="rc-hint">the cover comes from the release</span>
    <% end %>
  </div>

  <div class="console-status">
    <div class="console-status-row rc-field">
      <label class="console-key" for="track_title">TITLE</label>
      <span class="console-val"><%= f.text_field :title, class: "rc-input", required: true, autocomplete: "off" %><%= root_errors(track, :title) %></span>
    </div>
    <div class="console-status-row rc-field">
      <label class="console-key" for="track_slug">SLUG</label>
      <span class="console-val"><%= f.text_field :slug, class: "rc-input", required: true, autocomplete: "off", pattern: "[a-z0-9\\-\\.]+", title: "lowercase letters, digits, hyphens, dots" %><span class="rc-hint">/<%= track.artist&.slug || "artist" %>/trackz/<%= track.slug.presence || "slug" %> · unique per artist</span><%= root_errors(track, :slug) %></span>
    </div>
    <div class="console-status-row rc-field">
      <label class="console-key" for="track_release_id">RELEASE</label>
      <span class="console-val"><%= f.select :release_id, grouped_options_for_select(grouped, track.release_id), {include_blank: "— select release —"}, class: "rc-select", required: true %><span class="rc-hint">the artist follows the release</span><%= root_errors(track, :release) %></span>
    </div>
    <div class="console-status-row rc-field">
      <label class="console-key" for="track_track_number">TRACK #</label>
      <span class="console-val"><%= f.number_field :track_number, class: "rc-input rc-input--short", min: 1, step: 1 %><span class="rc-hint">disc order · the public rows read NN</span></span>
    </div>
    <div class="console-status-row rc-field">
      <label class="console-key" for="track_duration">LENGTH</label>
      <span class="console-val"><%= f.text_field :duration, class: "rc-input rc-input--short", placeholder: "3:45", autocomplete: "off", pattern: "\\d+:\\d{2}(:\\d{2})?", title: "M:SS or H:MM:SS" %><span class="rc-hint">M:SS · the release length sums these</span><%= root_errors(track, :duration) %></span>
    </div>
    <div class="console-status-row rc-field">
      <label class="console-key" for="track_release_date">RELEASED</label>
      <span class="console-val"><%= f.date_field :release_date, class: "rc-input rc-input--date" %><span class="rc-hint">blank = the release's date</span></span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">FLAGS</span>
      <span class="console-val">
        <label class="rc-check"><%= f.check_box :featured %> ★ FEATURED</label>
        <label class="rc-check"><%= f.check_box :show_in_pulse_vault %> IN THE VAULT</label>
        <span class="rc-hint">featured sorts first on /vault · unchecked VAULT hides the track from /vault, /fm and the public catalog's counts</span>
      </span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">AUDIO</span>
      <span class="console-val">
        <% if audio %>
          <span class="rc-on">ON FILE</span>
          <span class="rc-hint"><%= track.audio_file.filename %> · <%= number_to_human_size(track.audio_file.byte_size) %></span>
          <%= audio_tag url_for(track.audio_file), controls: true, preload: "none", class: "rc-audio" %>
        <% else %>
          <span class="rc-off">NO AUDIO ON FILE</span>
          <span class="rc-hint">the public rows read NO AUDIO · out of the vault until a file lands</span>
        <% end %>
        <span class="rc-pick" data-controller="file-pick">
          <%= f.file_field :audio_file, accept: "audio/ogg,audio/mpeg,audio/wav,audio/flac,audio/mp4", class: "rc-pick-input",
            data: {file_pick_target: "input", action: "change->file-pick#changed"} %>
          <button type="button" class="rc-btn" data-action="file-pick#open">[^] <%= audio ? "REPLACE" : "UPLOAD" %> AUDIO</button>
          <span class="rc-hint" data-file-pick-target="name">no file chosen</span>
        </span>
        <% if audio && track.persisted? %>
          <button type="submit" form="purge-audio" class="rc-btn rc-btn--danger">[x] REMOVE AUDIO</button>
        <% end %>
        <span class="rc-hint">OGG · MP3 · WAV · FLAC · M4A</span>
      </span>
    </div>
  </div>
</div>

<div class="console-rule"><span>// DECODED LYRICS //</span></div>
<%= f.text_area :lyrics, class: "rc-textarea rc-textarea--lyrics", rows: 16, spellcheck: true,
  data: {controller: "autogrow", action: "input->autogrow#grow"} %>
<p class="rc-sub">markdown · one line per lyric line, a blank line between verses (the public page keeps the line breaks) · [Chorus] and the like read as plain text</p>

<%= render "admin/music/frequencies_fields", f: f, links: track.streaming_links,
  hint: "the track's own frequencies · a single's track page merges the release's under these" %>
