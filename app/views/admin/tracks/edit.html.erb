<%= render TuiWindowComponent.new(title: "/root/tracks/#{@track.slug} :: EDIT TRACK", variant: :admin, width: 1000) do %>

    <div style="padding: 20px;">
      <!-- Flash Messages -->
      <% if flash[:success] %>
        <div style="background: #003300; border: 2px solid #00ff00; padding: 15px; margin: 20px 0;">
          <p class="green-255-text">✓ SUCCESS</p>
          <p class="white-text"><%= flash[:success] %></p>
        </div>
      <% end %>

      <!-- Navigation -->
      <div style="margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap;">
        <%= tui_button "← Back to #{@release.name}", edit_admin_release_path(@release), color: :green, style: "padding: 8px 20px;" %>
        <%= tui_button "All Releases", admin_releases_path, color: :cyan, style: "padding: 8px 20px;" %>
      </div>

      <div style="padding: 10px; margin-bottom: 20px; background: #0a0a0a; border: 1px solid #333;">
        <span style="color: #888;">Release:</span>
        <span style="color: #0ff;"><%= @release.name %></span>
        <span style="color: #666;">by</span>
        <span style="color: #0ff;"><%= @track.artist.name %></span>
      </div>

      <%# Flash Errors %>
      <% if flash[:error] %>
        <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin: 20px 0;">
          <p class="red-255-text">⚠ ERROR</p>
          <p class="white-text"><%= flash[:error] %></p>
        </div>
      <% end %>

      <%= form_with model: [:admin, @track], local: true do |f| %>
        <h3 class="cyan-255-text" style="margin: 20px 0 15px 0;">[:: TRACK INFO ::]</h3>

        <div style="margin-bottom: 20px;">
          <%= f.tui_text_field :title %>
        </div>

        <div style="margin-bottom: 20px;">
          <%= f.tui_text_field :slug %>
        </div>

        <div style="display: flex; gap: 20px; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 120px; margin-bottom: 20px;">
            <%= f.tui_number_field :track_number, min: 1, label: "TRACK #" %>
          </div>
          <div style="flex: 1; min-width: 120px; margin-bottom: 20px;">
            <%= f.tui_text_field :duration, placeholder: "3:45" %>
          </div>
          <div style="flex: 1; min-width: 150px; margin-bottom: 20px;">
            <%= f.tui_date_field :release_date %>
          </div>
        </div>

        <div style="display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 20px;">
          <div>
            <%= f.tui_check_box :featured, style: "width: 20px; height: 20px;" %>
          </div>
          <div>
            <%= f.tui_check_box :show_in_pulse_vault, style: "width: 20px; height: 20px;" %>
          </div>
        </div>

        <h3 class="cyan-255-text" style="margin: 20px 0 15px 0;">[:: AUDIO FILE ::]</h3>

        <% if @track.audio_file.attached? %>
          <div style="margin-bottom: 15px; padding: 10px; background: #0a0a0a; border: 1px solid #333; display: flex; align-items: center; justify-content: space-between;">
            <div>
              <span class="green-255-text">✓ Audio file attached</span>
              <span style="color: #888; margin-left: 10px; font-family: monospace; font-size: 0.85em;">
                <%= @track.audio_file.filename %>
                (<%= number_to_human_size(@track.audio_file.byte_size) %>)
              </span>
            </div>
          </div>
        <% end %>

        <div style="margin-bottom: 20px; display: flex; align-items: center; gap: 15px; flex-wrap: wrap;">
          <div>
            <label class="white-text" style="display: block; margin-bottom: 8px; font-weight: bold;">
              <%= @track.audio_file.attached? ? "REPLACE AUDIO" : "UPLOAD AUDIO" %>
            </label>
            <%= f.file_field :audio_file, accept: "audio/ogg,audio/mpeg,audio/wav,audio/flac,audio/mp4",
                id: "audio-file-input",
                style: "display: none;" %>
            <label for="audio-file-input" class="tui-button purple-168"
                   style="padding: 8px 20px; font-size: 0.85em; cursor: pointer; display: inline-block;">
              CHOOSE FILE
            </label>
            <span id="audio-filename" style="color: #888; font-size: 0.85em; margin-left: 10px;"></span>
            <small style="color: #666; display: block; margin-top: 8px;">OGG, MP3, WAV, FLAC, or M4A.</small>
            <script nonce="<%= content_security_policy_nonce %>">
              document.getElementById('audio-file-input').addEventListener('change', function(e) {
                var name = e.target.files[0] ? e.target.files[0].name : '';
                document.getElementById('audio-filename').textContent = name;
              });
            </script>
          </div>

          <% if @track.audio_file.attached? %>
            <div style="margin-left: auto;">
              <%= tui_button_to "Remove Audio",
                  purge_audio_admin_track_path(@track),
                  method: :delete,
                  color: :red,
                  style: "padding: 8px 20px; font-size: 0.85em;",
                  data: { turbo_confirm: "Remove audio file from '#{@track.title}'?" } %>
            </div>
          <% end %>
        </div>

        <div style="margin-bottom: 20px;">
          <%= f.tui_text_area :lyrics, style: "min-height: 200px; line-height: 1.6;" %>
        </div>

        <%# Actions %>
        <div style="margin-top: 30px; display: flex; gap: 10px;">
          <%= tui_submit "Save Track", form: f,
              color: :purple,
              style: "padding: 10px 30px; font-size: 1.1em;" %>
          <%= tui_button "Cancel", edit_admin_release_path(@release),
              color: :grey,
              style: "padding: 10px 30px; font-size: 1.1em;" %>
          <%= tui_button "History", history_admin_track_path(@track),
              color: :purple,
              style: "padding: 10px 30px; font-size: 1.1em;" %>
        </div>
      <% end %>
    </div>
<% end %>
