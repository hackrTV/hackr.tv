<%# /root/tracks/:slug/edit — the track record as a console screen
    (2026-10-30; show redirects here; the public console_track's twin
    with fields where it has readouts — lyrics as one tall textarea).
    Bar (title · ARTIST · RELEASE · TRACK NN · path; ★ FEATURED badge;
    [<] the release's record screen, [>] PUBLIC when the artist is
    routed, [HISTORY]), the form (admin/tracks/_form: cover context +
    status rows, lyrics, frequencies) closed by // COMMIT //, then
    // ALSO ON <RELEASE> // — the release's other tracks as nav rows
    (NN opens them; the hop while editing a record), destinations, the
    > prompt. Hidden forms at the end: purge-audio, delete-track
    (data-confirm). URLs use slug_in_database. Assigns: @track,
    @release (as saved), @siblings, @releases. %>
<% slug = @track.slug_in_database %>
<% title = @track.title_in_database %>
<% content_for :title, "/root/tracks/#{slug} :: #{title}" %>
<% num = format("%02d", @track.track_number_in_database.to_i) %>
<% sibling_numbers = @siblings.map { |t| format("%02d", t.track_number.to_i) } %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <div class="console-bar">
    <h1 class="console-bar-title"><%= title %></h1>
    <span class="console-bar-sub"><%= @release.artist.name %> · <%= @release.name %> · TRACK <%= num %> · /root/tracks/<%= slug %></span>
    <span class="console-bar-right">
      <% if @track.featured_in_database %><span class="console-bar-badge">★ FEATURED</span><% end %>
      <%= link_to "[<] #{@release.name.upcase}", edit_admin_release_path(@release), class: "console-bar-link" %>
      <% if (pub = root_public_track_path(@track)) %><%= link_to "[>] PUBLIC", pub, class: "console-bar-link" %><% end %>
      <%= link_to "[HISTORY]", history_admin_track_path(slug), class: "console-bar-link" %>
    </span>
  </div>
  <%= render "admin/music/flash" %>

  <%= form_with model: @track, url: admin_track_path(slug), method: :patch, local: true do |f| %>
    <%= render "form", f: f, track: @track %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[SAVE TRACK]</button>
      <%= link_to "[CANCEL]", edit_admin_release_path(@release), class: "rc-btn" %>
      <span class="rc-actions--end">
        <button type="submit" form="delete-track" class="rc-btn rc-btn--danger">[DELETE TRACK]</button>
      </span>
    </div>
  <% end %>

  <% if @siblings.any? %>
    <section class="console-section" aria-label="Also on <%= @release.name %>">
      <div class="console-rule"><span>// ALSO ON <%= @release.name.upcase %> //</span></div>
      <div class="cc-tracks">
        <% @siblings.each do |sibling| %>
          <% sibling_num = format("%02d", sibling.track_number.to_i) %>
          <div class="cc-track cc-track--nav">
            <span class="console-tag"><%= sibling_num %></span>
            <%= link_to sibling.title, edit_admin_track_path(sibling), class: "console-link cc-track-title", data: {command: sibling_num} %>
            <span class="cc-track-time console-dim"><%= sibling.duration.presence || "—" %></span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= render "admin/music/destinations" %>

  <div class="console-rule"><span>// END OF TRANSMISSION //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(numbers: sibling_numbers, noun: "a track number") %>

  <div class="rc-hidden-forms">
    <% if root_audio_ready?(@track) %>
      <%= root_delete_form("purge-audio", purge_audio_admin_track_path(slug), confirm: "Remove the audio file from '#{title}'?") %>
    <% end %>
    <%= root_delete_form("delete-track", admin_track_path(slug), confirm: "Delete track '#{title}'? This cannot be undone.") %>
  </div>
</div>
