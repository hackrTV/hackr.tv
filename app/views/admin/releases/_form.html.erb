<%# The release record's fields on the console: the cover column (art +
    [^] REPLACE / UPLOAD inside this form, [x] REMOVE pointing at the
    hidden purge form — a button_to can't nest) beside the status rows,
    then // DESCRIPTION // // CREDITS // // NOTES // as growing textareas
    and // FREQUENCIES // (admin/music/_frequencies_fields). The commit
    row belongs to the caller. Locals: f, release; @artists for the
    select. %>
<% cover = root_cover_ready?(release) %>
<div class="cc-head">
  <div class="rc-art-stack">
    <div class="cc-art <%= "cc-art--incoming" if release.coming_soon %>" <%= tag.attributes(data: peek_attrs(url_for(release.cover_large))) if cover %>>
      <% if cover %>
        <%= image_tag url_for(release.cover_standard), alt: release.name_in_database.to_s, class: "cc-art-img" %>
      <% else %>
        <div class="cc-art-none" aria-hidden="true">&#9834;</div>
      <% end %>
    </div>
    <span class="rc-pick" data-controller="file-pick">
      <%= f.file_field :cover_image, accept: "image/jpeg,image/png,image/webp", class: "rc-pick-input",
        data: {file_pick_target: "input", action: "change->file-pick#changed"} %>
      <button type="button" class="rc-btn" data-action="file-pick#open">[^] <%= cover ? "REPLACE" : "UPLOAD" %> COVER</button>
      <span class="rc-hint" data-file-pick-target="name">no file chosen</span>
    </span>
    <% if cover && release.persisted? %>
      <span><button type="submit" form="purge-cover" class="rc-btn rc-btn--danger">[x] REMOVE COVER</button></span>
    <% end %>
    <span class="rc-hint">JPEG · PNG · WEBP · served at 80 / 300 / 800px</span>
  </div>

  <div class="console-status">
    <div class="console-status-row rc-field">
      <label class="console-key" for="release_name">NAME</label>
      <span class="console-val"><%= f.text_field :name, class: "rc-input", required: true, autocomplete: "off" %><%= root_errors(release, :name) %></span>
    </div>
    <div class="console-status-row rc-field">
      <label class="console-key" for="release_slug">SLUG</label>
      <span class="console-val"><%= f.text_field :slug, class: "rc-input", required: true, autocomplete: "off", pattern: "[a-z0-9\\-\\.]+", title: "lowercase letters, digits, hyphens, dots" %><span class="rc-hint">/<%= release.artist&.slug || "artist" %>/releases/<%= release.slug.presence || "slug" %> · unique per artist</span><%= root_errors(release, :slug) %></span>
    </div>
    <div class="console-status-row rc-field">
      <label class="console-key" for="release_artist_id">ARTIST</label>
      <span class="console-val"><%= f.select :artist_id, options_for_select(@artists.map { |a| [a.name, a.id] }, release.artist_id), {include_blank: "— select artist —"}, class: "rc-select", required: true %><%= root_errors(release, :artist) %></span>
    </div>
    <div class="console-status-row rc-field">
      <label class="console-key" for="release_release_type">TYPE</label>
      <span class="console-val"><%= f.select :release_type, options_for_select(Admin::MusicConsoleHelper::RELEASE_TYPES.map { |t| [t.upcase, t] }, release.release_type), {include_blank: "—"}, class: "rc-select" %><span class="rc-hint">a one-track SINGLE renders as its track page on the console catalog</span></span>
    </div>
    <div class="console-status-row rc-field">
      <label class="console-key" for="release_release_date">RELEASED</label>
      <span class="console-val"><%= f.date_field :release_date, class: "rc-input rc-input--date" %><span class="rc-hint">blank = undated</span></span>
    </div>
    <div class="console-status-row rc-field">
      <label class="console-key" for="release_label">LABEL</label>
      <span class="console-val"><%= f.text_field :label, class: "rc-input", autocomplete: "off", placeholder: "hackr.fm" %></span>
    </div>
    <div class="console-status-row rc-field">
      <label class="console-key" for="release_catalog_number">CATALOG #</label>
      <span class="console-val"><%= f.text_field :catalog_number, class: "rc-input rc-input--short", autocomplete: "off", placeholder: "HFM-001" %></span>
    </div>
    <div class="console-status-row rc-field">
      <label class="console-key" for="release_media_format">FORMAT</label>
      <span class="console-val"><%= f.text_field :media_format, class: "rc-input", autocomplete: "off", placeholder: "Digital" %></span>
    </div>
    <div class="console-status-row rc-field">
      <label class="console-key" for="release_classification">CLASS</label>
      <span class="console-val"><%= f.text_field :classification, class: "rc-input", autocomplete: "off", placeholder: "Transmission" %></span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">STATUS</span>
      <span class="console-val">
        <label class="rc-check"><%= f.check_box :coming_soon %> ◌ SIGNAL INCOMING</label>
        <span class="rc-hint">masks the record on the public pages · the tracklist reads encrypted · out of the vault and /fm</span>
      </span>
    </div>
  </div>
</div>

<div class="console-rule"><span>// DESCRIPTION //</span></div>
<%= f.text_area :description, class: "rc-textarea", rows: 4, data: {controller: "autogrow", action: "input->autogrow#grow"} %>

<div class="console-rule"><span>// CREDITS //</span></div>
<%= f.text_area :credits, class: "rc-textarea", rows: 3, data: {controller: "autogrow", action: "input->autogrow#grow"} %>

<div class="console-rule"><span>// NOTES //</span></div>
<%= f.text_area :notes, class: "rc-textarea", rows: 3, data: {controller: "autogrow", action: "input->autogrow#grow"} %>

<%= render "admin/music/frequencies_fields", f: f, links: release.streaming_links,
  hint: "all blank = the public page aggregates the tracks' links instead" %>
