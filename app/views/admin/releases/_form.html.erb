<%# The release record's fields on the console: the cover column (art +
    [^] REPLACE / UPLOAD inside this form, [x] REMOVE pointing at the
    hidden purge form — a button_to can't nest) beside the status rows
    (ConsoleFormBuilder rc_* rows), then // DESCRIPTION // // CREDITS //
    // NOTES // as growing textareas and // FREQUENCIES //
    (admin/music/_frequencies_fields). The commit row belongs to the
    caller. Locals: f, release; @artists for the select. %>
<% cover = root_cover_ready?(release) %>
<div class="cc-head">
  <div class="rc-art-stack">
    <div class="cc-art <%= "cc-art--incoming" if release.coming_soon %>" <%= tag.attributes(data: peek_attrs(url_for(release.cover_large))) if cover %>>
      <% if cover %>
        <%= image_tag url_for(release.cover_standard), alt: release.name_in_database.to_s, class: "cc-art-img" %>
      <% else %>
        <div class="cc-art-none" aria-hidden="true">&#9834;</div>
      <% end %>
    </div>
    <span class="rc-pick" data-controller="file-pick">
      <%= f.file_field :cover_image, accept: "image/jpeg,image/png,image/webp", class: "rc-pick-input",
        data: {file_pick_target: "input", action: "change->file-pick#changed"} %>
      <button type="button" class="rc-btn" data-action="file-pick#open">[^] <%= cover ? "REPLACE" : "UPLOAD" %> COVER</button>
      <span class="rc-hint" data-file-pick-target="name">no file chosen</span>
    </span>
    <% if cover && release.persisted? %>
      <span><button type="submit" form="purge-cover" class="rc-btn rc-btn--danger">[x] REMOVE COVER</button></span>
    <% end %>
    <span class="rc-hint">JPEG · PNG · WEBP · served at 80 / 300 / 800px</span>
  </div>

  <div class="console-status">
    <%= f.rc_text_field :name, required: true, autocomplete: "off" %>
    <%= f.rc_text_field :slug, required: true, autocomplete: "off", pattern: "[a-z0-9\\-\\.]+", title: "lowercase letters, digits, hyphens, dots",
      hint: "/#{release.artist&.slug || "artist"}/releases/#{release.slug.presence || "slug"} · unique per artist" %>
    <%= f.rc_select :artist_id, options_for_select(@artists.map { |a| [a.name, a.id] }, release.artist_id), {include_blank: "— select artist —"}, required: true %>
    <%= f.rc_select :release_type, options_for_select(Admin::MusicConsoleHelper::RELEASE_TYPES.map { |t| [t.upcase, t] }, release.release_type), {include_blank: "—"},
      label: "TYPE", hint: "a one-track SINGLE renders as its track page on the console catalog" %>
    <%= f.rc_date_field :release_date, label: "RELEASED", hint: "blank = undated" %>
    <%= f.rc_text_field :label, autocomplete: "off", placeholder: "hackr.fm" %>
    <%= f.rc_text_field :catalog_number, label: "CATALOG #", width: :short, autocomplete: "off", placeholder: "HFM-001" %>
    <%= f.rc_text_field :media_format, label: "FORMAT", autocomplete: "off", placeholder: "Digital" %>
    <%= f.rc_text_field :classification, label: "CLASS", autocomplete: "off", placeholder: "Transmission" %>
    <%= f.rc_flags("STATUS", hint: "masks the record on the public pages · the tracklist reads encrypted · out of the vault and /fm") do %>
      <%= f.rc_check_box :coming_soon, label: "◌ SIGNAL INCOMING" %>
    <% end %>
  </div>
</div>

<%= f.rc_text_area :description, rows: 4 %>
<%= f.rc_text_area :credits, rows: 3 %>
<%= f.rc_text_area :notes, rows: 3 %>

<%= render "admin/music/frequencies_fields", f: f, links: release.streaming_links,
  hint: "all blank = the public page aggregates the tracks' links instead" %>
