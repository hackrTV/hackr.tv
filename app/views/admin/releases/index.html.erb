<%# /root/releases — the releases ledger as a console screen (2026-10-30;
    console.css family + root_console.css): bar, CATALOG / LATEST /
    INCOMING rows, one // <ARTIST> // rule per artist with its releases
    as rows ([NN] · cover · name over TYPE · date · tracks · length ·
    catalog # · slug · state · [HISTORY]; incoming first, then newest),
    destinations, the > prompt (NN opens the record screen).
    Assigns: @releases, @groups, @incoming, @latest, @track_count. %>
<% content_for :title, "/root/releases :: RELEASES" %>
<% numbers = @releases.to_a.each_index.map { |i| root_num(i) } %>
<% counter = 0 %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "RELEASES", sub: "ROOT · MUSIC · /root/releases"} do %>
    <%= link_to "[+] NEW RELEASE", new_admin_release_path, class: "console-bar-link", data: {command: "new"} %>
    <%= link_to "[>] FM", "/fm/releases", class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">CATALOG</span>
      <span class="console-val"><%= pluralize(@releases.size, "release") %> <span class="console-dim">· <%= pluralize(@track_count, "track") %> · <%= pluralize(@groups.size, "artist") %><% if @incoming.any? %> · <%= @incoming.size %> incoming<% end %></span></span>
    </div>
    <% if @latest %>
      <div class="console-status-row">
        <span class="console-key">LATEST</span>
        <span class="console-val"><%= link_to @latest.name, edit_admin_release_path(@latest), class: "console-link" %> <span class="console-dim">· <%= @latest.artist.name %> · <%= @latest.release_type&.upcase || "RELEASE" %> · <%= @latest.release_date.strftime("%Y-%m-%d") %></span></span>
      </div>
    <% end %>
    <% if (incoming = @incoming.first) %>
      <div class="console-status-row">
        <span class="console-key">INCOMING</span>
        <span class="console-val"><%= link_to incoming.name, edit_admin_release_path(incoming), class: "console-link" %> <span class="console-dim">· <%= incoming.artist.name %> · <%= incoming.release_type&.upcase || "RELEASE" %> · PENDING TRANSMISSION<% if @incoming.size > 1 %> · +<%= @incoming.size - 1 %> more<% end %></span></span>
      </div>
    <% end %>
  </div>

  <% if @releases.empty? %>
    <div class="console-rule"><span>// CATALOG //</span></div>
    <p class="rc-empty">NO RELEASES ON RECORD <span class="console-dim">· [+] NEW RELEASE starts the catalog</span></p>
  <% end %>
  <% @groups.each do |artist, releases| %>
    <section class="console-section" aria-label="<%= artist.name %>">
      <div class="console-rule"><span>// <%= artist.name.upcase %> · <%= pluralize(releases.size, "RELEASE").upcase %> //</span></div>
      <% releases.each do |release| %>
        <%= render "admin/music/release_row", release: release, num: root_num(counter) %>
        <% counter += 1 %>
      <% end %>
    </section>
  <% end %>

  <%= render "admin/console/destinations", section: :music, except: "RELEASES" %>

  <div class="console-rule"><span>// EVERY TRANSMISSION COMMITTED TO RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:music, except: "RELEASES", numbers: numbers, noun: "a release number", extra: ["new"]) %>
</div>
