<%# /root/releases/:slug/edit — the release record as a console screen
    (2026-10-30; show redirects here; the public console_release's twin
    with fields where it has readouts). Bar (name · ARTIST · TYPE · path;
    ◌ SIGNAL INCOMING badge; [<] RELEASES, [>] PUBLIC when the artist is
    routed, [HISTORY]), the form (admin/releases/_form: cover column +
    status rows, prose, frequencies) closed by // COMMIT //, then the
    // TRACKS // ledger (NN · title · AUDIO · ★ · VAULT · time · [HISTORY]
    [DEL]) + [+] ADD TRACK prefilled, destinations, the > prompt (NN
    opens a track). Hidden forms at the end: purge-cover, delete-release
    (typed slug confirmation — confirm-slug controller), delete-track-<id>
    (data-confirm). URLs use slug_in_database. Assigns: @release,
    @artists, @tracks. %>
<% slug = @release.slug_in_database %>
<% name = @release.name_in_database %>
<% content_for :title, "/root/releases/#{slug} :: #{name}" %>
<% numbers = @tracks.to_a.each_index.map { |i| root_num(i) } %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: name, sub: "#{@release.artist.name} · #{@release.release_type_in_database&.upcase || "RELEASE"} · /root/releases/#{slug}"} do %>
    <% if @release.coming_soon_in_database %><span class="console-bar-badge">◌ SIGNAL INCOMING</span><% end %>
    <%= link_to "[<] RELEASES", admin_releases_path, class: "console-bar-link" %>
    <% if (pub = root_public_release_path(@release)) %><%= link_to "[>] PUBLIC", pub, class: "console-bar-link" %><% end %>
    <%= link_to "[HISTORY]", history_admin_release_path(slug), class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @release, url: admin_release_path(slug), method: :patch, local: true do |f| %>
    <%= render "form", f: f, release: @release %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[SAVE RELEASE]</button>
      <%= link_to "[CANCEL]", admin_releases_path, class: "rc-btn" %>
      <span class="rc-actions--end">
        <button type="submit" form="delete-release" class="rc-btn rc-btn--danger">[DELETE RELEASE<% if @tracks.any? %> + <%= @tracks.size %> TRACK<%= "S" unless @tracks.size == 1 %><% end %>]</button>
      </span>
    </div>
  <% end %>

  <section class="console-section" aria-label="Tracks">
    <div class="console-rule"><span>// TRACKS //</span></div>
    <% if @tracks.empty? %>
      <p class="rc-empty">NO TRACKS ON THIS RELEASE <span class="console-dim">· [+] ADD TRACK opens a prefilled record</span></p>
    <% end %>
    <% @tracks.each_with_index do |track, i| %>
      <%= render "admin/music/track_row", track: track, num: root_num(i), delete_form_id: "delete-track-#{track.id}" %>
    <% end %>
    <div class="rc-actions">
      <%= link_to "[+] ADD TRACK", new_admin_track_path(release_id: @release.id), class: "rc-btn", data: {command: "new"} %>
    </div>
  </section>

  <%= render "admin/console/destinations", section: :music %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:music, numbers: numbers, noun: "a track number", extra: ["new"]) %>

  <div class="rc-hidden-forms">
    <% if root_cover_ready?(@release) %>
      <%= root_delete_form("purge-cover", purge_cover_admin_release_path(slug), confirm: "Remove the cover image from '#{name}'?") %>
    <% end %>
    <%= form_with url: admin_release_path(slug), method: :delete, id: "delete-release", local: true,
      data: {controller: "confirm-slug", confirm_slug_slug_value: slug, action: "submit->confirm-slug#check"} do %><% end %>
    <% @tracks.each do |track| %>
      <%= root_delete_form("delete-track-#{track.id}", admin_track_path(track), confirm: "Delete track '#{track.title}'?") %>
    <% end %>
  </div>
</div>
