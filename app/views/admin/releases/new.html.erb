<%# /root/releases/new — a new release on the record screen's shell;
    ?artist_id prefills the ARTIST select (an artist screen's
    [+] NEW RELEASE). Tracks are added once the record exists. %>
<% content_for :title, "/root/releases/new :: NEW RELEASE" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <div class="console-bar">
    <h1 class="console-bar-title">NEW RELEASE</h1>
    <span class="console-bar-sub">ROOT · RELEASE · /root/releases/new</span>
    <span class="console-bar-right">
      <% if @release.artist %><%= link_to "[<] #{@release.artist.name.upcase}", edit_admin_artist_path(@release.artist), class: "console-bar-link" %><% end %>
      <%= link_to "[<] RELEASES", admin_releases_path, class: "console-bar-link" %>
    </span>
  </div>
  <%= render "admin/console/flash" %>

  <%= form_with model: @release, url: admin_releases_path, local: true do |f| %>
    <%= render "form", f: f, release: @release %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[CREATE RELEASE]</button>
      <%= link_to "[CANCEL]", admin_releases_path, class: "rc-btn" %>
      <span class="rc-hint">tracks are added on the record screen once it exists</span>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :music %>
  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:music) %>
</div>
