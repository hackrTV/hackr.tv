<%# /root/grid_hackr_missions/:id — one hackr's run at a mission as a
    console readout (2026-11-01; read-only): bar (#id · ROOT · ASSIGNMENT
    · path; [<] ASSIGNMENTS, [>] MISSION, [>] HACKR), // ASSIGNMENT //
    (mission, hackr, status, times, turn-ins), // OBJECTIVES // (each of
    the mission's objectives: label · TYPE · target · progress / count ·
    DONE), destinations, the > prompt. Assigns: @hackr_mission. %>
<% hm = @hackr_mission %>
<% mission = hm.grid_mission %>
<% objectives = mission.grid_mission_objectives.to_a %>
<% progress_by_id = hm.grid_hackr_mission_objectives.index_by(&:grid_mission_objective_id) %>
<% content_for :title, "/root/grid_hackr_missions/#{hm.id} :: ASSIGNMENT" %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "ASSIGNMENT ##{hm.id}", sub: "ROOT · ASSIGNMENT · /root/grid_hackr_missions/#{hm.id}"} do %>
    <%= link_to "[<] ASSIGNMENTS", admin_grid_hackr_missions_path, class: "console-bar-link" %>
    <%= link_to "[>] MISSION", edit_admin_grid_mission_path(mission), class: "console-bar-link" %>
    <%= link_to "[>] HACKR", admin_grid_hackr_path(hm.grid_hackr), class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-rule"><span>// ASSIGNMENT //</span></div>
  <div class="console-status">
    <div class="console-status-row"><span class="console-key">MISSION</span><span class="console-val"><%= link_to mission.name, edit_admin_grid_mission_path(mission), class: "console-link" %> <span class="console-dim">· <%= mission.slug %></span></span></div>
    <div class="console-status-row"><span class="console-key">HACKR</span><span class="console-val rc-hot"><%= hm.grid_hackr.hackr_alias %></span></div>
    <div class="console-status-row"><span class="console-key">STATUS</span><span class="console-val <%= hm.active? ? "rc-hot" : "rc-on" %>"><%= hm.status.upcase %></span></div>
    <div class="console-status-row"><span class="console-key">ACCEPTED</span><span class="console-val"><%= hm.accepted_at.strftime("%Y-%m-%d %H:%M:%S") %></span></div>
    <div class="console-status-row"><span class="console-key">COMPLETED</span><span class="console-val"><%= hm.completed_at&.strftime("%Y-%m-%d %H:%M:%S") || "—" %></span></div>
    <div class="console-status-row"><span class="console-key">TURN-INS</span><span class="console-val"><%= hm.turn_in_count %></span></div>
  </div>

  <section class="console-section rc-ledger rc-ledger--objectives" aria-label="Objectives">
    <div class="console-rule"><span>// OBJECTIVES · <%= objectives.size %> //</span></div>
    <% if objectives.empty? %>
      <%= render "admin/console/empty", text: "THE MISSION HAS NO OBJECTIVES" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span></span><span>OBJECTIVE</span><span>TYPE</span><span>TARGET</span><span class="rc-cell--r">PROGRESS</span><span>DONE</span>
      </div>
    <% end %>
    <% objectives.each_with_index do |objective, i| %>
      <% progress = progress_by_id[objective.id] %>
      <div class="rc-row">
        <span class="console-tag">[<%= root_num(i, total: objectives.size) %>]</span>
        <span><%= objective.label %></span>
        <span class="rc-cell"><%= objective.objective_type.upcase %></span>
        <span class="rc-cell rc-off"><%= objective.target_slug || "—" %></span>
        <span class="rc-cell rc-cell--r"><%= progress&.progress.to_i %> / <%= objective.target_count %></span>
        <span class="rc-cell <%= progress&.completed_at ? "rc-on" : "rc-off" %>"><%= progress&.completed_at ? "DONE" : "—" %></span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :systems %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems) %>
</div>
