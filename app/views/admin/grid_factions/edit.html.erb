<%= render TuiWindowComponent.new(title: "/root/grid/factions/#{@faction.slug} :: EDIT FACTION", variant: :admin, width: 900) do %>

    <div style="padding: 20px;">
      <%= form_with model: @faction, url: admin_grid_faction_path(@faction), method: :patch, local: true do |f| %>
        <%= render "form", f: f %>
      <% end %>
    </div>
<% end %>
