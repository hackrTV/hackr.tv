<%# /root/grid_factions/new — a new faction on the record screen's shell. %>
<% content_for :title, "/root/grid_factions/new :: NEW FACTION" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "NEW FACTION", sub: "ROOT · FACTION · /root/grid_factions/new"} do %>
    <%= link_to "[<] FACTIONS", admin_grid_factions_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @faction, url: admin_grid_factions_path, local: true do |f| %>
    <%= render "form", f: f, faction: @faction %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[CREATE FACTION]</button>
      <%= link_to "[CANCEL]", admin_grid_factions_path, class: "rc-btn" %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :world %>
  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world) %>
</div>
