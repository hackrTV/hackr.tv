<%# /root/grid_factions — the factions ledger and the rep-link graph as a
    console screen (2026-10-31; root_console.css): bar ([+] NEW FACTION,
    [>] REPLOG, [>] REPUTATIONS), ON RECORD row, // FACTIONS // rows
    ([NN] · name over slug · KIND · PARENT · POS · [HISTORY]),
    // REP LINKS // (the whole graph as one form: source · target ·
    weight rows plus three blank ones; a blank or zero row deletes on
    save), destinations, the > prompt (NN opens the record screen;
    deletes live there). Assigns: @factions, @rep_links. %>
<% content_for :title, "/root/grid_factions :: FACTIONS" %>
<% numbers = @factions.each_index.map { |i| root_num(i) } %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "FACTIONS", sub: "ROOT · WORLD · /root/grid_factions"} do %>
    <%= link_to "[+] NEW FACTION", new_admin_grid_faction_path, class: "console-bar-link", data: {command: "new"} %>
    <%= link_to "[>] REPLOG", admin_grid_reputation_events_path, class: "console-bar-link" %>
    <%= link_to "[>] REPUTATIONS", admin_grid_hackr_reputations_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(@factions.size, "faction") %> <span class="console-dim">· <%= pluralize(@rep_links.size, "rep link") %></span></span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--factions" aria-label="Factions">
    <div class="console-rule"><span>// FACTIONS //</span></div>
    <% if @factions.empty? %>
      <%= render "admin/console/empty", text: "NO FACTIONS ON RECORD", hint: "[+] NEW FACTION founds one" %>
    <% end %>
    <% @factions.each_with_index do |faction, i| %>
      <% num = numbers[i] %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to faction.display_name, edit_admin_grid_faction_path(faction), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= faction.slug %></div>
        </div>
        <span class="rc-cell rc-hot"><%= faction.kind.upcase %></span>
        <span class="rc-cell"><%= faction.parent&.display_name || "—" %></span>
        <span class="rc-cell rc-cell--r">POS <%= faction.position %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[HISTORY]", history_admin_grid_faction_path(faction), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--replinks" aria-label="Rep links">
    <div class="console-rule"><span>// REP LINKS //</span></div>
    <p class="rc-sub">directed edges: a change to the SOURCE's rep shifts the TARGET's computed rep by weight x source value · clear a row (or weight 0) to delete it on save</p>
    <%= form_with url: update_rep_links_admin_grid_factions_path, method: :post, local: true do %>
      <div class="rc-row rc-row--head" aria-hidden="true"><span>SOURCE</span><span>TARGET</span><span class="rc-cell--r">WEIGHT</span></div>
      <% (@rep_links.size + 3).times do |i| %>
        <% link = @rep_links[i] %>
        <div class="rc-row">
          <%= select_tag "rep_links[#{i}][source_slug]", options_from_collection_for_select(@factions, :slug, :display_name, link&.source_faction&.slug),
            include_blank: "(none)", class: "rc-select", aria: {label: "Source faction #{i + 1}"} %>
          <%= select_tag "rep_links[#{i}][target_slug]", options_from_collection_for_select(@factions, :slug, :display_name, link&.target_faction&.slug),
            include_blank: "(none)", class: "rc-select", aria: {label: "Target faction #{i + 1}"} %>
          <%= number_field_tag "rep_links[#{i}][weight]", link&.weight, step: 0.01, class: "rc-input rc-input--short rc-input--r", aria: {label: "Weight #{i + 1}"} %>
        </div>
      <% end %>
      <div class="rc-actions">
        <button type="submit" class="rc-btn rc-btn--hot">[SAVE REP LINKS]</button>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :world, except: "FACTIONS" %>

  <div class="console-rule"><span>// EVERY FACTION ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world, except: "FACTIONS", numbers: numbers, noun: "a faction number", extra: ["new"]) %>
</div>
