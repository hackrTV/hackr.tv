<%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "padding: 20px;") do %>
  <% if @faction.errors.any? %>
    <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin-bottom: 20px;">
      <p class="red-255-text"><%= @faction.errors.full_messages.join(", ") %></p>
    </div>
  <% end %>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_text_field :name %>
    </div>
    <div style="flex: 1;">
      <%= f.tui_text_field :slug %>
    </div>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.tui_text_area :description, style: "min-height: 60px;" %>
  </div>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_select :kind, GridFaction::KINDS.map { |k| [k, k] }, {} %>
    </div>
    <div style="flex: 1;">
      <%= f.tui_text_field :color_scheme, label: "COLOR" %>
    </div>
    <div style="flex: 1;">
      <%= f.tui_number_field :position %>
    </div>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.tui_collection_select :parent_id, GridFaction.ordered.where.not(id: @faction.id), :id, :display_name, {include_blank: "(none)"}, label: "PARENT FACTION (display hierarchy only)", hint: "Rep math is controlled by the Rep Link Graph on the index page, NOT by this field." %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.tui_collection_select :artist_id, Artist.order(:name), :id, :name, {include_blank: "(none)"}, label: "LINKED ARTIST" %>
  </div>

  <div style="margin-top: 20px;">
    <%= tui_submit @faction.new_record? ? "Create Faction" : "Update Faction", form: f, color: :green, style: "padding: 10px 20px; font-weight: bold;" %>
    <%= tui_button "Cancel", admin_grid_factions_path, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% if @faction.persisted? %>
      <%= tui_button "History", history_admin_grid_faction_path(@faction), color: :purple, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% end %>
  </div>
<% end %>
