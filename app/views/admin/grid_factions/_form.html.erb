<%# The faction's fields as console status rows (ConsoleFormBuilder rc_*
    rows), then // DESCRIPTION //. PARENT is display hierarchy only —
    rep math follows the rep-link graph on the factions ledger. The
    commit row belongs to the caller. Locals: f, faction. %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, required: true, autocomplete: "off", hint: "unique" %>
  <%= f.rc_select :kind, GridFaction::KINDS.map { |k| [k.upcase, k] }, {}, label: "KIND" %>
  <%= f.rc_text_field :color_scheme, label: "COLOR", autocomplete: "off", width: :short %>
  <%= f.rc_number_field :position, width: :short %>
  <%= f.rc_collection_select :parent_id, GridFaction.ordered.where.not(id: faction.id), :id, :display_name, {include_blank: "(none)"},
    label: "PARENT", hint: "display hierarchy only — rep math follows the REP LINKS graph on the factions ledger" %>
  <%= f.rc_collection_select :artist_id, Artist.order(:name), :id, :name, {include_blank: "(none)"}, label: "ARTIST" %>
</div>

<%= f.rc_text_area :description, rows: 3, spellcheck: true %>
