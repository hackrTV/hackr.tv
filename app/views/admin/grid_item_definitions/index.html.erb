<%= render TuiWindowComponent.new(title: "/root/grid/items :: ITEM DEFINITIONS", variant: :admin) do %>

    <div style="padding: 20px;">
      <% if flash[:success] %>
        <div style="background: #003300; border: 2px solid #00ff00; padding: 15px; margin: 20px 0;">
          <p class="green-255-text"><%= flash[:success] %></p>
        </div>
      <% end %>

      <% if flash[:error] %>
        <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin: 20px 0;">
          <p class="red-255-text"><%= flash[:error] %></p>
        </div>
      <% end %>

      <div style="display: flex; gap: 15px; align-items: center; margin-bottom: 20px;">
        <%= tui_button "+ New Definition", new_admin_grid_item_definition_path, color: :green %>

        <%= form_with url: admin_grid_item_definitions_path, method: :get, local: true, style: "display: inline-flex; gap: 8px; align-items: center; margin-left: 20px;" do %>
          <label class="white-text" style="font-weight: bold;">TYPE:</label>
          <%= select_tag :item_type,
                options_for_select([["ALL", ""]] + GridItem::ITEM_TYPES.map { |t| [t.titleize, t] }, @type_filter),
                class: "tui-input", style: "padding: 4px 8px;", onchange: "this.form.submit()" %>
          <% if @type_filter.present? %>
            <%= tui_button "× clear", admin_grid_item_definitions_path, style: "padding: 4px 10px; font-size: 0.8em;" %>
          <% end %>
        <% end %>
      </div>

      <%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "overflow-x: auto;") do %>
        <table class="tui-table" style="width: 100%;">
          <thead>
            <tr>
              <th style="text-align: left;">Name</th>
              <th style="text-align: left;">Slug</th>
              <th style="text-align: left;">Type</th>
              <th style="text-align: left;">Rarity</th>
              <th style="text-align: right;">Value</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @definitions.each_with_index do |defn, i| %>
              <tr style="<%= " background: #112;" if i.odd? %>">
                <td class="cyan-255-text"><%= defn.name %></td>
                <td style="color: #666; font-family: monospace;"><%= defn.slug %></td>
                <td style="color: #9ca3af;"><%= defn.item_type %></td>
                <td style="color: <%= defn.rarity_color %>;"><%= defn.rarity_label %></td>
                <td style="text-align: right; color: #fbbf24;"><%= defn.value %></td>
                <td style="text-align: center; white-space: nowrap; display: flex; gap: 8px; justify-content: center; align-items: center; padding: 8px 4px;">
                  <%= tui_button "Edit", edit_admin_grid_item_definition_path(defn), color: :cyan, style: "padding: 4px 12px; font-size: 0.85em; box-shadow: none; line-height: 1;" %>
                  <%= tui_button "History", history_admin_grid_item_definition_path(defn), color: :purple, style: "padding: 4px 12px; font-size: 0.85em; box-shadow: none; line-height: 1;" %>
                  <%= tui_button_to "Delete", admin_grid_item_definition_path(defn), method: :delete,
                        data: {confirm: "Delete '#{defn.name}'? This will fail if any items or listings reference it."},
                        color: :red, style: "padding: 4px 12px; font-size: 0.85em; box-shadow: none; line-height: 1;",
                        form: {style: "display: inline; margin: 0;"} %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <p style="color: #666; margin-top: 10px; font-size: 0.85em;">
        <%= @definitions.count %> definitions
      </p>
    </div>
<% end %>
