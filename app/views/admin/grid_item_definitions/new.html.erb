<%# /root/grid_item_definitions/new — a new item definition on the record
    screen's shell; the yield script after the screen. %>
<% content_for :title, "/root/grid_item_definitions/new :: NEW ITEM" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "NEW ITEM", sub: "ROOT · ITEM · /root/grid_item_definitions/new"} do %>
    <%= link_to "[<] ITEMS", admin_grid_item_definitions_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @definition, url: admin_grid_item_definitions_path, local: true do |f| %>
    <%= render "form", f: f, definition: @definition %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[CREATE ITEM]</button>
      <%= link_to "[CANCEL]", admin_grid_item_definitions_path, class: "rc-btn" %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :systems %>
  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems) %>
</div>
<%= render "script" %>
