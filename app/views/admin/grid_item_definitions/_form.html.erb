<%# The item definition's fields as console status rows (ConsoleFormBuilder
    rc_* rows), // DESCRIPTION //, // PROPERTIES // (the JSON object as
    typed — re-rendered from the params on a 422) and // SALVAGE YIELDS
    // — one row per yield (POS · OUTPUT · QTY · [x]; a saved row's [x]
    sets its _destroy flag and hides it, a new row's removes it; a row
    already flagged comes back hidden on a rejected save) and
    [+] ADD YIELD, both driven by grid_item_definitions/_script (the
    #salvage-yields-table / #add-yield-btn / #yield-row-template ids).
    The commit row belongs to the caller. Locals: f, definition;
    @all_definitions, @sorted_yields (edit: the saved yields + one blank). %>
<% output_options = @all_definitions.map { |d| ["#{d.name} [#{d.rarity_label}]", d.id] } %>
<% properties_json = params.dig(:grid_item_definition, :properties_json) || (definition.properties.present? ? JSON.pretty_generate(definition.properties) : "{}") %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, required: true, autocomplete: "off", hint: "lowercase letters, numbers, hyphens only" %>
  <%= f.rc_select :item_type, GridItem::ITEM_TYPES.map { |t| [t.titleize, t] }, {include_blank: "Select..."}, label: "TYPE" %>
  <%= f.rc_select :rarity, GridItem::RARITIES.map { |r| [GridItem::RARITY_LABELS[r] || r.upcase, r] }, {include_blank: "Select..."} %>
  <%= f.rc_number_field :value, label: "BASE VALUE", width: :short, min: 0, hint: "CRED" %>
  <%= f.rc_number_field :max_stack, label: "MAX STACK", width: :short, min: 1, hint: "blank = unlimited" %>
</div>

<%= f.rc_text_area :description, rows: 3, spellcheck: true %>

<div class="console-rule"><span>// PROPERTIES //</span></div>
<%= text_area_tag "grid_item_definition[properties_json]", properties_json, id: "grid_item_definition_properties_json", rows: 6,
  class: "rc-textarea rc-textarea--code", spellcheck: false, aria: {label: "Properties (JSON)"}, data: {controller: "autogrow", action: "input->autogrow#grow"} %>
<p class="rc-sub">JSON object. Components: {"slot": "gpu", "rate_multiplier": 1.5} · consumables: {"effect_type": "heal", "amount": 30} <%= f.rc_errors(:properties) %></p>

<section id="salvage-yields-table" class="console-section rc-ledger rc-ledger--parts" aria-label="Salvage yields">
  <div class="console-rule"><span>// SALVAGE YIELDS //</span></div>
  <p class="rc-sub">Items produced when this item is salvaged. No yields = XP only. UNICORN items cannot be salvaged regardless.</p>
  <div class="rc-row rc-row--head" aria-hidden="true">
    <span>POS</span><span>OUTPUT ITEM</span><span class="rc-cell--r">QTY</span><span></span>
  </div>
  <%= f.fields_for :salvage_yields, @sorted_yields || definition.salvage_yields do |ff| %>
    <%= tag.div class: "rc-row", hidden: ff.object.marked_for_destruction? do %>
      <span><%= ff.number_field :position, class: "rc-input", min: 0, aria: {label: "Position"} %></span>
      <span><%= ff.select :output_definition_id, output_options, {include_blank: "— select output —"}, class: "rc-select", aria: {label: "Output item"} %></span>
      <span><%= ff.number_field :quantity, class: "rc-input rc-input--r", min: 1, aria: {label: "Quantity"} %></span>
      <span class="rc-links">
        <% if ff.object.persisted? %>
          <%= ff.hidden_field :id %>
          <%= ff.hidden_field :_destroy, value: ff.object.marked_for_destruction? ? "1" : "0", class: "destroy-flag" %>
          <button type="button" class="rc-btn rc-btn--danger yield-destroy-btn" data-persisted="true" aria-label="Remove yield">[x]</button>
        <% else %>
          <button type="button" class="rc-btn rc-btn--danger yield-destroy-btn" aria-label="Remove yield">[x]</button>
        <% end %>
      </span>
    <% end %>
  <% end %>
</section>
<div class="rc-actions">
  <button type="button" id="add-yield-btn" class="rc-btn">[+] ADD YIELD</button>
  <%= f.rc_errors(:salvage_yields) %>
</div>
