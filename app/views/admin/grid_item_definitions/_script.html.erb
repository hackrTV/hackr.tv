<%# The item definition record's script, rendered after the screen: the
    salvage yield rows of grid_item_definitions/_form — [+] ADD YIELD
    clones #yield-row-template into #salvage-yields-table under a fresh
    nested-attributes index, [x] removes a new row or flags a saved one
    _destroy and hides it. Assigns: @definition, @all_definitions. %>
<template id="yield-row-template">
  <div class="rc-row">
    <span><input type="number" name="grid_item_definition[salvage_yields_attributes][__INDEX__][position]" class="rc-input" min="0" value="0" aria-label="Position"></span>
    <span>
      <select name="grid_item_definition[salvage_yields_attributes][__INDEX__][output_definition_id]" class="rc-select" aria-label="Output item">
        <option value="">— select output —</option>
        <% @all_definitions.each do |d| %>
          <option value="<%= d.id %>"><%= d.name %> [<%= d.rarity_label %>]</option>
        <% end %>
      </select>
    </span>
    <span><input type="number" name="grid_item_definition[salvage_yields_attributes][__INDEX__][quantity]" class="rc-input rc-input--r" min="1" value="1" aria-label="Quantity"></span>
    <span class="rc-links"><button type="button" class="rc-btn rc-btn--danger yield-destroy-btn" aria-label="Remove yield">[x]</button></span>
  </div>
</template>

<script nonce="<%= content_security_policy_nonce %>">
  (function() {
    var yieldRowIndex = <%= @definition.salvage_yields.size + 1000 %>;
    var table = document.getElementById('salvage-yields-table');

    // Event delegation for all destroy buttons (current + future rows)
    table.addEventListener('click', function(e) {
      var btn = e.target.closest('.yield-destroy-btn');
      if (!btn) return;
      var row = btn.closest('.rc-row');
      if (btn.dataset.persisted) {
        row.querySelector('.destroy-flag').value = '1';
        row.hidden = true;
      } else {
        row.remove();
      }
    });

    // Add yield row
    document.getElementById('add-yield-btn').addEventListener('click', function() {
      var template = document.getElementById('yield-row-template');
      var clone = template.content.cloneNode(true);
      clone.querySelectorAll('[name]').forEach(function(el) {
        el.name = el.name.replace('__INDEX__', yieldRowIndex);
      });
      table.appendChild(clone);
      yieldRowIndex++;
    });
  })();
</script>
