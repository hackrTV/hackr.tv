<%# /root/grid_transit_routes/new — a new transit route on the record
    screen's shell (stops are added once it is saved). %>
<% content_for :title, "/root/grid_transit_routes/new :: NEW ROUTE" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "NEW ROUTE", sub: "ROOT · ROUTE · /root/grid_transit_routes/new"} do %>
    <%= link_to "[<] ROUTES", admin_grid_transit_routes_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @route, url: admin_grid_transit_routes_path, local: true do |f| %>
    <%= render "form", f: f %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[CREATE ROUTE]</button>
      <%= link_to "[CANCEL]", admin_grid_transit_routes_path, class: "rc-btn" %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :world %>
  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world) %>
</div>
