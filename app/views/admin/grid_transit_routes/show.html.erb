<%= render TuiWindowComponent.new(title: "/root/grid/transit_routes/#{@route.slug} :: TRANSIT ROUTE", variant: :admin, width: 1200) do %>
    <div style="padding: 20px;">
      <p><strong>Name:</strong> <%= @route.name %></p>
      <p><strong>Type:</strong> <%= @route.grid_transit_type.name %></p>
      <p><strong>Region:</strong> <%= @route.grid_region.name %></p>
      <p><strong>Stops:</strong> <%= @stops.size %></p>

      <% if @stops.any? %>
        <h3 class="cyan-255-text" style="margin: 20px 0 15px 0;">[:: STOPS ::]</h3>
        <%= render TuiWindowComponent.new(variant: :panel, fieldset: false) do %>
          <table class="tui-table" style="width: 100%;">
            <thead>
              <tr>
                <th style="text-align: center;">Pos</th>
                <th style="text-align: left;">Label</th>
                <th style="text-align: left;">Room</th>
                <th style="text-align: center;">Terminus</th>
              </tr>
            </thead>
            <tbody>
              <% @stops.each do |s| %>
                <tr>
                  <td style="text-align: center;"><%= s.position %></td>
                  <td><%= s.display_name %></td>
                  <td style="color: #22d3ee;"><%= s.grid_room.name %></td>
                  <td style="text-align: center;"><%= s.is_terminus? ? "Yes" : "" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      <% end %>

      <div style="margin-top: 20px;">
        <%= tui_button "Edit", edit_admin_grid_transit_route_path(@route), color: :green, style: "padding: 8px 20px;" %>
        <%= tui_button "Back", admin_grid_transit_routes_path, style: "padding: 8px 20px; margin-left: 10px;" %>
      </div>
    </div>
<% end %>
