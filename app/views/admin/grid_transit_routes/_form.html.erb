<%# The transit route's fields as console status rows (ConsoleFormBuilder
    rc_* rows), then // DESCRIPTION //. The commit row belongs to the
    caller. Locals: f; @transit_types, @regions. %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, required: true, autocomplete: "off", pattern: "[a-z0-9\\-]+", title: "lowercase letters, digits, hyphens", hint: "unique · lowercase letters, numbers, hyphens" %>
  <%= f.rc_select :grid_transit_type_id, @transit_types.map { |t| ["#{t.name} (#{t.category})", t.id] }, {include_blank: "-- Select --"}, label: "TYPE" %>
  <%= f.rc_select :grid_region_id, @regions.map { |r| [r.name, r.id] }, {include_blank: "-- Select --"}, label: "REGION", hint: "stops are the region's transit rooms" %>
  <%= f.rc_number_field :position, width: :short, min: 0 %>
  <%= f.rc_flags("FLAGS") do %>
    <%= f.rc_check_box :loop_route, label: "LOOP" %>
    <%= f.rc_check_box :active, label: "ACTIVE" %>
  <% end %>
</div>

<%= f.rc_text_area :description, rows: 3, spellcheck: true %>
