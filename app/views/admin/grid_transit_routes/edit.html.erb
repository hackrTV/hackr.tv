<%# /root/grid_transit_routes/:slug/edit — the transit route as a console
    screen (2026-10-31; the read-only show page folded in here and
    redirects). Bar (name · ROOT · ROUTE · path; [<] ROUTES, [>] TYPE,
    [HISTORY]), the fields, // COMMIT // ([SAVE] [CANCEL] · [DELETE] —
    refused while journeys reference it), // STOPS // in order ([x]
    removes one), // ADD STOP // (a picker over the region's transit
    rooms, label, terminus), destinations, the > prompt. URLs use
    slug_in_database. The delete form is hidden at the end, the picker's
    script after the screen. Assigns: @route, @stops, @transit_types,
    @regions, @region_rooms. %>
<% slug = @route.slug_in_database %>
<% name = @route.name_in_database %>
<% stops = @stops.to_a %>
<% type = GridTransitType.find_by(id: @route.grid_transit_type_id_in_database) %>
<% content_for :title, "/root/grid_transit_routes/#{slug} :: #{name}" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: name, sub: "ROOT · ROUTE · /root/grid_transit_routes/#{slug}"} do %>
    <%= link_to "[<] ROUTES", admin_grid_transit_routes_path, class: "console-bar-link" %>
    <% if type %><%= link_to "[>] TYPE", edit_admin_grid_transit_type_path(type), class: "console-bar-link" %><% end %>
    <%= link_to "[HISTORY]", history_admin_grid_transit_route_path(slug), class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @route, url: admin_grid_transit_route_path(slug), method: :patch, local: true do |f| %>
    <%= render "form", f: f %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[SAVE ROUTE]</button>
      <%= link_to "[CANCEL]", admin_grid_transit_routes_path, class: "rc-btn" %>
      <span class="rc-actions--end">
        <button type="submit" form="delete-route" class="rc-btn rc-btn--danger">[DELETE ROUTE]</button>
      </span>
    </div>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--stops" aria-label="Stops">
    <div class="console-rule"><span>// STOPS · <%= stops.size %> //</span></div>
    <% if stops.empty? %>
      <%= render "admin/console/empty", text: "NO STOPS ON THIS ROUTE", hint: "ADD STOP below" %>
    <% end %>
    <% stops.each do |stop| %>
      <div class="rc-row">
        <span class="console-tag">[<%= stop.position %>]</span>
        <div class="cc-text">
          <%= link_to stop.display_name, edit_admin_grid_room_path(stop.grid_room), class: "console-link cc-name" %>
          <div class="cc-meta"><%= stop.grid_room.grid_zone.name %> / <%= stop.grid_room.name %></div>
        </div>
        <span class="rc-cell <%= stop.is_terminus? ? "rc-hot" : "rc-off" %>"><%= stop.is_terminus? ? "TERMINUS" : "STOP" %></span>
        <span class="rc-cell rc-links">
          <%= button_to "[x]", remove_stop_admin_grid_transit_route_path(slug, stop_id: stop.id), method: :delete, class: "rc-btn rc-btn--danger",
            aria: {label: "Remove stop #{stop.display_name}"}, form: {data: {confirm: "Remove stop '#{stop.display_name}'?"}} %>
        </span>
      </div>
    <% end %>
  </section>

  <div class="console-rule"><span>// ADD STOP //</span></div>
  <%= form_with url: add_stop_admin_grid_transit_route_path(slug), method: :post, local: true, id: "add-stop-form" do %>
    <div class="console-status">
      <%= render "admin/console/picker", label: "ROOM", key: "stop-room", name: "grid_transit_stop[grid_room_id]", value: nil, text: nil,
        placeholder: "type a transit room of the region", status: pluralize(@region_rooms.length, "transit room") %>
      <%= root_field("LABEL", id: "grid_transit_stop_label") do %>
        <%= text_field_tag "grid_transit_stop[label]", nil, id: "grid_transit_stop_label", class: "rc-input", autocomplete: "off", placeholder: "override the room's name" %>
        <span class="rc-hint">optional</span>
      <% end %>
      <%= root_field("FLAGS") do %>
        <label class="rc-check"><%= check_box_tag "grid_transit_stop[is_terminus]", "1", false %> TERMINUS</label>
      <% end %>
    </div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[+] ADD STOP</button>
      <span class="rc-hint">added at the end of the line</span>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :world %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world) %>

  <div class="rc-hidden-forms">
    <%= root_delete_form("delete-route", admin_grid_transit_route_path(slug), confirm: "Delete route '#{name}' and its stops?") %>
  </div>
</div>
<%= render "admin/shared/combobox" %>
<script nonce="<%= content_security_policy_nonce %>">
  (function() {
    var rooms = <%= raw json_escape(@region_rooms.map { |r| {id: r.id, name: r.name, zone_name: r.grid_zone.name} }.to_json) %>;
    AdminCombobox.init({
      inputId: 'stop-room-input',
      hiddenId: 'stop-room-hidden',
      dropdownId: 'stop-room-dropdown',
      statusId: 'stop-room-status',
      items: rooms,
      getSearchText: function(r) { return (r.name + ' ' + r.zone_name).toLowerCase(); },
      getGroupKey: function(r) { return r.zone_name; },
      renderOption: function(r, e) {
        return '<span class="cb-name">' + e(r.name) + '</span>';
      },
      getId: function(r) { return String(r.id); },
      getLabel: function(r) { return r.zone_name + ' / ' + r.name; },
      emptyText: 'No transit rooms in this region',
      selectedText: 'Room selected',
      submitError: 'Select a room first',
      formId: 'add-stop-form'
    });
  })();
</script>
