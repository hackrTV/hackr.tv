<%# /root/pulse_wire — every pulse on the WIRE as a console ledger
    (2026-10-31; root_console.css): bar ([>] THE WIRE), ON RECORD, the
    // FILTER // rows (server-side: STATUS links, HACKR, SEARCH, FROM / TO
    — [FILTER] / [x] CLEAR), the BULK row (select-all, count, [DROP
    SELECTED] [DELETE SELECTED] — the inline script below builds the
    POST / DELETE; ids verbatim), // PULSES // newest first ([NN] ·
    checkbox · content over @alias / SPLICE / DROPPED · echoes · splices
    · when · [>] VIEW [DROP] / [RESTORE] [DEL]), destinations, the >
    prompt (NN opens the pulse on the WIRE). Assigns: @pulses. %>
<% content_for :title, "/root/pulse_wire :: WIRE" %>
<% pulses = @pulses.to_a %>
<% numbers = pulses.each_index.map { |i| root_num(i, total: pulses.size) } %>
<% status = params[:status].to_s.presence_in(%w[active dropped]).to_s %>
<% keep = request.query_parameters.slice("username", "search", "start_date", "end_date") %>
<% filtered = status.present? || keep.values.any?(&:present?) %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "PULSEWIRE", sub: "ROOT · MODERATION · /root/pulse_wire"} do %>
    <%= link_to "[>] THE WIRE", wire_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(pulses.size, "pulse") %><% if filtered %> <span class="console-dim">· filtered</span><% end %> <span class="console-dim">· <%= pulses.count(&:pulse_dropped) %> dropped</span></span>
    </div>
  </div>

  <%= form_with url: admin_pulse_wire_index_path, method: :get, local: true do %>
    <div class="console-rule"><span>// FILTER //</span></div>
    <div class="console-status">
      <div class="console-status-row rc-field">
        <span class="console-key">STATUS</span>
        <span class="console-val">
          <% [["ALL", ""], ["ACTIVE", "active"], ["DROPPED", "dropped"]].each do |word, value| %>
            <%= link_to word, admin_pulse_wire_index_path(keep.merge(status: value.presence).compact), class: class_names("rc-btn", "rc-btn--on": status == value), aria: {current: status == value && "page"} %>
          <% end %>
        </span>
      </div>
      <%= root_field("HACKR", id: "username") do %>
        <%= text_field_tag :username, params[:username], class: "rc-input", placeholder: "alias", autocomplete: "off", spellcheck: "false" %>
      <% end %>
      <%= root_field("SEARCH", id: "search") do %>
        <%= text_field_tag :search, params[:search], class: "rc-input rc-input--wide", placeholder: "words in the pulse", autocomplete: "off" %>
      <% end %>
      <%= root_field("FROM", id: "start_date") do %>
        <%= date_field_tag :start_date, params[:start_date], class: "rc-input rc-input--date" %>
        <%= label_tag :end_date, "TO", class: "rc-count" %>
        <%= date_field_tag :end_date, params[:end_date], class: "rc-input rc-input--date" %>
      <% end %>
    </div>
    <% if status.present? %><%= hidden_field_tag :status, status %><% end %>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[FILTER]</button>
      <%= link_to "[x] CLEAR", admin_pulse_wire_index_path, class: "rc-btn" %>
    </div>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--pulses" aria-label="Pulses">
    <div class="console-rule"><span>// PULSES //</span></div>
    <% if pulses.empty? %>
      <%= render "admin/console/empty", text: filtered ? "NO PULSES MATCH" : "THE WIRE IS EMPTY", hint: filtered ? "[x] CLEAR shows every pulse" : "no pulses broadcast yet" %>
    <% else %>
      <div class="console-status-row rc-field">
        <span class="console-key">BULK</span>
        <span class="console-val">
          <label class="rc-check"><input type="checkbox" id="select-all"> SELECT ALL</label>
          <span id="selected-count" class="rc-count">0 selected</span>
          <button type="button" id="bulk-pulse-drop" class="rc-btn" disabled>[DROP SELECTED]</button>
          <button type="button" id="bulk-delete" class="rc-btn rc-btn--danger" disabled>[DELETE SELECTED]</button>
        </span>
      </div>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>NN</span><span></span><span>PULSE</span><span>ECHO SPLICE</span><span>PULSED</span><span></span>
      </div>
    <% end %>
    <% pulses.each_with_index do |pulse, i| %>
      <% num = numbers[i] %>
      <% author = pulse.grid_hackr.hackr_alias %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <input type="checkbox" class="pulse-checkbox rc-check-input" value="<%= pulse.id %>" aria-label="Select pulse <%= num %>">
        <div class="cc-text">
          <span class="<%= "rc-off" if pulse.pulse_dropped %>"><%= pulse.content %></span>
          <div class="cc-meta">@<%= author %><% if pulse.is_splice? %> · SPLICE<% end %><% if pulse.pulse_dropped %> · <span class="rc-bad">DROPPED</span> <%= time_ago_in_words(pulse.pulse_dropped_at) %> ago<% end %></div>
        </div>
        <span class="rc-cell"><%= pulse.echo_count %> · <%= pulse.splice_count %></span>
        <span class="rc-cell"><%= pulse.pulsed_at.strftime("%Y-%m-%d %H:%M") %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[>] VIEW", wire_pulse_path(pulse.id), class: "console-link", target: "_blank", rel: "noopener", data: {command: num} %>
          <% if pulse.pulse_dropped %>
            <%= button_to "[RESTORE]", restore_admin_pulse_wire_path(pulse), class: "rc-btn" %>
          <% else %>
            <%= button_to "[DROP]", pulse_drop_admin_pulse_wire_path(pulse), class: "rc-btn", form: {data: {confirm: "Pulse-drop this pulse by @#{author}?"}} %>
          <% end %>
          <%= button_to "[DEL]", admin_pulse_wire_path(pulse), method: :delete, class: "rc-btn rc-btn--danger", form: {data: {confirm: "Permanently delete this pulse? This cannot be undone!"}} %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :moderation, except: "WIRE" %>

  <div class="console-rule"><span>// END OF WIRE //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:moderation, except: "WIRE", numbers: numbers, noun: "a pulse number") %>
</div>

<% if pulses.any? %>
  <script nonce="<%= content_security_policy_nonce %>">
    document.addEventListener('DOMContentLoaded', function() {
      const selectAllCheckbox = document.getElementById('select-all');
      const pulseCheckboxes = document.querySelectorAll('.pulse-checkbox');
      const selectedCount = document.getElementById('selected-count');
      const bulkPulseDropBtn = document.getElementById('bulk-pulse-drop');
      const bulkDeleteBtn = document.getElementById('bulk-delete');

      function updateSelectedCount() {
        const checked = document.querySelectorAll('.pulse-checkbox:checked');
        const count = checked.length;
        selectedCount.textContent = count + ' selected';

        // Enable/disable bulk action buttons
        bulkPulseDropBtn.disabled = count === 0;
        bulkDeleteBtn.disabled = count === 0;

        // Update select-all checkbox state
        if (count === 0) {
          selectAllCheckbox.checked = false;
          selectAllCheckbox.indeterminate = false;
        } else if (count === pulseCheckboxes.length) {
          selectAllCheckbox.checked = true;
          selectAllCheckbox.indeterminate = false;
        } else {
          selectAllCheckbox.checked = false;
          selectAllCheckbox.indeterminate = true;
        }
      }

      // Select all toggle
      selectAllCheckbox.addEventListener('change', function() {
        pulseCheckboxes.forEach(cb => {
          cb.checked = this.checked;
        });
        updateSelectedCount();
      });

      // Individual checkbox change
      pulseCheckboxes.forEach(cb => {
        cb.addEventListener('change', updateSelectedCount);
      });

      // Bulk pulse-drop
      bulkPulseDropBtn.addEventListener('click', function() {
        const checked = Array.from(document.querySelectorAll('.pulse-checkbox:checked'));
        const count = checked.length;

        if (count === 0) return;

        if (!confirm(`Pulse-drop ${count} pulse${count === 1 ? '' : 's'}?`)) {
          return;
        }

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '<%= bulk_pulse_drop_admin_pulse_wire_index_path %>';

        // CSRF token
        const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = 'authenticity_token';
        csrfInput.value = csrfToken;
        form.appendChild(csrfInput);

        // Pulse IDs
        checked.forEach(cb => {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'pulse_ids[]';
          input.value = cb.value;
          form.appendChild(input);
        });

        document.body.appendChild(form);
        form.submit();
      });

      // Bulk delete
      bulkDeleteBtn.addEventListener('click', function() {
        const checked = Array.from(document.querySelectorAll('.pulse-checkbox:checked'));
        const count = checked.length;

        if (count === 0) return;

        if (!confirm(`PERMANENTLY DELETE ${count} pulse${count === 1 ? '' : 's'}? This cannot be undone!`)) {
          return;
        }

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '<%= bulk_destroy_admin_pulse_wire_index_path %>';

        // Rails expects DELETE method via _method parameter
        const methodInput = document.createElement('input');
        methodInput.type = 'hidden';
        methodInput.name = '_method';
        methodInput.value = 'delete';
        form.appendChild(methodInput);

        // CSRF token
        const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = 'authenticity_token';
        csrfInput.value = csrfToken;
        form.appendChild(csrfInput);

        // Pulse IDs
        checked.forEach(cb => {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'pulse_ids[]';
          input.value = cb.value;
          form.appendChild(input);
        });

        document.body.appendChild(form);
        form.submit();
      });

      // Initialize count
      updateSelectedCount();
    });
  </script>
<% end %>
