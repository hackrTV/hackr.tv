<%# /root/pulse_wire/pulse_drops — the pulses moderation took off the
    WIRE as a console ledger (2026-10-31; root_console.css): bar ([<]
    WIRE), ON RECORD, // DROPPED // newest first ([NN] · content over
    @alias / SPLICE / first pulsed · echoes · splices · dropped ago · [>]
    VIEW [RESTORE] [DEL]), destinations, the > prompt (NN opens the pulse
    on the WIRE). Assigns: @pulses. %>
<% content_for :title, "/root/pulse_wire/pulse_drops :: DROPS" %>
<% pulses = @pulses.to_a %>
<% numbers = pulses.each_index.map { |i| root_num(i, total: pulses.size) } %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "PULSE DROPS", sub: "ROOT · MODERATION · /root/pulse_wire/pulse_drops"} do %>
    <%= link_to "[<] WIRE", admin_pulse_wire_index_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(pulses.size, "dropped pulse") %> <span class="console-dim">· off the WIRE by moderation · restore puts one back, delete is final</span></span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--drops" aria-label="Dropped pulses">
    <div class="console-rule"><span>// DROPPED //</span></div>
    <% if pulses.empty? %>
      <%= render "admin/console/empty", text: "NO DROPPED PULSES", hint: "every pulse on the WIRE is active" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>NN</span><span>PULSE</span><span>ECHO SPLICE</span><span>DROPPED</span><span></span>
      </div>
    <% end %>
    <% pulses.each_with_index do |pulse, i| %>
      <% num = numbers[i] %>
      <% author = pulse.grid_hackr.hackr_alias %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <span><%= pulse.content %></span>
          <div class="cc-meta">@<%= author %><% if pulse.is_splice? %> · SPLICE<% end %> · pulsed <%= pulse.pulsed_at.strftime("%Y-%m-%d %H:%M") %></div>
        </div>
        <span class="rc-cell"><%= pulse.echo_count %> · <%= pulse.splice_count %></span>
        <span class="rc-cell rc-bad"><%= time_ago_in_words(pulse.pulse_dropped_at) %> ago</span>
        <span class="rc-cell rc-links">
          <%= link_to "[>] VIEW", wire_pulse_path(pulse.id), class: "console-link", target: "_blank", rel: "noopener", data: {command: num} %>
          <%= button_to "[RESTORE]", restore_admin_pulse_wire_path(pulse), class: "rc-btn", form: {data: {confirm: "Restore this pulse by @#{author}?"}} %>
          <%= button_to "[DEL]", admin_pulse_wire_path(pulse), method: :delete, class: "rc-btn rc-btn--danger", form: {data: {confirm: "Permanently delete this pulse? This cannot be undone!"}} %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :moderation, except: "DROPS" %>

  <div class="console-rule"><span>// END OF DROPS //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:moderation, except: "DROPS", numbers: numbers, noun: "a pulse number") %>
</div>
