<%# The codex entry's fields as console status rows (ConsoleFormBuilder
    rc_* rows), then // SUMMARY // // CONTENT // // METADATA // as
    growing textareas (metadata is a JSON object the controller parses;
    a rejected save shows the JSON as typed, not the stored value). The
    commit row belongs to the caller. Locals: f, entry. %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, autocomplete: "off", pattern: "[a-z0-9\\-]+", title: "lowercase letters, digits, hyphens",
    hint: "/codex/#{entry.slug_in_database.presence || "slug"} · blank = from the name · lowercase, hyphens" %>
  <%= f.rc_select :entry_type, CodexEntry::ENTRY_TYPES.map { |t| [t.upcase, t] }, {}, label: "TYPE" %>
  <%= f.rc_number_field :position, width: :short, min: 0, step: 1, hint: "the codex orders by this, then the name" %>
  <%= f.rc_flags("FLAGS", hint: "unchecked keeps the entry off /codex") do %>
    <%= f.rc_check_box :published, label: "PUBLISHED" %>
  <% end %>
</div>

<%= f.rc_text_area :summary, rows: 3, spellcheck: true %>
<%= f.rc_text_area :content, rows: 12, spellcheck: true, class: "rc-textarea--body", hint: "markdown" %>
<%= f.rc_text_area :metadata_json, label: "METADATA", rows: 4, spellcheck: false, class: "rc-textarea--code",
  value: params.dig(:codex_entry, :metadata_json) || (entry.metadata.present? ? JSON.pretty_generate(entry.metadata) : "{}"),
  hint: "a JSON object · blank = {}" %>
