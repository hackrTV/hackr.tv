<div class="tui-window white-text" style="display: block; background: #0a0a0a; padding: 20px;">
  <% if @entry.errors.any? %>
    <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin-bottom: 20px;">
      <p class="red-255-text"><%= @entry.errors.full_messages.join(", ") %></p>
    </div>
  <% end %>

  <div style="display: flex; gap: 20px; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 300px; margin-bottom: 20px;">
      <%= f.tui_text_field :name %>
    </div>
    <div style="flex: 1; min-width: 200px; margin-bottom: 20px;">
      <%= f.tui_text_field :slug %>
    </div>
  </div>

  <div style="display: flex; gap: 20px; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 200px; margin-bottom: 20px;">
      <%= f.tui_select :entry_type,
          options_for_select(CodexEntry::ENTRY_TYPES.map { |t| [t.titleize, t] }, @entry.entry_type),
          {} %>
    </div>
    <div style="flex: 1; min-width: 150px; margin-bottom: 20px;">
      <%= f.tui_number_field :position %>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <%= f.tui_text_area :summary, style: "min-height: 80px;" %>
  </div>

  <div style="margin-bottom: 20px;">
    <%= f.tui_text_area :content, style: "min-height: 200px;" %>
  </div>

  <div style="margin-bottom: 20px;">
    <%= f.tui_text_area :metadata_json, value: (@entry.metadata.present? ? JSON.pretty_generate(@entry.metadata) : "{}"), style: "min-height: 100px;", label: "METADATA", hint: "JSON object" %>
  </div>

  <div style="margin-bottom: 20px;">
    <%= f.tui_check_box :published, style: "width: 20px; height: 20px;" %>
  </div>

  <div style="margin-top: 20px;">
    <%= tui_submit @entry.new_record? ? "Create Entry" : "Update Entry", form: f, color: :green, style: "padding: 10px 20px; font-weight: bold;" %>
    <%= tui_button "Cancel", admin_codex_entries_path, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% if @entry.persisted? %>
      <%= tui_button "History", history_admin_codex_entry_path(@entry), color: :purple, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% end %>
  </div>
</div>
