<%# /root/codex_entries — the codex ledger as a console screen
    (2026-10-31; root_console.css): bar, ON RECORD row, the TYPE row
    (server-side ?entry_type=), the FILTER row (ledger-filter: name /
    slug / summary / type), // CODEX // rows ([NN] · name over slug ·
    summary · TYPE · LIVE / DRAFT · [EDIT] [HISTORY]), destinations, the
    > prompt (NN opens the record screen; deletes live there). Assigns:
    @entries, @type_filter. %>
<% content_for :title, "/root/codex_entries :: CODEX" %>
<% entries = @entries.to_a %>
<% numbers = entries.each_index.map { |i| root_num(i, total: entries.size) } %>
<% live = entries.count(&:published) %>
<div class="console console--root" data-controller="terminal ledger-filter" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "CODEX", sub: "ROOT · CONTENT · /root/codex_entries"} do %>
    <%= link_to "[+] NEW ENTRY", new_admin_codex_entry_path, class: "console-bar-link", data: {command: "new"} %>
    <%= link_to "[>] PUBLIC", codex_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(entries.size, "entry") %><% if @type_filter.present? %> · <%= @type_filter.upcase %><% end %> <span class="console-dim">· <%= live %> live · <%= entries.size - live %> draft</span></span>
    </div>
    <div class="console-status-row rc-field">
      <span class="console-key">TYPE</span>
      <span class="console-val">
        <%= link_to "ALL", admin_codex_entries_path, class: class_names("rc-btn", "rc-btn--on": @type_filter.blank?), aria: {current: @type_filter.blank? && "page"} %>
        <% CodexEntry::ENTRY_TYPES.each do |type| %>
          <%= link_to type.upcase, admin_codex_entries_path(entry_type: type), class: class_names("rc-btn", "rc-btn--on": @type_filter == type), aria: {current: @type_filter == type && "page"} %>
        <% end %>
      </span>
    </div>
    <div class="console-status-row rc-field rc-filter">
      <label class="console-key" for="ledger-filter">FILTER</label>
      <span class="console-val">
        <input type="search" id="ledger-filter" class="rc-input" placeholder="name · slug · summary · type" autocomplete="off" spellcheck="false"
          data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
        <span class="rc-count" data-ledger-filter-target="count"><%= entries.size %> / <%= entries.size %></span>
        <button type="button" class="rc-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger" aria-label="Codex">
    <div class="console-rule"><span>// CODEX //</span></div>
    <% if entries.empty? %>
      <%= render "admin/console/empty", text: "NO ENTRIES ON RECORD", hint: "[+] NEW ENTRY starts the wiki" %>
    <% end %>
    <% entries.each_with_index do |entry, i| %>
      <% num = numbers[i] %>
      <div class="rc-row" data-ledger-filter-target="row" data-search="<%= [entry.name, entry.slug, entry.summary, entry.entry_type].compact.join(" ").downcase %>">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to entry.name, edit_admin_codex_entry_path(entry), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= entry.slug %><% if entry.position %> · POS <%= entry.position %><% end %><% if entry.summary.present? %> · <%= truncate(entry.summary, length: 80) %><% end %></div>
        </div>
        <span class="rc-cell rc-hot"><%= entry.entry_type.upcase %></span>
        <span class="rc-cell <%= entry.published ? "rc-on" : "rc-off" %>"><%= entry.published ? "LIVE" : "DRAFT" %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[EDIT]", edit_admin_codex_entry_path(entry), class: "console-link" %>
          <%= link_to "[HISTORY]", history_admin_codex_entry_path(entry), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :content, except: "CODEX" %>

  <div class="console-rule"><span>// EVERY ENTRY ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:content, except: "CODEX", numbers: numbers, noun: "an entry number", extra: ["new"]) %>
</div>
