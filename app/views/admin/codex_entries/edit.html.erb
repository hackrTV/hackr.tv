<%# /root/codex_entries/:slug/edit — the codex entry as a console screen
    (2026-10-31; show redirects here). Bar (name · ROOT · CODEX · path;
    [<] CODEX, [>] PUBLIC while published, [HISTORY]), the fields, the
    prose rules, // COMMIT // ([SAVE] [CANCEL] · [DELETE]), destinations,
    the > prompt. The delete form is hidden at the end. URLs use
    slug_in_database. Assigns: @entry. %>
<% slug = @entry.slug_in_database %>
<% content_for :title, "/root/codex_entries/#{slug} :: #{@entry.name_in_database}" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: @entry.name_in_database, sub: "ROOT · CODEX · /root/codex_entries/#{slug}"} do %>
    <%= link_to "[<] CODEX", admin_codex_entries_path, class: "console-bar-link" %>
    <% if @entry.published_in_database %><%= link_to "[>] PUBLIC", codex_entry_path(slug), class: "console-bar-link" %><% end %>
    <%= link_to "[HISTORY]", history_admin_codex_entry_path(slug), class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @entry, url: admin_codex_entry_path(slug), method: :patch, local: true do |f| %>
    <%= render "form", f: f, entry: @entry %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[SAVE ENTRY]</button>
      <%= link_to "[CANCEL]", admin_codex_entries_path, class: "rc-btn" %>
      <span class="rc-actions--end">
        <button type="submit" form="delete-entry" class="rc-btn rc-btn--danger">[DELETE ENTRY]</button>
      </span>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :content %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:content) %>

  <div class="rc-hidden-forms">
    <%= root_delete_form("delete-entry", admin_codex_entry_path(slug), confirm: "Delete codex entry '#{@entry.name_in_database}'?") %>
  </div>
</div>
