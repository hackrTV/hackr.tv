<%# /root/codex_entries/new — a new codex entry on the record screen's
    shell. %>
<% content_for :title, "/root/codex_entries/new :: NEW ENTRY" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "NEW ENTRY", sub: "ROOT · CODEX · /root/codex_entries/new"} do %>
    <%= link_to "[<] CODEX", admin_codex_entries_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @entry, url: admin_codex_entries_path, local: true do |f| %>
    <%= render "form", f: f, entry: @entry %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[CREATE ENTRY]</button>
      <%= link_to "[CANCEL]", admin_codex_entries_path, class: "rc-btn" %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :content %>
  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:content) %>
</div>
