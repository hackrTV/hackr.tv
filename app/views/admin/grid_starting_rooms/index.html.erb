<%# /root/grid_starting_rooms — the starting rooms ledger as a console
    screen (2026-10-31; root_console.css): bar, ON RECORD row,
    // STARTING ROOMS // rows in the order a graduate is offered them
    ([NN] · name over the room · REGION · POS · LIVE / OFF · [HISTORY]),
    destinations, the > prompt (NN opens the record screen; deletes live
    there). Assigns: @starting_rooms. %>
<% content_for :title, "/root/grid_starting_rooms :: STARTING ROOMS" %>
<% starts = @starting_rooms.to_a %>
<% numbers = starts.each_index.map { |i| root_num(i) } %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "STARTING ROOMS", sub: "ROOT · WORLD · /root/grid_starting_rooms"} do %>
    <%= link_to "[+] NEW START", new_admin_grid_starting_room_path, class: "console-bar-link", data: {command: "new"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(starts.size, "starting room") %> <span class="console-dim">· <%= starts.count(&:active?) %> offered at graduation</span></span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--starts" aria-label="Starting rooms">
    <div class="console-rule"><span>// STARTING ROOMS //</span></div>
    <% if starts.empty? %>
      <%= render "admin/console/empty", text: "NO STARTING ROOMS", hint: "graduates stay in the room they finish the tutorial in" %>
    <% end %>
    <% starts.each_with_index do |start, i| %>
      <% num = numbers[i] %>
      <% room = start.grid_room %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to start.name, edit_admin_grid_starting_room_path(start), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= room.grid_zone&.name %> / <%= room.name %></div>
        </div>
        <span class="rc-cell"><%= room.grid_zone&.grid_region&.name || "—" %></span>
        <span class="rc-cell rc-cell--r">POS <%= start.position %></span>
        <span class="rc-cell <%= start.active? ? "rc-on" : "rc-off" %>"><%= start.active? ? "LIVE" : "OFF" %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[HISTORY]", history_admin_grid_starting_room_path(start), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :world, except: "STARTS" %>

  <div class="console-rule"><span>// EVERY START ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world, except: "STARTS", numbers: numbers, noun: "a start number", extra: ["new"]) %>
</div>
