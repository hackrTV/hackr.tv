<%# /root/grid_starting_rooms/new — a new starting room on the record
    screen's shell (active, last in the order). %>
<% content_for :title, "/root/grid_starting_rooms/new :: NEW START" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "NEW START", sub: "ROOT · START · /root/grid_starting_rooms/new"} do %>
    <%= link_to "[<] STARTS", admin_grid_starting_rooms_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @starting_room, url: admin_grid_starting_rooms_path, local: true, id: "starting-room-form" do |f| %>
    <%= render "form", f: f, start: @starting_room %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[CREATE START]</button>
      <%= link_to "[CANCEL]", admin_grid_starting_rooms_path, class: "rc-btn" %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :world %>
  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world) %>
</div>
<%= render "script" %>
