<%= render TuiWindowComponent.new(title: "/root/grid/starting_rooms/new :: NEW STARTING ROOM", variant: :admin, width: 1200) do %>

    <div style="padding: 20px;">
      <% if flash[:error] %>
        <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin: 20px 0;">
          <p class="red-255-text"><%= flash[:error] %></p>
        </div>
      <% end %>

      <%= form_with(model: [:admin, @starting_room]) do |f| %>
        <%= render "form", f: f %>
      <% end %>
    </div>
<% end %>
