<%# The starting room's fields as console status rows (ConsoleFormBuilder
    rc_* rows; ROOM is a typed picker — admin/console/_picker, which
    refuses the commit until a room is picked), then // BLURB //. The
    commit row belongs to the caller. Locals: f, start; @rooms. %>
<% room = start.grid_room %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= render "admin/console/picker", label: "ROOM", key: "room-cb", name: "grid_starting_room[grid_room_id]", value: start.grid_room_id,
    text: room && "#{room.grid_zone&.grid_region&.name} / #{room.grid_zone&.name} / #{room.name}", placeholder: "type a room, zone, region or type", status: pluralize(@rooms.length, "room"),
    errors: f.rc_errors(:grid_room_id) %>
  <%= f.rc_number_field :position, width: :short, hint: "the graduation menu lists starts by this" %>
  <%= f.rc_flags("FLAGS", hint: "unchecked keeps it off the graduation menu") do %>
    <%= f.rc_check_box :active, label: "ACTIVE" %>
  <% end %>
</div>

<%= f.rc_text_area :blurb, rows: 3, spellcheck: true, hint: "shown to a hackr choosing where to start after the tutorial" %>
