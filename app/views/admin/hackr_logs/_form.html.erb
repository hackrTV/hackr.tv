<%# The log record's fields as console status rows (ConsoleFormBuilder
    rc_* rows) and // BODY // as one growing textarea. The commit row
    belongs to the caller. Locals: f, log; @hackrs for the author. %>
<div class="console-status">
  <%= f.rc_text_field :title, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, required: true, autocomplete: "off",
    hint: "/logs/#{log.slug_in_database.presence || "slug"} · the public URL" %>
  <%= f.rc_collection_select :grid_hackr_id, @hackrs, :id, :hackr_alias, label: "AUTHOR", include_blank: "— select author —" %>
  <%= f.rc_text_field :timeline, width: :short, autocomplete: "off", hint: "the era the log belongs to · 2120s" %>
  <%= f.rc_datetime_local_field :published_at, label: "PUBLISHED AT", hint: "the logs page orders by this" %>
  <%= f.rc_flags("FLAGS", hint: "unchecked keeps the log off /logs") do %>
    <%= f.rc_check_box :published, label: "PUBLISHED" %>
  <% end %>
</div>

<%= f.rc_text_area :body, rows: 16, required: true, spellcheck: true, class: "rc-textarea--body", hint: "markdown" %>
