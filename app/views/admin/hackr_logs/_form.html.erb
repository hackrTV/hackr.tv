<%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "padding: 20px;") do %>
  <% if @log.errors.any? %>
    <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin-bottom: 20px;">
      <p class="red-255-text"><%= @log.errors.full_messages.join(", ") %></p>
    </div>
  <% end %>

  <div style="display: flex; gap: 20px; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 300px; margin-bottom: 20px;">
      <%= f.tui_text_field :title %>
    </div>
    <div style="flex: 1; min-width: 200px; margin-bottom: 20px;">
      <%= f.tui_text_field :slug %>
    </div>
  </div>

  <div style="display: flex; gap: 20px; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 200px; margin-bottom: 20px;">
      <%= f.tui_collection_select :grid_hackr_id, @hackrs, :id, :hackr_alias,
          { include_blank: "— Select Author —" },
          label: "AUTHOR" %>
    </div>
    <div style="flex: 1; min-width: 150px; margin-bottom: 20px;">
      <%= f.tui_text_field :timeline %>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <%= f.tui_text_area :body, style: "min-height: 300px;" %>
  </div>

  <div style="display: flex; gap: 20px; flex-wrap: wrap; align-items: center;">
    <div style="margin-bottom: 20px;">
      <%= f.tui_check_box :published, style: "width: 20px; height: 20px;" %>
    </div>
    <div style="flex: 1; min-width: 200px; margin-bottom: 20px;">
      <%= f.tui_datetime_field :published_at %>
    </div>
  </div>

  <div style="margin-top: 20px;">
    <%= tui_submit @log.new_record? ? "Create Log" : "Update Log", form: f, color: :green, style: "padding: 10px 20px; font-weight: bold;" %>
    <%= tui_button "Cancel", admin_hackr_logs_path, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% if @log.persisted? %>
      <%= tui_button "History", history_admin_hackr_log_path(@log), color: :purple, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% end %>
  </div>
<% end %>
