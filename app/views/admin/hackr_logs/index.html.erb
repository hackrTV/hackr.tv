<%= render TuiWindowComponent.new(title: "/root/hackr_logs :: MANAGE LOGS", variant: :admin) do %>

    <div style="padding: 20px;">
      <!-- Flash Messages -->
      <% if flash[:success] %>
        <div style="background: #003300; border: 2px solid #00ff00; padding: 15px; margin: 20px 0;">
          <p class="green-255-text">✓ SUCCESS</p>
          <p class="white-text"><%= flash[:success] %></p>
        </div>
      <% end %>

      <% if flash[:error] %>
        <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin: 20px 0;">
          <p class="red-255-text">⚠ ERROR</p>
          <p class="white-text"><%= flash[:error] %></p>
        </div>
      <% end %>

      <!-- Navigation -->
      <div style="margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
        <%= tui_button "← Dashboard", admin_root_path, color: :green, style: "padding: 8px 20px;" %>
        <%= tui_button "+ New", new_admin_hackr_log_path, color: :cyan, style: "padding: 8px 20px;" %>
      </div>

      <!-- Logs Table -->
      <% if @logs.any? %>
        <%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "margin-top: 20px;") do %>
          <table class="tui-table" style="width: 100%;">
            <thead>
              <tr>
                <th style="text-align: left;">Title</th>
                <th style="text-align: left;">Author</th>
                <th style="text-align: center;">Status</th>
                <th style="text-align: center;">Published</th>
                <th style="text-align: center;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @logs.each_with_index do |log, i| %>
                <tr class="admin-table-row" style="<%= " background: #112;" if i.odd? %>">
                  <td>
                    <strong><%= log.title %></strong>
                    <br>
                    <small style="color: #666; font-family: monospace;">/<%= log.slug %></small>
                  </td>
                  <td><%= log.grid_hackr&.hackr_alias %></td>
                  <td style="text-align: center;">
                    <% if log.published? %>
                      <span class="green-255-text">✓ Published</span>
                    <% else %>
                      <span style="color: #888;">⊗ Draft</span>
                    <% end %>
                  </td>
                  <td style="text-align: center;">
                    <%= log.published_at&.strftime("%Y-%m-%d %H:%M") || "—" %>
                  </td>
                  <td style="text-align: center; white-space: nowrap;">
                    <%= tui_button "Edit", edit_admin_hackr_log_path(log), style: "padding: 2px 8px; font-size: 0.8em;" %>
                    <%= tui_button "History", history_admin_hackr_log_path(log), color: :purple, style: "padding: 2px 8px; font-size: 0.8em; margin-left: 4px;" %>
                    <%= tui_button_to "Delete", admin_hackr_log_path(log), method: :delete, form: { style: "display: inline;" }, color: :red, style: "padding: 2px 8px; font-size: 0.8em; margin-left: 4px;", data: { confirm: "Delete '#{log.title}'?" } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      <% else %>
        <div style="padding: 40px; text-align: center; background: #1a1a1a; border: 1px solid #333;">
          <p style="color: #666; font-size: 1.2em;">No log entries yet. Write your first one!</p>
        </div>
      <% end %>
    </div>
<% end %>
