<%# /root/hackr_logs — the logs ledger as a console screen (2026-10-31;
    root_console.css): bar, ON RECORD row, the FILTER row (ledger-filter:
    title / slug / author / timeline), // LOGS // rows ([NN] · title over
    slug · author · timeline · LIVE / DRAFT · published · [EDIT]
    [HISTORY]), destinations, the > prompt (NN opens the record screen;
    deletes live there). Assigns: @logs. %>
<% content_for :title, "/root/hackr_logs :: LOGS" %>
<% logs = @logs.to_a %>
<% numbers = logs.each_index.map { |i| root_num(i, total: logs.size) } %>
<% live = logs.count(&:published?) %>
<div class="console console--root" data-controller="terminal ledger-filter" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "LOGS", sub: "ROOT · CONTENT · /root/hackr_logs"} do %>
    <%= link_to "[+] NEW LOG", new_admin_hackr_log_path, class: "console-bar-link", data: {command: "new"} %>
    <%= link_to "[>] PUBLIC", hackr_logs_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(logs.size, "log") %> <span class="console-dim">· <%= live %> live · <%= logs.size - live %> draft</span></span>
    </div>
    <div class="console-status-row rc-field rc-filter">
      <label class="console-key" for="ledger-filter">FILTER</label>
      <span class="console-val">
        <input type="search" id="ledger-filter" class="rc-input" placeholder="title · slug · author · timeline" autocomplete="off" spellcheck="false"
          data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
        <span class="rc-count" data-ledger-filter-target="count"><%= logs.size %> / <%= logs.size %></span>
        <button type="button" class="rc-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger" aria-label="Logs">
    <div class="console-rule"><span>// LOGS //</span></div>
    <% if logs.empty? %>
      <%= render "admin/console/empty", text: "NO LOGS ON RECORD", hint: "[+] NEW LOG opens the first transmission" %>
    <% end %>
    <% logs.each_with_index do |log, i| %>
      <% num = numbers[i] %>
      <% author = log.grid_hackr&.hackr_alias %>
      <div class="rc-row" data-ledger-filter-target="row" data-search="<%= [log.title, log.slug, author, log.timeline].compact.join(" ").downcase %>">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to log.title, edit_admin_hackr_log_path(log), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= log.slug %><% if author %> · @<%= author %><% end %> · <%= log.timeline %></div>
        </div>
        <span class="rc-cell <%= log.published? ? "rc-on" : "rc-off" %>"><%= log.published? ? "LIVE" : "DRAFT" %></span>
        <span class="rc-cell rc-cell--r"><%= log.published_at&.strftime("%Y-%m-%d") || "—" %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[EDIT]", edit_admin_hackr_log_path(log), class: "console-link" %>
          <%= link_to "[HISTORY]", history_admin_hackr_log_path(log), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :content, except: "LOGS" %>

  <div class="console-rule"><span>// EVERY TRANSMISSION ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:content, except: "LOGS", numbers: numbers, noun: "a log number", extra: ["new"]) %>
</div>
