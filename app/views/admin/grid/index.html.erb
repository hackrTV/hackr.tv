<%# /root/grid — the PULSE GRID's operator screen as a console
    (2026-10-31; root_console.css): bar ([>] HACKRS, [>] EXPORT), ON
    RECORD, // BROADCAST // (one system line into every room — POST
    broadcast), // ONLINE // ([NN] · alias · ROLE · room · room id), //
    RECENT MESSAGES // the last 50 oldest first (time · room · <alias>
    or [SYSTEM] · line), // HACKRS // every account ([NN] · alias over
    id / since / SVC · ROLE · CLR · XP · GRID access · LOGIN · NOW: ON
    while in the ONLINE set (active in the last 15 minutes and in a
    room), not merely holding a room · [GRANT] / [REVOKE] [ENABLE] / [DISABLE] [SVC] / [x] SVC), numbered
    through, destinations, the > prompt (NN opens the hackr inspector).
    Assigns: @online_hackrs, @recent_messages, @all_hackrs. %>
<% content_for :title, "/root/grid :: GRID" %>
<% online = @online_hackrs.to_a %>
<% online_ids = online.map(&:id).to_set %>
<% hackrs = @all_hackrs.to_a %>
<% messages = @recent_messages.to_a %>
<% total = online.size + hackrs.size %>
<% numbers = (0...total).map { |i| root_num(i, total: total) } %>
<% granted_ids = hackrs.select { |h| h.feature_grants.any? { |fg| fg.feature == FeatureGrant::PULSE_GRID } }.to_set(&:id) %>
<% granted = hackrs.count { |h| !h.admin? && granted_ids.include?(h.id) } %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "PULSE GRID", sub: "ROOT · MODERATION · /root/grid"} do %>
    <%= link_to "[>] HACKRS", admin_grid_hackrs_path, class: "console-bar-link" %>
    <%= link_to "[>] EXPORT", admin_grid_world_export_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(hackrs.size, "hackr") %> <span class="console-dim">· <%= online.size %> online · <%= hackrs.count(&:admin?) %> admin · <%= granted %> granted grid access · <%= hackrs.count(&:login_disabled?) %> login disabled</span></span>
    </div>
  </div>

  <%= form_with url: admin_grid_broadcast_path, method: :post, local: true do %>
    <div class="console-rule"><span>// BROADCAST //</span></div>
    <%= text_area_tag :message, nil, class: "rc-textarea", rows: 3, placeholder: "the line every room receives as [SYSTEM BROADCAST]",
      aria: {label: "Broadcast message"}, data: {controller: "autogrow", action: "input->autogrow#grow"} %>
    <p class="rc-sub">every room on the grid gets it, live in the terminal and the tactical grid</p>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--danger" data-confirm="Send broadcast to all rooms?">[BROADCAST]</button>
    </div>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--online" aria-label="Online hackrs">
    <div class="console-rule"><span>// ONLINE · <%= online.size %> //</span></div>
    <% if online.empty? %>
      <%= render "admin/console/empty", text: "NO HACKRS ONLINE" %>
    <% end %>
    <% online.each_with_index do |hackr, i| %>
      <% num = numbers[i] %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to hackr.hackr_alias, admin_grid_hackr_path(hackr), class: "console-link cc-name", data: {command: num} %><% if hackr.id == current_hackr.id %> <span class="console-dim">(you)</span><% end %>
        </div>
        <span class="rc-cell <%= hackr.admin? ? "rc-bad" : "rc-off" %>"><%= hackr.admin? ? "ADMIN" : "OPERATIVE" %></span>
        <span class="rc-cell"><%= hackr.current_room&.name || "—" %></span>
        <span class="rc-cell rc-cell--r"><%= hackr.current_room_id ? "##{hackr.current_room_id}" : "—" %></span>
      </div>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--chat" aria-label="Recent messages">
    <div class="console-rule"><span>// RECENT MESSAGES //</span></div>
    <% if messages.empty? %>
      <%= render "admin/console/empty", text: "NO MESSAGES YET" %>
    <% end %>
    <% messages.reverse_each do |message| %>
      <% system = message.message_type == "system" %>
      <div class="rc-row">
        <span class="console-tag"><%= message.created_at.strftime("%H:%M:%S") %></span>
        <span class="rc-cell"><%= message.room&.name || "unknown room" %></span>
        <div class="cc-text">
          <span><% if system %><span class="rc-bad">[SYSTEM]</span><% else %><span class="rc-on">&lt;<%= message.grid_hackr&.hackr_alias || "unknown" %>&gt;</span><% end %> <%= message.content %></span>
        </div>
      </div>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--hackrs" aria-label="Hackrs">
    <div class="console-rule"><span>// HACKRS · <%= hackrs.size %> //</span></div>
    <% if hackrs.empty? %>
      <%= render "admin/console/empty", text: "NO HACKRS ON RECORD" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>NN</span><span>HACKR</span><span>ROLE</span><span>CLR</span><span>XP</span><span>GRID</span><span>LOGIN</span><span>NOW</span><span></span>
      </div>
    <% end %>
    <% hackrs.each_with_index do |hackr, i| %>
      <% num = numbers[online.size + i] %>
      <% alias_name = hackr.hackr_alias %>
      <% grid_access = granted_ids.include?(hackr.id) %>
      <% now = online_ids.include?(hackr.id) %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to alias_name, admin_grid_hackr_path(hackr), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta">#<%= hackr.id %> · since <%= hackr.created_at.strftime("%Y-%m-%d") %><% if hackr.service_account? %> · <span class="rc-star">SERVICE ACCOUNT</span><% end %></div>
        </div>
        <span class="rc-cell <%= hackr.admin? ? "rc-bad" : "rc-off" %>"><%= hackr.admin? ? "ADMIN" : "OPERATIVE" %></span>
        <span class="rc-cell rc-hot"><%= hackr.stat("clearance") %></span>
        <span class="rc-cell rc-on"><%= hackr.stat("xp") %></span>
        <span class="rc-cell <%= (hackr.admin? || grid_access) ? "rc-on" : "rc-off" %>"><%= hackr.admin? ? "ADMIN" : (grid_access ? "GRANTED" : "NONE") %></span>
        <span class="rc-cell <%= hackr.login_disabled? ? "rc-bad" : "rc-on" %>"><%= hackr.login_disabled? ? "DISABLED" : "ENABLED" %></span>
        <span class="rc-cell <%= now ? "rc-on" : "rc-off" %>"><%= now ? "ON" : "OFF" %></span>
        <span class="rc-cell rc-links">
          <% unless hackr.admin? %>
            <% if grid_access %>
              <%= button_to "[REVOKE]", admin_grid_revoke_feature_path(hackr_id: hackr.id, feature: FeatureGrant::PULSE_GRID), method: :delete, class: "rc-btn rc-btn--danger", form: {data: {confirm: "Revoke grid access from #{alias_name}?"}} %>
            <% else %>
              <%= button_to "[GRANT]", admin_grid_grant_feature_path(hackr_id: hackr.id, feature: FeatureGrant::PULSE_GRID), class: "rc-btn", form: {data: {confirm: "Grant grid access to #{alias_name}?"}} %>
            <% end %>
          <% end %>
          <% if hackr.login_disabled? %>
            <%= button_to "[ENABLE]", admin_grid_enable_login_path(hackr_id: hackr.id), class: "rc-btn", form: {data: {confirm: "Re-enable login for #{alias_name}?"}} %>
          <% elsif hackr.id != current_hackr.id %>
            <%= button_to "[DISABLE]", admin_grid_disable_login_path(hackr_id: hackr.id), class: "rc-btn rc-btn--danger", form: {data: {confirm: "Disable login for #{alias_name}? They will be logged out immediately."}} %>
          <% end %>
          <% if hackr.service_account? %>
            <%= button_to "[x] SVC", admin_grid_toggle_service_account_path(hackr_id: hackr.id), class: "rc-btn", title: "Remove service account flag", form: {data: {confirm: "Remove service account flag from #{alias_name}?"}} %>
          <% else %>
            <%= button_to "[SVC]", admin_grid_toggle_service_account_path(hackr_id: hackr.id), class: "rc-btn", title: "Mark as a service account", form: {data: {confirm: "Mark #{alias_name} as a service account? API tokens will bypass login-disabled."}} %>
          <% end %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :moderation, except: "GRID" %>

  <div class="console-rule"><span>// END OF GRID //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:moderation, except: "GRID", numbers: numbers, noun: "a hackr number") %>
</div>
