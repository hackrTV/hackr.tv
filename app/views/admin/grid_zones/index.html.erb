<%# /root/grid_zones — the zones ledger as a console screen (2026-10-31;
    root_console.css): bar, ON RECORD row, the FILTER row (ledger-filter:
    name / slug / region / faction / playlist — replaces the old filter
    script), // ZONES // rows ([NN] · name over slug · REGION · FACTION
    · PLAYLIST · DANGER · ROOMS · [HISTORY]), destinations, the > prompt
    (NN opens the record screen; deletes live there). Assigns: @zones. %>
<% content_for :title, "/root/grid_zones :: ZONES" %>
<% zones = @zones.to_a %>
<% numbers = zones.each_index.map { |i| root_num(i, total: zones.size) } %>
<div class="console console--root" data-controller="terminal ledger-filter" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "ZONES", sub: "ROOT · WORLD · /root/grid_zones"} do %>
    <%= link_to "[+] NEW ZONE", new_admin_grid_zone_path, class: "console-bar-link", data: {command: "new"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(zones.size, "zone") %> <span class="console-dim">· <%= pluralize(zones.sum { |z| z.grid_rooms.size }, "room") %> · <%= zones.count { |z| z.danger_level.positive? } %> dangerous</span></span>
    </div>
    <div class="console-status-row rc-field rc-filter">
      <label class="console-key" for="ledger-filter">FILTER</label>
      <span class="console-val">
        <input type="search" id="ledger-filter" class="rc-input" placeholder="name · slug · region · faction · playlist" autocomplete="off" spellcheck="false"
          data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
        <span class="rc-count" data-ledger-filter-target="count"><%= zones.size %> / <%= zones.size %></span>
        <button type="button" class="rc-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--zones" aria-label="Zones">
    <div class="console-rule"><span>// ZONES //</span></div>
    <% if zones.empty? %>
      <%= render "admin/console/empty", text: "NO ZONES ON RECORD", hint: "[+] NEW ZONE adds one to a region" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span></span><span>ZONE</span><span>REGION</span><span>FACTION</span><span>PLAYLIST</span><span class="rc-cell--r">DANGER</span><span class="rc-cell--r">ROOMS</span><span></span>
      </div>
    <% end %>
    <% zones.each_with_index do |zone, i| %>
      <% num = numbers[i] %>
      <div class="rc-row" data-ledger-filter-target="row" data-search="<%= [zone.name, zone.slug, zone.grid_region&.name, zone.grid_faction&.name, zone.ambient_playlist&.name].compact.join(" ").downcase %>">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to zone.name, edit_admin_grid_zone_path(zone), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= zone.slug %></div>
        </div>
        <span class="rc-cell"><%= zone.grid_region&.name || "—" %></span>
        <span class="rc-cell"><%= zone.grid_faction&.name || "—" %></span>
        <span class="rc-cell <%= "rc-hot" if zone.ambient_playlist %>"><%= zone.ambient_playlist&.name || "—" %></span>
        <span class="rc-cell rc-cell--r <%= zone.danger_level.positive? ? "rc-bad" : "rc-off" %>"><%= zone.danger_level %></span>
        <span class="rc-cell rc-cell--r"><%= zone.grid_rooms.size %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[HISTORY]", history_admin_grid_zone_path(zone), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :world, except: "ZONES" %>

  <div class="console-rule"><span>// EVERY ZONE ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world, except: "ZONES", numbers: numbers, noun: "a zone number", extra: ["new"]) %>
</div>
