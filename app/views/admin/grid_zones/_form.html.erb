<%# The zone's fields as console status rows (ConsoleFormBuilder rc_*
    rows), then // DESCRIPTION //. The commit row belongs to the caller.
    Locals: f; @regions, @factions, @playlists for the selects. %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, required: true, autocomplete: "off", hint: "unique" %>
  <%= f.rc_collection_select :grid_region_id, @regions, :id, :name, {}, label: "REGION" %>
  <%= f.rc_collection_select :grid_faction_id, @factions, :id, :name, {include_blank: "(none)"}, label: "FACTION" %>
  <%= f.rc_collection_select :ambient_playlist_id, @playlists, :id, :name, {include_blank: "(none)"}, label: "PLAYLIST", hint: "the zone's ambient playlist" %>
  <%= f.rc_number_field :danger_level, label: "DANGER", width: :short, min: 0, max: 10, hint: "0 = safe · 10 = max ambient encounters" %>
</div>

<%= f.rc_text_area :description, rows: 3, spellcheck: true %>
