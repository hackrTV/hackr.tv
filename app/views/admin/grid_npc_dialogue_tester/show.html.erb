<%# /root/grid_npc_dialogue_tester — the NPC dialogue terminal as a
    console screen (2026-11-01; dev tools; root_console.css .rc-term):
    bar (NPC TEST · [<] INSPECTOR, [>] MOB, the DEV TOOLS badge), the
    session rows + [END SESSION] (confirming; warps the hackr back), the
    terminal (opens on `look`; the screen's own > input posts to command
    and appends the reply, a clear event empties the pane — no page
    prompt, one > per screen), the ended line the script reveals if the
    session ends. The script renders after the screen; ids verbatim
    (dialogue-output, command-input, send-btn, command-section,
    session-ended, end-form). Assigns: @hackr, @mob, @initial_output. %>
<% content_for :title, "/root/grid_npc_dialogue_tester :: NPC TEST" %>
<div class="console console--root">
  <%= render layout: "admin/console/bar", locals: {title: "NPC TEST", sub: "ROOT · HACKRS · /root/grid_npc_dialogue_tester"} do %>
    <%= link_to "[<] INSPECTOR", admin_grid_hackr_path(@hackr), class: "console-bar-link" %>
    <%= link_to "[>] MOB", edit_admin_grid_mob_path(@mob), class: "console-bar-link" %>
    <%= root_badge("DEV TOOLS ON", :warn) %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row"><span class="console-key">HACKR</span><span class="console-val rc-hot"><%= @hackr.hackr_alias %> <span class="console-dim">· CL <%= @hackr.stat("clearance") %></span></span></div>
    <div class="console-status-row"><span class="console-key">TALKING TO</span><span class="console-val rc-hot"><%= @mob.name %><% if @mob.mob_type %> <span class="console-dim">· <%= @mob.mob_type.upcase %></span><% end %> <span class="console-dim">· <%= @mob.grid_room.grid_zone&.name %> / <%= @mob.grid_room.name %></span></span></div>
  </div>
  <div class="rc-actions">
    <%= button_to "[END SESSION]", finish_admin_grid_npc_dialogue_tester_path, method: :delete, class: "rc-btn rc-btn--danger", form: {id: "end-form", data: {confirm: "End dialogue test? Hackr will be warped back to original room."}} %>
  </div>

  <div class="console-rule"><span>// TERMINAL //</span></div>
  <div class="rc-term">
    <div id="dialogue-output" class="rc-term-out"><div><%= raw @initial_output %></div></div>
    <div id="command-section">
      <div class="rc-term-in">
        <label class="console-mark" for="command-input">&gt;</label>
        <input type="text" id="command-input" class="rc-input" autocomplete="off" spellcheck="false" autofocus placeholder="a command · help lists them">
        <button type="button" id="send-btn" class="rc-btn rc-btn--hot">[SEND]</button>
      </div>
      <p class="rc-sub">talk · ask · examine · shop · buy · sell · give · accept · turn_in · missions · mission · stat · rep · inventory · look · who · help · up / down for history</p>
    </div>
  </div>

  <div id="session-ended" class="rc-flash rc-flash--warn console-line" hidden>
    <span class="console-tag">[END]</span>
    <span>NPC DIALOGUE TEST ENDED <span class="console-dim">· the hackr is back in the original room</span>
      <%= link_to "[<] INSPECTOR", admin_grid_hackr_path(@hackr), class: "rc-btn" %>
      <%= link_to "[+] NEW TEST", new_admin_grid_npc_dialogue_tester_path(hackr_id: @hackr.id), class: "rc-btn rc-btn--hot" %>
    </span>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  (function() {
    var commandUrl = '<%= command_admin_grid_npc_dialogue_tester_path %>';
    var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    var outputEl = document.getElementById('dialogue-output');
    var inputEl = document.getElementById('command-input');
    var sendBtn = document.getElementById('send-btn');
    var commandSection = document.getElementById('command-section');
    var endedEl = document.getElementById('session-ended');
    var endForm = document.getElementById('end-form');
    var sending = false;

    // Command history (mirrors frontend useCommandHistory.ts)
    var history = [];
    var historyIndex = -1;
    var currentDraft = '';

    function addCommand(cmd) {
      if (!cmd) return;
      if (history.length > 0 && history[history.length - 1] === cmd) {
        historyIndex = -1;
        currentDraft = '';
        return;
      }
      history.push(cmd);
      if (history.length > 100) history = history.slice(-100);
      historyIndex = -1;
      currentDraft = '';
    }

    function navigateUp() {
      if (history.length === 0) return;
      if (historyIndex === -1) {
        currentDraft = inputEl.value;
        historyIndex = history.length - 1;
      } else if (historyIndex > 0) {
        historyIndex--;
      }
      inputEl.value = history[historyIndex];
    }

    function navigateDown() {
      if (history.length === 0 || historyIndex === -1) return;
      historyIndex++;
      if (historyIndex >= history.length) {
        historyIndex = -1;
        inputEl.value = currentDraft;
      } else {
        inputEl.value = history[historyIndex];
      }
    }

    function appendOutput(html) {
      var div = document.createElement('div');
      div.innerHTML = html;
      outputEl.appendChild(div);
      outputEl.scrollTop = outputEl.scrollHeight;
    }

    function endSession() {
      commandSection.hidden = true;
      endedEl.hidden = false;
      if (endForm) endForm.hidden = true;
    }

    function setDisabled(disabled) {
      inputEl.disabled = disabled;
      sendBtn.disabled = disabled;
    }

    function sendCommand() {
      if (sending) return;
      var input = inputEl.value.trim();
      if (!input) return;

      sending = true;
      setDisabled(true);
      addCommand(input);

      appendOutput('<span class="rc-term-echo">&gt; ' + input.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</span>');
      inputEl.value = '';

      fetch(commandUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
          'Accept': 'application/json'
        },
        body: JSON.stringify({ input: input })
      })
      .then(function(response) { return response.json(); })
      .then(function(data) {
        if (data.event && data.event.type === 'clear') {
          outputEl.innerHTML = '';
        } else if (data.output) {
          appendOutput(data.output);
        }
        if (data.session_active === false) {
          endSession();
        } else {
          setDisabled(false);
          inputEl.focus();
        }
        sending = false;
      })
      .catch(function(err) {
        var line = document.createElement('span');
        line.className = 'rc-bad';
        line.textContent = 'Error: ' + err.message;
        var div = document.createElement('div');
        div.appendChild(line);
        outputEl.appendChild(div);
        outputEl.scrollTop = outputEl.scrollHeight;
        setDisabled(false);
        sending = false;
      });
    }

    inputEl.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        sendCommand();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        navigateUp();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        navigateDown();
      }
    });
    sendBtn.addEventListener('click', sendCommand);

    // Auto-scroll to bottom on load
    outputEl.scrollTop = outputEl.scrollHeight;
    inputEl.focus();
  })();
</script>
