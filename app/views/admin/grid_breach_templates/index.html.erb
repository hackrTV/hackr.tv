<%# /root/grid_breach_templates — the BREACH templates ledger as a console
    screen (2026-11-01; root_console.css): bar, ON RECORD row, the FILTER
    row (ledger-filter: name / slug / tier / zone slugs),
    // TEMPLATES // rows ([NN] · name over slug · TIER · CL · PNR · XP ·
    CRED · ACTIVE · LIVE / DRAFT · [HISTORY]), destinations, the > prompt
    (NN opens the record screen; deletes live there). Assigns:
    @templates, @active_counts. %>
<% content_for :title, "/root/grid_breach_templates :: BREACH TEMPLATES" %>
<% templates = @templates.to_a %>
<% numbers = templates.each_index.map { |i| root_num(i, total: templates.size) } %>
<div class="console console--root" data-controller="terminal ledger-filter" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "BREACH TEMPLATES", sub: "ROOT · SYSTEMS · /root/grid_breach_templates"} do %>
    <%= link_to "[+] NEW TEMPLATE", new_admin_grid_breach_template_path, class: "console-bar-link", data: {command: "new"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(templates.size, "template") %> <span class="console-dim">· <%= templates.count(&:published?) %> live · <%= pluralize(@active_counts.values.sum, "active breach", plural: "active breaches") %></span></span>
    </div>
    <div class="console-status-row rc-field rc-filter">
      <label class="console-key" for="ledger-filter">FILTER</label>
      <span class="console-val">
        <input type="search" id="ledger-filter" class="rc-input" placeholder="name · slug · tier · zone" autocomplete="off" spellcheck="false"
          data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
        <span class="rc-count" data-ledger-filter-target="count"><%= templates.size %> / <%= templates.size %></span>
        <button type="button" class="rc-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--breach-templates" aria-label="Breach templates">
    <div class="console-rule"><span>// TEMPLATES //</span></div>
    <% if templates.empty? %>
      <%= render "admin/console/empty", text: "NO BREACH TEMPLATES ON RECORD", hint: "[+] NEW TEMPLATE adds one" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span></span><span>TEMPLATE</span><span>TIER</span><span class="rc-cell--r">CL</span><span class="rc-cell--r">PNR</span><span class="rc-cell--r">XP</span><span class="rc-cell--r">CRED</span><span class="rc-cell--r">ACTIVE</span><span></span><span></span>
      </div>
    <% end %>
    <% templates.each_with_index do |template, i| %>
      <% num = numbers[i] %>
      <% active = @active_counts[template.id] || 0 %>
      <div class="rc-row" data-ledger-filter-target="row" data-search="<%= [template.name, template.slug, template.tier_label, *Array(template.zone_slugs)].compact.join(" ").downcase %>">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to template.name, edit_admin_grid_breach_template_path(template), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= template.slug %></div>
        </div>
        <span class="rc-cell <%= "rc-hot" if template.tier == "world_event" %>"><%= template.tier_label %></span>
        <span class="rc-cell rc-cell--r"><%= template.min_clearance %></span>
        <span class="rc-cell rc-cell--r"><%= template.pnr_threshold %>%</span>
        <span class="rc-cell rc-cell--r"><%= template.xp_reward %></span>
        <span class="rc-cell rc-cell--r"><%= template.cred_reward %></span>
        <span class="rc-cell rc-cell--r <%= active.positive? ? "rc-hot" : "rc-off" %>"><%= active %></span>
        <span class="rc-cell <%= template.published? ? "rc-on" : "rc-off" %>"><%= template.published? ? "LIVE" : "DRAFT" %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[HISTORY]", history_admin_grid_breach_template_path(template), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :systems, except: "BREACH" %>

  <div class="console-rule"><span>// EVERY BREACH TEMPLATE ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems, except: "BREACH", numbers: numbers, noun: "a template number", extra: ["new"]) %>
</div>
