<%# /root/grid_breach_templates/new — a new BREACH template on the record
    screen's shell (draft, standard tier, the next position). %>
<% content_for :title, "/root/grid_breach_templates/new :: NEW TEMPLATE" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "NEW TEMPLATE", sub: "ROOT · BREACH · /root/grid_breach_templates/new"} do %>
    <%= link_to "[<] BREACH", admin_grid_breach_templates_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @template, url: admin_grid_breach_templates_path, local: true do |f| %>
    <%= render "form", f: f, template: @template %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[CREATE TEMPLATE]</button>
      <%= link_to "[CANCEL]", admin_grid_breach_templates_path, class: "rc-btn" %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :systems %>
  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems) %>
</div>
