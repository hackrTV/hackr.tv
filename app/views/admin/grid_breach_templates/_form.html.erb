<%# The BREACH template's fields as console status rows (ConsoleFormBuilder
    rc_* rows): identity, tuning, rewards and gates, then
    // AMBIENT TARGETING //, // DESCRIPTION // and the two JSON
    textareas (re-rendered as typed on a 422 — params.dig). The commit
    row belongs to the caller. Locals: f, template; @tiers. %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, required: true, autocomplete: "off", pattern: "[a-z0-9\\-]+", title: "lowercase letters, digits, hyphens", hint: "unique · lowercase letters, numbers, hyphens" %>
  <%= f.rc_select :tier, @tiers.map { |t| [t.upcase.tr("_", " "), t] }, {} %>
  <%= f.rc_number_field :min_clearance, label: "CLEARANCE", width: :short, min: 0, max: 99 %>
  <%= f.rc_number_field :pnr_threshold, label: "PNR", width: :short, min: 1, max: 100, hint: "% — the point of no return" %>
  <%= f.rc_number_field :base_detection_rate, label: "DETECT RATE", width: :short, min: 1, hint: "base detection per round" %>
  <%= f.rc_number_field :xp_reward, label: "XP", width: :short, min: 0 %>
  <%= f.rc_number_field :cred_reward, label: "CRED", width: :short, min: 0 %>
  <%= f.rc_number_field :cooldown_min, label: "COOLDOWN MIN", width: :short, min: 0, hint: "seconds" %>
  <%= f.rc_number_field :cooldown_max, label: "COOLDOWN MAX", width: :short, min: 0, hint: "seconds · at least the minimum" %>
  <%= f.rc_text_field :requires_mission_slug, label: "MISSION", autocomplete: "off", hint: "optional — a mission that must be active or completed" %>
  <%= f.rc_text_field :requires_item_slug, label: "KEY ITEM", autocomplete: "off", hint: "optional — an item slug required to breach" %>
  <%= f.rc_number_field :position, width: :short, min: 0 %>
  <%= f.rc_flags("FLAGS", hint: "unchecked keeps the template out of encounters and ambient spawns") do %>
    <%= f.rc_check_box :published, label: "PUBLISHED" %>
  <% end %>
</div>

<div class="console-rule"><span>// AMBIENT TARGETING //</span></div>
<div class="console-status">
  <%= f.rc_number_field :danger_level_min, label: "MIN DANGER", width: :short, min: 0, max: 10, hint: "a zone's danger level must be at least this to spawn" %>
  <%= f.rc_text_field :zone_slugs_csv, label: "ZONES", autocomplete: "off", width: :wide,
    value: (template.zone_slugs.is_a?(Array) ? template.zone_slugs.join(", ") : ""), hint: "comma-separated zone slugs · empty = any zone" %>
</div>

<%= f.rc_text_area :description, rows: 3, spellcheck: true %>
<%= f.rc_text_area :protocol_composition_json, label: "PROTOCOL COMPOSITION (JSON)", rows: 10, spellcheck: false, class: "rc-textarea--code",
  value: params.dig(:grid_breach_template, :protocol_composition_json) || JSON.pretty_generate(template.protocol_composition.is_a?(Array) ? template.protocol_composition : []),
  hint: %(a JSON array of protocols · [{"type": "trace", "count": 1, "health": 50, "max_health": 50, "charge_rounds": 0}]) %>
<%= f.rc_text_area :reward_table_json, label: "REWARD TABLE (JSON)", rows: 4, spellcheck: false, class: "rc-textarea--code",
  value: params.dig(:grid_breach_template, :reward_table_json) || JSON.pretty_generate(template.reward_table || {}),
  hint: "a JSON object · extra reward configuration (future use) · XP and CRED are set above" %>
