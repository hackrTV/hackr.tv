<%= form_with model: [:admin, template], local: true do |f| %>
  <h3 class="cyan-255-text" style="margin: 20px 0 15px 0;">[:: TEMPLATE INFO ::]</h3>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
    <div>
      <%= f.tui_text_field :name %>
    </div>
    <div>
      <%= f.tui_text_field :slug, hint: "lowercase letters, numbers, hyphens only" %>
    </div>
  </div>

  <div style="margin-top: 15px;">
    <%= f.tui_text_area :description, style: "height: 80px;" %>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 20px; margin-top: 15px;">
    <div>
      <%= f.tui_select :tier, @tiers.map { |t| [t.upcase.tr("_", " "), t] }, {} %>
    </div>
    <div>
      <%= f.tui_number_field :min_clearance, min: 0, max: 99 %>
    </div>
    <div>
      <%= f.tui_number_field :pnr_threshold, min: 1, max: 100, label: "PNR THRESHOLD (%)" %>
    </div>
    <div>
      <%= f.tui_number_field :base_detection_rate, min: 1, label: "BASE DETECT RATE" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 20px; margin-top: 15px;">
    <div>
      <%= f.tui_number_field :xp_reward, min: 0 %>
    </div>
    <div>
      <%= f.tui_number_field :cred_reward, min: 0 %>
    </div>
    <div>
      <%= f.tui_number_field :cooldown_min, min: 0, label: "COOLDOWN MIN (s)" %>
    </div>
    <div>
      <%= f.tui_number_field :cooldown_max, min: 0, label: "COOLDOWN MAX (s)" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 15px;">
    <div>
      <%= f.tui_text_field :requires_mission_slug, hint: "Optional — mission that must be active/completed" %>
    </div>
    <div>
      <%= f.tui_text_field :requires_item_slug, hint: "Optional — key item required to breach" %>
    </div>
  </div>

  <h3 class="cyan-255-text" style="margin: 25px 0 15px 0;">[:: AMBIENT ENCOUNTER TARGETING ::]</h3>

  <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 20px;">
    <div>
      <%= f.tui_number_field :danger_level_min, min: 0, max: 10, label: "MIN DANGER LEVEL" %>
      <small style="color: #888;">Zone danger_level must be >= this to spawn</small>
    </div>
    <div>
      <%= f.tui_text_field :zone_slugs_csv,
            value: (template.zone_slugs.is_a?(Array) ? template.zone_slugs.join(", ") : ""),
            label: "ZONE SLUGS", hint: "Comma-separated zone slugs. Empty = any zone." %>
    </div>
  </div>

  <h3 class="cyan-255-text" style="margin: 25px 0 15px 0;">[:: PROTOCOL COMPOSITION (JSON) ::]</h3>
  <div style="margin-top: 10px;">
    <%= f.text_area :protocol_composition_json,
      value: JSON.pretty_generate(template.protocol_composition.is_a?(Array) ? template.protocol_composition : []),
      class: "tui-input", style: "width: 100%; font-family: monospace; height: 200px;" %>
    <small style="color: #888;">Array of protocol definitions. Example: [{"type": "trace", "count": 1, "health": 50, "max_health": 50, "charge_rounds": 0}]</small>
  </div>

  <h3 class="cyan-255-text" style="margin: 25px 0 15px 0;">[:: REWARD TABLE (JSON) ::]</h3>
  <div style="margin-top: 10px;">
    <%= f.text_area :reward_table_json,
      value: JSON.pretty_generate(template.reward_table || {}),
      class: "tui-input", style: "width: 100%; font-family: monospace; height: 100px;" %>
    <small style="color: #888;">Additional reward configuration (future use). XP and CRED are set above.</small>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
    <div>
      <%= f.tui_number_field :position, min: 0 %>
    </div>
    <div style="display: flex; align-items: flex-end;">
      <label style="color: white; cursor: pointer;">
        <%= f.check_box :published, style: "margin-right: 8px;" %>
        PUBLISHED
      </label>
    </div>
  </div>

  <div style="margin-top: 25px;">
    <%= tui_submit template.new_record? ? "Create Template" : "Update Template", form: f, color: :green, style: "padding: 8px 20px;" %>
  </div>
<% end %>
