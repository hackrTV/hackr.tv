<%# /root/grid_pac_escape_tester — the PAC escape terminal as a console
    screen (2026-11-01; dev tools; root_console.css .rc-term): bar (PAC
    TEST · [<] INSPECTOR, the ESCAPED badge the script reveals, the DEV
    TOOLS badge), the session rows + [END TEST] (confirming; restores the
    hackr), the terminal (opens on `look`; the screen's own > input posts
    to command and appends the reply — no page prompt, one > per
    screen; it stays live after an escape so the admin can look around).
    The script renders after the screen; ids verbatim (pac-output,
    command-input, send-btn, escaped-badge, end-form). Assigns: @hackr,
    @initial_output. %>
<% content_for :title, "/root/grid_pac_escape_tester :: PAC TEST" %>
<% room = @hackr.current_room %>
<div class="console console--root">
  <%= render layout: "admin/console/bar", locals: {title: "PAC TEST", sub: "ROOT · HACKRS · /root/grid_pac_escape_tester"} do %>
    <%= link_to "[<] INSPECTOR", admin_grid_hackr_path(@hackr), class: "console-bar-link" %>
    <span id="escaped-badge" class="console-bar-badge rc-badge--live" hidden>ESCAPED</span>
    <%= root_badge("DEV TOOLS ON", :warn) %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row"><span class="console-key">HACKR</span><span class="console-val rc-hot"><%= @hackr.hackr_alias %> <span class="console-dim">· CL <%= @hackr.stat("clearance") %></span></span></div>
    <div class="console-status-row"><span class="console-key">IN</span><span class="console-val"><%= room&.grid_zone&.name %> / <%= room&.name %></span></div>
  </div>
  <div class="rc-actions">
    <%= button_to "[END TEST]", finish_admin_grid_pac_escape_tester_path, method: :delete, class: "rc-btn rc-btn--danger", form: {id: "end-form", data: {confirm: "End PAC escape test? Hackr will be restored to original state."}} %>
  </div>

  <div class="console-rule"><span>// TERMINAL //</span></div>
  <div class="rc-term">
    <div id="pac-output" class="rc-term-out"><div><%= raw @initial_output %></div></div>
    <div id="command-section">
      <div class="rc-term-in">
        <label class="console-mark" for="command-input">&gt;</label>
        <input type="text" id="command-input" class="rc-input" autocomplete="off" spellcheck="false" autofocus placeholder="a command · help lists them">
        <button type="button" id="send-btn" class="rc-btn rc-btn--hot">[EXECUTE]</button>
      </div>
      <p class="rc-sub">captured: look · go · breach · bribe · talk · examine · stat · inventory · who · help · up / down for history</p>
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  (function() {
    var commandUrl = '<%= command_admin_grid_pac_escape_tester_path %>';
    var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    var outputEl = document.getElementById('pac-output');
    var inputEl = document.getElementById('command-input');
    var sendBtn = document.getElementById('send-btn');
    var escapedBadge = document.getElementById('escaped-badge');
    var sending = false;

    // Command history (mirrors frontend useCommandHistory.ts)
    var history = [];
    var historyIndex = -1;
    var currentDraft = '';

    function addCommand(cmd) {
      if (!cmd) return;
      if (history.length > 0 && history[history.length - 1] === cmd) {
        historyIndex = -1;
        currentDraft = '';
        return;
      }
      history.push(cmd);
      if (history.length > 100) history = history.slice(-100);
      historyIndex = -1;
      currentDraft = '';
    }

    function navigateUp() {
      if (history.length === 0) return;
      if (historyIndex === -1) {
        currentDraft = inputEl.value;
        historyIndex = history.length - 1;
      } else if (historyIndex > 0) {
        historyIndex--;
      }
      inputEl.value = history[historyIndex];
    }

    function navigateDown() {
      if (history.length === 0 || historyIndex === -1) return;
      historyIndex++;
      if (historyIndex >= history.length) {
        historyIndex = -1;
        inputEl.value = currentDraft;
      } else {
        inputEl.value = history[historyIndex];
      }
    }

    function appendOutput(html) {
      var div = document.createElement('div');
      div.innerHTML = html;
      outputEl.appendChild(div);
      outputEl.scrollTop = outputEl.scrollHeight;
    }

    function setDisabled(disabled) {
      inputEl.disabled = disabled;
      sendBtn.disabled = disabled;
    }

    function sendCommand() {
      if (sending) return;
      var input = inputEl.value.trim();
      if (!input) return;

      sending = true;
      setDisabled(true);
      addCommand(input);

      appendOutput('<span class="rc-term-echo">&gt; ' + input.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</span>');
      inputEl.value = '';

      fetch(commandUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
          'Accept': 'application/json'
        },
        body: JSON.stringify({ input: input })
      })
      .then(function(response) { return response.json(); })
      .then(function(data) {
        if (data.output) {
          appendOutput(data.output);
        }
        if (data.escaped) {
          escapedBadge.hidden = false;
        }
        setDisabled(false);
        inputEl.focus();
        sending = false;
      })
      .catch(function(err) {
        var line = document.createElement('span');
        line.className = 'rc-bad';
        line.textContent = 'Error: ' + err.message;
        var div = document.createElement('div');
        div.appendChild(line);
        outputEl.appendChild(div);
        outputEl.scrollTop = outputEl.scrollHeight;
        setDisabled(false);
        sending = false;
      });
    }

    inputEl.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        sendCommand();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        navigateUp();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        navigateDown();
      }
    });
    sendBtn.addEventListener('click', sendCommand);

    // Auto-scroll to bottom on load
    outputEl.scrollTop = outputEl.scrollHeight;
    inputEl.focus();
  })();
</script>
