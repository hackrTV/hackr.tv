<%# /root/grid_pac_escape_tester/new — start a PAC escape test as a
    console screen (2026-11-01; dev tools; root_console.css): bar (the
    DEV TOOLS badge, [<] INSPECTOR when a hackr came in), the WARNING
    row, // HACKR // (the HACKR picker, prefilled from ?hackr_id=, the
    options tagging captured / in-breach hackrs; with a hackr in: its
    room and what blocks a capture), // OPTIONS // (IMPOUND) + [CAPTURE
    INTO PAC] confirming, destinations, the > prompt; the picker's
    script renders after the screen (hackr-* ids). Assigns: @hackr (or
    nil), @hackrs, @breach_hackr_ids. %>
<% content_for :title, "/root/grid_pac_escape_tester :: PAC" %>
<% room = @hackr&.current_room %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "PAC ESCAPE TESTER", sub: "ROOT · HACKRS · /root/grid_pac_escape_tester/new"} do %>
    <% if @hackr %><%= link_to "[<] INSPECTOR", admin_grid_hackr_path(@hackr), class: "console-bar-link", data: {command: "back"} %><% end %>
    <%= root_badge("DEV TOOLS ON", :warn) %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row"><span class="console-key">WARNING</span><span class="console-val rc-star">one-click capture into the GovCorp Perception Alignment Center <span class="console-dim">· full state restore on end · CRED spent on bribes and items forfeited are not restored</span></span></div>
  </div>

  <%= form_with url: admin_grid_pac_escape_tester_path, method: :post, local: true, id: "pac-tester-form" do %>
    <div class="console-rule"><span>// HACKR //</span></div>
    <div class="console-status">
      <%= render "admin/console/picker", label: "HACKR", key: "hackr", name: "hackr_id", value: @hackr&.id,
        text: @hackr && "#{@hackr.hackr_alias} (CL #{@hackr.stat("clearance")})", placeholder: "alias · role",
        status: @hackr ? "Selected: #{@hackr.hackr_alias}" : "#{@hackrs.size} hackrs · type to filter" %>
      <% if @hackr %>
        <div class="console-status-row">
          <span class="console-key">ROOM</span>
          <% if room %>
            <span class="console-val"><%= room.name %> <span class="console-dim">· <%= room.grid_zone&.name %> · <%= room.grid_zone&.grid_region&.name %></span></span>
          <% else %>
            <span class="console-val rc-bad">no room</span>
          <% end %>
        </div>
        <% if @hackr.in_breach? %>
          <div class="console-status-row"><span class="console-key">BREACH</span><span class="console-val rc-bad">IN PROGRESS <span class="console-dim">· a capture is refused until it ends</span></span></div>
        <% end %>
        <% if Grid::ContainmentService.captured?(@hackr) %>
          <div class="console-status-row"><span class="console-key">CAPTURED</span><span class="console-val rc-bad">ALREADY IN PAC</span></div>
        <% end %>
      <% end %>
    </div>

    <div class="console-rule"><span>// OPTIONS //</span></div>
    <div class="console-status">
      <%= root_field("IMPOUND") do %>
        <label class="rc-check"><%= check_box_tag :impound, "1", false %> impound equipped gear</label>
        <span class="rc-hint">confiscates the loadout on capture · tests impound recovery / bribe forfeit</span>
      <% end %>
    </div>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--danger" data-confirm="Force-capture hackr into PAC? (State will be restored on End Test)">[CAPTURE INTO PAC]</button>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :hackrs, except: "PAC" %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:hackrs, except: "PAC", extra: (@hackr ? ["back"] : [])) %>
</div>

<%= render "admin/shared/combobox" %>
<script nonce="<%= content_security_policy_nonce %>">
  AdminCombobox.init({
    inputId: 'hackr-input',
    hiddenId: 'hackr-hidden',
    dropdownId: 'hackr-dropdown',
    statusId: 'hackr-status',
    formId: 'pac-tester-form',
    items: <%= raw json_escape(@hackrs.map { |h| {id: h.id, alias: h.hackr_alias, cl: h.stat("clearance"), role: h.role || "hackr", captured: Grid::ContainmentService.captured?(h), in_breach: @breach_hackr_ids.include?(h.id)} }.to_json) %>,
    getId: function(r) { return r.id; },
    getSearchText: function(r) { return (r.alias + ' ' + r.role).toLowerCase(); },
    getGroupKey: function(r) { return r.role.toUpperCase(); },
    renderOption: function(r, esc) {
      var flags = (r.captured ? ' [CAPTURED]' : '') + (r.in_breach ? ' [IN BREACH]' : '');
      return '<span class="cb-name">' + esc(r.alias) + '</span> <span class="cb-meta">CL ' + r.cl + flags + '</span>';
    },
    getLabel: function(r) { return r.alias + ' (CL ' + r.cl + ')'; },
    emptyText: 'No hackrs match',
    selectedText: 'Hackr selected',
    submitError: 'Select a hackr first'
  });
</script>
