<%# The redirect record's fields as console status rows
    (ConsoleFormBuilder rc_* rows). The commit row belongs to the caller.
    Locals: f. %>
<div class="console-status">
  <%= f.rc_text_field :path, required: true, autocomplete: "off", placeholder: "/old-path", hint: "the incoming path to match" %>
  <%= f.rc_text_field :destination_url, label: "DESTINATION", required: true, autocomplete: "off", width: :wide,
    placeholder: "/new-path or https://example.com/page", hint: "a path or a full URL" %>
  <%= f.rc_text_field :domain, autocomplete: "off", placeholder: "hackr.tv", hint: "blank = every domain" %>
</div>
