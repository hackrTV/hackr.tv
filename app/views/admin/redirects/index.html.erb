<%# /root/redirects — the redirects ledger as a console screen
    (2026-10-31; root_console.css): bar, ON RECORD row, the FILTER row
    (ledger-filter: domain / path / destination), // REDIRECTS // rows
    ([NN] · path over its domain · destination · [EDIT]), destinations,
    the > prompt (NN opens the record screen; deletes live there).
    Assigns: @redirects. %>
<% content_for :title, "/root/redirects :: REDIRECTS" %>
<% redirects = @redirects.to_a %>
<% numbers = redirects.each_index.map { |i| root_num(i, total: redirects.size) } %>
<% global = redirects.count { |r| r.domain.blank? } %>
<div class="console console--root" data-controller="terminal ledger-filter" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "REDIRECTS", sub: "ROOT · CONTENT · /root/redirects"} do %>
    <%= link_to "[+] NEW REDIRECT", new_admin_redirect_path, class: "console-bar-link", data: {command: "new"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(redirects.size, "redirect") %> <span class="console-dim">· <%= global %> global · <%= redirects.size - global %> per domain</span></span>
    </div>
    <div class="console-status-row rc-field rc-filter">
      <label class="console-key" for="ledger-filter">FILTER</label>
      <span class="console-val">
        <input type="search" id="ledger-filter" class="rc-input" placeholder="domain · path · destination" autocomplete="off" spellcheck="false"
          data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
        <span class="rc-count" data-ledger-filter-target="count"><%= redirects.size %> / <%= redirects.size %></span>
        <button type="button" class="rc-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--redirects" aria-label="Redirects">
    <div class="console-rule"><span>// REDIRECTS //</span></div>
    <% if redirects.empty? %>
      <%= render "admin/console/empty", text: "NO REDIRECTS ON RECORD", hint: "[+] NEW REDIRECT maps the first path" %>
    <% end %>
    <% redirects.each_with_index do |redirect, i| %>
      <% num = numbers[i] %>
      <div class="rc-row" data-ledger-filter-target="row" data-search="<%= [redirect.domain, redirect.path, redirect.destination_url].compact.join(" ").downcase %>">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to redirect.path, edit_admin_redirect_path(redirect), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= redirect.domain.presence || "every domain" %></div>
        </div>
        <span class="rc-cell" title="<%= redirect.destination_url %>">&gt; <%= truncate(redirect.destination_url, length: 60) %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[EDIT]", edit_admin_redirect_path(redirect), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :content, except: "REDIRECTS" %>

  <div class="console-rule"><span>// EVERY PATH ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:content, except: "REDIRECTS", numbers: numbers, noun: "a redirect number", extra: ["new"]) %>
</div>
