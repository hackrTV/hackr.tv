<%# /root/grid_hackrs/:id/edit_stats — the stat editor as a console
    screen (2026-11-01; dev tools; root_console.css): bar (alias · STATS
    · [<] INSPECTOR, the DEV TOOLS badge), the warning row, // STATS //
    (named stats[...] fields as rc-field rows — CLEARANCE and XP sync,
    XP winning; CAPTURED with its hidden 0) + [WRITE STATS], // RAW JSON
    // (the whole stats column; a rejected text re-renders as typed) +
    [WRITE RAW JSON], each confirming, destinations, the > prompt.
    Assigns: @hackr. %>
<% content_for :title, "/root/grid_hackrs/#{@hackr.id}/edit_stats :: STATS" %>
<% fields = {
  "health" => [0, 999, "max #{@hackr.effective_max("health")}"],
  "energy" => [0, 999, "max #{@hackr.effective_max("energy")}"],
  "psyche" => [0, 999, "max #{@hackr.effective_max("psyche")}"],
  "clearance" => [0, GridHackr::Stats::MAX_CLEARANCE, "sets XP to this level's minimum"],
  "xp" => [0, nil, "wins over CLEARANCE when both change"],
  "inspiration" => [0, nil, nil],
  "bonus_inventory_slots" => [0, nil, nil],
  "govcorp_debt" => [0, nil, "CRED"],
  "facility_alert_level" => [0, 100, nil]
} %>
<% labels = {"bonus_inventory_slots" => "BONUS SLOTS", "govcorp_debt" => "GOVCORP DEBT", "facility_alert_level" => "ALERT LEVEL"} %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: link_to(@hackr.hackr_alias, admin_grid_hackr_path(@hackr)), sub: "ROOT · STATS · /root/grid_hackrs/#{@hackr.id}/edit_stats"} do %>
    <%= link_to "[<] INSPECTOR", admin_grid_hackr_path(@hackr), class: "console-bar-link", data: {command: "back"} %>
    <%= root_badge("DEV TOOLS ON", :warn) %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row"><span class="console-key">WARNING</span><span class="console-val rc-star">direct stat writes bypass game logic <span class="console-dim">· use with care</span></span></div>
  </div>

  <%= form_with url: update_stats_admin_grid_hackr_path(@hackr), method: :patch, local: true, id: "stats-form" do %>
    <div class="console-rule"><span>// STATS //</span></div>
    <div class="console-status">
      <% fields.each do |key, (min, max, hint)| %>
        <%= root_field(labels[key] || key.upcase, id: "stats_#{key}") do %>
          <%= number_field_tag "stats[#{key}]", @hackr.stat(key).to_i, id: "stats_#{key}", class: "rc-input rc-input--short", min: min, max: max %>
          <% if hint %><span class="rc-hint"><%= hint %></span><% end %>
        <% end %>
      <% end %>
      <%= root_field("CAPTURED") do %>
        <input type="hidden" name="stats[captured]" value="0">
        <label class="rc-check"><%= check_box_tag "stats[captured]", "1", @hackr.stat("captured"), id: "stats_captured" %> in containment</label>
        <span class="rc-hint">unchecking clears containment and the alert level</span>
      <% end %>
    </div>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--danger" data-confirm="Overwrite stats for <%= @hackr.hackr_alias %>?">[WRITE STATS]</button>
      <%= link_to "[CANCEL]", admin_grid_hackr_path(@hackr), class: "rc-btn" %>
    </div>
  <% end %>

  <%= form_with url: update_stats_admin_grid_hackr_path(@hackr), method: :patch, local: true, id: "raw-stats-form" do %>
    <div class="console-rule"><span>// RAW JSON //</span></div>
    <%= text_area_tag :raw_json, params[:raw_json] || JSON.pretty_generate(@hackr.current_stats), class: "rc-textarea rc-textarea--code", rows: 12,
      spellcheck: "false", aria: {label: "Raw stats JSON"}, data: {controller: "autogrow", action: "input->autogrow#grow"} %>
    <p class="rc-sub">a JSON object · replaces the whole stats column</p>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--danger" data-confirm="Replace ALL stats for <%= @hackr.hackr_alias %> with raw JSON?">[WRITE RAW JSON]</button>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :hackrs %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:hackrs, extra: ["back"]) %>
</div>
