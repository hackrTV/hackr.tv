<%# /root/grid_hackrs/:id/mining_rig — the rig manager as a console
    screen (2026-11-01; dev tools; root_console.css): bar (alias · RIG ·
    [<] INSPECTOR, the DEV TOOLS badge), // RIG // (state, functional,
    rate, multiplier, last tick, what keeps it from running) +
    [FORCE ACTIVATE] / [DEACTIVATE], // SLOTS // (capacity · installed ·
    free per slot type), // COMPONENTS // ([UNINSTALL] per part — a part
    has no screen of its own), // FORCE INSTALL // (a rig component from
    the inventory), every force action confirming, destinations, the >
    prompt. Assigns: @hackr, @rig, @components, @inventory_components. %>
<% content_for :title, "/root/grid_hackrs/#{@hackr.id}/mining_rig :: RIG" %>
<% problems = @rig.functionality_errors %>
<% installed = @components.map(&:slot).tally %>
<% slots = [["MOTHERBOARD", nil, installed["motherboard"].to_i],
  ["PSU", @rig.total_psu_slots, installed["psu"].to_i],
  ["CPU", @rig.total_cpu_slots, installed["cpu"].to_i],
  ["GPU", @rig.total_gpu_slots, installed["gpu"].to_i],
  ["RAM", @rig.total_ram_slots, installed["ram"].to_i]] %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: link_to(@hackr.hackr_alias, admin_grid_hackr_path(@hackr)), sub: "ROOT · RIG · /root/grid_hackrs/#{@hackr.id}/mining_rig"} do %>
    <%= link_to "[<] INSPECTOR", admin_grid_hackr_path(@hackr), class: "console-bar-link", data: {command: "back"} %>
    <%= root_badge("DEV TOOLS ON", :warn) %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-rule"><span>// RIG //</span></div>
  <div class="console-status">
    <div class="console-status-row"><span class="console-key">STATE</span><span class="console-val <%= @rig.active? ? "rc-on" : "rc-bad" %>"><%= @rig.active? ? "ACTIVE" : "INACTIVE" %></span></div>
    <div class="console-status-row"><span class="console-key">FUNCTIONAL</span><span class="console-val <%= @rig.functional? ? "rc-on" : "rc-bad" %>"><%= @rig.functional? ? "YES" : "NO" %></span></div>
    <div class="console-status-row"><span class="console-key">RATE</span><span class="console-val rc-on"><%= @rig.effective_rate %> <span class="console-dim">· multiplier x<%= @rig.total_multiplier %></span></span></div>
    <div class="console-status-row"><span class="console-key">LAST TICK</span><span class="console-val"><%= @rig.last_tick_at&.strftime("%Y-%m-%d %H:%M") || "never" %></span></div>
    <% problems.each do |problem| %>
      <div class="console-status-row"><span class="console-key">PROBLEM</span><span class="console-val rc-bad"><%= problem %></span></div>
    <% end %>
  </div>
  <div class="rc-actions">
    <% if @rig.active? %>
      <%= button_to "[DEACTIVATE]", force_deactivate_rig_admin_grid_hackr_path(@hackr), class: "rc-btn rc-btn--danger", form: {data: {confirm: "Deactivate #{@hackr.hackr_alias}'s mining rig?"}} %>
    <% else %>
      <%= button_to "[FORCE ACTIVATE]", force_activate_rig_admin_grid_hackr_path(@hackr), class: "rc-btn rc-btn--hot", form: {data: {confirm: "Force-activate #{@hackr.hackr_alias}'s mining rig? (bypasses the functional check)"}} %>
    <% end %>
  </div>

  <section class="console-section rc-ledger rc-ledger--rig-slots" aria-label="Slots">
    <div class="console-rule"><span>// SLOTS //</span></div>
    <div class="rc-row rc-row--head" aria-hidden="true">
      <span>SLOT</span><span class="rc-cell--r">CAPACITY</span><span class="rc-cell--r">INSTALLED</span><span class="rc-cell--r">FREE</span>
    </div>
    <% slots.each do |label, cap, used| %>
      <% free = cap && [cap - used, 0].max %>
      <div class="rc-row">
        <span><%= label %></span>
        <span class="rc-cell rc-cell--r"><%= cap || "INF" %></span>
        <span class="<%= class_names("rc-cell rc-cell--r", "rc-star": cap && cap > 0 && used >= cap) %>"><%= used %></span>
        <span class="<%= class_names("rc-cell rc-cell--r", "rc-on": free.nil? || free > 0, "rc-off": free == 0) %>"><%= free || "INF" %></span>
      </div>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--rig-parts" aria-label="Installed components">
    <div class="console-rule"><span>// COMPONENTS · <%= @components.size %> //</span></div>
    <% if @components.empty? %>
      <%= render "admin/console/empty", text: "NO COMPONENTS INSTALLED", hint: "// FORCE INSTALL // below takes one from the inventory" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>COMPONENT</span><span>SLOT</span><span class="rc-cell--r">MULT</span><span>RARITY</span><span></span>
      </div>
    <% end %>
    <% @components.sort_by { |c| c.slot.to_s }.each do |comp| %>
      <div class="rc-row">
        <span><%= comp.name %></span>
        <span class="rc-cell rc-hot"><%= comp.slot&.upcase || "—" %></span>
        <span class="rc-cell rc-cell--r">x<%= comp.rate_multiplier %></span>
        <span class="rc-cell"><%= comp.rarity_label %></span>
        <span class="rc-cell rc-links">
          <%= button_to "[UNINSTALL]", force_uninstall_component_admin_grid_hackr_path(@hackr, item_id: comp.id), class: "rc-btn rc-btn--danger", form: {data: {confirm: "Force-uninstall #{comp.name} from the rig? It returns to the inventory."}} %>
        </span>
      </div>
    <% end %>
  </section>

  <div class="console-rule"><span>// FORCE INSTALL //</span></div>
  <% if @inventory_components.any? %>
    <%= form_with url: force_install_component_admin_grid_hackr_path(@hackr), method: :post, local: true, id: "rig-install-form" do %>
      <div class="console-status">
        <%= root_field("COMPONENT", id: "item_id") do %>
          <%= select_tag :item_id, options_for_select(@inventory_components.map { |item| ["#{item.name} · #{item.slot&.upcase || "?"} · x#{item.rate_multiplier} · #{item.rarity_label}", item.id] }), prompt: "— pick a part —", class: "rc-select", required: true %>
          <span class="rc-hint">loose rig components in the inventory</span>
        <% end %>
      </div>
      <div class="rc-actions">
        <button type="submit" class="rc-btn rc-btn--hot">[FORCE INSTALL]</button>
      </div>
    <% end %>
  <% else %>
    <%= render "admin/console/empty", text: "NO RIG COMPONENTS IN THE INVENTORY", hint: "[>] ITEMS on the inspector grants one" %>
  <% end %>

  <%= render "admin/console/destinations", section: :hackrs %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:hackrs, extra: ["back"]) %>
</div>
