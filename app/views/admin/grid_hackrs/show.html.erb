<%# /root/grid_hackrs/:id — the hackr inspector as a console readout
    (2026-11-01; root_console.css; read-only but for RESET 2FA): bar
    (alias · [<] HACKRS, [>] ITEMS, the DEV TOOLS badge), // DEV TOOLS //
    ([STATS] [WARP] [RIG] [SANDBOX] [NPC] [PAC] for this hackr — their
    commands shadow the generic SANDBOX / NPC / PAC rows below, first
    link wins), // IDENTITY // (2FA with [RESET 2FA]), // VITALS //,
    // LOCATION //, // ECONOMY //, // BREACH //, // LOADOUT //,
    // INVENTORY //, // MINING RIG //, // REPUTATION //, // MISSIONS //
    (NN opens the assignment), // FEATURES //, destinations, the >
    prompt. Rarity reads as a word (no inline colour). Assigns: @hackr,
    @stats, @inventory, @loadout, @cache, @cred_balance, @active_breach,
    @mining_rig, @reputations, @active_missions, @feature_grants,
    @impound_records. %>
<% content_for :title, "/root/grid_hackrs/#{@hackr.id} :: #{@hackr.hackr_alias}" %>
<% dev = dev_tools_enabled? %>
<% room = @hackr.current_room %>
<% missions = @active_missions.to_a %>
<% inventory = @inventory.to_a %>
<% reputations = @reputations.to_a %>
<% numbers = missions.each_index.map { |i| root_num(i, total: missions.size) } %>
<% extra = %w[back items] + (dev ? %w[stats warp] + (@mining_rig ? %w[rig] : []) : []) %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: @hackr.hackr_alias, sub: "ROOT · HACKR ##{@hackr.id} · /root/grid_hackrs/#{@hackr.id}"} do %>
    <%= link_to "[<] HACKRS", admin_grid_hackrs_path, class: "console-bar-link", data: {command: "back"} %>
    <%= link_to "[>] ITEMS", admin_grid_hackr_items_path(@hackr), class: "console-bar-link", data: {command: "items"} %>
    <% if dev %><%= root_badge("DEV TOOLS ON", :warn) %><% end %>
  <% end %>
  <%= render "admin/console/flash" %>

  <% if dev %>
    <div class="console-rule"><span>// DEV TOOLS //</span></div>
    <div class="rc-actions">
      <%= link_to "[STATS]", edit_stats_admin_grid_hackr_path(@hackr), class: "rc-btn", data: {command: "stats"} %>
      <%= link_to "[WARP]", warp_admin_grid_hackr_path(@hackr), class: "rc-btn", data: {command: "warp"} %>
      <% if @mining_rig %><%= link_to "[RIG]", mining_rig_admin_grid_hackr_path(@hackr), class: "rc-btn", data: {command: "rig"} %><% end %>
      <%= link_to "[SANDBOX]", new_admin_grid_breach_sandbox_path(hackr_id: @hackr.id), class: "rc-btn", data: {command: "sandbox"} %>
      <%= link_to "[NPC]", new_admin_grid_npc_dialogue_tester_path(hackr_id: @hackr.id), class: "rc-btn", data: {command: "npc"} %>
      <%= link_to "[PAC]", new_admin_grid_pac_escape_tester_path(hackr_id: @hackr.id), class: "rc-btn", data: {command: "pac"} %>
    </div>
  <% end %>

  <div class="console-rule"><span>// IDENTITY //</span></div>
  <div class="console-status">
    <div class="console-status-row"><span class="console-key">ALIAS</span><span class="console-val rc-hot"><%= @hackr.hackr_alias %> <span class="console-dim">· #<%= @hackr.id %></span></span></div>
    <div class="console-status-row"><span class="console-key">EMAIL</span><span class="console-val"><%= @hackr.email || "—" %></span></div>
    <div class="console-status-row"><span class="console-key">ROLE</span><span class="<%= class_names("console-val", "rc-star": @hackr.admin?) %>"><%= @hackr.role&.upcase || "—" %></span></div>
    <div class="console-status-row"><span class="console-key">CLEARANCE</span><span class="console-val rc-hot"><%= @stats["clearance"] %> <span class="console-dim">· <%= @stats["xp"] %> XP</span></span></div>
    <div class="console-status-row"><span class="console-key">REGISTERED</span><span class="console-val"><%= @hackr.created_at.strftime("%Y-%m-%d") %></span></div>
    <div class="console-status-row"><span class="console-key">LAST ACTIVE</span><span class="console-val"><%= @hackr.last_activity_at&.strftime("%Y-%m-%d %H:%M") || "never" %></span></div>
    <div class="console-status-row rc-field">
      <span class="console-key">2FA</span>
      <span class="console-val">
        <% if @hackr.otp_required_for_login? %>
          <span class="rc-on">ENABLED</span>
          <%= button_to "[RESET 2FA]", admin_grid_reset_totp_path(hackr_id: @hackr.id), class: "rc-btn rc-btn--danger", form: {data: {confirm: "Disable 2FA for #{@hackr.hackr_alias}? They sign in with the password alone until they enrol again."}} %>
        <% else %>
          <span class="rc-off">off</span>
        <% end %>
      </span>
    </div>
    <div class="console-status-row"><span class="console-key">LOGIN</span><span class="console-val <%= @hackr.login_disabled? ? "rc-bad" : "rc-on" %>"><%= @hackr.login_disabled? ? "DISABLED" : "enabled" %></span></div>
  </div>

  <div class="console-rule"><span>// VITALS //</span></div>
  <div class="console-status">
    <% %w[health energy psyche].each do |vital| %>
      <% val = @stats[vital].to_i %>
      <% max = @hackr.effective_max(vital) %>
      <div class="console-status-row">
        <span class="console-key"><%= vital.upcase %></span>
        <span class="console-val"><%= val %> / <%= max %> <span class="console-dim">· <%= (max > 0) ? (val.to_f / max * 100).round : 0 %>%</span></span>
      </div>
    <% end %>
    <div class="console-status-row"><span class="console-key">INSPIRATION</span><span class="console-val"><%= @stats["inspiration"] %></span></div>
    <div class="console-status-row"><span class="console-key">BONUS SLOTS</span><span class="console-val"><%= @stats["bonus_inventory_slots"] %></span></div>
  </div>

  <div class="console-rule"><span>// LOCATION //</span></div>
  <div class="console-status">
    <% if room %>
      <div class="console-status-row"><span class="console-key">ROOM</span><span class="console-val"><%= link_to room.name, edit_admin_grid_room_path(room), class: "console-link" %> <span class="console-dim">· <%= room.room_type || "—" %></span></span></div>
      <div class="console-status-row"><span class="console-key">ZONE</span><span class="console-val"><%= room.grid_zone&.name || "—" %> <span class="console-dim">· <%= room.grid_zone&.grid_region&.name || "—" %></span></span></div>
    <% else %>
      <div class="console-status-row"><span class="console-key">ROOM</span><span class="console-val rc-off">nowhere <span class="console-dim">· no current room</span></span></div>
    <% end %>
    <% if @hackr.stat("captured") %>
      <div class="console-status-row"><span class="console-key">CAPTURED</span><span class="console-val rc-bad">IN CONTAINMENT <span class="console-dim">· alert level <%= @hackr.stat("facility_alert_level") %></span></span></div>
    <% end %>
  </div>

  <div class="console-rule"><span>// ECONOMY //</span></div>
  <div class="console-status">
    <% if @cache %>
      <div class="console-status-row"><span class="console-key">CRED</span><span class="console-val rc-on"><%= @cred_balance %></span></div>
      <div class="console-status-row"><span class="console-key">CACHE</span><span class="console-val"><%= @cache.address %> <span class="console-dim">· <%= @cache.status %></span></span></div>
    <% else %>
      <div class="console-status-row"><span class="console-key">CACHE</span><span class="console-val rc-off">none provisioned</span></div>
    <% end %>
    <% debt = @hackr.stat("govcorp_debt").to_i %>
    <% if debt > 0 %>
      <div class="console-status-row"><span class="console-key">DEBT</span><span class="console-val rc-bad"><%= debt %> CRED <span class="console-dim">· GovCorp · 50% garnishment active</span></span></div>
    <% end %>
    <% impounds = @impound_records.to_a %>
    <% if impounds.any? %>
      <div class="console-status-row"><span class="console-key">IMPOUND</span><span class="console-val"><span class="rc-star"><%= impounds.size %> total · <%= impounds.count(&:impounded?) %> active</span> <%= link_to "[>] IMPOUND", admin_grid_impound_records_path(hackr_alias: @hackr.hackr_alias), class: "console-link" %></span></div>
    <% end %>
  </div>

  <div class="console-rule"><span>// BREACH //</span></div>
  <% if @active_breach %>
    <% protocols = @active_breach.grid_breach_protocols.to_a %>
    <div class="console-status">
      <div class="console-status-row"><span class="console-key">TEMPLATE</span><span class="console-val rc-hot"><%= @active_breach.grid_breach_template&.name || "—" %><% if @active_breach.sandbox? %> <span class="console-dim">· sandbox</span><% end %></span></div>
      <div class="console-status-row"><span class="console-key">STATE</span><span class="console-val rc-star"><%= @active_breach.state.upcase %> <span class="console-dim">· round <%= @active_breach.round_number %> · <%= @active_breach.actions_remaining %> actions left</span></span></div>
      <div class="console-status-row"><span class="console-key">DETECTION</span><span class="console-val <%= (@active_breach.detection_level > 70) ? "rc-bad" : "rc-star" %>"><%= @active_breach.detection_level %> / 100</span></div>
      <div class="console-status-row"><span class="console-key">STARTED</span><span class="console-val"><%= @active_breach.created_at.strftime("%Y-%m-%d %H:%M") %></span></div>
      <% if protocols.any? %>
        <div class="console-status-row"><span class="console-key">PROTOCOLS</span><span class="console-val"><%= safe_join(protocols.map { |p| tag.span("#{p.protocol_type.upcase} #{p.health}hp #{p.state}", class: (p.state == "destroyed") ? "rc-off" : "rc-hot") }, " · ") %></span></div>
      <% end %>
    </div>
  <% else %>
    <%= render "admin/console/empty", text: "NO ACTIVE BREACH" %>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--loadout" aria-label="Loadout">
    <div class="console-rule"><span>// LOADOUT //</span></div>
    <% GridHackr::Loadout::GEAR_SLOT_LABELS.each do |slot, label| %>
      <% item = @loadout[slot] %>
      <div class="rc-row">
        <span class="rc-cell"><%= label %></span>
        <% if item %>
          <span><%= item.name %></span>
          <span class="rc-cell"><%= item.rarity_label %></span>
        <% else %>
          <span class="rc-off">EMPTY</span>
          <span></span>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--holdings" aria-label="Inventory">
    <div class="console-rule"><span>// INVENTORY · <%= inventory.size %> / <%= @hackr.inventory_capacity %> //</span></div>
    <% if inventory.empty? %>
      <%= render "admin/console/empty", text: "INVENTORY EMPTY", hint: "[>] ITEMS grants one" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>ITEM</span><span>TYPE</span><span>RARITY</span><span class="rc-cell--r">QTY</span><span class="rc-cell--r">VALUE</span>
      </div>
    <% end %>
    <% inventory.each do |item| %>
      <div class="rc-row">
        <span><%= item.name %></span>
        <span class="rc-cell"><%= item.item_type %></span>
        <span class="rc-cell"><%= item.rarity_label %></span>
        <span class="rc-cell rc-cell--r"><%= item.quantity %></span>
        <span class="rc-cell rc-cell--r"><%= item.value %></span>
      </div>
    <% end %>
  </section>

  <div class="console-rule"><span>// MINING RIG //</span></div>
  <% if @mining_rig %>
    <% components = @mining_rig.components.to_a %>
    <div class="console-status">
      <div class="console-status-row"><span class="console-key">STATUS</span><span class="console-val <%= @mining_rig.active? ? "rc-on" : "rc-bad" %>"><%= @mining_rig.active? ? "ACTIVE" : "INACTIVE" %> <span class="console-dim">· rate <%= @mining_rig.effective_rate %></span></span></div>
      <div class="console-status-row"><span class="console-key">COMPONENTS</span><span class="console-val"><%= components.any? ? components.map(&:name).join(" · ") : "—" %></span></div>
    </div>
  <% else %>
    <%= render "admin/console/empty", text: "NO MINING RIG PROVISIONED" %>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--standing" aria-label="Faction reputation">
    <div class="console-rule"><span>// REPUTATION //</span></div>
    <% if reputations.empty? %>
      <%= render "admin/console/empty", text: "NO FACTION REPUTATION RECORDS" %>
    <% end %>
    <% reputations.each do |rep| %>
      <div class="rc-row">
        <span class="rc-violet"><%= rep.subject&.respond_to?(:display_name) ? rep.subject.display_name : rep.subject&.name || "—" %></span>
        <span class="rc-cell rc-cell--r <%= rep.value.positive? ? "rc-on" : rep.value.negative? ? "rc-bad" : "rc-off" %>"><%= rep.value %></span>
      </div>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--hackr-missions" aria-label="Active missions">
    <div class="console-rule"><span>// MISSIONS · <%= missions.size %> ACTIVE //</span></div>
    <% if missions.empty? %>
      <%= render "admin/console/empty", text: "NO ACTIVE MISSIONS" %>
    <% end %>
    <% missions.each_with_index do |hm, i| %>
      <% num = numbers[i] %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <%= link_to hm.grid_mission.name, admin_grid_hackr_mission_path(hm), class: "console-link", data: {command: num} %>
        <span class="rc-cell"><%= hm.grid_mission.grid_mission_arc&.name || "—" %></span>
        <span class="rc-cell"><%= hm.accepted_at&.strftime("%Y-%m-%d %H:%M") %></span>
      </div>
    <% end %>
  </section>

  <div class="console-rule"><span>// FEATURES //</span></div>
  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">GRANTS</span>
      <% if @feature_grants.any? %>
        <span class="console-val rc-star"><%= @feature_grants.map(&:feature).join(" · ") %></span>
      <% else %>
        <span class="console-val rc-off">none <span class="console-dim">· the admin role has every feature</span></span>
      <% end %>
    </div>
  </div>

  <%= render "admin/console/destinations", section: :hackrs %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:hackrs, numbers: numbers, noun: "a mission number", extra: extra) %>
</div>
