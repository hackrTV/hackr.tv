<%# /root/grid_hackrs/:id/warp — the admin warp as a console screen
    (2026-11-01; dev tools; root_console.css): bar (alias · WARP ·
    [<] INSPECTOR, the DEV TOOLS badge), // NOW // (the current room, a
    BREACH that blocks the warp, captured state the warp clears),
    // DESTINATION // (the ROOM picker over every room — warp-* ids, the
    commit refused until a room is picked) + [WARP] confirming,
    destinations, the > prompt; the picker's script renders after the
    screen. Assigns: @hackr, @rooms. %>
<% content_for :title, "/root/grid_hackrs/#{@hackr.id}/warp :: WARP" %>
<% room = @hackr.current_room %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: link_to(@hackr.hackr_alias, admin_grid_hackr_path(@hackr)), sub: "ROOT · WARP · /root/grid_hackrs/#{@hackr.id}/warp"} do %>
    <%= link_to "[<] INSPECTOR", admin_grid_hackr_path(@hackr), class: "console-bar-link", data: {command: "back"} %>
    <%= root_badge("DEV TOOLS ON", :warn) %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-rule"><span>// NOW //</span></div>
  <div class="console-status">
    <% if room %>
      <div class="console-status-row"><span class="console-key">ROOM</span><span class="console-val"><%= room.name %> <span class="console-dim">· <%= room.grid_zone&.name %> · <%= room.grid_zone&.grid_region&.name %></span></span></div>
    <% else %>
      <div class="console-status-row"><span class="console-key">ROOM</span><span class="console-val rc-off">nowhere <span class="console-dim">· no current room</span></span></div>
    <% end %>
    <% if @hackr.in_breach? %>
      <div class="console-status-row"><span class="console-key">BREACH</span><span class="console-val rc-bad">IN PROGRESS <span class="console-dim">· the warp is refused until it ends</span></span></div>
    <% end %>
    <% if @hackr.stat("captured") %>
      <div class="console-status-row"><span class="console-key">CAPTURED</span><span class="console-val rc-star">IN CONTAINMENT <span class="console-dim">· the warp clears it</span></span></div>
    <% end %>
    <div class="console-status-row"><span class="console-key">WARNING</span><span class="console-val rc-star">bypasses clearance gates, locks and zone restrictions</span></div>
  </div>

  <%= form_with url: perform_warp_admin_grid_hackr_path(@hackr), method: :post, local: true, id: "warp-form" do %>
    <div class="console-rule"><span>// DESTINATION //</span></div>
    <div class="console-status">
      <%= render "admin/console/picker", label: "ROOM", key: "warp", name: "room_id", value: nil, text: nil,
        placeholder: "region · zone · room name", status: "#{@rooms.size} rooms · type to filter" %>
    </div>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot" data-confirm="Warp <%= @hackr.hackr_alias %> to the selected room?">[WARP]</button>
      <%= link_to "[CANCEL]", admin_grid_hackr_path(@hackr), class: "rc-btn" %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :hackrs %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:hackrs, extra: ["back"]) %>
</div>

<%= render "admin/shared/combobox" %>
<script nonce="<%= content_security_policy_nonce %>">
  AdminCombobox.init({
    inputId: 'warp-input',
    hiddenId: 'warp-hidden',
    dropdownId: 'warp-dropdown',
    statusId: 'warp-status',
    formId: 'warp-form',
    items: <%= raw json_escape(@rooms.map { |r| {id: r.id, name: r.name, type: r.room_type || "default", zone: r.grid_zone.name, region: r.grid_zone.grid_region&.name || "Unknown"} }.to_json) %>,
    getId: function(r) { return r.id; },
    getSearchText: function(r) { return (r.region + ' ' + r.zone + ' ' + r.name + ' ' + r.type).toLowerCase(); },
    getGroupKey: function(r) { return r.region + ' / ' + r.zone; },
    renderOption: function(r, esc) { return '<span class="cb-name">' + esc(r.name) + '</span> <span class="cb-meta">' + esc(r.type) + '</span>'; },
    getLabel: function(r) { return r.region + ' / ' + r.zone + ' / ' + r.name; },
    emptyText: 'No rooms match',
    selectedText: 'Room selected · ready to warp',
    submitError: 'Select a destination room first'
  });
</script>
