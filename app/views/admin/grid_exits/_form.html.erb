<%# The exit's fields as console status rows (ConsoleFormBuilder rc_*
    rows): the two rooms (every room, zone first), the direction (free
    text — the six compass words + up / down offered, diagonals and
    named ways like "enter" kept as typed), LOCKED, the key item. The
    commit row belongs to the caller. Locals: f, exit_record; @rooms. %>
<% room_choices = @rooms.map { |r| ["#{r.grid_zone.name} — #{r.name}", r.id] } %>
<div class="console-status">
  <%= f.rc_select :from_room_id, options_for_select(room_choices, exit_record.from_room_id), {include_blank: "(select room)"}, label: "FROM" %>
  <%= f.rc_text_field :direction, required: true, autocomplete: "off", width: :short, list: "exit-directions",
    hint: "lowercase · hyphens · north south east west up down, diagonals, any named way" %>
  <%= f.rc_select :to_room_id, options_for_select(room_choices, exit_record.to_room_id), {include_blank: "(select room)"}, label: "TO" %>
  <%= f.rc_flags("FLAGS") do %>
    <%= f.rc_check_box :locked, label: "LOCKED" %>
  <% end %>
  <%= f.rc_collection_select :requires_item_id, GridItem.all, :id, :name, {include_blank: "(none)"}, label: "KEY ITEM" %>
</div>
<datalist id="exit-directions">
  <% %w[north south east west up down northeast northwest southeast southwest].each do |direction| %>
    <option value="<%= direction %>"></option>
  <% end %>
</datalist>
