<%# /root/grid_breach_sandbox/new — start a sandbox BREACH as a console
    screen (2026-11-01; dev tools; root_console.css): bar (the DEV TOOLS
    badge, [<] INSPECTOR when a hackr came in), the WARNING row,
    // HACKR // (the HACKR picker, prefilled from ?hackr_id=, + the
    hackr's DECK and a BREACH that blocks the start), // TEMPLATE // (the
    TEMPLATE picker over every template, drafts tagged) + [START
    SANDBOX] confirming, destinations, the > prompt; the pickers' script
    renders after the screen (sandbox-* / hackr-* ids). Assigns: @hackr
    (or nil), @template (on a rejected start), @hackrs, @templates. %>
<% content_for :title, "/root/grid_breach_sandbox :: SANDBOX" %>
<% deck = @hackr&.equipped_deck %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "BREACH SANDBOX", sub: "ROOT · HACKRS · /root/grid_breach_sandbox/new"} do %>
    <% if @hackr %><%= link_to "[<] INSPECTOR", admin_grid_hackr_path(@hackr), class: "console-bar-link", data: {command: "back"} %><% end %>
    <%= root_badge("DEV TOOLS ON", :warn) %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row"><span class="console-key">WARNING</span><span class="console-val rc-star">a dry-run BREACH past every gate <span class="console-dim">· vitals and DECK battery restored on end · exploits and consumables used are not</span></span></div>
  </div>

  <%= form_with url: admin_grid_breach_sandbox_index_path, method: :post, local: true, id: "sandbox-form" do %>
    <div class="console-rule"><span>// HACKR //</span></div>
    <div class="console-status">
      <%= render "admin/console/picker", label: "HACKR", key: "hackr", name: "hackr_id", value: @hackr&.id,
        text: @hackr && "#{@hackr.hackr_alias} (CL #{@hackr.stat("clearance")})", placeholder: "alias · role",
        status: @hackr ? "Selected: #{@hackr.hackr_alias}" : "#{@hackrs.size} hackrs · type to filter" %>
      <% if @hackr %>
        <div class="console-status-row">
          <span class="console-key">DECK</span>
          <% if deck.nil? %>
            <span class="console-val rc-bad">none equipped</span>
          <% elsif deck.deck_fried? %>
            <span class="console-val rc-bad"><%= deck.name %> <span class="console-dim">· FRIED level <%= deck.deck_fried_level %></span></span>
          <% else %>
            <span class="console-val rc-on"><%= deck.name %> <span class="console-dim">· battery <%= deck.deck_battery %> / <%= deck.deck_battery_max %> · slots <%= deck.deck_slots_used %> / <%= deck.deck_slot_count %></span></span>
          <% end %>
        </div>
        <% if @hackr.in_breach? %>
          <div class="console-status-row"><span class="console-key">BREACH</span><span class="console-val rc-bad">IN PROGRESS <span class="console-dim">· a sandbox cannot start until it ends</span></span></div>
        <% end %>
      <% end %>
    </div>

    <div class="console-rule"><span>// TEMPLATE //</span></div>
    <div class="console-status">
      <%= render "admin/console/picker", label: "TEMPLATE", key: "sandbox", name: "template_id", value: @template&.id,
        text: @template && "#{@template.tier.upcase} / #{@template.name} (CL #{@template.min_clearance})", placeholder: "name · tier · slug",
        status: @template ? "Selected: #{@template.name}" : "#{@templates.size} templates · type to filter" %>
    </div>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot" data-confirm="Start a sandbox BREACH?">[START SANDBOX]</button>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :hackrs, except: "SANDBOX" %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:hackrs, except: "SANDBOX", extra: (@hackr ? ["back"] : [])) %>
</div>

<%= render "admin/shared/combobox" %>
<script nonce="<%= content_security_policy_nonce %>">
  AdminCombobox.init({
    inputId: 'hackr-input',
    hiddenId: 'hackr-hidden',
    dropdownId: 'hackr-dropdown',
    statusId: 'hackr-status',
    formId: 'sandbox-form',
    items: <%= raw json_escape(@hackrs.map { |h| {id: h.id, alias: h.hackr_alias, cl: h.stat("clearance"), role: h.role || "hackr"} }.to_json) %>,
    getId: function(r) { return r.id; },
    getSearchText: function(r) { return (r.alias + ' ' + r.role).toLowerCase(); },
    getGroupKey: function(r) { return r.role.toUpperCase(); },
    renderOption: function(r, esc) { return '<span class="cb-name">' + esc(r.alias) + '</span> <span class="cb-meta">CL ' + r.cl + '</span>'; },
    getLabel: function(r) { return r.alias + ' (CL ' + r.cl + ')'; },
    emptyText: 'No hackrs match',
    selectedText: 'Hackr selected',
    submitError: 'Select a hackr first'
  });
  AdminCombobox.init({
    inputId: 'sandbox-input',
    hiddenId: 'sandbox-hidden',
    dropdownId: 'sandbox-dropdown',
    statusId: 'sandbox-status',
    formId: 'sandbox-form',
    items: <%= raw json_escape(@templates.map { |t| {id: t.id, name: t.name, slug: t.slug, tier: t.tier, min_cl: t.min_clearance, published: t.published?, protocols: t.protocols.sum { |p| (p["count"] || 1).to_i }, gates: t.puzzle_gate_definitions.size} }.to_json) %>,
    getId: function(r) { return r.id; },
    getSearchText: function(r) { return (r.name + ' ' + r.slug + ' ' + r.tier).toLowerCase(); },
    getGroupKey: function(r) { return r.tier.toUpperCase(); },
    renderOption: function(r, esc) {
      var info = 'CL ' + r.min_cl + ' · ' + r.protocols + 'P' + (r.gates > 0 ? ' ' + r.gates + 'G' : '');
      return '<span class="cb-name">' + esc(r.name) + '</span>' + (r.published ? '' : ' <span class="cb-meta">[DRAFT]</span>') + ' <span class="cb-meta">' + info + '</span>';
    },
    getLabel: function(r) { return r.tier.toUpperCase() + ' / ' + r.name + ' (CL ' + r.min_cl + ')'; },
    emptyText: 'No templates match',
    selectedText: 'Template selected · ready to start',
    submitError: 'Select a breach template first'
  });
</script>
