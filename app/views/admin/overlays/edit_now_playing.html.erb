<%# /root/overlays/now-playing/edit — what the HUD shows as now playing,
    as a console screen (2026-10-31; root_console.css): bar ([<]
    OVERLAYS, [>] API JSON), // CURRENT // readout, // SET // rows (a
    catalog track, or a custom title + artist; PAUSED), // COMMIT //
    ([UPDATE & BROADCAST] · [CLEAR] — the hidden clear form at the end),
    destinations, the > prompt. Every commit broadcasts on OverlayChannel.
    Assigns: @now_playing, @tracks. %>
<% content_for :title, "/root/overlays/now-playing :: NOW PLAYING" %>
<% np = @now_playing %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "NOW PLAYING", sub: "ROOT · OVERLAYS · /root/overlays/now-playing"} do %>
    <%= link_to "[<] OVERLAYS", admin_overlays_path, class: "console-bar-link" %>
    <%= link_to "[>] API JSON", "/api/overlay/now-playing", target: "_blank", rel: "noopener", class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-rule"><span>// CURRENT //</span></div>
  <div class="console-status">
    <% if np.playing? %>
      <div class="console-status-row"><span class="console-key">TITLE</span><span class="console-val"><%= np.display_title %></span></div>
      <div class="console-status-row"><span class="console-key">ARTIST</span><span class="console-val"><%= np.display_artist.presence || "—" %></span></div>
      <% if np.display_album.present? %>
        <div class="console-status-row"><span class="console-key">ALBUM</span><span class="console-val"><%= np.display_album %></span></div>
      <% end %>
      <div class="console-status-row"><span class="console-key">STATE</span><span class="console-val"><span class="<%= np.paused ? "rc-star" : "rc-on" %>"><%= np.paused ? "PAUSED" : "PLAYING" %></span></span></div>
    <% else %>
      <div class="console-status-row"><span class="console-key">STATE</span><span class="console-val rc-off">NOTHING PLAYING</span></div>
    <% end %>
  </div>

  <%= form_with scope: :overlay_now_playing, url: admin_update_overlay_now_playing_path, method: :patch, local: true do |f| %>
    <div class="console-rule"><span>// SET //</span></div>
    <div class="console-status">
      <%= f.rc_select :track_id, @tracks.map { |t| ["#{t.artist&.name} — #{t.title}", t.id] }, {include_blank: "— select track —"}, label: "TRACK",
        hint: "a catalog track wins over the custom fields" %>
      <%= f.rc_text_field :custom_title, value: np.custom_title, label: "CUSTOM TITLE", autocomplete: "off", hint: "or a title off the catalog" %>
      <%= f.rc_text_field :custom_artist, value: np.custom_artist, label: "CUSTOM ARTIST", autocomplete: "off" %>
      <%= f.rc_flags("STATE", hint: "with no track and no custom title, a commit only flips the pause") do %>
        <%= f.rc_check_box :paused, checked: np.paused, label: "PAUSED" %>
      <% end %>
    </div>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[UPDATE &amp; BROADCAST]</button>
      <span class="rc-actions--end">
        <button type="submit" form="clear-now-playing" class="rc-btn rc-btn--danger">[CLEAR NOW PLAYING]</button>
      </span>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :streams %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:streams) %>

  <div class="rc-hidden-forms">
    <%= form_with url: admin_update_overlay_now_playing_path, method: :patch, id: "clear-now-playing", local: true, data: {confirm: "Clear now playing?"} do %>
      <%= hidden_field_tag :clear, "1" %>
    <% end %>
  </div>
</div>
