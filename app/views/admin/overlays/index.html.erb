<%# /root/overlays — the HUD's data surface as a console screen
    (2026-10-31; root_console.css). OBS overlays are drawn by the external
    HUD app; this screen shows what hackr.tv feeds it: // NOW PLAYING //
    (title / artist / state, [>] NOW PLAYING edits it), // ALERTS //
    (pending count, [ALERTS] manages the queue), // HUD DATA SURFACE //
    (the endpoints and cable channels the HUD reads), destinations, the >
    prompt. Assigns: @now_playing, @pending_alerts. %>
<% content_for :title, "/root/overlays :: OVERLAYS" %>
<% np = @now_playing %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "OVERLAYS", sub: "ROOT · STREAMS · /root/overlays"} do %>
    <%= link_to "[>] NOW PLAYING", admin_edit_overlay_now_playing_path, class: "console-bar-link", data: {command: "playing"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-rule"><span>// NOW PLAYING //</span></div>
  <div class="console-status">
    <% if np.playing? %>
      <div class="console-status-row"><span class="console-key">TITLE</span><span class="console-val"><%= np.display_title %></span></div>
      <div class="console-status-row"><span class="console-key">ARTIST</span><span class="console-val"><%= np.display_artist %></span></div>
      <div class="console-status-row"><span class="console-key">STATE</span><span class="console-val"><span class="<%= np.paused ? "rc-star" : "rc-on" %>"><%= np.paused ? "PAUSED" : "PLAYING" %></span></span></div>
    <% else %>
      <div class="console-status-row"><span class="console-key">STATE</span><span class="console-val rc-off">NOTHING PLAYING</span></div>
    <% end %>
  </div>

  <div class="console-rule"><span>// ALERTS //</span></div>
  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">PENDING</span>
      <span class="console-val"><span class="<%= (@pending_alerts > 0) ? "rc-star" : "rc-off" %>"><%= pluralize(@pending_alerts, "alert") %></span> <span class="console-dim">· waiting for the HUD</span></span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--surface" aria-label="HUD data surface">
    <div class="console-rule"><span>// HUD DATA SURFACE //</span></div>
    <% [
      ["GET /api/overlay/now-playing", "the current track (player and admin writes)"],
      ["GET /api/overlay/alerts/pending", "the undisplayed alert queue"],
      ["GET /api/world_events", "the world event feed backlog"],
      ["OverlayChannel", "live pushes: now_playing_changed, new_alert"],
      ["WorldEventFeedChannel", "live world events"]
    ].each do |surface, carries| %>
      <div class="rc-row">
        <span class="rc-hot"><%= surface %></span>
        <span class="console-desc"><%= carries %></span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :streams, except: "OVERLAYS" %>

  <div class="console-rule"><span>// END OF SURFACE //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:streams, except: "OVERLAYS", extra: ["playing"]) %>
</div>
