<%# The flash as console replies under the bar — [OK] + the message after
    a commit, [ERR] + the message on a rejected one (flash.now). Shared by
    every /root music screen. %>
<% if flash[:success].present? %>
  <div class="rc-flash rc-flash--ok console-line" data-terminal-target="line">
    <span class="console-tag">[OK]</span><span><%= flash[:success] %></span>
  </div>
<% end %>
<% if flash[:error].present? %>
  <div class="rc-flash rc-flash--err console-line" data-terminal-target="line">
    <span class="console-tag">[ERR]</span><span><%= flash[:error] %></span>
  </div>
<% end %>
