<%# /root/data_audit_flags — the data audit's RED FLAGS as a console
    screen (2026-11-04; root_console.css): bar, // OPEN // tiles (by
    severity, by domain), LAST SCAN + [RESCAN] (POST scan), the //
    FILTER // rows (server-side: STATUS / SEVERITY / DOMAIN links
    keeping each other, CHECK select, SEARCH — [FILTER] / [x] CLEAR),
    // RED FLAGS // last seen first, 50 a page (STATUS over "until …" ·
    SEVERITY · title over the check and first flagged · DOMAIN · the
    subject ([>] EDIT when it has a record screen) · LAST SEEN · [ACK
    24H] [ACK 7D] [ACK FOREVER] or [REOPEN] — each lands back here)
    with the pager, destinations, the > prompt. A data ledger: no row
    opens anything of its own. Assigns: @flags, @by_severity,
    @by_domain, @check_names, @total_count, @offset, @per_page,
    @last_scan_at, @status, @severity, @domain, @check_name. %>
<% content_for :title, "/root/data_audit_flags :: RED FLAGS" %>
<% flags = @flags.to_a %>
<% keep = {"status" => @status, "severity" => @severity, "domain" => @domain, "check_name" => @check_name, "search" => @search}.compact_blank %>
<% filtered = keep.any? %>
<% severity_tone = {"critical" => "rc-bad", "warning" => "rc-star", "info" => "rc-hot"} %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "RED FLAGS", sub: "ROOT · META · /root/data_audit_flags"} do %>
    <% open_count = @by_severity.values.sum %>
    <%= root_badge(open_count.zero? ? "ALL CLEAR" : "#{open_count} OPEN", open_count.zero? ? :live : :err) %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-rule"><span>// OPEN //</span></div>
  <div class="rc-stats">
    <% DataAuditFlag::SEVERITIES.each do |sev| %>
      <div class="rc-stat"><span class="rc-stat-key"><%= sev.upcase %></span><span class="rc-stat-val <%= (@by_severity[sev].to_i > 0) ? severity_tone[sev] : "rc-off" %>"><%= @by_severity[sev] || 0 %></span></div>
    <% end %>
    <% DataAuditFlag::DOMAINS.each do |dom| %>
      <div class="rc-stat"><span class="rc-stat-key"><%= dom.upcase %></span><span class="rc-stat-val"><%= @by_domain[dom] || 0 %></span></div>
    <% end %>
  </div>
  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">LAST SCAN</span>
      <span class="console-val"><%= @last_scan_at ? @last_scan_at.strftime("%Y-%m-%d %H:%M:%S") : "NEVER" %> <span class="console-dim">· every 6 hours</span></span>
    </div>
  </div>
  <div class="rc-actions">
    <%= button_to "[!] RESCAN", scan_admin_data_audit_flags_path, method: :post, class: "rc-btn rc-btn--hot" %>
  </div>

  <%= form_with url: admin_data_audit_flags_path, method: :get, local: true do %>
    <div class="console-rule"><span>// FILTER //</span></div>
    <div class="console-status">
      <% {"STATUS" => [:status, @status, DataAuditFlag::STATUSES], "SEVERITY" => [:severity, @severity, DataAuditFlag::SEVERITIES], "DOMAIN" => [:domain, @domain, DataAuditFlag::DOMAINS]}.each do |label, (key, current, values)| %>
        <div class="console-status-row rc-field">
          <span class="console-key"><%= label %></span>
          <span class="console-val">
            <% [["ALL", ""]].concat(values.map { |v| [v.upcase, v] }).each do |word, value| %>
              <%= link_to word, admin_data_audit_flags_path(keep.merge(key.to_s => value.presence).compact), class: class_names("rc-btn", "rc-btn--on": current == value), aria: {current: current == value && "page"} %>
            <% end %>
          </span>
        </div>
      <% end %>
      <%= root_field("CHECK", id: "check_name") do %>
        <%= select_tag :check_name, options_for_select([["ALL", ""]] + @check_names.map { |c| [c.humanize.upcase, c] }, @check_name), class: "rc-select" %>
      <% end %>
      <%= root_field("SEARCH", id: "search") do %>
        <%= text_field_tag :search, @search, class: "rc-input rc-input--wide", placeholder: "words in the title", autocomplete: "off" %>
      <% end %>
    </div>
    <% keep.except("search", "check_name").each do |key, value| %><%= hidden_field_tag key, value %><% end %>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[FILTER]</button>
      <%= link_to "[x] CLEAR", admin_data_audit_flags_path, class: "rc-btn" %>
    </div>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--flags" aria-label="Red flags">
    <div class="console-rule"><span>// RED FLAGS · <%= @total_count %> //</span></div>
    <% if flags.empty? %>
      <%= render "admin/console/empty", text: filtered ? "NO FLAGS MATCH" : "NO RED FLAGS · ALL CLEAR", hint: ("[x] CLEAR shows every flag" if filtered) %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>STATUS</span><span>SEVERITY</span><span>TITLE</span><span>DOMAIN</span><span>SUBJECT</span><span>LAST SEEN</span><span></span>
      </div>
    <% end %>
    <% flags.each do |flag| %>
      <% eff_status = flag.effective_status %>
      <% subject_path = flag.subject_type.present? && flag.subject_id.present? && admin_subject_path(flag.subject_type, flag.subject_id) %>
      <div class="rc-row">
        <div class="cc-text">
          <span class="rc-cell <%= (eff_status == "open") ? "rc-bad" : "rc-off" %>"><%= eff_status.upcase %></span>
          <% if flag.status == "acknowledged" %><div class="cc-meta"><%= flag.snooze_until ? "until #{flag.snooze_until.strftime("%m-%d %H:%M")}" : "forever" %></div><% end %>
        </div>
        <span class="rc-cell <%= severity_tone[flag.severity] %>"><%= flag.severity.upcase %></span>
        <div class="cc-text">
          <span class="cc-name" title="<%= flag.title %>"><%= flag.title %></span>
          <div class="cc-meta"><%= flag.check_name %> · first <%= flag.first_flagged_at&.strftime("%Y-%m-%d %H:%M") || "—" %></div>
        </div>
        <span class="rc-cell <%= (flag.domain == "grid") ? "rc-on" : "rc-violet" %>"><%= flag.domain.upcase %></span>
        <span class="rc-cell">
          <% if subject_path %>
            <%= link_to "[>] EDIT", subject_path, class: "console-link" %>
          <% elsif flag.subject_type.present? && flag.subject_id.present? %>
            <span class="rc-off"><%= flag.subject_type.demodulize %>#<%= flag.subject_id %></span>
          <% else %>
            —
          <% end %>
        </span>
        <span class="rc-cell"><%= flag.last_seen_at&.strftime("%Y-%m-%d %H:%M") || "—" %></span>
        <span class="rc-cell rc-links">
          <% if eff_status == "open" %>
            <% {"24h" => "24H", "7d" => "7D", "forever" => "FOREVER"}.each do |duration, word| %>
              <%= button_to "[ACK #{word}]", acknowledge_admin_data_audit_flag_path(flag, duration: duration), method: :post, class: "rc-btn" %>
            <% end %>
          <% else %>
            <%= button_to "[REOPEN]", reopen_admin_data_audit_flag_path(flag), method: :post, class: "rc-btn rc-btn--danger" %>
          <% end %>
        </span>
      </div>
    <% end %>
    <%= root_pager(@offset, @per_page, @total_count) %>
  </section>

  <%= render "admin/console/destinations", section: :meta, except: "FLAGS" %>

  <div class="console-rule"><span>// LAST SEEN FIRST //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:meta, except: "FLAGS") %>
</div>
