<%# /root/grid_transit_types/new — a new transit type on the record
    screen's shell (a draft, last in the order). %>
<% content_for :title, "/root/grid_transit_types/new :: NEW TYPE" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "NEW TYPE", sub: "ROOT · TRANSIT · /root/grid_transit_types/new"} do %>
    <%= link_to "[<] TRANSIT", admin_grid_transit_types_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @transit_type, url: admin_grid_transit_types_path, local: true do |f| %>
    <%= render "form", f: f %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[CREATE TYPE]</button>
      <%= link_to "[CANCEL]", admin_grid_transit_types_path, class: "rc-btn" %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :world %>
  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world) %>
</div>
