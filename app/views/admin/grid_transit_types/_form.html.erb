<%# The transit type's fields as console status rows (ConsoleFormBuilder
    rc_* rows), then // DESCRIPTION //. The commit row belongs to the
    caller. Locals: f. %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, required: true, autocomplete: "off", pattern: "[a-z0-9\\-]+", title: "lowercase letters, digits, hyphens", hint: "unique · lowercase letters, numbers, hyphens" %>
  <%= f.rc_select :category, GridTransitType::CATEGORIES.map { |c| [c.upcase, c] }, {} %>
  <%= f.rc_number_field :base_fare, label: "FARE", width: :short, min: 0, hint: "CRED" %>
  <%= f.rc_number_field :min_clearance, label: "CLEARANCE", width: :short, min: 0, max: 99 %>
  <%= f.rc_text_field :icon_key, label: "ICON", autocomplete: "off", width: :short, hint: "e.g. TRAIN, BUS, TAXI" %>
  <%= f.rc_number_field :position, width: :short %>
  <%= f.rc_flags("FLAGS", hint: "unchecked hides the type and its routes from hackrs") do %>
    <%= f.rc_check_box :published, label: "PUBLISHED" %>
  <% end %>
</div>

<%= f.rc_text_area :description, rows: 3, spellcheck: true %>
