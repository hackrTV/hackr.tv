<%= form_with model: [:admin, transit_type], local: true do |f| %>
  <h3 class="cyan-255-text" style="margin: 20px 0 15px 0;">[:: TYPE INFO ::]</h3>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
    <div>
      <%= f.tui_text_field :name %>
    </div>
    <div>
      <%= f.tui_text_field :slug, hint: "lowercase letters, numbers, hyphens only" %>
    </div>
  </div>

  <div style="margin-top: 15px;">
    <%= f.tui_text_area :description, style: "height: 80px;" %>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 20px; margin-top: 15px;">
    <div>
      <%= f.tui_select :category, GridTransitType::CATEGORIES.map { |c| [c.upcase, c] }, {} %>
    </div>
    <div>
      <%= f.tui_number_field :base_fare, min: 0, label: "BASE FARE (CRED)" %>
    </div>
    <div>
      <%= f.tui_number_field :min_clearance, min: 0, max: 99 %>
    </div>
    <div>
      <%= f.tui_text_field :icon_key, hint: "e.g. TRAIN, BUS, TAXI" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 15px;">
    <div>
      <%= f.tui_number_field :position, min: 0 %>
    </div>
    <div>
      <%= f.tui_check_box :published %>
    </div>
  </div>

  <div style="margin-top: 25px;">
    <%= tui_submit transit_type.new_record? ? "Create Transit Type" : "Update Transit Type", form: f, color: :green, style: "padding: 8px 20px;" %>
    <%= tui_button "Cancel", admin_grid_transit_types_path, style: "padding: 8px 20px; margin-left: 10px;" %>
  </div>
<% end %>
