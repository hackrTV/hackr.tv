<%# /root/grid_transit_types/:slug/edit — the transit type as a console
    screen (2026-10-31). Bar (name · ROOT · TRANSIT · path; [<] TRANSIT,
    [HISTORY]), the fields, // COMMIT // ([SAVE] [CANCEL] · [DELETE] —
    refused while routes use the type), // ROUTES // (the type's routes,
    NN opens one), destinations, the > prompt. URLs use
    slug_in_database. The delete form is hidden at the end. Assigns:
    @transit_type. %>
<% slug = @transit_type.slug_in_database %>
<% name = @transit_type.name_in_database %>
<% routes = @transit_type.grid_transit_routes.includes(:grid_region).ordered.to_a %>
<% numbers = routes.each_index.map { |i| root_num(i) } %>
<% content_for :title, "/root/grid_transit_types/#{slug} :: #{name}" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: name, sub: "ROOT · TRANSIT · /root/grid_transit_types/#{slug}"} do %>
    <%= link_to "[<] TRANSIT", admin_grid_transit_types_path, class: "console-bar-link" %>
    <%= link_to "[HISTORY]", history_admin_grid_transit_type_path(slug), class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @transit_type, url: admin_grid_transit_type_path(slug), method: :patch, local: true do |f| %>
    <%= render "form", f: f %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[SAVE TYPE]</button>
      <%= link_to "[CANCEL]", admin_grid_transit_types_path, class: "rc-btn" %>
      <span class="rc-actions--end">
        <button type="submit" form="delete-type" class="rc-btn rc-btn--danger">[DELETE TYPE]</button>
      </span>
    </div>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--type-routes" aria-label="Routes">
    <div class="console-rule"><span>// ROUTES //</span></div>
    <% if routes.empty? %>
      <%= render "admin/console/empty", text: "NO ROUTES RUN THIS TYPE" %>
    <% end %>
    <% routes.each_with_index do |route, i| %>
      <% num = numbers[i] %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <%= link_to route.name, edit_admin_grid_transit_route_path(route), class: "console-link cc-name", data: {command: num} %>
        <span class="rc-cell"><%= route.grid_region.name %></span>
        <span class="rc-cell <%= route.active? ? "rc-on" : "rc-off" %>"><%= route.active? ? "ACTIVE" : "OFF" %></span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :world %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world, numbers: numbers, noun: "a route number") %>

  <div class="rc-hidden-forms">
    <%= root_delete_form("delete-type", admin_grid_transit_type_path(slug), confirm: "Delete transit type '#{name}'?") %>
  </div>
</div>
