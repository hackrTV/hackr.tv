<%# /root/grid_transit_types — the transit types ledger as a console
    screen (2026-10-31; root_console.css): bar, ON RECORD row,
    // TRANSIT TYPES // rows ([NN] · name over slug · CATEGORY · FARE ·
    CL · ICON · LIVE / DRAFT · [HISTORY]), destinations, the > prompt (NN
    opens the record screen; deletes live there). Assigns:
    @transit_types. %>
<% content_for :title, "/root/grid_transit_types :: TRANSIT TYPES" %>
<% types = @transit_types.to_a %>
<% numbers = types.each_index.map { |i| root_num(i) } %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "TRANSIT TYPES", sub: "ROOT · WORLD · /root/grid_transit_types"} do %>
    <%= link_to "[+] NEW TYPE", new_admin_grid_transit_type_path, class: "console-bar-link", data: {command: "new"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(types.size, "transit type") %> <span class="console-dim">· <%= types.count(&:published?) %> live</span></span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--transit-types" aria-label="Transit types">
    <div class="console-rule"><span>// TRANSIT TYPES //</span></div>
    <% if types.empty? %>
      <%= render "admin/console/empty", text: "NO TRANSIT TYPES ON RECORD", hint: "[+] NEW TYPE adds a vehicle" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span></span><span>TYPE</span><span>CATEGORY</span><span class="rc-cell--r">FARE</span><span class="rc-cell--r">CL</span><span>ICON</span><span></span><span></span>
      </div>
    <% end %>
    <% types.each_with_index do |type, i| %>
      <% num = numbers[i] %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to type.name, edit_admin_grid_transit_type_path(type), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= type.slug %></div>
        </div>
        <span class="rc-cell <%= {"public" => "rc-on", "private" => "rc-star"}.fetch(type.category, "rc-hot") %>"><%= type.category.upcase %></span>
        <span class="rc-cell rc-cell--r"><%= type.base_fare %></span>
        <span class="rc-cell rc-cell--r"><%= type.min_clearance %></span>
        <span class="rc-cell"><%= type.icon_key.presence || "—" %></span>
        <span class="rc-cell <%= type.published? ? "rc-on" : "rc-off" %>"><%= type.published? ? "LIVE" : "DRAFT" %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[HISTORY]", history_admin_grid_transit_type_path(type), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :world, except: "TRANSIT" %>

  <div class="console-rule"><span>// EVERY TRANSIT TYPE ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world, except: "TRANSIT", numbers: numbers, noun: "a type number", extra: ["new"]) %>
</div>
