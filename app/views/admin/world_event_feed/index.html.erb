<%# /root/world_event_feed — the World Event Feed's controls as a console
    screen (2026-10-31; root_console.css): bar (SIMULATOR ON / HIDDEN
    badges), // STATUS // tiles (organic rate, target, totals,
    simulants), // SETTINGS // (target rate, simulator, visibility — PATCH
    settings), // MANUAL PUBLISH // (an event as a simulant or SYSTEM —
    POST publish), // RECENT EVENTS // the last 50 (time · type · message
    over the alias · SIM / ORG), destinations, the > prompt. Assigns:
    @settings, @recent_events, @simulants, @organic_rate, @total_events,
    @simulated_count, @organic_count. %>
<% content_for :title, "/root/world_event_feed :: FEED" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "WORLD FEED", sub: "ROOT · STREAMS · /root/world_event_feed"} do %>
    <%= root_badge(@settings.simulator_enabled? ? "SIMULATOR ON" : "SIMULATOR OFF", @settings.simulator_enabled? ? :live : :warn) %>
    <% unless @settings.visible? %><%= root_badge("HIDDEN", :warn) %><% end %>
    <%= link_to "[>] FEED", world_feed_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-rule"><span>// STATUS //</span></div>
  <div class="rc-stats">
    <div class="rc-stat"><span class="rc-stat-key">ORGANIC / MIN</span><span class="rc-stat-val rc-on"><%= @organic_rate %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">TARGET / MIN</span><span class="rc-stat-val"><%= @settings.target_events_per_minute %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">EVENTS</span><span class="rc-stat-val"><%= @total_events %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">ORGANIC</span><span class="rc-stat-val"><%= @organic_count %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">SIMULATED</span><span class="rc-stat-val"><%= @simulated_count %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">SIMULANTS</span><span class="rc-stat-val"><%= @simulants.size %></span></div>
  </div>

  <%= form_with model: @settings, url: settings_admin_world_event_feed_index_path, method: :patch, local: true do |f| %>
    <div class="console-rule"><span>// SETTINGS //</span></div>
    <div class="console-status">
      <%= f.rc_number_field :target_events_per_minute, label: "TARGET", width: :short, min: 1, max: 60, step: 1, hint: "events per minute the simulator tops the organic rate up to" %>
      <%= f.rc_flags("FEED", hint: "hidden keeps /feed and the HUD's world events off for hackrs") do %>
        <%= f.rc_check_box :simulator_enabled, label: "SIMULATOR ON" %>
        <%= f.rc_check_box :visible, label: "VISIBLE TO HACKRS" %>
      <% end %>
    </div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[SAVE SETTINGS]</button>
    </div>
  <% end %>

  <%= form_with url: publish_admin_world_event_feed_index_path, method: :post, local: true do |f| %>
    <div class="console-rule"><span>// MANUAL PUBLISH //</span></div>
    <div class="console-status">
      <%= f.rc_select :event_type, WorldEvent::EVENT_TYPES.map { |t| [t.upcase, t] }, {}, label: "EVENT TYPE" %>
      <%= f.rc_select :hackr_alias, @simulants.map { |s| [s.hackr_alias, s.hackr_alias] }, {include_blank: "— SYSTEM —"}, label: "SIMULANT",
        hint: "simulant accounts only · blank publishes as SYSTEM" %>
      <%= f.rc_text_field :message, autocomplete: "off", width: :wide, hint: "for the manual type" %>
      <%= f.rc_text_field :mission_name, label: "MISSION", autocomplete: "off", width: :wide, hint: "for mission accepted / completed" %>
    </div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[PUBLISH EVENT]</button>
    </div>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--events" aria-label="Recent events">
    <div class="console-rule"><span>// RECENT EVENTS //</span></div>
    <% if @recent_events.empty? %>
      <%= render "admin/console/empty", text: "NO EVENTS YET", hint: "start the simulator or publish one by hand" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>TIME</span><span>TYPE</span><span>MESSAGE</span><span>SRC</span>
      </div>
    <% end %>
    <% @recent_events.each do |event| %>
      <div class="rc-row">
        <span class="console-tag"><%= event.created_at.strftime("%H:%M:%S") %></span>
        <span class="rc-cell rc-hot"><%= event.event_type %></span>
        <div class="cc-text">
          <span><%= WorldEventFeed::Publisher.render_message(event) %></span>
          <div class="cc-meta">@<%= event.hackr_alias %></div>
        </div>
        <span class="rc-cell <%= event.simulated? ? "rc-star" : "rc-on" %>"><%= event.simulated? ? "SIM" : "ORG" %></span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :streams, except: "FEED" %>

  <div class="console-rule"><span>// END OF FEED //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:streams, except: "FEED") %>
</div>
