<%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "padding: 20px;") do %>
  <% if @scene_group.errors.any? %>
    <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin-bottom: 20px;">
      <p class="red-255-text"><%= @scene_group.errors.full_messages.join(", ") %></p>
    </div>
  <% end %>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_text_field :name %>
    </div>
    <div style="flex: 1;">
      <%= f.tui_text_field :slug, hint: "Leave blank to auto-generate from name" %>
    </div>
  </div>

  <div style="margin-top: 20px;">
    <%= tui_submit @scene_group.new_record? ? "Create Group" : "Update Group", form: f, color: :green, style: "padding: 10px 20px; font-weight: bold;" %>
    <%= tui_button "Cancel", admin_overlay_scene_groups_path, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% if @scene_group.persisted? %>
      <%= tui_button "History", history_admin_overlay_scene_group_path(@scene_group), color: :purple, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% end %>
  </div>
<% end %>
