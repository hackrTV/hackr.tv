<%# The /root nav bar — one 22px row (admin_chrome.css), the public
    .tui-nav's height. Brand + alias left, the section links right; the
    dropdowns are pure-CSS hover menus (no Turbo / Stimulus in the admin
    layout). Section colors ride the TuiCss palette classes; the active
    section / entry comes from Admin::NavHelper. Console [<] / [>] tags
    instead of arrow glyphs — the Terminus subset has no arrows. %>
<nav class="admin-nav" aria-label="Admin">
  <div class="admin-nav-inner">
    <%= link_to "/root", admin_root_path, class: "admin-nav-brand" %>
    <% if current_hackr %>
      <span class="admin-nav-who" title="Logged in as">@<span class="purple-168-text"><%= current_hackr.hackr_alias %></span></span>
    <% end %>

    <ul class="admin-nav-items">
      <%= admin_nav_item(:dashboard) do %>
        <%= admin_nav_link "Dashboard", admin_root_path, css: "cyan-168-text", match: "=/root" %>
      <% end %>
      <%= admin_nav_item(:music, dropdown: true) do %>
        <span class="admin-nav-dropdown-trigger cyan-168-text">Music</span>
        <ul class="admin-nav-dropdown-menu">
          <li><%= admin_nav_link "Artists", admin_artists_path, css: "cyan-168-text" %></li>
          <li><%= admin_nav_link "Releases", admin_releases_path, css: "cyan-168-text" %></li>
          <li><%= admin_nav_link "Tracks", admin_tracks_path, css: "cyan-168-text" %></li>
          <li><%= admin_nav_link "Radio", admin_radio_stations_path, css: "cyan-168-text" %></li>
        </ul>
      <% end %>
      <%= admin_nav_item(:logs) do %>
        <%= admin_nav_link "Logs", admin_hackr_logs_path, css: "cyan-168-text" %>
      <% end %>
      <%= admin_nav_item(:codex) do %>
        <%= admin_nav_link "Codex", admin_codex_entries_path, css: "cyan-168-text" %>
      <% end %>
      <%= admin_nav_item(:handbook, dropdown: true) do %>
        <span class="admin-nav-dropdown-trigger cyan-168-text">Handbook</span>
        <ul class="admin-nav-dropdown-menu">
          <li><%= admin_nav_link "Sections", admin_handbook_sections_path, css: "cyan-168-text" %></li>
          <li><%= admin_nav_link "Articles", admin_handbook_articles_path, css: "cyan-168-text" %></li>
        </ul>
      <% end %>
      <%= admin_nav_item(:streams) do %>
        <%= admin_nav_link "Streams", admin_hackr_streams_path, css: "green-255-text" %>
      <% end %>
      <%= admin_nav_item(:pulsewire) do %>
        <%= admin_nav_link "PulseWire", admin_pulse_wire_index_path, css: "purple-168-text" %>
      <% end %>
      <%= admin_nav_item(:emotes) do %>
        <%= admin_nav_link "Emotes", admin_emotes_path, css: "purple-168-text" %>
      <% end %>
      <%= admin_nav_item(:uplink) do %>
        <%= admin_nav_link "Uplink", admin_uplink_index_path, css: "purple-168-text" %>
      <% end %>
      <%= admin_nav_item(:grid, dropdown: true) do %>
        <span class="admin-nav-dropdown-trigger green-168-text">Grid</span>
        <ul class="admin-nav-dropdown-menu">
          <li><%= admin_nav_link "Dashboard", admin_grid_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Economy", admin_grid_economy_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Transactions", admin_grid_transactions_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Item Defs", admin_grid_item_definitions_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Shops", admin_grid_shop_listings_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Achievements", admin_grid_achievements_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Missions", admin_grid_missions_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Schematics", admin_grid_schematics_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Breach Templates", admin_grid_breach_templates_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Breach Encounters", admin_grid_breach_encounters_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Transit Types", admin_grid_transit_types_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Transit Routes", admin_grid_transit_routes_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Slipstream", admin_grid_slipstream_routes_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Journeys", admin_grid_transit_journeys_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Mission Arcs", admin_grid_mission_arcs_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Factions", admin_grid_factions_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Regions", admin_grid_regions_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Zones", admin_grid_zones_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Rooms", admin_grid_rooms_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Mobs", admin_grid_mobs_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Exits", admin_grid_exits_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Map Editor", admin_grid_map_editor_region_show_path(region_id: GridRegion.first&.id || 0), css: "green-168-text", match: "/root/grid_map_editor*" %></li>
          <li><%= admin_nav_link "Starting Rooms", admin_grid_starting_rooms_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Rep Log", admin_grid_reputation_events_path, css: "green-168-text" %></li>
          <li><%= admin_nav_link "Impound", admin_grid_impound_records_path, css: "green-168-text" %></li>
        </ul>
      <% end %>
      <%= admin_nav_item(:hackrs) do %>
        <% if dev_tools_enabled? %>
          <%= admin_nav_link "Hackrs", admin_grid_hackrs_path, css: "yellow-168-text", match: "/root/grid_hackr*", title: "DEV TOOLS ON" %>
        <% else %>
          <%= admin_nav_link "Hackrs", admin_grid_hackrs_path, css: "green-168-text", match: "/root/grid_hackr*" %>
        <% end %>
      <% end %>
      <%= admin_nav_item(:meta, dropdown: true, end_aligned: true) do %>
        <span class="admin-nav-dropdown-trigger cyan-168-text">Meta</span>
        <ul class="admin-nav-dropdown-menu">
          <li><%= admin_nav_link "Errors", admin_error_groups_path, css: "red-168-text" %></li>
          <li><%= admin_nav_link "Red Flags", admin_data_audit_flags_path, style: "color: #ff6600;" %></li>
          <li><%= admin_nav_link "Analytics", admin_analytics_dashboard_path, css: "cyan-168-text" %></li>
          <li><%= admin_nav_link "Overlays", admin_overlays_path, css: "yellow-168-text" %></li>
          <li><%= admin_nav_link "World Feed", admin_world_event_feed_index_path, css: "cyan-168-text" %></li>
          <li><%= admin_nav_link "Redirects", admin_redirects_path, css: "cyan-168-text" %></li>
          <li><%= admin_nav_link "Test Guide", admin_test_guide_path, css: "green-168-text", match: "/root/test_*" %></li>
        </ul>
      <% end %>
      <li class="admin-nav-sep" aria-hidden="true">|</li>
      <li><%= link_to "[<] EXIT", root_path, class: "red-168-text" %></li>
    </ul>
  </div>
</nav>
