<%# RED FLAGS strip — one 22px line flush under the nav (admin_chrome.css
    .admin-banner), rendered only while flags are open. %>
<% count = DataAudit::FlagCache.open_count %>
<% if count > 0 %>
  <div class="admin-banner admin-banner--flags" role="status">
    <div class="admin-banner-inner">
      <span class="admin-banner-label">⚑ RED FLAGS: <%= count %> open</span>
      <span class="admin-banner-sep" aria-hidden="true">|</span>
      <%= link_to "View All →", admin_data_audit_flags_path %>
    </div>
  </div>
<% end %>
