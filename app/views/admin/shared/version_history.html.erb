<%# admin/shared/version_history — a Versionable record's PaperTrail
    timeline as a console screen (2026-10-30; Admin::Versionable#history
    renders it for every versioned resource). Bar (the record's name ·
    ROOT · <MODEL> · HISTORY · slug; [<] BACK to the ledger, [EDIT] the
    record — the prompt's back / edit), the VERSIONS readout, the
    // VERSIONS // ledger ([NN] · CREATE / UPDATE / DESTROY · SOURCE (a
    child row names its model) · BY · WHEN · the first eight changed
    keys as `key: from > to` lines, +N more), the > prompt. Assigns:
    @record, @model_name, @entries ({version:, source:, changes:},
    newest first), @back_path. %>
<% name = @record.respond_to?(:name) ? @record.name : (@record.respond_to?(:title) ? @record.title : "##{@record.id}") %>
<% content_for :title, "/root/history :: #{name}" %>
<% child_count = @entries.count { |entry| entry[:source] != @model_name } %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: name, sub: "ROOT · #{@model_name.upcase} · HISTORY#{" · #{@record.slug}" if @record.respond_to?(:slug)}"} do %>
    <%= link_to "[<] BACK", @back_path, class: "console-bar-link", data: {command: "back"} %>
    <%= link_to "[EDIT]", url_for(action: :edit, id: @record, only_path: true), class: "console-bar-link", data: {command: "edit"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">VERSIONS</span>
      <span class="console-val"><%= pluralize(@entries.size, "version") %> <span class="console-dim">· newest first<% if child_count > 0 %> · <%= pluralize(child_count, "child change") %><% end %></span></span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--versions" aria-label="Versions">
    <div class="console-rule"><span>// VERSIONS //</span></div>
    <% if @entries.empty? %>
      <%= render "admin/console/empty", text: "NO VERSIONS ON RECORD", hint: "nothing has changed since tracking began" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>NN</span><span>EVENT</span><span>SOURCE</span><span>BY</span><span>WHEN</span><span>CHANGES</span>
      </div>
    <% end %>
    <% @entries.each_with_index do |entry, i| %>
      <% version = entry[:version] %>
      <% changes = entry[:changes] %>
      <% child = entry[:source] != @model_name %>
      <% who = version.whodunnit.present? ? (GridHackr.find_by(id: version.whodunnit)&.hackr_alias || "hackr##{version.whodunnit}") : nil %>
      <div class="rc-row">
        <span class="console-tag">[<%= root_num(i, total: @entries.size) %>]</span>
        <span class="rc-cell <%= {"create" => "rc-on", "update" => "rc-star", "destroy" => "rc-bad"}[version.event] %>"><%= version.event.upcase %></span>
        <span class="rc-cell <%= "rc-hot" if child %>"><%= entry[:source] %></span>
        <span class="rc-cell <%= who ? "rc-hot" : "rc-off" %>"><%= who || "system" %></span>
        <span class="rc-cell"><%= version.created_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
        <div class="rc-diff">
          <% if changes.any? %>
            <% changes.first(8).each do |change| %>
              <div class="rc-diff-line"><span class="rc-diff-key"><%= change[:key].delete_suffix("_id") %></span>:
                <% if change[:from].present? %><del class="rc-del"><%= truncate(change[:from].to_s, length: 60) %></del><% end %>
                <% if change[:from].present? %> &gt; <% end %>
                <% if change[:to].present? %><ins class="rc-add"><%= truncate(change[:to].to_s, length: 60) %></ins><% elsif change[:from].present? %><span class="console-dim">null</span><% end %></div>
            <% end %>
            <% if changes.size > 8 %>
              <div class="rc-diff-line console-dim">+<%= changes.size - 8 %> more</div>
            <% end %>
          <% elsif version.event == "create" && !child %>
            <div class="rc-diff-line">initial creation</div>
          <% else %>
            <div class="rc-diff-line">—</div>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: safe_join(["type ", tag.span("back", class: "console-dim"), " or ", tag.span("edit", class: "console-dim"), " · enter · ? help"]) %>
</div>
