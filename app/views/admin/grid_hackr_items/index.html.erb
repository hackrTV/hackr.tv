<%# /root/grid_hackrs/:hackr_id/items — a hackr's items as a console
    screen (2026-11-01; prod-safe; root_console.css): bar (alias · ITEMS
    · [<] INSPECTOR), ON HAND (slots used / capacity), // GRANT // (the
    ITEM picker over every definition — grant-* ids, the commit refused
    until one is picked — and QTY), // EQUIPPED // (slot · item; removal
    waits for an unequip), // INVENTORY // ([REMOVE] per item, confirming
    — an item has no screen of its own), destinations, the > prompt; the
    picker's script renders after the screen. Assigns: @hackr,
    @inventory, @equipped, @definitions. %>
<% content_for :title, "/root/grid_hackrs/#{@hackr.id}/items :: ITEMS" %>
<% inventory = @inventory.to_a %>
<% equipped = @equipped.to_a %>
<% definitions = @definitions.to_a %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: link_to(@hackr.hackr_alias, admin_grid_hackr_path(@hackr)), sub: "ROOT · ITEMS · /root/grid_hackrs/#{@hackr.id}/items"} do %>
    <%= link_to "[<] INSPECTOR", admin_grid_hackr_path(@hackr), class: "console-bar-link", data: {command: "back"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON HAND</span>
      <span class="console-val"><%= inventory.size %> / <%= @hackr.inventory_capacity %> slots <span class="console-dim">· <%= equipped.size %> equipped</span></span>
    </div>
  </div>

  <%= form_with url: admin_grant_grid_hackr_item_path(@hackr), method: :post, local: true, id: "grant-form" do %>
    <div class="console-rule"><span>// GRANT //</span></div>
    <div class="console-status">
      <%= render "admin/console/picker", label: "ITEM", key: "grant", name: "definition_id", value: nil, text: nil,
        placeholder: "name · type · rarity", status: "#{definitions.size} definitions · type to filter" %>
      <%= root_field("QTY", id: "quantity") do %>
        <%= number_field_tag :quantity, 1, min: 1, max: 99, class: "rc-input rc-input--short" %>
      <% end %>
    </div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[GRANT]</button>
    </div>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--equipped" aria-label="Equipped">
    <div class="console-rule"><span>// EQUIPPED · <%= equipped.size %> //</span></div>
    <% if equipped.empty? %>
      <%= render "admin/console/empty", text: "NOTHING EQUIPPED" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>SLOT</span><span>ITEM</span><span>TYPE</span><span>RARITY</span><span class="rc-cell--r">VALUE</span>
      </div>
    <% end %>
    <% equipped.each do |item| %>
      <div class="rc-row">
        <span class="rc-cell rc-hot"><%= GridHackr::Loadout::GEAR_SLOT_LABELS[item.equipped_slot] || item.equipped_slot %></span>
        <span><%= item.name %></span>
        <span class="rc-cell"><%= item.item_type %></span>
        <span class="rc-cell"><%= item.rarity_label %></span>
        <span class="rc-cell rc-cell--r"><%= item.value %></span>
      </div>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--held" aria-label="Inventory">
    <div class="console-rule"><span>// INVENTORY · <%= inventory.size %> / <%= @hackr.inventory_capacity %> //</span></div>
    <% if inventory.empty? %>
      <%= render "admin/console/empty", text: "INVENTORY EMPTY", hint: "// GRANT // above puts an item in it" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>ITEM</span><span>TYPE</span><span>RARITY</span><span class="rc-cell--r">QTY</span><span class="rc-cell--r">VALUE</span><span></span>
      </div>
    <% end %>
    <% inventory.each do |item| %>
      <div class="rc-row">
        <span><%= item.name %></span>
        <span class="rc-cell"><%= item.item_type %></span>
        <span class="rc-cell"><%= item.rarity_label %></span>
        <span class="rc-cell rc-cell--r"><%= item.quantity %></span>
        <span class="rc-cell rc-cell--r"><%= item.value %></span>
        <span class="rc-cell rc-links">
          <%= button_to "[REMOVE]", admin_remove_grid_hackr_item_path(@hackr, item), method: :delete, class: "rc-btn rc-btn--danger",
            form: {data: {confirm: "Remove #{item.name} (x#{item.quantity}) from #{@hackr.hackr_alias}?"}} %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :hackrs %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:hackrs, extra: ["back"]) %>
</div>

<%= render "admin/shared/combobox" %>
<script nonce="<%= content_security_policy_nonce %>">
  AdminCombobox.init({
    inputId: 'grant-input',
    hiddenId: 'grant-hidden',
    dropdownId: 'grant-dropdown',
    statusId: 'grant-status',
    formId: 'grant-form',
    items: <%= raw json_escape(definitions.map { |d| {id: d.id, name: d.name, type: d.item_type, rarity: d.rarity_label, value: d.value} }.to_json) %>,
    getId: function(r) { return r.id; },
    getSearchText: function(r) { return (r.type + ' ' + r.name + ' ' + r.rarity).toLowerCase(); },
    getGroupKey: function(r) { return r.type; },
    renderOption: function(r, esc) { return '<span class="cb-name">' + esc(r.name) + '</span> <span class="cb-meta">' + esc(r.rarity) + ' · ' + r.value + ' CRED</span>'; },
    getLabel: function(r) { return r.type + ' / ' + r.name; },
    emptyText: 'No items match',
    selectedText: 'Item selected · ready to grant',
    submitError: 'Select an item definition first'
  });
</script>
