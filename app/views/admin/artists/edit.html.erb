<%= render TuiWindowComponent.new(title: "/root/artists/#{@artist.slug} :: EDIT ARTIST", variant: :admin, width: 900) do %>
    <div style="padding: 20px;">
      <%= form_with model: @artist, url: admin_artist_path(@artist), method: :patch, local: true do |f| %>
        <%= render "form", f: f %>
      <% end %>
    </div>
<% end %>
