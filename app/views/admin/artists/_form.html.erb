<%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "padding: 20px;") do %>
  <% if @artist.errors.any? %>
    <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin-bottom: 20px;">
      <p class="red-255-text"><%= @artist.errors.full_messages.join(", ") %></p>
    </div>
  <% end %>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_text_field :name %>
    </div>
    <div style="flex: 1;">
      <%= f.tui_text_field :slug %>
    </div>
  </div>

  <div style="display: flex; gap: 20px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.tui_select :artist_type, Artist::ARTIST_TYPES.map { |t| [t, t] }, {}, label: "TYPE" %>
    </div>
    <div style="flex: 1;">
      <%= f.tui_text_field :genre %>
    </div>
  </div>

  <div style="margin-top: 20px;">
    <%= tui_submit @artist.new_record? ? "Create Artist" : "Update Artist", form: f, color: :green, style: "padding: 10px 20px; font-weight: bold;" %>
    <%= tui_button "Cancel", admin_artists_path, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% if @artist.persisted? %>
      <%= tui_button "History", history_admin_artist_path(@artist), color: :purple, style: "padding: 10px 20px; margin-left: 10px;" %>
    <% end %>
  </div>
<% end %>
