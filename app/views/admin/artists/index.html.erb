<%# /root/artists — the artists ledger as a console screen (2026-10-30;
    console.css family + root_console.css): bar, ON RECORD / CATALOG rows,
    // ARTISTS // rows ([NN] · name over slug · TYPE · genre · releases ·
    tracks · [EDIT] [HISTORY]), destinations, the > prompt (NN opens the
    record screen). data-boot="done": a work screen boots instantly.
    Assigns: @artists, @type_counts, @release_count, @incoming_count,
    @track_count. %>
<% content_for :title, "/root/artists :: ARTISTS" %>
<% numbers = @artists.to_a.each_index.map { |i| root_num(i) } %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <div class="console-bar">
    <h1 class="console-bar-title">ARTISTS</h1>
    <span class="console-bar-sub">ROOT · MUSIC · /root/artists</span>
    <span class="console-bar-right">
      <%= link_to "[+] NEW ARTIST", new_admin_artist_path, class: "console-bar-link", data: {command: "new"} %>
      <%= link_to "[>] FNET", "/f/net", class: "console-bar-link" %>
    </span>
  </div>
  <%= render "admin/music/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(@artists.size, "artist") %> <span class="console-dim">· <%= Artist::ARTIST_TYPES.map { |t| "#{@type_counts[t] || 0} #{t}" }.join(" · ") %></span></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">CATALOG</span>
      <span class="console-val"><%= pluralize(@release_count, "release") %> <span class="console-dim">· <%= pluralize(@track_count, "track") %><% if @incoming_count > 0 %> · <%= @incoming_count %> incoming<% end %></span></span>
    </div>
  </div>

  <section class="console-section" aria-label="Artists">
    <div class="console-rule"><span>// ARTISTS //</span></div>
    <% if @artists.empty? %>
      <p class="rc-empty">NO ARTISTS ON RECORD <span class="console-dim">· [+] NEW ARTIST starts the record</span></p>
    <% end %>
    <% @artists.each_with_index do |artist, i| %>
      <% num = root_num(i) %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to artist.name, edit_admin_artist_path(artist), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= artist.slug %> · <%= artist.artist_type.upcase %><% if artist.genre.present? %> · <%= artist.genre %><% end %></div>
        </div>
        <span class="rc-cell rc-cell--r"><%= pluralize(artist.releases.size, "release") %></span>
        <span class="rc-cell rc-cell--r"><%= pluralize(artist.tracks.size, "track") %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[EDIT]", edit_admin_artist_path(artist), class: "console-link" %>
          <%= link_to "[HISTORY]", history_admin_artist_path(artist), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/music/destinations", except: "ARTISTS" %>

  <div class="console-rule"><span>// EVERY ACT COMMITTED TO RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(except: "ARTISTS", numbers: numbers, noun: "an artist number", extra: ["new"]) %>
</div>
