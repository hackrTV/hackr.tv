<%= render TuiWindowComponent.new(title: "/root/artists :: MANAGE ARTISTS", variant: :admin, width: 1200) do %>

    <div style="padding: 20px;">
      <!-- Flash Messages -->
      <% if flash[:success] %>
        <div style="background: #003300; border: 2px solid #00ff00; padding: 15px; margin: 20px 0;">
          <p class="green-255-text">✓ SUCCESS</p>
          <p class="white-text"><%= flash[:success] %></p>
        </div>
      <% end %>

      <% if flash[:error] %>
        <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin: 20px 0;">
          <p class="red-255-text">⚠ ERROR</p>
          <p class="white-text"><%= flash[:error] %></p>
        </div>
      <% end %>

      <!-- Navigation -->
      <div style="margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
        <%= tui_button "← Dashboard", admin_root_path, color: :green, style: "padding: 8px 20px;" %>
        <%= tui_button "+ New Artist", new_admin_artist_path, color: :green, style: "padding: 8px 20px;" %>
      </div>

      <!-- Artists Table -->
      <% if @artists.any? %>
        <%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "margin-top: 20px;") do %>
          <table class="tui-table" style="width: 100%;">
            <thead>
              <tr>
                <th style="text-align: left;">Name</th>
                <th style="text-align: left;">Slug</th>
                <th style="text-align: center;">Tracks</th>
                <th style="text-align: center;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @artists.each_with_index do |artist, i| %>
                <tr class="admin-table-row" style="<%= " background: #112;" if i.odd? %>">
                  <td><strong><%= artist.name %></strong></td>
                  <td style="font-family: monospace; color: #888;">/<%= artist.slug %></td>
                  <td style="text-align: center;"><%= artist.tracks.size %></td>
                  <td style="text-align: center; white-space: nowrap;">
                    <%= tui_button "Edit", edit_admin_artist_path(artist), style: "padding: 4px 10px;" %>
                    <%= tui_button "History", history_admin_artist_path(artist), color: :purple, style: "padding: 4px 10px;" %>
                    <%= tui_button_to "Delete", admin_artist_path(artist), method: :delete, form: { style: "display: inline;" }, color: :red, style: "padding: 4px 10px;", data: { confirm: "Delete artist '#{artist.name}'?" } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      <% else %>
        <div style="padding: 40px; text-align: center; background: #1a1a1a; border: 1px solid #333;">
          <p style="color: #666; font-size: 1.2em;">No artists yet. Create your first one!</p>
        </div>
      <% end %>
    </div>
<% end %>
