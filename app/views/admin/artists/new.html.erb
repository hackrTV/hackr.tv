<%# /root/artists/new — a new artist on the record screen's shell. %>
<% content_for :title, "/root/artists/new :: NEW ARTIST" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "NEW ARTIST", sub: "ROOT · ARTIST · /root/artists/new"} do %>
    <%= link_to "[<] ARTISTS", admin_artists_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @artist, url: admin_artists_path, local: true do |f| %>
    <%= render "form", f: f, artist: @artist %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[CREATE ARTIST]</button>
      <%= link_to "[CANCEL]", admin_artists_path, class: "rc-btn" %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :music %>
  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:music) %>
</div>
