<%# /root/test_runs/:id — one manual test run as a console readout
    (2026-11-04; root_console.css): bar (the label · RUN #id · by ·
    started · completed · [<] RUNS [>] GUIDE), // RESULTS // tiles
    (PASS / FAIL / BLOCKED / SKIP / UNRECORDED / RECORDED %), //
    ACTIONS // ([MARK RUN COMPLETE] while open — PATCH; [DELETE RUN]
    — the hidden DELETE form, confirming), // FAILURES // (the article
    over its notes, whole) when any, // ARTICLES // numbered through
    (NN opens the article · title · STATUS · notes), destinations, the
    > prompt. Assigns: @run, @articles, @results, @failures. %>
<% content_for :title, "/root/test_runs/#{@run.id} :: #{@run.label}" %>
<% numbers = @articles.each_index.map { |i| root_num(i) } %>
<% status_tone = {"pass" => "rc-on", "fail" => "rc-bad", "blocked" => "rc-star", "skip" => "rc-violet"} %>
<% counts = @results.values.group_by(&:status).transform_values(&:size) %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: @run.label, sub: "RUN ##{@run.id} · by #{@run.grid_hackr.hackr_alias} · started #{@run.created_at.strftime("%Y-%m-%d %H:%M")}#{" · completed #{@run.completed_at.strftime("%Y-%m-%d %H:%M")}" if @run.completed?}"} do %>
    <%= root_badge(@run.completed? ? "COMPLETE" : "OPEN", @run.completed? ? :hot : :live) %>
    <%= link_to "[<] RUNS", admin_test_runs_path, class: "console-bar-link", data: {command: "back"} %>
    <%= link_to "[>] GUIDE", admin_test_guide_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-rule"><span>// RESULTS //</span></div>
  <div class="rc-stats">
    <% ManualTestResult::STATUSES.each do |status| %>
      <div class="rc-stat"><span class="rc-stat-key"><%= status.upcase %></span><span class="rc-stat-val <%= (counts[status].to_i > 0) ? status_tone[status] : "rc-off" %>"><%= counts[status] || 0 %></span></div>
    <% end %>
    <div class="rc-stat"><span class="rc-stat-key">UNRECORDED</span><span class="rc-stat-val"><%= @articles.size - @results.size %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">RECORDED</span><span class="rc-stat-val"><%= @run.progress(@articles.size) %>%</span></div>
  </div>

  <div class="console-rule"><span>// ACTIONS //</span></div>
  <div class="rc-actions">
    <% unless @run.completed? %>
      <%= button_to "[MARK RUN COMPLETE]", admin_test_run_path(@run), method: :patch, class: "rc-btn rc-btn--hot" %>
    <% end %>
    <button type="submit" form="delete-run" class="rc-btn rc-btn--danger rc-actions--end">[DELETE RUN]</button>
  </div>

  <% if @failures.any? %>
    <section class="console-section rc-ledger rc-ledger--failures" aria-label="Failures">
      <div class="console-rule"><span>// FAILURES · <%= counts["fail"] %> //</span></div>
      <% @failures.each do |result| %>
        <% article = @articles.find { |a| a.slug == result.article_slug } %>
        <div class="rc-row">
          <span class="rc-cell rc-bad">FAIL</span>
          <div class="cc-text">
            <%= link_to article&.title || result.article_slug, admin_test_guide_article_path(result.article_slug), class: "console-link cc-name" %>
            <div class="cc-meta rc-cell--wrap"><%= result.notes.presence || "no notes" %></div>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--run-articles" aria-label="Articles">
    <div class="console-rule"><span>// ARTICLES //</span></div>
    <div class="rc-row rc-row--head" aria-hidden="true">
      <span></span><span>ARTICLE</span><span>STATUS</span><span>NOTES</span>
    </div>
    <% @articles.each_with_index do |article, i| %>
      <% result = @results[article.slug] %>
      <div class="rc-row">
        <span class="console-tag">[<%= numbers[i] %>]</span>
        <%= link_to article.title, admin_test_guide_article_path(article.slug), class: "console-link cc-name", data: {command: numbers[i]} %>
        <span class="rc-cell <%= result ? status_tone[result.status] : "rc-off" %>"><%= result ? result.status.upcase : "—" %></span>
        <span class="rc-cell rc-off" title="<%= result&.notes %>"><%= result&.notes.presence&.truncate(90) %></span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :meta, except: "RUNS" %>

  <div class="console-rule"><span>// END OF RUN //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:meta, except: "RUNS", numbers: numbers, noun: "an article number", extra: ["back"]) %>

  <div class="rc-hidden-forms">
    <%= root_delete_form("delete-run", admin_test_run_path(@run), confirm: "Delete run \"#{@run.label}\" and its results?") %>
  </div>
</div>
