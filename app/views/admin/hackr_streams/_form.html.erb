<%# The stream record's fields as console status rows (ConsoleFormBuilder
    rc_* rows): the broadcast (artist, title, URLs), the schedule (a
    cancelled stream says so; a new SCHEDULED FOR clears it on save), the
    timing and, on a saved stream, its state. The commit row belongs to
    the caller. Locals: f, hackr_stream; @artists for the select. %>
<% stream = hackr_stream %>
<div class="console-status">
  <%= f.rc_collection_select :artist_id, @artists, :id, :name, label: "ARTIST", include_blank: "— select artist —" %>
  <%= f.rc_text_field :title, autocomplete: "off", width: :wide, placeholder: "Live Performance - The Fracture Tour", hint: "optional · what is being streamed" %>
  <%= f.rc_text_field :live_url, label: "LIVE URL", autocomplete: "off", width: :wide, placeholder: "YouTube watch / embed URL, Twitch embed URL",
    hint: "YouTube URLs become embeds on save · required to go live" %>
  <%= f.rc_text_field :vod_url, label: "VOD URL", autocomplete: "off", width: :wide, placeholder: "YouTube watch / embed URL of the archive",
    hint: "optional · the video on demand once the stream ends" %>
</div>

<div class="console-rule"><span>// SCHEDULE //</span></div>
<div class="console-status">
  <%= f.rc_datetime_local_field :scheduled_at, label: "SCHEDULED", hint: "when it is planned to go live · blank = on demand" %>
  <% if stream.persisted? && stream.cancelled_at.present? %>
    <div class="console-status-row">
      <span class="console-key">CANCELLED</span>
      <span class="console-val"><span class="rc-bad"><%= stream.cancelled_at.strftime("%Y-%m-%d %H:%M") %></span> <span class="console-dim">· set a new SCHEDULED and save to reschedule — the cancellation clears</span></span>
    </div>
  <% end %>
  <%= f.rc_datetime_local_field :started_at, label: "STARTED", hint: "set on GO LIVE" %>
  <%= f.rc_datetime_local_field :ended_at, label: "ENDED", hint: "set on END" %>
  <% if stream.persisted? %>
    <div class="console-status-row">
      <span class="console-key">STATE</span>
      <span class="console-val"><%= render "admin/hackr_streams/state", stream: stream %> <span class="console-dim">· GO LIVE / END / CANCEL from the streams ledger</span></span>
    </div>
  <% end %>
</div>
