<%# /root/hackr_streams — the streams ledger as a console screen
    (2026-10-31; root_console.css): bar (LIVE badge while a stream is
    on), LIVE NOW + ON RECORD rows, // STREAMS // rows newest first ([NN]
    · artist over title / started / ended / URL · scheduled · state ·
    [GO LIVE] / [END] / [CANCEL] as the state allows · [EDIT]),
    destinations, the > prompt (NN opens the record screen; deletes live
    there). Assigns: @hackr_streams, @current_live. %>
<% content_for :title, "/root/hackr_streams :: STREAMS" %>
<% streams = @hackr_streams.to_a %>
<% numbers = streams.each_index.map { |i| root_num(i, total: streams.size) } %>
<% fmt = "%Y-%m-%d %H:%M" %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "STREAMS", sub: "ROOT · STREAMS · /root/hackr_streams"} do %>
    <% if @current_live %><%= root_badge("ON AIR", :live) %><% end %>
    <%= link_to "[+] NEW STREAM", new_admin_hackr_stream_path, class: "console-bar-link", data: {command: "new"} %>
    <%= link_to "[>] SCHEDULE", streams_schedule_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">LIVE NOW</span>
      <span class="console-val">
        <% if @current_live %>
          <span class="rc-on"><%= @current_live.artist.name %></span><% if @current_live.title.present? %> · <%= @current_live.title %><% end %>
          <span class="console-dim">· since <%= @current_live.started_at&.strftime(fmt) %></span>
        <% else %>
          <span class="rc-off">NO ACTIVE LIVESTREAM</span>
        <% end %>
      </span>
    </div>
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(streams.size, "stream") %> <span class="console-dim">· <%= streams.count { |s| %i[upcoming starting_soon].include?(s.display_state) } %> scheduled · <%= streams.count(&:vod?) %> with a VOD</span></span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--streams" aria-label="Streams">
    <div class="console-rule"><span>// STREAMS //</span></div>
    <% if streams.empty? %>
      <%= render "admin/console/empty", text: "NO STREAMS ON RECORD", hint: "[+] NEW STREAM schedules the first broadcast" %>
    <% end %>
    <% streams.each_with_index do |stream, i| %>
      <% num = numbers[i] %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to stream.artist.name, edit_admin_hackr_stream_path(stream), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= stream.title.presence || "untitled" %><% if stream.started_at %> · started <%= stream.started_at.strftime(fmt) %><% end %><% if stream.ended_at %> · ended <%= stream.ended_at.strftime(fmt) %><% end %><% if stream.live_url.present? %> · <%= truncate(stream.live_url, length: 48) %><% end %></div>
        </div>
        <span class="rc-cell"><%= stream.scheduled_at&.strftime(fmt) || "—" %></span>
        <%= render "admin/hackr_streams/state", stream: stream, cell: true %>
        <span class="rc-cell rc-links">
          <% if stream.is_live %>
            <%= button_to "[END]", end_stream_admin_hackr_stream_path(stream), class: "rc-btn rc-btn--danger", form: {data: {confirm: "End this livestream?"}} %>
          <% elsif stream.ended_at.nil? && stream.cancelled_at.nil? && stream.live_url.present? %>
            <%= button_to "[GO LIVE]", go_live_admin_hackr_stream_path(stream), class: "rc-btn rc-btn--hot", form: {data: {confirm: "Start livestream for #{stream.artist.name}?"}} %>
          <% end %>
          <% if stream.scheduled_at.present? && stream.cancelled_at.nil? && !stream.is_live? && stream.ended_at.nil? %>
            <%= button_to "[CANCEL]", cancel_admin_hackr_stream_path(stream), class: "rc-btn", form: {data: {confirm: "Cancel scheduled stream?"}} %>
          <% end %>
          <%= link_to "[EDIT]", edit_admin_hackr_stream_path(stream), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :streams, except: "STREAMS" %>

  <div class="console-rule"><span>// EVERY BROADCAST ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:streams, except: "STREAMS", numbers: numbers, noun: "a stream number", extra: ["new"]) %>
</div>
