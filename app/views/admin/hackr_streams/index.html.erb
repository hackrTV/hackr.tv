<%= render TuiWindowComponent.new(title: "/root/streams :: MANAGE LIVESTREAMS", variant: :admin, width: 1600) do %>

    <div style="padding: 20px;">
      <!-- Flash Messages -->
      <% if flash[:success] %>
        <div style="background: #003300; border: 2px solid #00ff00; padding: 15px; margin: 20px 0;">
          <p class="green-255-text">✓ SUCCESS</p>
          <p class="white-text"><%= flash[:success] %></p>
        </div>
      <% end %>

      <% if flash[:error] %>
        <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin: 20px 0;">
          <p class="red-255-text">⚠ ERROR</p>
          <p class="white-text"><%= flash[:error] %></p>
        </div>
      <% end %>

      <!-- Current Live Stream Status -->
      <% if @current_live %>
        <div style="background: #001a00; border: 2px solid #00ff00; padding: 20px; margin: 20px 0;">
          <p class="green-255-text" style="font-size: 1.5em; margin-bottom: 10px;">⚡ LIVE NOW</p>
          <p class="white-text"><strong><%= @current_live.artist.name %></strong></p>
          <% if @current_live.title.present? %>
            <p class="white-text"><%= @current_live.title %></p>
          <% end %>
          <p style="color: #888; margin-top: 10px;">
            Started: <%= @current_live.started_at.strftime("%Y-%m-%d %H:%M") %>
          </p>
        </div>
      <% else %>
        <div style="background: #1a1a1a; border: 2px solid #444; padding: 20px; margin: 20px 0;">
          <p style="color: #888; font-size: 1.2em;">⚫ No active livestream</p>
        </div>
      <% end %>

      <!-- Actions -->
      <div style="margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
        <%= tui_button "← Dashboard", admin_root_path, color: :green, style: "padding: 8px 20px;" %>
        <div style="margin-left: auto; display: flex; gap: 10px;">
          <%= tui_button "➕ New Stream", new_admin_hackr_stream_path, color: :purple, style: "padding: 8px 20px;" %>
        </div>
      </div>

      <!-- Streams Table -->
      <% if @hackr_streams.any? %>
        <%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "margin-top: 20px;") do %>
          <table class="tui-table" style="width: 100%;">
            <thead>
              <tr>
                <th style="text-align: left;">Artist</th>
                <th style="text-align: left;">Title</th>
                <th style="text-align: left;">Scheduled</th>
                <th style="text-align: left;">Live URL</th>
                <th style="text-align: center;">Status</th>
                <th style="text-align: center;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @hackr_streams.each do |stream| %>
                <tr class="admin-table-row">
                  <td>
                    <strong class="cyan-255-text"><%= stream.artist.name %></strong>
                  </td>
                  <td>
                    <%= stream.title.presence || "—" %>
                    <% if stream.started_at.present? %>
                      <br>
                      <small style="color: #666;">
                        Started: <%= stream.started_at.strftime("%Y-%m-%d %H:%M") %>
                      </small>
                    <% end %>
                    <% if stream.ended_at.present? %>
                      <br>
                      <small style="color: #666;">
                        Ended: <%= stream.ended_at.strftime("%Y-%m-%d %H:%M") %>
                      </small>
                    <% end %>
                  </td>
                  <td>
                    <% if stream.scheduled_at.present? %>
                      <small style="color: #00d9ff;">
                        <%= stream.scheduled_at.strftime("%Y-%m-%d %H:%M") %>
                      </small>
                    <% else %>
                      <span style="color: #666;">—</span>
                    <% end %>
                  </td>
                  <td>
                    <% if stream.live_url.present? %>
                      <small style="color: #888; font-family: monospace; word-break: break-all;">
                        <%= truncate(stream.live_url, length: 40) %>
                      </small>
                    <% else %>
                      <span style="color: #666;">—</span>
                    <% end %>
                  </td>
                  <td style="text-align: center;">
                    <% case stream.display_state %>
                    <% when :live %>
                      <span class="green-255-text" style="font-weight: bold;">⚡ LIVE</span>
                    <% when :upcoming %>
                      <span style="color: #00d9ff; font-weight: bold;">📅 SCHEDULED</span>
                    <% when :starting_soon %>
                      <span style="color: #f59e0b; font-weight: bold;">⏳ STARTING SOON</span>
                    <% when :cancelled %>
                      <span style="color: #ff4444;">✗ CANCELLED</span>
                    <% when :expired %>
                      <span style="color: #888;">⏰ EXPIRED</span>
                    <% when :ended %>
                      <span style="color: #666;">✓ Ended</span>
                    <% else %>
                      <span style="color: #666;">⚫ Offline</span>
                    <% end %>
                  </td>
                  <td style="text-align: center;">
                    <div style="display: flex; gap: 5px; justify-content: center; white-space: nowrap;">
                      <% if stream.is_live %>
                        <%= tui_button_to "⏸ End Stream", end_stream_admin_hackr_stream_path(stream),
                            color: :orange,
                            style: "padding: 2px 10px; font-size: 0.9em;",
                            form: { style: "display: contents;" },
                            data: { confirm: "End this livestream?" } %>
                      <% elsif stream.ended_at.present? %>
                        <span class="tui-button grey-168"
                              style="padding: 2px 10px; font-size: 0.9em; opacity: 0.5; cursor: not-allowed;"
                              title="Stream already finished. Create a new stream to go live again.">
                          ✓ Finished
                        </span>
                      <% elsif stream.cancelled_at.present? %>
                        <span class="tui-button grey-168"
                              style="padding: 2px 10px; font-size: 0.9em; opacity: 0.5; cursor: not-allowed;">
                          ✗ Cancelled
                        </span>
                      <% elsif stream.live_url.present? %>
                        <%= tui_button_to "▶ Go Live", go_live_admin_hackr_stream_path(stream),
                            color: :green,
                            style: "padding: 2px 10px; font-size: 0.9em;",
                            form: { style: "display: contents;" },
                            data: { confirm: "Start livestream for #{stream.artist.name}?" } %>
                      <% else %>
                        <span class="tui-button grey-168"
                              style="padding: 2px 10px; font-size: 0.9em; opacity: 0.5; cursor: not-allowed;"
                              title="Set stream URL first">
                          ▶ Go Live
                        </span>
                      <% end %>
                      <% if stream.scheduled_at.present? && stream.cancelled_at.nil? && !stream.is_live? && stream.ended_at.nil? %>
                        <%= tui_button_to "✗ Cancel", cancel_admin_hackr_stream_path(stream),
                            color: :orange,
                            style: "padding: 2px 10px; font-size: 0.9em;",
                            form: { style: "display: contents;" },
                            data: { confirm: "Cancel scheduled stream?" } %>
                      <% end %>
                      <%= tui_button "✎ Edit", edit_admin_hackr_stream_path(stream),
                          color: :cyan,
                          style: "padding: 2px 10px; font-size: 0.9em;" %>
                      <%= tui_button_to "✗ Delete", admin_hackr_stream_path(stream),
                          method: :delete,
                          form: { style: "display: contents;" },
                          data: { confirm: "Delete stream for #{stream.artist.name}?" },
                          color: :red,
                          style: "padding: 2px 10px; font-size: 0.9em;" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      <% else %>
        <div style="padding: 40px; text-align: center; background: #1a1a1a; border: 1px solid #333;">
          <p style="color: #666; font-size: 1.2em;">No streams configured yet. Create your first one!</p>
        </div>
      <% end %>
    </div>
<% end %>
