<%# /root/test_guide — the manual testing guide's article list as a
    console screen (2026-11-04; root_console.css): bar ([>] RUNS),
    ARTICLES / TIME / SOURCE rows, then either // ACTIVE RUN // (the
    run, its progress, [>] CONTINUE to the next unrecorded article, [>]
    RUN) or // START A RUN // (LABEL + [START TEST RUN] — POST
    test_runs), one // <AREA> // ledger per area numbered through (NN
    opens the article · title over slug · the active run's STATUS ·
    ~MIN), destinations, the > prompt. Assigns: @areas, @total_minutes,
    @active_run, @results. %>
<% content_for :title, "/root/test_guide :: TEST GUIDE" %>
<% articles = TestGuide.articles %>
<% numbers = articles.each_index.map { |i| root_num(i) } %>
<% position = articles.each_with_index.to_h { |a, i| [a.slug, i] } %>
<% status_tone = {"pass" => "rc-on", "fail" => "rc-bad", "blocked" => "rc-star", "skip" => "rc-violet"} %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "TEST GUIDE", sub: "ROOT · META · /root/test_guide"} do %>
    <% if @active_run %><%= root_badge("RUN OPEN", :live) %><% end %>
    <%= link_to "[>] RUNS", admin_test_runs_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ARTICLES</span>
      <span class="console-val"><%= articles.size %> <span class="console-dim">· in <%= pluralize(@areas.size, "area") %> · a full pass over the public site, THE PULSE GRID and /root</span></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">TIME</span>
      <span class="console-val">~<%= @total_minutes / 60 %>h<%= @total_minutes % 60 %>m <span class="console-dim">· summed from the articles</span></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">SOURCE</span>
      <span class="console-val">docs/testing/ <span class="console-dim">· readable offline</span></span>
    </div>
  </div>

  <% if @active_run %>
    <% next_unrecorded = articles.find { |a| !@results.key?(a.slug) } %>
    <div class="console-rule"><span>// ACTIVE RUN //</span></div>
    <div class="console-status">
      <div class="console-status-row">
        <span class="console-key">RUN</span>
        <span class="console-val"><%= link_to @active_run.label, admin_test_run_path(@active_run), class: "console-link" %> <span class="console-dim">· started <%= @active_run.created_at.strftime("%Y-%m-%d %H:%M") %></span></span>
      </div>
      <div class="console-status-row">
        <span class="console-key">PROGRESS</span>
        <span class="console-val"><%= @results.size %> / <%= articles.size %> recorded <span class="console-dim">· <%= @active_run.progress(articles.size) %>%</span> · <span class="<%= @results.values.any? { |r| r.status == "fail" } ? "rc-bad" : "rc-on" %>"><%= @results.values.count { |r| r.status == "fail" } %> failed</span><% if next_unrecorded %> <span class="console-dim">· next: <%= next_unrecorded.title.upcase %></span><% end %></span>
      </div>
    </div>
    <div class="rc-actions">
      <% if next_unrecorded %>
        <%= link_to "[>] CONTINUE", admin_test_guide_article_path(next_unrecorded.slug), class: "rc-btn rc-btn--hot", title: next_unrecorded.title, data: {command: "continue"} %>
      <% end %>
      <%= link_to "[>] RUN", admin_test_run_path(@active_run), class: "rc-btn", data: {command: "run"} %>
    </div>
  <% else %>
    <%= form_with url: admin_test_runs_path, method: :post, local: true do %>
      <div class="console-rule"><span>// START A RUN //</span></div>
      <div class="console-status">
        <%= root_field("LABEL", id: "label") do %>
          <%= text_field_tag :label, nil, class: "rc-input rc-input--wide", placeholder: "environment + date", autocomplete: "off" %>
          <span class="rc-hint">blank names it by the time · the run opens on the first article</span>
        <% end %>
      </div>
      <div class="rc-actions">
        <button type="submit" class="rc-btn rc-btn--hot">[START TEST RUN]</button>
      </div>
    <% end %>
  <% end %>

  <% @areas.each do |area, area_articles| %>
    <section class="console-section rc-ledger rc-ledger--guide" aria-label="<%= area %>">
      <div class="console-rule"><span>// <%= area.upcase %> //</span></div>
      <% area_articles.each do |article| %>
        <% result = @results[article.slug] %>
        <div class="rc-row">
          <span class="console-tag">[<%= numbers[position[article.slug]] %>]</span>
          <div class="cc-text">
            <%= link_to article.title, admin_test_guide_article_path(article.slug), class: "console-link cc-name", data: {command: numbers[position[article.slug]]} %>
            <div class="cc-meta"><%= article.slug %></div>
          </div>
          <span class="rc-cell <%= result ? status_tone[result.status] : "rc-off" %>"><%= result ? result.status.upcase : "—" %></span>
          <span class="rc-cell rc-cell--r">~<%= article.minutes %> MIN</span>
        </div>
      <% end %>
    </section>
  <% end %>

  <%= render "admin/console/destinations", section: :meta, except: "GUIDE" %>

  <div class="console-rule"><span>// END OF GUIDE //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:meta, except: "GUIDE", numbers: numbers, noun: "an article number", extra: (@active_run ? %w[continue run] : [])) %>
</div>
