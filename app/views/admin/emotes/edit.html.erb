<%# /root/emotes/:slug/edit — the emote record as a console screen
    (2026-10-31; show redirects here). Bar (token · ROOT · EMOTE · path;
    [<] EMOTES, [HISTORY]), the fields with the IMAGE row, // COMMIT //
    ([SAVE] [CANCEL] · [DELETE]), destinations, the > prompt. The purge
    and delete forms are hidden at the end; their ghost buttons point at
    them (form=). URLs use slug_in_database — a rejected slug must not
    build the form's action (gotchas). Assigns: @emote. %>
<% slug = @emote.slug_in_database %>
<% token = ":#{slug}:" %>
<% content_for :title, "/root/emotes/#{slug} :: EMOTE" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: token, sub: "ROOT · EMOTE · /root/emotes/#{slug}"} do %>
    <%= link_to "[<] EMOTES", admin_emotes_path, class: "console-bar-link" %>
    <%= link_to "[HISTORY]", history_admin_emote_path(slug), class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @emote, url: admin_emote_path(slug), method: :patch, local: true do |f| %>
    <%= render "form", f: f, emote: @emote %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[SAVE EMOTE]</button>
      <%= link_to "[CANCEL]", admin_emotes_path, class: "rc-btn" %>
      <span class="rc-actions--end">
        <button type="submit" form="delete-emote" class="rc-btn rc-btn--danger">[DELETE EMOTE]</button>
      </span>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :content %>

  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:content) %>

  <div class="rc-hidden-forms">
    <%= root_delete_form("purge-image", purge_image_admin_emote_path(slug), confirm: "Remove the image from #{token}? It stops rendering until a new one is uploaded.") %>
    <%= root_delete_form("delete-emote", admin_emote_path(slug), confirm: "Delete #{token}? Copies already rendered into chat history will break.") %>
  </div>
</div>
