<%# /root/emotes — the emotes ledger as a console screen (2026-10-31;
    root_console.css): bar, ON RECORD + USE rows, // EMOTES // rows ([NN]
    · the emote as chat draws it · token over the image facts · ENABLED /
    DISABLED · updated · [EDIT] [HISTORY]), destinations, the > prompt
    (NN opens the record screen; deletes live there). Assigns: @emotes. %>
<% content_for :title, "/root/emotes :: EMOTES" %>
<% emotes = @emotes.to_a %>
<% numbers = emotes.each_index.map { |i| root_num(i, total: emotes.size) } %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "EMOTES", sub: "ROOT · CONTENT · /root/emotes"} do %>
    <%= link_to "[+] NEW EMOTE", new_admin_emote_path, class: "console-bar-link", data: {command: "new"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(emotes.size, "emote") %> <span class="console-dim">· <%= emotes.count(&:enabled?) %> enabled · <%= emotes.count(&:gif?) %> animated</span></span>
    </div>
    <div class="console-status-row">
      <span class="console-key">USE</span>
      <span class="console-val console-dim">hackrs type :slug: in the uplink or on the WIRE (autocomplete opens after the colon) · disabled emotes stop rendering in new packets; rendered history keeps its images</span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--emotes" aria-label="Emotes">
    <div class="console-rule"><span>// EMOTES //</span></div>
    <% if emotes.empty? %>
      <%= render "admin/console/empty", text: "NO EMOTES ON RECORD", hint: "[+] NEW EMOTE uploads the first one" %>
    <% end %>
    <% emotes.each_with_index do |emote, i| %>
      <% num = numbers[i] %>
      <% image = emote.image.attached? %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <span class="rc-cell">
          <% if image %>
            <%= link_to image_tag(emote.chat_url, alt: emote.token, class: "rc-emote"), edit_admin_emote_path(emote), tabindex: -1, aria: {hidden: true} %>
          <% else %>
            <span class="rc-emote-none">NO IMAGE</span>
          <% end %>
        </span>
        <div class="cc-text">
          <%= link_to emote.token, edit_admin_emote_path(emote), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta">
            <% if image %>
              <%= emote.image.content_type.delete_prefix("image/").upcase %> · <%= number_to_human_size(emote.image.byte_size) %><% if emote.image.metadata["width"] %> · <%= emote.image.metadata["width"] %>×<%= emote.image.metadata["height"] %> (<%= emote.chat_size.join("×") %> in chat)<% end %><% if emote.gif? %> · animated, served as uploaded<% end %>
            <% else %>
              no image · does not render
            <% end %>
          </div>
        </div>
        <span class="rc-cell <%= emote.enabled? ? "rc-on" : "rc-off" %>"><%= emote.enabled? ? "ENABLED" : "DISABLED" %></span>
        <span class="rc-cell rc-cell--r"><%= emote.updated_at.strftime("%Y-%m-%d") %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[EDIT]", edit_admin_emote_path(emote), class: "console-link" %>
          <%= link_to "[HISTORY]", history_admin_emote_path(emote), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :content, except: "EMOTES" %>

  <div class="console-rule"><span>// EVERY EMOTE ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:content, except: "EMOTES", numbers: numbers, noun: "an emote number", extra: ["new"]) %>
</div>
