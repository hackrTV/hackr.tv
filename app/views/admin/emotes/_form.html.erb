<%# Flash Messages %>
<% if flash[:error] %>
  <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin: 20px 0;">
    <p class="red-255-text">⚠ ERROR</p>
    <p class="white-text"><%= flash[:error] %></p>
  </div>
<% end %>

<%= form_with model: [:admin, emote], local: true do |f| %>
  <h3 class="cyan-255-text" style="margin: 20px 0 15px 0;">[:: EMOTE ::]</h3>

  <div style="max-width: 480px;">
    <div style="margin-bottom: 20px;">
      <%= f.tui_text_field :slug, label: "SLUG",
          hint: "2–32 chars: a-z, 0-9, _ (at least one letter). Hackrs type it as :slug: — lowercased on save.",
          autocomplete: "off", spellcheck: "false" %>
    </div>

    <div style="margin-bottom: 20px;">
      <%= f.tui_check_box :enabled, label: "ENABLED", style: "width: 20px; height: 20px;",
          hint: "Disabled emotes stay literal :slug: text in new packets and vanish from the autocomplete." %>
    </div>

    <div style="margin-bottom: 20px;">
      <%= f.tui_file_field :image, label: emote.image.attached? ? "REPLACE IMAGE" : "IMAGE",
          accept: "image/png,image/gif,image/webp",
          hint: "PNG, GIF, or WebP, 512 KB max. Square ~112px looks best. PNG/WebP are resized to 56×56 WebP for chat; GIFs are served as uploaded so animation survives (animated WebP would be flattened — use GIF)." %>
    </div>
  </div>

  <%# Actions %>
  <div style="margin-top: 30px; display: flex; gap: 10px;">
    <%= tui_submit "Save Emote", form: f,
        color: :purple,
        style: "padding: 10px 30px; font-size: 1.1em;" %>
    <%= tui_button "Cancel", admin_emotes_path,
        color: :grey,
        style: "padding: 10px 30px; font-size: 1.1em;" %>
    <% if emote.persisted? %>
      <%= tui_button "History", history_admin_emote_path(emote),
          color: :purple,
          style: "padding: 10px 30px; font-size: 1.1em;" %>
    <% end %>
  </div>
<% end %>
