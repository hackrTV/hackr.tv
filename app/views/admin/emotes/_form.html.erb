<%# The emote record's fields as console status rows (ConsoleFormBuilder
    rc_* rows — SLUG, FLAGS) and the hand-written IMAGE row: the emote as
    chat draws it + the file facts, [^] REPLACE / UPLOAD inside this form,
    [x] REMOVE pointing at the caller's hidden purge form. After a failed
    update the attachment may hold the REJECTED, unsaved blob — only a
    persisted blob has a signed URL, so nothing is previewed then
    (gotchas); a new emote has no previous image to fall back on. The commit row belongs to the caller. Locals: f, emote. %>
<% persisted_image = emote.image.attached? && emote.image.blob.persisted? %>
<div class="console-status">
  <%= f.rc_text_field :slug, required: true, autocomplete: "off", spellcheck: "false",
    hint: "2–32 chars: a-z, 0-9, _ (at least one letter) · hackrs type it as :slug: · lowercased on save" %>
  <%= f.rc_flags("FLAGS", hint: "disabled emotes stay literal :slug: text in new packets and leave the autocomplete") do %>
    <%= f.rc_check_box :enabled, label: "ENABLED" %>
  <% end %>
  <div class="console-status-row rc-field">
    <span class="console-key">IMAGE</span>
    <span class="console-val">
      <% if persisted_image %>
        <%= image_tag emote.chat_url, alt: emote.token, class: "rc-emote" %>
        <span class="rc-hint">in chat: <%= emote.token %> · <%= emote.image.content_type.delete_prefix("image/").upcase %> · <%= number_to_human_size(emote.image.byte_size) %><% if emote.image.metadata["width"] %> · <%= emote.image.metadata["width"] %>×<%= emote.image.metadata["height"] %> (<%= emote.chat_size.join("×") %> in chat)<% end %> · <%= emote.gif? ? "animated GIF, served as uploaded" : "served as a WebP variant fitted to 224×56" %></span>
      <% elsif emote.image.attached? %>
        <span class="rc-bad">UPLOAD REJECTED</span>
        <% if emote.persisted? %>
          <span class="rc-hint">Upload rejected — the previous image is unchanged. Reload to preview it.</span>
        <% else %>
          <span class="rc-hint">Upload rejected — pick another file.</span>
        <% end %>
      <% else %>
        <span class="rc-off">NO IMAGE</span>
        <span class="rc-hint">the emote does not render until one is uploaded</span>
      <% end %>
      <span class="rc-pick" data-controller="file-pick">
        <%= f.file_field :image, accept: "image/png,image/gif,image/webp", class: "rc-pick-input",
          data: {file_pick_target: "input", action: "change->file-pick#changed"} %>
        <button type="button" class="rc-btn" data-action="file-pick#open">[^] <%= emote.image.attached? ? "REPLACE" : "UPLOAD" %> IMAGE</button>
        <span class="rc-hint" data-file-pick-target="name">no file chosen</span>
      </span>
      <% if persisted_image && emote.persisted? %>
        <button type="submit" form="purge-image" class="rc-btn rc-btn--danger">[x] REMOVE IMAGE</button>
      <% end %>
      <% if (errors = emote.errors[:image]).any? %><span class="rc-err"><%= errors.join(", ") %></span><% end %>
    </span>
  </div>
</div>
<p class="rc-sub">PNG, GIF or WebP, 512 KB max, any aspect ratio (wide FrankerFaceZ-style emotes work; past 4:1 they letterbox). Chat draws emotes 28px tall, so upload at least 56px tall for hi-dpi screens (FFZ 4x files are ideal). PNG / WebP shrink to fit 224×56 and serve as WebP; GIFs serve as uploaded so the animation survives (animated WebP would flatten — use GIF).</p>
