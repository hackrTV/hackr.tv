<%# /root/grid_economy — the CRED economy as a console screen (2026-11-01;
    root_console.css): bar ([>] TRANSACTIONS), // SUPPLY // tiles (total,
    halving, both pools against their totals, mined, awarded, burned,
    redeemed), // ABUSE FLAGS // (registration IPs behind more than one
    active rig — only when any), // CACHES //, // MINING RIGS //, the
    newest 100 // TRANSACTIONS // (time · hash · TYPE · from · to ·
    amount · memo), destinations, the > prompt. Data ledgers: no row
    opens anything here. Assigns: @supply, @caches, @active_rigs,
    @recent_transactions, @flagged_ips. %>
<% content_for :title, "/root/grid_economy :: ECONOMY" %>
<% caches = @caches.to_a %>
<% rigs = @active_rigs.to_a %>
<% transactions = @recent_transactions.to_a %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "ECONOMY", sub: "ROOT · SYSTEMS · /root/grid_economy"} do %>
    <%= link_to "[>] TRANSACTIONS", admin_grid_transactions_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-rule"><span>// SUPPLY //</span></div>
  <div class="rc-stats">
    <div class="rc-stat"><span class="rc-stat-key">TOTAL SUPPLY</span><span class="rc-stat-val"><%= format_cred(@supply[:total]) %></span><span class="rc-stat-key">CRED</span></div>
    <div class="rc-stat"><span class="rc-stat-key">HALVING</span><span class="rc-stat-val"><%= @supply[:halving_factor] %>x</span></div>
    <div class="rc-stat"><span class="rc-stat-key">MINING POOL</span><span class="rc-stat-val rc-on"><%= format_cred(@supply[:mining_pool_balance]) %></span><span class="rc-stat-key">OF <%= format_cred(@supply[:mining_pool_total]) %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">MINED</span><span class="rc-stat-val"><%= format_cred(@supply[:mining_pool_mined]) %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">GAMEPLAY POOL</span><span class="rc-stat-val rc-on"><%= format_cred(@supply[:gameplay_pool_balance]) %></span><span class="rc-stat-key">OF <%= format_cred(@supply[:gameplay_pool_total]) %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">AWARDED</span><span class="rc-stat-val"><%= format_cred(@supply[:gameplay_awarded]) %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">BURNED</span><span class="rc-stat-val rc-bad"><%= format_cred(@supply[:total_burned]) %></span></div>
    <div class="rc-stat"><span class="rc-stat-key">REDEEMED</span><span class="rc-stat-val rc-violet"><%= format_cred(@supply[:total_redeemed]) %></span></div>
  </div>

  <% if @flagged_ips.any? %>
    <section class="console-section rc-ledger rc-ledger--abuse" aria-label="Abuse flags">
      <div class="console-rule"><span>// ABUSE FLAGS · <%= @flagged_ips.size %> //</span></div>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>REGISTRATION IP</span><span class="rc-cell--r">ACTIVE RIGS</span>
      </div>
      <% @flagged_ips.each do |ip, count| %>
        <div class="rc-row">
          <span><%= ip %></span>
          <span class="rc-cell rc-cell--r rc-bad"><%= count %></span>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--caches" aria-label="Caches">
    <div class="console-rule"><span>// CACHES · <%= caches.size %> //</span></div>
    <% if caches.empty? %>
      <%= render "admin/console/empty", text: "NO CACHES ON RECORD", hint: "rails data:economy seeds the system caches" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>ADDRESS</span><span>OWNER</span><span>NICKNAME</span><span class="rc-cell--r">BALANCE</span><span>STATUS</span><span>TYPE</span><span>CREATED</span>
      </div>
    <% end %>
    <% caches.each do |cache| %>
      <div class="rc-row">
        <span class="rc-cell"><%= cache.address %></span>
        <span class="rc-cell <%= "rc-off" if cache.system? %>"><%= cache.system? ? "[SYSTEM]" : (cache.grid_hackr&.hackr_alias || "—") %></span>
        <span class="rc-cell rc-violet"><%= cache.nickname || "—" %></span>
        <span class="rc-cell rc-cell--r rc-on"><%= format_cred(cache.balance) %></span>
        <span class="rc-cell <%= cache.active? ? "rc-on" : "rc-off" %>"><%= cache.active? ? "ACTIVE" : "ABANDONED" %></span>
        <span class="rc-cell"><%= (cache.system_type || "player").upcase %></span>
        <span class="rc-cell"><%= cache.created_at.strftime("%Y-%m-%d") %></span>
      </div>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--rigs" aria-label="Active mining rigs">
    <div class="console-rule"><span>// MINING RIGS · <%= rigs.size %> ACTIVE //</span></div>
    <% if rigs.empty? %>
      <%= render "admin/console/empty", text: "NO ACTIVE MINING RIGS" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>HACKR</span><span class="rc-cell--r">RATE</span><span class="rc-cell--r">MULT</span><span class="rc-cell--r">PARTS</span><span>LAST TICK</span><span>REG IP</span>
      </div>
    <% end %>
    <% rigs.each do |rig| %>
      <div class="rc-row">
        <span class="rc-hot"><%= rig.grid_hackr.hackr_alias %></span>
        <span class="rc-cell rc-cell--r rc-on"><%= rig.effective_rate %></span>
        <span class="rc-cell rc-cell--r">x<%= rig.total_multiplier %></span>
        <span class="rc-cell rc-cell--r"><%= rig.components.count %></span>
        <span class="rc-cell"><%= rig.last_tick_at&.strftime("%Y-%m-%d %H:%M") || "—" %></span>
        <span class="rc-cell"><%= rig.grid_hackr.registration_ip || "—" %></span>
      </div>
    <% end %>
  </section>

  <section class="console-section rc-ledger rc-ledger--tx" aria-label="Recent transactions">
    <div class="console-rule"><span>// TRANSACTIONS · NEWEST 100 //</span></div>
    <% if transactions.empty? %>
      <%= render "admin/console/empty", text: "NO TRANSACTIONS YET", hint: "rails data:economy seeds genesis" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>TIME</span><span>HASH</span><span>TYPE</span><span>FROM</span><span>TO</span><span class="rc-cell--r">AMOUNT</span><span>MEMO</span>
      </div>
    <% end %>
    <% transactions.each do |tx| %>
      <div class="rc-row">
        <span class="console-tag"><%= tx.created_at.strftime("%Y-%m-%d %H:%M") %></span>
        <span class="rc-cell rc-off"><%= tx.short_hash %></span>
        <%= render "admin/grid_transactions/tx_type", tx: tx %>
        <span class="rc-cell"><%= tx.from_cache.address %></span>
        <span class="rc-cell"><%= tx.to_cache.address %></span>
        <span class="rc-cell rc-cell--r rc-on"><%= format_cred(tx.amount) %></span>
        <span class="rc-cell rc-off" title="<%= tx.memo %>"><%= tx.memo || "—" %></span>
      </div>
    <% end %>
    <div class="rc-actions">
      <%= link_to "[>] EVERY TRANSACTION", admin_grid_transactions_path, class: "rc-btn" %>
    </div>
  </section>

  <%= render "admin/console/destinations", section: :systems, except: "ECONOMY" %>

  <div class="console-rule"><span>// END OF LEDGER //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems, except: "ECONOMY") %>
</div>
