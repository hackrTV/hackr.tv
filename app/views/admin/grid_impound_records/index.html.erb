<%# /root/grid_impound_records — gear GovCorp holds as a console ledger
    (2026-11-01; root_console.css): bar (the DEV TOOLS badge), ON SCREEN,
    the // FILTER // rows (server-side: HACKR, STATUS links keeping the
    hackr — [FILTER] / [x] CLEAR), // IMPOUND // newest 200 (#id ·
    hackr, opening the inspector · breach · STATUS · bribe · items ·
    created · [RECOVER] [FORFEIT] while impounded and dev tools are on,
    each confirming first), destinations, the > prompt. Assigns:
    @records, @hackr_not_found. %>
<% content_for :title, "/root/grid_impound_records :: IMPOUND" %>
<% records = @records.to_a %>
<% status = params[:status].to_s.presence_in(GridImpoundRecord::STATUSES).to_s %>
<% keep = request.query_parameters.slice("hackr_alias").compact_blank %>
<% filtered = status.present? || keep.any? %>
<% status_tone = {"impounded" => "rc-bad", "recovered" => "rc-on", "forfeited" => "rc-off"} %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "IMPOUND", sub: "ROOT · SYSTEMS · /root/grid_impound_records"} do %>
    <% if dev_tools_enabled? %><%= root_badge("DEV TOOLS ON", :warn) %><% end %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON SCREEN</span>
      <span class="console-val"><%= pluralize(records.size, "record") %><% if filtered %> <span class="console-dim">· filtered</span><% end %> <span class="console-dim">· <%= records.count(&:impounded?) %> impounded · newest first · at most 200</span></span>
    </div>
  </div>

  <%= form_with url: admin_grid_impound_records_path, method: :get, local: true do %>
    <div class="console-rule"><span>// FILTER //</span></div>
    <div class="console-status">
      <%= root_field("HACKR", id: "hackr_alias") do %>
        <%= text_field_tag :hackr_alias, params[:hackr_alias], class: "rc-input", placeholder: "alias", autocomplete: "off", spellcheck: "false" %>
      <% end %>
      <div class="console-status-row rc-field">
        <span class="console-key">STATUS</span>
        <span class="console-val">
          <% [["ALL", ""]].concat(GridImpoundRecord::STATUSES.map { |s| [s.upcase, s] }).each do |word, value| %>
            <%= link_to word, admin_grid_impound_records_path(keep.merge(status: value.presence).compact), class: class_names("rc-btn", "rc-btn--on": status == value), aria: {current: status == value && "page"} %>
          <% end %>
        </span>
      </div>
    </div>
    <% if status.present? %><%= hidden_field_tag :status, status %><% end %>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[FILTER]</button>
      <%= link_to "[x] CLEAR", admin_grid_impound_records_path, class: "rc-btn" %>
    </div>
  <% end %>

  <section class="console-section rc-ledger rc-ledger--impound" aria-label="Impound records">
    <div class="console-rule"><span>// IMPOUND //</span></div>
    <% if @hackr_not_found %>
      <%= render "admin/console/empty", text: "NO HACKR NAMED '#{params[:hackr_alias]}'", hint: "[x] CLEAR shows every record" %>
    <% elsif records.empty? %>
      <%= render "admin/console/empty", text: filtered ? "NO RECORDS MATCH" : "NOTHING IMPOUNDED YET", hint: ("[x] CLEAR shows every record" if filtered) %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span>ID</span><span>HACKR</span><span>BREACH</span><span>STATUS</span><span class="rc-cell--r">BRIBE</span><span class="rc-cell--r">ITEMS</span><span>CREATED</span><span></span>
      </div>
    <% end %>
    <% records.each do |record| %>
      <div class="rc-row">
        <span class="console-tag">#<%= record.id %></span>
        <%= link_to record.grid_hackr.hackr_alias, admin_grid_hackr_path(record.grid_hackr), class: "console-link cc-name" %>
        <span class="rc-cell rc-off"><%= record.grid_hackr_breach_id || "—" %></span>
        <span class="rc-cell <%= status_tone[record.status] %>"><%= record.status.upcase %></span>
        <span class="rc-cell rc-cell--r rc-star"><%= record.bribe_cost %></span>
        <span class="rc-cell rc-cell--r"><%= record.impounded_items.size %></span>
        <span class="rc-cell"><%= record.created_at.strftime("%Y-%m-%d %H:%M") %></span>
        <span class="rc-cell rc-links">
          <% if record.impounded? && dev_tools_enabled? %>
            <%= button_to "[RECOVER]", force_recover_admin_grid_impound_record_path(record), method: :post, class: "rc-btn",
              form: {data: {confirm: "Force-recover impound ##{record.id}? Items return to inventory, no CRED charged."}} %>
            <%= button_to "[FORFEIT]", force_forfeit_admin_grid_impound_record_path(record), method: :post, class: "rc-btn rc-btn--danger",
              form: {data: {confirm: "Force-forfeit impound ##{record.id}? All items will be PERMANENTLY DESTROYED."}} %>
          <% end %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :systems, except: "IMPOUND" %>

  <div class="console-rule"><span>// NEWEST RECORDS //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:systems, except: "IMPOUND") %>
</div>
