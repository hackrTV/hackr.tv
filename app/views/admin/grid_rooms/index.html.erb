<%# /root/grid_rooms — the rooms ledger as a console screen (2026-10-31;
    root_console.css): bar, ON RECORD row, the FILTER row (ledger-filter:
    name / slug / zone / region / type — replaces the old filter script;
    ~2,100 rows, served in full as the old table was), // ROOMS // rows
    ([NNNN] · name over slug · ZONE · TYPE · CL · PLAYLIST · [HISTORY]),
    destinations, the > prompt (NN opens the record screen; deletes live
    there). Assigns: @rooms. %>
<% content_for :title, "/root/grid_rooms :: ROOMS" %>
<% rooms = @rooms.to_a %>
<% numbers = rooms.each_index.map { |i| root_num(i, total: rooms.size) } %>
<div class="console console--root" data-controller="terminal ledger-filter" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "ROOMS", sub: "ROOT · WORLD · /root/grid_rooms"} do %>
    <%= link_to "[+] NEW ROOM", new_admin_grid_room_path, class: "console-bar-link", data: {command: "new"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(rooms.size, "room") %> <span class="console-dim">· <%= pluralize(rooms.map(&:grid_zone_id).uniq.size, "zone") %></span></span>
    </div>
    <div class="console-status-row rc-field rc-filter">
      <label class="console-key" for="ledger-filter">FILTER</label>
      <span class="console-val">
        <input type="search" id="ledger-filter" class="rc-input" placeholder="name · slug · zone · region · type" autocomplete="off" spellcheck="false"
          data-ledger-filter-target="input" data-action="input->ledger-filter#filter">
        <span class="rc-count" data-ledger-filter-target="count"><%= rooms.size %> / <%= rooms.size %></span>
        <button type="button" class="rc-btn" data-action="ledger-filter#clear">[x] CLEAR</button>
      </span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--rooms" aria-label="Rooms">
    <div class="console-rule"><span>// ROOMS //</span></div>
    <% if rooms.empty? %>
      <%= render "admin/console/empty", text: "NO ROOMS ON RECORD", hint: "[+] NEW ROOM adds one to a zone" %>
    <% else %>
      <div class="rc-row rc-row--head" aria-hidden="true">
        <span></span><span>ROOM</span><span>ZONE</span><span>TYPE</span><span class="rc-cell--r">CL</span><span>PLAYLIST</span><span></span>
      </div>
    <% end %>
    <% rooms.each_with_index do |room, i| %>
      <% num = numbers[i] %>
      <% type = room.room_type %>
      <div class="rc-row" data-ledger-filter-target="row" data-search="<%= [room.name, room.slug, room.grid_zone.name, room.grid_zone.grid_region&.name, type].compact.join(" ").downcase %>">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to room.name, edit_admin_grid_room_path(room), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= room.slug.presence || "—" %></div>
        </div>
        <span class="rc-cell rc-hot"><%= room.grid_zone.name %></span>
        <span class="rc-cell <%= "rc-off" if type == "standard" %>"><%= type.upcase %></span>
        <span class="rc-cell rc-cell--r"><%= room.min_clearance %></span>
        <span class="rc-cell"><%= room.ambient_playlist&.name || "—" %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[HISTORY]", history_admin_grid_room_path(room), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :world, except: "ROOMS" %>

  <div class="console-rule"><span>// EVERY ROOM ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world, except: "ROOMS", numbers: numbers, noun: "a room number", extra: ["new"]) %>
</div>
