<%# The room's fields as console status rows (ConsoleFormBuilder rc_*
    rows; ZONE is a typed picker — admin/console/_picker), then
    // DESCRIPTION //. The slug follows the name until it is edited by
    hand, and the zone picker's script runs after the screen (_script).
    The commit row belongs to the caller. Locals: f, room; @zones,
    @playlists. %>
<% zone = room.grid_zone %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, autocomplete: "off", hint: "follows the name until edited" %>
  <%= render "admin/console/picker", label: "ZONE", key: "zone-cb", name: "grid_room[grid_zone_id]", value: room.grid_zone_id,
    text: zone && "#{zone.grid_region&.name} / #{zone.name}", placeholder: "type a zone or region", status: pluralize(@zones.length, "zone"),
    errors: f.rc_errors(:grid_zone_id) %>
  <%= f.rc_select :room_type,
    [["Standard", "standard"], ["Hub", "hub"], ["Faction Base", "faction_base"], ["GovCorp", "govcorp"], ["Special", "special"], ["Safe Zone", "safe_zone"], ["Transit", "transit"], ["Shop", "shop"], ["Danger Zone", "danger_zone"], ["Den", "den"], ["Hospital", "hospital"], ["Firmware Vendor", "firmware_vendor"], ["Repair Service", "repair_service"], ["Rest Pod", "rest_pod"], ["Containment", "containment"], ["Impound", "impound"], ["Sally Port Anteroom", "sally_port_anteroom"], ["Sally Port", "sally_port"]],
    {selected: room.room_type || "standard"}, label: "TYPE" %>
  <%= f.rc_number_field :min_clearance, label: "CLEARANCE", width: :short, min: 0 %>
  <%= f.rc_collection_select :ambient_playlist_id, @playlists, :id, :name, {include_blank: "(none)"}, label: "PLAYLIST", hint: "the room's ambient playlist" %>
</div>

<%= f.rc_text_area :description, rows: 4, spellcheck: true %>
