<%# The region's fields as console status rows (ConsoleFormBuilder rc_*
    rows), // DESCRIPTION //, then // GOVCORP ROOMS // — the six rooms
    capture, the facility and the restorepoint send a hackr to, each a
    typed picker over the region's own rooms (admin/console/_picker; the
    pickers' script is the caller's, _pickers). The commit row belongs
    to the caller. Locals: f, region. %>
<div class="console-status">
  <%= f.rc_text_field :name, required: true, autocomplete: "off", width: :wide %>
  <%= f.rc_text_field :slug, required: true, autocomplete: "off", hint: "unique · lowercase, hyphens" %>
</div>

<%= f.rc_text_area :description, rows: 3, spellcheck: true %>

<div class="console-rule"><span>// GOVCORP ROOMS //</span></div>
<div class="console-status">
  <% {hospital_room_id: "RESTOREPOINT", containment_room_id: "CONTAINMENT", cell_block_room_id: "CELL BLOCK", sally_port_room_id: "SALLY PORT",
       facility_exit_room_id: "EXIT · SALLY", facility_bribe_exit_room_id: "EXIT · BRIBE"}.each do |field, label| %>
    <% room = region.public_send(field.to_s.delete_suffix("_id")) %>
    <%= render "admin/console/picker", label: label, key: field.to_s.delete_suffix("_id").dasherize, name: "grid_region[#{field}]",
      value: region.public_send(field), text: room && "#{room.grid_zone.grid_region.name} / #{room.grid_zone.name} / #{room.name}",
      placeholder: region.persisted? ? "type a room of this region" : "save the region first", status: ("none" unless room),
      errors: f.rc_errors(field) %>
  <% end %>
</div>
