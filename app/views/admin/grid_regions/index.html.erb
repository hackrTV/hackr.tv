<%= render TuiWindowComponent.new(title: "/root/grid/regions :: MANAGE GRID REGIONS", variant: :admin) do %>

    <div style="padding: 20px;">
      <% if flash[:success] %>
        <div style="background: #003300; border: 2px solid #00ff00; padding: 15px; margin: 20px 0;">
          <p class="green-255-text"><%= flash[:success] %></p>
        </div>
      <% end %>

      <% if flash[:error] %>
        <div style="background: #330000; border: 2px solid #ff0000; padding: 15px; margin: 20px 0;">
          <p class="red-255-text"><%= flash[:error] %></p>
        </div>
      <% end %>

      <div style="display: flex; gap: 15px; align-items: center; margin-bottom: 20px;">
        <%= tui_button "← Dashboard", admin_root_path, color: :green %>
        <%= tui_button "+ New Region", new_admin_grid_region_path, color: :green %>
      </div>

      <% if @regions.any? %>
        <%= render TuiWindowComponent.new(variant: :panel, fieldset: false, style: "overflow-x: auto;") do %>
          <table class="tui-table" style="width: 100%;">
            <thead>
              <tr>
                <th style="text-align: left;">Name</th>
                <th style="text-align: left;">Slug</th>
                <th style="text-align: left;">Description</th>
                <th style="text-align: center;">Zones</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @regions.each_with_index do |region, i| %>
                <tr style="<%= " background: #112;" if i.odd? %>">
                  <td class="cyan-255-text"><strong><%= region.name %></strong></td>
                  <td style="font-family: monospace; color: #666;">/<%= region.slug %></td>
                  <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= truncate(region.description, length: 60) %></td>
                  <td style="text-align: center;"><%= region.grid_zones.size %></td>
                  <td style="text-align: right; white-space: nowrap;">
                    <%= tui_button "Map", admin_grid_map_editor_region_show_path(region_id: region.id), color: :cyan, style: "padding: 2px 8px; font-size: 0.8em;" %>
                    <%= tui_button "Edit", edit_admin_grid_region_path(region), style: "padding: 2px 8px; font-size: 0.8em; margin-left: 4px;" %>
                    <%= tui_button "History", history_admin_grid_region_path(region), color: :purple, style: "padding: 2px 8px; font-size: 0.8em; margin-left: 4px;" %>
                    <%= tui_button_to "Delete", admin_grid_region_path(region), method: :delete, form: { style: "display: inline;" }, color: :red, style: "padding: 2px 8px; font-size: 0.8em; margin-left: 4px;", data: { confirm: "Delete '#{region.name}'?" } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>

        <p style="color: #666; margin-top: 10px; font-size: 0.85em;">
          <%= @regions.count %> regions
        </p>
      <% else %>
        <div style="padding: 40px; text-align: center; background: #1a1a1a; border: 1px solid #333;">
          <p style="color: #666; font-size: 1.2em;">No regions yet.</p>
        </div>
      <% end %>
    </div>
<% end %>
