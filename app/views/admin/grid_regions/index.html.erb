<%# /root/grid_regions — the regions ledger as a console screen
    (2026-10-31; root_console.css): bar, ON RECORD row, // REGIONS //
    rows ([NN] · name over slug · description · ZONES · [MAP] [HISTORY]),
    destinations, the > prompt (NN opens the record screen; deletes live
    there). Assigns: @regions (zones preloaded). %>
<% content_for :title, "/root/grid_regions :: REGIONS" %>
<% regions = @regions.to_a %>
<% numbers = regions.each_index.map { |i| root_num(i, total: regions.size) } %>
<div class="console console--root" data-controller="terminal" data-boot="done">
  <%= render layout: "admin/console/bar", locals: {title: "REGIONS", sub: "ROOT · WORLD · /root/grid_regions"} do %>
    <%= link_to "[+] NEW REGION", new_admin_grid_region_path, class: "console-bar-link", data: {command: "new"} %>
  <% end %>
  <%= render "admin/console/flash" %>

  <div class="console-status">
    <div class="console-status-row">
      <span class="console-key">ON RECORD</span>
      <span class="console-val"><%= pluralize(regions.size, "region") %> <span class="console-dim">· <%= pluralize(regions.sum { |r| r.grid_zones.size }, "zone") %></span></span>
    </div>
  </div>

  <section class="console-section rc-ledger rc-ledger--regions" aria-label="Regions">
    <div class="console-rule"><span>// REGIONS //</span></div>
    <% if regions.empty? %>
      <%= render "admin/console/empty", text: "NO REGIONS ON RECORD", hint: "[+] NEW REGION starts the grid" %>
    <% end %>
    <% regions.each_with_index do |region, i| %>
      <% num = numbers[i] %>
      <div class="rc-row">
        <span class="console-tag">[<%= num %>]</span>
        <div class="cc-text">
          <%= link_to region.name, edit_admin_grid_region_path(region), class: "console-link cc-name", data: {command: num} %>
          <div class="cc-meta"><%= region.slug %><% if region.description.present? %> · <%= truncate(region.description, length: 80) %><% end %></div>
        </div>
        <span class="rc-cell rc-cell--r"><%= region.grid_zones.size %> ZONE<%= "S" unless region.grid_zones.size == 1 %></span>
        <span class="rc-cell rc-links">
          <%= link_to "[MAP]", admin_grid_map_editor_region_show_path(region_id: region.id), class: "console-link" %>
          <%= link_to "[HISTORY]", history_admin_grid_region_path(region), class: "console-link" %>
        </span>
      </div>
    <% end %>
  </section>

  <%= render "admin/console/destinations", section: :world, except: "REGIONS" %>

  <div class="console-rule"><span>// EVERY REGION ON RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world, except: "REGIONS", numbers: numbers, noun: "a region number", extra: ["new"]) %>
</div>
