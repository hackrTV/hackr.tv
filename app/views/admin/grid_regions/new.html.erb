<%# /root/grid_regions/new — a new region on the record screen's shell
    (the GOVCORP ROOMS pickers fill once the region has rooms). %>
<% content_for :title, "/root/grid_regions/new :: NEW REGION" %>
<div class="console console--root" data-controller="terminal" data-boot="done" data-terminal-autofocus-value="false">
  <%= render layout: "admin/console/bar", locals: {title: "NEW REGION", sub: "ROOT · REGION · /root/grid_regions/new"} do %>
    <%= link_to "[<] REGIONS", admin_grid_regions_path, class: "console-bar-link" %>
  <% end %>
  <%= render "admin/console/flash" %>

  <%= form_with model: @region, url: admin_grid_regions_path, local: true do |f| %>
    <%= render "form", f: f, region: @region %>
    <div class="console-rule"><span>// COMMIT //</span></div>
    <div class="rc-actions">
      <button type="submit" class="rc-btn rc-btn--hot">[CREATE REGION]</button>
      <%= link_to "[CANCEL]", admin_grid_regions_path, class: "rc-btn" %>
    </div>
  <% end %>

  <%= render "admin/console/destinations", section: :world %>
  <div class="console-rule"><span>// END OF RECORD //</span></div>
  <%= render "shared/console_prompt", hint: root_prompt_hint(:world) %>
</div>
<%= render "pickers" %>
