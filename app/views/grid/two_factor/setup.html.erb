<% content_for :title, "Two-Factor Setup — hackr.tv" %>

<%= render layout: "grid/shared/auth_window", locals: {legend: "TWO-FACTOR AUTH", dark: true} do %>
  <div class="center auth-head">
    <h1 class="cyan-255-text auth-title auth-title--sm">TWO-FACTOR AUTHENTICATION</h1>
    <p class="auth-sub auth-sub--sm">HACKR: <%= current_hackr.hackr_alias %></p>
  </div>

  <% if @error %>
    <div class="auth-error--thin"><p><%= @error %></p></div>
  <% end %>

  <div class="tf-section">
    <p class="cyan-255-text tf-step">STEP 1: SCAN QR CODE</p>
    <p class="tf-scan-hint">Scan this QR code with your authenticator app:</p>

    <div class="center">
      <%# Server-generated by RQRCode from our own provisioning URI — trusted markup. %>
      <div class="tf-qr-box"><%== @qr_svg %></div>
    </div>

    <p class="tf-secret-hint">Or enter this secret manually:</p>
    <div class="tf-secret-box"><%= @secret %></div>

    <p class="cyan-255-text tf-step tf-step--gap">STEP 2: VERIFY CODE</p>

    <%# turbo=false: success renders the shown-once backup codes as a 200
        from the POST — Turbo would refuse a 200 form response. %>
    <%= form_with url: grid_two_factor_enable_path, data: {turbo: false} do %>
      <%= hidden_field_tag :otp_secret, @secret %>
      <div class="tf-field">
        <%= label_tag :password, "CONFIRM PASSWORD", class: "white-text tf-label" %>
        <%= password_field_tag :password, nil, class: "tui-input auth-input", placeholder: "Enter your password", required: true %>
      </div>
      <div class="tf-field">
        <%= label_tag :code, "AUTHENTICATOR CODE", class: "white-text tf-label" %>
        <%= text_field_tag :code, nil, class: "tui-input auth-input", placeholder: "6-digit code", maxlength: 6, autocomplete: "one-time-code", required: true %>
      </div>
      <div class="center tf-actions">
        <%= submit_tag "ACTIVATE 2FA", class: "btn-terminal btn-terminal--wide" %>
        <%= link_to "CANCEL", grid_two_factor_path, class: "btn-cancel" %>
      </div>
    <% end %>
  </div>

  <div class="center tf-back">
    <%= link_to "← BACK TO IDENTITY", grid_identity_path %>
  </div>
<% end %>
