<% content_for :title, "Register — hackr.tv" %>

<%= render layout: "grid/shared/auth_window", locals: {legend: "THE PULSE GRID :: REGISTRATION"} do %>
  <% if @sent_email %>
    <div class="center auth-head">
      <h1 class="green-255-text auth-success-head">CHECK YOUR INBOX</h1>
      <p class="auth-success-lede">
        A verification link has been sent to<br>
        <span class="cyan-255-text"><strong><%= @sent_email %></strong></span>
      </p>
      <p class="auth-success-note">
        Click the link in the email to complete your registration and join the Fracture Network.
      </p>
      <p class="auth-success-fine">The link expires in 24 hours.</p>
    </div>

    <hr class="auth-hr">

    <div class="center auth-alt">
      <p class="white-text auth-alt-label">DIDN'T RECEIVE IT?</p>
      <%= link_to "TRY AGAIN", grid_register_path, class: "tui-button purple-168" %>
    </div>
  <% else %>
    <%= render "grid/shared/auth_error", message: @error, title: "ERROR" %>

    <div class="center auth-head">
      <h1 class="cyan-255-text auth-title">REGISTER</h1>
      <p class="auth-sub">JOIN THE FRACTURE NETWORK</p>
    </div>

    <%= form_with url: grid_register_path do %>
      <div class="auth-field">
        <%= label_tag :email, "EMAIL ADDRESS", class: "white-text auth-label" %>
        <%= email_field_tag :email, params[:email], class: "tui-input auth-input", placeholder: "Enter your email", required: true, autofocus: true %>
        <small class="gray-text auth-hint">We'll send you a verification link to complete registration.</small>
      </div>

      <div class="center auth-actions">
        <%= submit_tag "SEND VERIFICATION", class: "tui-button purple-168 auth-submit" %>
      </div>
    <% end %>

    <hr class="auth-hr">

    <div class="center auth-alt">
      <p class="white-text auth-alt-label">ALREADY REGISTERED?</p>
      <%= link_to "LOG IN", grid_login_path, class: "tui-button green-168" %>
    </div>
  <% end %>
<% end %>
